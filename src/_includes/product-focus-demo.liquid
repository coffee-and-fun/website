          <div class="focus-window" id="focus-demo" data-focus-demo>
            <div class="focus-window-bar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>ProcrastiNOT</span><span class="demo-tag">Demo</span></div>
            <div class="focus-window-content">
              <img class="focus-app-icon" src="{{ product.icon }}" alt="" width="88" height="88" fetchpriority="high">
              <p class="eyebrow focus-status" data-focus-state>ROOM TO FOCUS</p>
              <h2 data-focus-title>This tab<br>can wait.</h2>
              <p class="focus-caption" data-focus-caption>A small pause for the thing<br>you meant to do.</p>
              <form class="focus-math" data-focus-form hidden>
                <label for="focus-answer">Ready for a break? Try the math.</label>
                <div class="focus-math-row"><span aria-hidden="true">8 × 7 =</span><input id="focus-answer" name="answer" type="text" inputmode="numeric" autocomplete="off" maxlength="3" required aria-label="What is eight times seven?" aria-describedby="focus-feedback"><button type="submit">Check</button></div>
              </form>
              <p class="focus-feedback" id="focus-feedback" role="status" data-focus-feedback>Try it here. No extension needed.</p>
              <button class="focus-reset" type="button" data-focus-reset hidden>Try it again</button>
              <noscript><p class="focus-noscript">In the app, solve a math problem to turn blocking off.</p></noscript>
            </div>
          </div>
