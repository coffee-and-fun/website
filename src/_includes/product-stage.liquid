{% case productKey %}
{% when 'markdown-editor' %}
<figure class="cp-stage cp-editor-stage"><img src="/assets/images/apps/{{ product.image }}" alt="{{ product.imageAlt | escape }}" width="{{ product.image | prepend: '/assets/images/apps/' | imageWidth }}" height="{{ product.image | prepend: '/assets/images/apps/' | imageHeight }}" fetchpriority="high"><figcaption>The real editor. Your words, with room to breathe.</figcaption></figure>
{% when 'stillkeys' %}
<figure class="cp-stage cp-stillkeys-stage" id="app-preview" data-appearance="light"><div class="cp-stillkeys-capture"><img class="capture-light" src="/assets/images/stillkeys/app-light.png" alt="Stillkeys with timer choices and the Start cleaning screen button." width="2880" height="1800" fetchpriority="high"><img class="capture-dark" src="/assets/images/stillkeys/app-dark.png" alt="Stillkeys in dark appearance, with the same timer choices and cleaning controls." width="2880" height="1800" loading="lazy" hidden></div><figcaption><span>Right at home on your Mac.</span><div class="appearance-picker" role="group" aria-label="App screenshot appearance" hidden><button type="button" data-appearance="light" aria-pressed="true">Light</button><button type="button" data-appearance="dark" aria-pressed="false">Dark</button></div></figcaption></figure>
{% when 'procrastinot' %}
<figure class="cp-stage cp-focus-stage"><div class="cp-demo-scene">{% include product-focus-demo.liquid %}</div><figcaption>An interactive example. Your tabs stay as they are.</figcaption></figure>
{% when 'hide-spoilers-extension' %}
<figure class="cp-stage cp-spoiler-stage"><div class="cp-demo-scene"><div class="cp-spoiler-demo"><div class="cp-window-bar"><span aria-hidden="true">● ● ●</span> A spoiler-free corner</div><div class="cp-spoiler-inner"><p class="cp-eyebrow">THE INTERNET HAS THOUGHTS</p><h2>The big reveal.<br>On your terms.</h2><div class="cp-hidden-spoiler" data-spoiler-text aria-hidden="true"><span>It was the cat.<br>It’s always the cat.</span></div><p class="cp-spoiler-caption" role="status" data-spoiler-status>A pretend spoiler. Safely blurred.</p><button class="cp-button cp-primary" data-spoiler-toggle type="button" aria-pressed="false">Reveal the sample</button></div></div></div><figcaption>Try a sample of the blur effect.</figcaption></figure>
{% when 'immersive-reader' %}
<figure class="cp-stage cp-reader-stage"><div class="cp-demo-scene"><div class="cp-reader-sheet"><div class="cp-reader-toolbar" aria-hidden="true"><span>Aa</span><span>Listen</span><span>Translate</span></div><p class="cp-eyebrow">A LITTLE ROOM TO READ</p><h2>A page.<br>Your pace.</h2><p class="cp-reader-lines"><span>Some days, a little more space</span><mark>makes room for a good story.</mark><span>Find the way in that feels like you.</span></p><div class="cp-reader-audio" aria-hidden="true">▶ <span>{% for n in (1..13) %}<i></i>{% endfor %}</span> Read along</div></div></div><figcaption>Reading concept illustration. App coming soon.</figcaption></figure>
{% when 'instant-incognito' %}
<figure class="cp-stage cp-archive-stage"><div class="cp-demo-scene"><div class="cp-private-window"><div class="cp-window-bar"><span aria-hidden="true">● ● ●</span> A private window</div><img src="{{ product.icon }}" alt="" width="140" height="140"><h2>A quieter entrance.</h2><p>Chosen websites.<br>A separate browsing window.</p></div></div><figcaption>Illustration of an earlier Coffee &amp; Fun project.</figcaption></figure>
{% when 'flash-cards' %}
<figure class="cp-stage cp-study-stage"><div class="cp-demo-scene"><div class="cp-study-card"><span class="cp-eyebrow">ONE THING TO REMEMBER</span><h2>What makes<br>a good idea stick?</h2><p>A little practice.<br>And another look tomorrow.</p><span class="cp-study-footer">01 / A SMALL STUDY SESSION</span></div></div><figcaption>Illustration of a retired study companion.</figcaption></figure>
{% endcase %}
