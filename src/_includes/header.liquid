                    <li><a href="/focus-timer/">Focus timer</a></li>
                    <li><a href="/timezone-converter/">Time zone converter</a></li>
                    <li><a href="/word-clock/">Word clock</a></li>
                    <li><a href="/flip/">Flip a coin</a></li>
