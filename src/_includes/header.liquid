{% assign showDonation = showDonation | default: false %}
{% assign showTriviaApp = showTriviaApp | default: false %}
{% assign showMysteryApp = showMysteryApp | default: false %}
{% assign showDiscordApp = showDiscordApp | default: true %}
{% assign showMenu = showMenu | default: true %}
{% assign showKeyboardModal = showKeyboardModal | default: false %}
{% assign showInstantApp = showInstantApp | default: false %}
{% assign showProcrastinot = showProcrastinot | default: false %}
{% assign showFun = showFun | default: false %}
{% assign showMiddleBadge = showMiddleBadge | default: false %}
{% assign showMiddleBadgeWithText = showMiddleBadgeWithText | default: false %}
{% assign showSpoilers = showSpoilers | default: false %}
{% assign showTicker = showTicker | default: false %}

{% if showTicker %}
  {% include ticker.liquid %}
{% endif %}

<style>
  /* Mega menu — daisyUI's megamenu relies on CSS anchor positioning, which
     Chromium has and Firefox (and older Safari) don't. So: show the megamenu
     ONLY where anchor positioning works, and fall back to the original pill
     nav everywhere else. The modal menu remains available on every browser. */
  .cf-megawrap { display: none; }
  @supports (anchor-name: --a) {
    .cf-megawrap { display: none; }
    @media (min-width: 768px) { .cf-megawrap { display: block; } .cf-navfallback { display: none !important; } }
  }

  .cf-pill { background: color-mix(in srgb, var(--color-cream) 95%, transparent);
    border-radius: 9999px; padding-inline: 0.5rem; box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
    outline: 1px solid color-mix(in srgb, var(--color-mocha) 20%, transparent); backdrop-filter: blur(4px); }
  .cf-mm-trigger { font-size: 1.5rem; font-weight: 600; color: #292524; background: transparent;
    border: 0; border-radius: 9999px; padding-inline: 1rem; cursor: pointer; }
  .cf-mm-trigger:hover { color: var(--color-espresso); }
  .cf-mm-trigger:focus-visible { outline: 2px solid var(--color-espresso); outline-offset: 2px; }

  /* megamenu-wide pins the panel to the trigger-pill width; a 3-column panel
     needs more room, so widen it (higher specificity than daisyUI's rule). */
  .megamenu.megamenu-wide .cf-mm-panel { width: max-content; min-width: 34rem; max-width: min(92vw, 44rem); }
  .cf-mm-panel { padding: 1.25rem 1.4rem 1rem; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    box-shadow: 0 20px 40px -12px rgb(0 0 0 / 0.25); }
  .cf-mm-grid { display: grid; grid-template-columns: repeat(3, minmax(160px, 1fr)); gap: 1.5rem 2rem; }
  .cf-mm-head { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    color: #8a7f74; margin: 0 0 0.5rem; }
  .cf-mm-panel ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.15rem; }
  .cf-mm-panel a { display: block; padding: 0.4rem 0.5rem; margin-inline: -0.5rem; border-radius: 0.5rem;
    font-size: 0.95rem; color: #44403c; text-decoration: none; }
  .cf-mm-panel a:hover { background: #faf5ee; color: var(--color-espresso); }
  .cf-mm-panel a:focus-visible { outline: 2px solid var(--color-espresso); outline-offset: 1px; }
  .cf-mm-foot { margin: 1rem 0 0; padding-top: 0.75rem; border-top: 1px solid #ece3d7; }
  .cf-mm-foot a { font-weight: 600; color: var(--color-espresso); font-size: 0.9rem; }
  @media (prefers-reduced-motion: reduce) {
    .megamenu-active, .megamenu [popover] { transition: none !important; }
  }
</style>

<header class="pointer-events-none sticky top-0 z-40">
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:rounded-lg focus:text-white focus:text-sm focus:font-semibold focus:outline-none focus:ring-2 focus:ring-offset-2 bg-espresso focus:ring-espresso"
  >
    Skip to main content
  </a>

  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 pt-4 pb-3">
    <div class="relative flex items-center gap-4">

      <!-- Left: Logo (no circle wrap, larger) -->
      <div class="flex flex-1">
        <a
          href="/"
          aria-label="Coffee &amp; Fun homepage"
          class="pointer-events-auto block h-20 w-20 sm:h-24 sm:w-24 transition hover:scale-105 focus:outline-none focus-visible:ring-2 focus-visible:ring-espresso focus-visible:ring-offset-2 rounded-full"
        >
          <img
            alt="Coffee &amp; Fun LLC logo"
            src="/assets/images/coffee-and-fun-logo-dark.png"
            width="120"
            height="120"
            class="h-full w-full object-contain"
            decoding="async"
          />
        </a>
      </div>

      <!-- Center: Nav pill (desktop) / Menu button (mobile) -->
      <div class="flex flex-1 justify-end md:justify-center">

        <!-- Mobile menu button -->
        {% if showMenu %}
          <button
            type="button"
            class="pointer-events-auto md:hidden inline-flex items-center gap-2 rounded-full bg-cream/95 px-5 py-2 text-lg font-semibold text-stone-800 shadow-lg ring-1 ring-mocha/20 backdrop-blur-sm transition hover:text-espresso hover:ring-mocha/40 focus:outline-none focus-visible:ring-2 focus-visible:ring-espresso focus-visible:ring-offset-2"
            style="font-family: 'Caveat', cursive;"
            onclick="my_modal_site_menu.showModal()"
            aria-label="Open site navigation menu"
            aria-controls="my_modal_site_menu"
          >
            Menu
            <svg viewBox="0 0 8 6" aria-hidden="true" class="h-auto w-2 stroke-espresso">
              <path d="M1.75 1.75 4 4.25l2.25-2.5" fill="none" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        {% endif %}

        <!-- Desktop mega menu — keeps the cream pill + Caveat character, adds
             rich panels. Falls back to the simple pill nav below on browsers
             without CSS anchor positioning, and the modal menu works everywhere. -->
