{% pageCss "site-header" %}
{% pageCss "journal" %}
{% pageJs "site-header" %}
{% assign cfTool = false %}
{% for item in apps.tools %}{% if page.url == item.link %}{% assign cfTool = true %}{% endif %}{% endfor %}
{% assign cfProducts = '/stillkeys/|/markdown-editor/|/immersive-reader/|/procrastinot/|/hide-spoilers-extension/|/instant-incognito/|/flash-cards/' | split: '|' %}
{% assign cfProduct = false %}
{% for path in cfProducts %}{% if page.url == path %}{% assign cfProduct = true %}{% endif %}{% endfor %}
<header class="cf-header{% if cfTool or toolPage %} cf-header-tool{% endif %}" data-site-header>
  <a href="#{{ skipTarget | default: 'main-content' }}" class="cf-skip">Skip to main content</a>
  <div class="cf-header-inner">
    <a class="cf-brand" href="/" aria-label="{% if cfTool or toolPage %}By {% endif %}Coffee &amp; Fun home">
      {% if cfTool or toolPage %}<span class="cf-by">by</span>{% endif %}
      <img src="/assets/images/brand/coffee-and-fun-logo-dark.png" alt="" width="92" height="92" decoding="async">
    </a>
    <div class="cf-desktop-navigation">{% include navigation.liquid %}</div>
    <details class="cf-mobile-navigation">
      <summary>Menu <span aria-hidden="true">⌄</span></summary>
      <div class="cf-mobile-panel">{% include navigation.liquid %}</div>
    </details>
  </div>
</header>
