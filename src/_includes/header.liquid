            <button type="button" popovertarget="mm-play" class="cf-mm-trigger">Play</button>
            <div popover id="mm-play" class="cf-mm-panel">
              <div class="cf-mm-grid">
                <div>
                  <p class="cf-mm-head">Head to head</p>
                  <ul>
                    <li><a href="/tactical-tiles/">Tactical Tiles</a></li>
                    <li><a href="/drop-dungeon/">Drop Dungeon</a></li>
