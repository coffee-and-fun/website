<!DOCTYPE html>
<html class="brand-color-background scroll-smooth antialiased" lang="en" data-theme="light" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  
  <!-- Primary Meta Tags -->
  <title>{{ title | escape }} - Coffee & Fun LLC</title>
  <meta name="description" content="{{ description | escape }}" />
  {%- assign postAuthorSlug = author | default: authors.default -%}
{%- assign postAuthor = false -%}
{%- for p in authors.people -%}{%- if p.slug == postAuthorSlug -%}{%- assign postAuthor = p -%}{%- endif -%}{%- endfor -%}
{%- unless postAuthor -%}{%- for p in authors.people -%}{%- if p.slug == authors.default -%}{%- assign postAuthor = p -%}{%- endif -%}{%- endfor -%}{%- endunless -%}
  <meta name="author" content="{{ postAuthor.name }}" />
  <meta name="keywords" content="{{ keywords | escape }}" />
  <meta name="robots" content="index, follow" />
  <meta name="rating" content="safe for kids" />
<link
  rel="canonical"
  href="https://www.coffeeandfun.com{{ page.url }}"
/>
  <!-- Favicon -->
  <link rel="icon" href="/assets/images/brand/favicon.png" />

  <!-- PWA Manifest -->
  <link rel="manifest" href="/assets/images/social/site.webmanifest" />

  <!-- Theme & Mobile Meta -->
  <meta name="theme-color" content="#fef5ec" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />

  <!-- Icons -->
  <link rel="apple-touch-icon" href="/assets/images/social/192.png" />
  <link rel="icon" href="/assets/images/social/192.png" sizes="192x192" type="image/png" />

  <!-- Open Graph Meta Tags -->
  <meta property="og:title" content="{{ title | escape }} - Coffee & Fun LLC" />
  <meta property="og:site_name" content="Coffee & Fun LLC" />
  <meta property="og:url" content="https://www.coffeeandfun.com{{ page.url }}" />
  <meta property="og:description" content="{{ description | escape }}" />
  <meta property="og:type" content="article" />
  <meta property="og:image" content="https://www.coffeeandfun.com{{img}}" />
  {% assign ogW = img | imageWidth %}{% assign ogH = img | imageHeight %}{% if ogW != '' and ogH != '' %}<meta property="og:image:width" content="{{ ogW }}" />
  <meta property="og:image:height" content="{{ ogH }}" />
  {% endif %}<meta property="og:image:alt" content="Cover art for: {{ cardTitle | default: title | escape }}" />
  <meta property="article:author" content="Coffee & Fun LLC" />
  <meta property="article:published_time" content="{{date | date: '%Y-%m-%d' }}" />

  <!-- Twitter Meta Tags -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@bycoffeeandfun" />
  <meta name="twitter:title" content="{{ title | escape }} - Coffee & Fun LLC" />
  <meta name="twitter:description" content="{{ description | escape }}" />
  <meta name="twitter:image" content="https://www.coffeeandfun.com{{img}}" />
  <meta name="twitter:image:alt" content="Cover art for: {{ cardTitle | default: title | escape }}" />

  <!-- Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ title | json }},
    "description": {{ description | json }},
    "image": "https://www.coffeeandfun.com{{img}}",
    "author": {
      "@type": "Person",
      {% if postAuthor.slug == authors.default %}"@id": "https://www.coffeeandfun.com/#founder",{% endif %}
      "name": {{ postAuthor.name | json }},
      "jobTitle": {{ postAuthor.title | json }},
      "url": "https://www.coffeeandfun.com{{ postAuthor.url }}"
    },
    "publisher": { "@id": "https://www.coffeeandfun.com/#organization" },
    "isPartOf": { "@id": "https://www.coffeeandfun.com/#website" },
    "inLanguage": "en",
    "datePublished": "{{date | date: '%Y-%m-%d' }}",
    "dateModified": "{{date | date: '%Y-%m-%d' }}",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://www.coffeeandfun.com{{ page.url }}"
    }
  }
  </script>

  {% include schema-org.liquid %}

    {% bundledCss %}
  {% pageCss "post" %}

  <!-- Service Worker -->
  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/service-worker.js').catch(() => {});
      });
    }
  </script>

  {% include scripts.html %}
</head>

<body class="cf-post-page">
  {% include header.liquid %}
  <main tabindex="-1" id="main-content" class="mx-auto max-w-7xl">
    <div class="po-reading-column mx-auto max-w-4xl pt-8 pb-12 sm:pt-12 sm:pb-16 lg:pt-16 lg:pb-20 px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="po-breadcrumb breadcrumbs text-sm mb-4 text-stone-600">
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><span aria-current="page">{{ title }}</span></li>
        </ul>
      </nav>
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.coffeeandfun.com/" },
          { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://www.coffeeandfun.com/blog/" },
          { "@type": "ListItem", "position": 3, "name": {{ title | jsonify }} }
        ]
      }
      </script>

      <nav aria-label="Blog navigation" class="po-navigation relative mb-6 sm:mb-8">
        <div class="po-back-group">
          <a class="po-back" href="/blog/" aria-label="Back to the blog">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7.25 11.25 3.75 8m0 0 3.5-3.25M3.75 8h8.5"/></svg>
          </a>
          <span class="po-back-label" aria-hidden="true">Back to the blog</span>
        </div>
        <span class="po-notebook-note" aria-hidden="true">from our notebook<svg viewBox="0 0 145 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M3 6C42 1 84 12 141 4M23 10C61 5 93 13 122 8"/></svg></span>
      </nav>
      <article aria-labelledby="article-title" class="prose prose-lg sm:prose-xl max-w-none">
        <header class="po-article-header relative not-prose mb-8 sm:mb-12">
          {% include post-doodles.liquid, place: 'header' %}
          <h1 id="article-title" class="text-2xl sm:text-3xl lg:text-4xl xl:text-5xl font-bold tracking-tight mb-6 sm:mb-8 leading-tight">{{ cardTitle | default: title }}</h1>
          <div class="po-meta flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 py-4 border-t border-b">
            <div class="po-byline flex flex-wrap items-center gap-2 sm:gap-3">
              <a class="po-author" href="{{ postAuthor.url }}" rel="author">{{ postAuthor.name }}</a>
              <time class="po-date" datetime="{{ date | date: '%Y-%m-%d' }}">{{ date | formatDateWithOrdinal }}</time>
            </div>
            {% if time %}<span class="po-reading-time">{{ time }}<span class="sr-only"> read</span></span>{% endif %}
          </div>
          <div class="po-cover relative mt-8 sm:mt-12">
            <picture>
              <source srcset="{{ img | replace: '.png', '.webp' | replace: '.jpg', '.webp' }}" type="image/webp">
              <img src="{{ img }}" alt="{{ title | escape }}" width="1200" height="630" class="w-full h-64 sm:h-80 lg:h-96 object-cover rounded-2xl mb-8 border-stone-200 border" title="{{ title | escape }}" fetchpriority="high" decoding="async">
            </picture>
          </div>
        </header>
        <div class="relative article-content mt-8 sm:mt-12">
          {% include post-doodles.liquid, place: 'body' %}
          {{ content | safe }}
        </div>
        <footer class="po-article-footer relative not-prose mt-12 sm:mt-16 pt-8 border-t">
          {% include post-doodles.liquid, place: 'footer' %}
          {% include author-bio.liquid %}
          <div class="po-footer-links flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mt-10 sm:mt-12">
            <div class="flex items-center gap-3">
              <span class="text-sm font-medium">Share this article:</span>
              <a class="po-share" href="https://twitter.com/intent/tweet?text={{ title | url_encode }}&url=https://www.coffeeandfun.com{{ page.url | safe }}" target="_blank" rel="noopener noreferrer" aria-label="Share on Twitter">
                <svg width="22" height="22" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"/></svg>
              </a>
            </div>
            <a class="po-more" href="/blog/">More articles</a>
          </div>
        </footer>
      </article>
    </div>
  </main>
  {% include footer.liquid %}
</body>
</html>
