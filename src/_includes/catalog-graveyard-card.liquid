{% assign retiredTag = 'div' %}{% if app.link %}{% assign retiredTag = 'a' %}{% endif %}
<{{ retiredTag }} class="app-card ca-archived{% if app.name == 'Instant Incognito' or app.name == 'Instant Flash Cards' %} ca-archived-wide{% endif %}"{% if app.link %} href="{{ app.link }}"{% endif %} data-title="{{ app.name | downcase | escape }}" data-description="{{ app.description | downcase | escape }}" data-platforms="{{ app.platform | join: ' ' | downcase }}">
  <div class="ca-retired-art" style="--retired-art: {{ app.catalogBackground }};" aria-hidden="true"><img src="{{ app.image }}" alt="" {% if app.name == 'Mystery Rank' %}width="1363" height="701"{% else %}width="800" height="420"{% endif %} loading="lazy" decoding="async">{% if app.name == 'Instant Incognito' or app.name == 'Instant Flash Cards' %}<svg viewBox="0 0 800 220" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M76 62L81 81L100 86L82 94L77 114L71 95L51 90L69 81ZM703 126L712 109L716 127L735 134L717 140L713 159L705 143L687 138ZM101 158Q127 144 146 158M110 170Q129 160 145 172M646 60L656 70M661 48L667 63"/></svg>{% endif %}</div>
  <div class="ca-archived-copy"><h3>{{ app.name }}</h3><span class="ca-retired-status">{% if app.link %}Retired project{% else %}No longer available{% endif %}</span><span class="ca-retired-platform">{{ app.platform | join: ' · ' }}</span></div>
</{{ retiredTag }}>
