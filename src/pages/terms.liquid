<!doctype html>
<html class="brand-color-background scroll-smooth antialiased" lang="en" data-theme="light" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary Meta Tags -->
    <title>Terms &amp; Refunds - Coffee &amp; Fun LLC</title>
    <meta name="title" content="Terms &amp; Refunds - Coffee &amp; Fun LLC" />
    <meta name="description" content="The rules for using Coffee &amp; Fun apps and tools, in plain English. Includes our 30 day refund promise and how to get your money back wherever you bought." />
    <meta name="keywords" content="terms and conditions, refund policy, 30 day refund, Coffee &amp; Fun LLC, app terms, extension terms" />
    <meta name="author" content="Coffee &amp; Fun LLC" />
    <meta name="robots" content="index, follow" />
    <meta name="rating" content="safe for kids" />

    <link rel="canonical" href="https://www.coffeeandfun.com/terms/" />
    <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coffee &amp; Fun" />
    <meta property="og:title" content="Terms &amp; Refunds - Coffee &amp; Fun LLC" />
    <meta property="og:description" content="The rules for using Coffee &amp; Fun apps and tools, in plain English. Includes our 30 day refund promise and how to get your money back wherever you bought." />
    <meta property="og:url" content="https://www.coffeeandfun.com/terms/" />
    <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/terms.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Coffee &amp; Fun cup logo above a red badge reading Terms and Refunds" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bycoffeeandfun" />
    <meta name="twitter:creator" content="@bycoffeeandfun" />
    <meta name="twitter:title" content="Terms &amp; Refunds - Coffee &amp; Fun LLC" />
    <meta name="twitter:description" content="The rules for using Coffee &amp; Fun apps and tools, in plain English. Includes our 30 day refund promise and how to get your money back wherever you bought." />
    <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/terms.png" />
    <meta name="twitter:image:alt" content="Coffee &amp; Fun cup logo above a red badge reading Terms and Refunds" />

    <link rel="manifest" href="/assets/images/social/site.webmanifest" />
    <meta name="theme-color" content="#fef5ec" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="apple-touch-icon" href="/assets/images/social/192.png" />
    <link rel="icon" href="/assets/images/social/192.png" sizes="192x192" type="image/png" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": "Terms & Refunds",
        "description": "Coffee & Fun LLC terms of use and refund policy, including the 30 day refund window.",
        "url": "https://www.coffeeandfun.com/terms/",
        "publisher": {
          "@id": "https://www.coffeeandfun.com/#organization"
        },
        "breadcrumb": {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Home",
              "item": "https://www.coffeeandfun.com/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Terms & Refunds",
              "item": "https://www.coffeeandfun.com/terms/"
            }
          ]
        },
        "isPartOf": {
          "@id": "https://www.coffeeandfun.com/#website"
        }
      }
    </script>

    {% include schema-org.liquid %}

    {% bundledCss %}


    {% include scripts.html %}
    {% include sketch-styles.liquid %}
  </head>

  <body>
    {% assign showFun = true %}
    {% assign showMiddleBadgeWithText = true %}
    {% include header.liquid %}

    <main id="main-content">

      <!-- Hero -->
      <section class="relative mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 pt-20 sm:pt-28 pb-10 sm:pb-14 text-center overflow-visible">
        <h1 class="brand-heading text-4xl sm:text-5xl lg:text-6xl leading-[1.15] mb-5">
          Terms &amp; Refunds
        </h1>
        <p class="text-lg sm:text-xl text-stone-600 max-w-2xl mx-auto leading-relaxed">
          The rules for using our apps and tools, written so you can actually read them. Plus how to get your money back if something is not right.
        </p>

        <p class="mt-8 text-xl sm:text-2xl text-caramel" style="font-family: 'Caveat', cursive;">
          Plain English&nbsp;&nbsp;&middot;&nbsp;&nbsp;30 day refunds&nbsp;&nbsp;&middot;&nbsp;&nbsp;No small print
        </p>

        <div class="sketch-note text-lg sm:text-xl" style="top: 12px; right: 17%; transform: rotate(-5deg);">
          no lawyer speak!
          <svg width="86" height="84" style="bottom: -80px; left: -44px;">
            <path d="M80 4 C72 30, 50 54, 14 74" class="sketch-arrow"/>
            <path d="M14 60 L10 78 L30 72" class="sketch-arrow"/>
          </svg>
        </div>

        <div class="sketch-note sketch-wiggle" style="top: 40%; right: 6%; --sketch-rotate: 5deg;">
          <svg width="20" height="18" viewBox="0 0 22 20">
            <path d="M3 10 L9 16 L19 4" class="sketch-check"/>
          </svg>
        </div>

        <div class="sketch-note" style="top: 14%; left: 3%; transform: rotate(-12deg);">
          <svg width="24" height="24" viewBox="0 0 30 30">
            <path d="M15 2 L17 11 L26 11 L19 17 L22 26 L15 21 L8 26 L11 17 L4 11 L13 11 Z" fill="none" stroke="#fd6155" stroke-width="1.5" stroke-linejoin="round" opacity="0.4"/>
          </svg>
        </div>

        <div class="sketch-note" style="bottom: 6%; left: 4%;">
          <svg width="50" height="14" viewBox="0 0 50 14">
            <path d="M2 8 C8 2, 14 12, 20 7 C26 2, 32 12, 38 7 C44 2, 48 10, 48 7" class="sketch-squiggle"/>
          </svg>
        </div>
      </section>

      <!-- Content -->
      <section class="relative mx-auto max-w-2xl px-4 sm:px-6 lg:px-8 pb-16 overflow-visible">
        <div class="sketch-note text-base sm:text-lg" style="top: -10px; right: -8%; transform: rotate(4deg); opacity: 0.75;">
          the short version:<br/>be nice, we'll be fair
        </div>

        <div class="sketch-note" style="top: 42%; right: -5%;">
          <svg width="8" height="24" viewBox="0 0 8 24">
            <circle cx="4" cy="4" r="2.5" class="sketch-dots"/>
            <circle cx="4" cy="12" r="2.5" class="sketch-dots"/>
            <circle cx="4" cy="20" r="2.5" class="sketch-dots"/>
          </svg>
        </div>

        <article class="space-y-10 text-pretty">

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">The short version</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              Use our apps for whatever you like. Do not resell them or use them to hurt anyone. If you paid for something and you are not happy, tell us within 30 days and we will sort it out. That is really the whole thing.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">What these terms cover</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              Everything Coffee &amp; Fun LLC makes: our <a class="underline decoration-2 underline-offset-2" style="color: var(--color-caramel);" href="/apps/">apps, browser extensions and free web tools</a>, and this website.
            </p>
            <p class="text-lg text-stone-600 leading-relaxed mt-4">
              Helperbird has its own terms and its own billing. For anything about Helperbird, visit <a class="underline decoration-2 underline-offset-2" style="color: var(--color-caramel);" href="https://www.helperbird.com" rel="noopener">helperbird.com</a>.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">What you can do</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              Use our apps at home, at school, at work, on as many of your own devices as you want. Use what you make with them however you like. If you build a receipt, a signature or an image with one of our <a class="underline decoration-2 underline-offset-2" style="color: var(--color-caramel);" href="/apps/">free tools</a>, it is yours. We do not claim any of it.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">What you cannot do</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              Please do not sell our apps as your own, take them apart to make a copy, or use them to break the law or hurt someone. Do not use our tools to pretend to be a real business you are not. Our receipt generator is for testing, learning and mock ups, not for faking real receipts.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">What things cost</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              Most of what we make is free, and we like it that way. When we do charge, we try hard to keep the price low and the value obvious. We would rather have a tool you happily pay a little for than one you feel tricked by.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">Refunds: the 30 day rule</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              If you contact us within <strong class="text-stone-900">30 days</strong> of buying something or of a subscription renewing, we will refund you. You do not need a clever reason. "It is not for me" is a fine reason.
            </p>
            <p class="text-lg text-stone-600 leading-relaxed mt-4">
              How you get it back depends on where you bought it, and in almost every case that is straight from us.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">Almost everything: we refund it ourselves</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              Our browser extensions and anything bought on this site are billed by us through Stripe, not by the Chrome, Edge or Firefox stores. That means we can refund you directly. Email us, and the money goes back to the card you paid with, usually within five to ten working days depending on your bank. There is no fee and no form to fill in.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">The one exception: the App Store</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              Apple is the only place we cannot help directly. Apple takes the money for anything bought on the App Store, so only Apple can give it back, even when we would rather do it ourselves. Their process is quick once you know where to look, and we wrote a guide: <a class="underline decoration-2 underline-offset-2" style="color: var(--color-caramel);" href="/blog/how-to-find-apple-receipts-and-request-a-refund/">how to find your Apple receipts and request a refund</a>.
            </p>
            <p class="text-lg text-stone-600 leading-relaxed mt-4">
              If Apple says no and you think that is unfair, email us anyway. We will help you push back.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">The free tools come as they are</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              Our free web tools are given to you as they are, with no promises attached. We use them ourselves and we fix what we find, but we cannot promise they will never have a bad day. If one lets you down, please tell us, and please keep your own copy of anything important.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">When we change these terms</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              We update this page when something real changes, and the date at the bottom always tells you when. If a change matters to people who have paid us, we will say so rather than quietly editing the page.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">Which laws apply</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              Coffee &amp; Fun LLC is registered in Arkansas, in the United States, and these terms follow Arkansas law. None of this takes away rights you already have where you live. If your country gives you stronger consumer protection, you keep it.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">Talking to a human</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              There is no ticket system and no phone tree. Email <a class="underline decoration-2 underline-offset-2" style="color: var(--color-caramel);" href="mailto:hello@coffeeandfun.com">hello@coffeeandfun.com</a> and a person will read it. You can also use our <a class="underline decoration-2 underline-offset-2" style="color: var(--color-caramel);" href="/support/">support page</a>.
            </p>
          </section>

          <p class="text-sm text-stone-500 pt-4">Last updated: 4 August 2026.</p>

        </article>
      </section>

      <!-- CTA -->
      <section class="relative mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 pb-24 sm:pb-32 text-center overflow-visible">
        <div class="sketch-note text-base sm:text-lg" style="top: -6px; right: 8%; transform: rotate(4deg);">
          <svg width="18" height="16" viewBox="0 0 22 20" style="position: relative; display: inline-block; margin-right: 3px; vertical-align: middle;">
            <path d="M3 10 L9 16 L19 4" class="sketch-check"/>
          </svg>
          we do actually reply!
        </div>

        <h2 class="brand-heading text-3xl sm:text-4xl lg:text-5xl leading-[1.25] mb-4">
          Need a refund?
        </h2>
        <p class="text-lg sm:text-xl text-stone-600 max-w-xl mx-auto leading-relaxed mb-8">
          Tell us what you bought and roughly when. That is all we need to get started.
        </p>

        <div class="relative inline-block">
          <a
            class="btn btn-lg rounded-lg px-8 sm:px-10 font-semibold text-white border-0 bg-caramel hover:bg-espresso shadow-[0_10px_15px_-3px_rgba(122,78,49,0.35)] hover:shadow-xl hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-espresso focus-visible:ring-offset-2 transition-all duration-200"
            href="mailto:hello@coffeeandfun.com?subject=Refund%20request"
            title="Email Coffee &amp; Fun about a refund"
          >
            Email Us
          </a>
        </div>

        <div class="relative inline-block w-full">
          <p class="mt-6 text-sm text-stone-500">
            Or write to <a href="mailto:hello@coffeeandfun.com" class="underline hover:text-stone-700 transition-colors" style="color: var(--color-mocha);">hello@coffeeandfun.com</a>
          </p>
          <div class="sketch-note" style="bottom: -8px; left: 50%; transform: translateX(-50%);">
            <svg width="100" height="10" viewBox="0 0 100 10">
              <path d="M2 7 C12 2, 22 10, 35 5 C48 0, 58 10, 72 5 C85 0, 92 8, 98 4" class="sketch-underline"/>
            </svg>
          </div>
        </div>
      </section>

    </main>

    {% include modals.liquid %}
    {% include footer.liquid %}
  </body>
</html>
