    <link rel="apple-touch-icon" href="/assets/images/social/192.png" />
    <link rel="icon" href="/assets/images/social/192.png" sizes="192x192" type="image/png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coffee &amp; Fun" />
    <meta property="og:title" content="Delete Retweets, Likes and Tweets - Coffee &amp; Fun LLC" />
    <meta property="og:description" content="Build a free script that deletes your retweets, likes and tweets on X. Pick what to remove, copy it, paste it into your own browser console. No app, no account access." />
