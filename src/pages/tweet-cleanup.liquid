    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bycoffeeandfun" />
    <meta name="twitter:creator" content="@bycoffeeandfun" />
    <meta name="twitter:title" content="Delete Retweets, Likes and Tweets - Coffee &amp; Fun LLC" />
    <meta name="twitter:description" content="Build a free script that deletes your retweets, likes and tweets on X. Pick what to remove, copy it, paste it into your own browser console. No app, no account access." />
    <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/tweet-cleanup.png" />
    <meta name="twitter:image:alt" content="Delete Retweets, Likes and Tweets card with the Coffee and Fun cup logo" />
