<!DOCTYPE html>
<html class="antialiased" lang="en" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary Meta Tags -->
    <title>Free Blackjack Strategy Trainer - Coffee & Fun LLC</title>
    <meta name="title" content="Free Blackjack Strategy Trainer - Coffee & Fun LLC" />
    <meta name="description" content="Drill blackjack basic strategy one hand at a time: every hit, stand, double, split, and surrender is graded, with the full chart, dealer bust odds, and stats." />
    <meta name="author" content="Coffee & Fun LLC" />
    <meta name="robots" content="index, follow" />

    <!-- Canonical URL -->
    <link rel="canonical" href="https://www.coffeeandfun.com/blackjack-trainer/" />

    <!-- Favicon -->
    <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coffee & Fun" />
    <meta property="og:title" content="Free Blackjack Strategy Trainer - Coffee & Fun LLC" />
    <meta property="og:description" content="Drill blackjack basic strategy one hand at a time: every hit, stand, double, split, and surrender is graded, with the full chart, dealer bust odds, and stats." />
    <meta property="og:url" content="https://www.coffeeandfun.com/blackjack-trainer/" />
    <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/blackjack-trainer.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Two aces on a green felt table beside the words Hit or Stand, the free blackjack strategy trainer" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bycoffeeandfun" />
    <meta name="twitter:title" content="Free Blackjack Strategy Trainer - Coffee & Fun LLC" />
    <meta name="twitter:description" content="Drill blackjack basic strategy one hand at a time: every hit, stand, double, split, and surrender is graded, with the full chart, dealer bust odds, and stats." />
    <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/blackjack-trainer.png" />
    <meta name="twitter:image:alt" content="Two aces on a green felt table beside the words Hit or Stand, the free blackjack strategy trainer" />

    <meta name="theme-color" content="#0b4a30" />

    <!-- Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "VideoGame",
        "name": "Free Blackjack Strategy Trainer",
        "description": "Practice blackjack basic strategy with instant grading, plain-English explanations, the full strategy chart, dealer bust odds, and personal accuracy stats. Educational, no gambling, no bets.",
        "url": "https://www.coffeeandfun.com/blackjack-trainer/",
        "applicationCategory": "EducationalApplication",
        "operatingSystem": "Web Browser",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "author": {
          "@type": "Organization",
          "name": "Coffee & Fun LLC"
        },
        "publisher": {
          "@id": "https://www.coffeeandfun.com/#organization"
        },
        "creator": {
          "@id": "https://www.coffeeandfun.com/#founder"
        },
        "isAccessibleForFree": true,
        "inLanguage": "en"
      }
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "When should you hit or stand in blackjack?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Always stand on hard 17 or more. With hard 13–16, stand when the dealer shows 2–6 (they bust often) and hit against 7 through ace. Hard 12 is the exception: hit against a 2 or 3, stand against 4–6. Always hit hard 8 or less, and hit soft hands until at least soft 18."
            }
          },
          {
            "@type": "Question",
            "name": "When should you split pairs in blackjack?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Always split aces and eights. Never split tens or fives. Split 2s, 3s, and 7s against a dealer 2–7, split 6s against 2–6, and split 9s against 2–6 and 8–9 (stand against 7, 10, or ace)."
            }
          },
          {
            "@type": "Question",
            "name": "When should you double down?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Double hard 11 against everything except an ace, hard 10 against 2–9, and hard 9 against 3–6. Soft hands double against a weak dealer: for example, double soft 17 (A-6) against 3–6, and soft 18 (A-7) against 3–6."
            }
          },
          {
            "@type": "Question",
            "name": "Does basic strategy guarantee you win at blackjack?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. Basic strategy is the mathematically best decision for every hand, which shrinks the house edge to roughly half a percent, the lowest of any standard casino game, but the casino keeps a small long-run advantage. This trainer is for learning, not for gambling."
            }
          }
        ],
        "publisher": {
          "@id": "https://www.coffeeandfun.com/#organization"
        },
        "isPartOf": {
          "@id": "https://www.coffeeandfun.com/#website"
        }
      }
    </script>

    <!-- Casino marquee font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Limelight&display=swap" rel="stylesheet" />

    <script src="https://unpkg.com/vue@3"></script>

    {% pageCss "blackjack-trainer" %}
{% include schema-org.liquid %}

    </head>

<body>
{% raw %}
    <a href="#tool" class="skip">Skip to the trainer</a>

    <!-- Shown only if the CDN script fails, the app stays v-cloak-hidden. -->
    <div id="load-fallback" class="wrap" hidden>
        <p class="lede">The trainer couldn&rsquo;t load a file it needs. Check your connection and refresh the page.</p>
    </div>
    <noscript>
        <div class="wrap"><p class="lede">The blackjack trainer needs JavaScript turned on.</p></div>
    </noscript>

    <main v-cloak id="app" class="wrap">

        <div class="topbar">
            <a href="/" class="home-link" aria-label="Back to coffeeandfun.com">
                <img src="/assets/images/brand/coffee-and-fun-logo-dark.png" alt="" width="64" height="64" decoding="async" />
                <span class="tip" aria-hidden="true">Back to coffeeandfun.com</span>
            </a>
            <button type="button" class="mute-btn" @click="toggleMute" :aria-pressed="muted ? 'true' : 'false'"
                    :aria-label="muted ? 'Sound is off, turn it on' : 'Sound is on, turn it off'">
                <span aria-hidden="true">{{ muted ? '🔇' : '🔊' }}</span>
            </button>
        </div>

        <header id="tool">
            <h1>Hit or Stand?</h1>
            <p class="lede">Learn perfect blackjack one decision at a time. The dealer shows a card, you make the call, and the book grades you on the spot, with the why, the full chart, and your stats.</p>
        </header>

        <!-- Live status for screen readers -->
        <div class="sr-only" role="status" aria-live="polite">{{ announcement }}</div>

        <!-- View tabs -->
        <fieldset style="border:0;padding:0;margin:0;">
            <legend class="sr-only">Choose a view</legend>
            <div class="views">
                <label class="view-chip" :class="{ on: view === 'play' }">
                    <input type="radio" class="sr-only" name="view" value="play" v-model="view" />
                    🃏 Practice
                </label>
                <label class="view-chip" :class="{ on: view === 'chart' }">
                    <input type="radio" class="sr-only" name="view" value="chart" v-model="view" />
                    📋 The chart
                </label>
                <label class="view-chip" :class="{ on: view === 'stats' }">
                    <input type="radio" class="sr-only" name="view" value="stats" v-model="view" />
                    📈 Your stats
                </label>
            </div>
        </fieldset>

        <!-- ===================== PRACTICE ===================== -->
        <section v-if="view === 'play'" aria-label="Practice table">
            <div class="table-zone">
                <p class="deck-label">Dealer shows</p>
                <div class="cards-row">
                    <div class="pcard" :class="[{ red: isRed(up.s) }, dealAnim ? 'deal' : '']" role="img" :aria-label="cardName(up)">
                        <span class="corner" aria-hidden="true">{{ up.r }}<br>{{ up.s }}</span>
                        <span class="mid" aria-hidden="true"><span class="r">{{ up.r }}</span><span class="s">{{ up.s }}</span></span>
                        <span class="corner flip" aria-hidden="true">{{ up.r }}<br>{{ up.s }}</span>
                    </div>
                    <div class="pcard back" role="img" aria-label="Dealer's face-down card"></div>
                </div>

                <p class="felt-print" aria-hidden="true">Blackjack pays 3 to 2 &nbsp;·&nbsp; Dealer stands on soft 17</p>

                <p class="deck-label">Your hand</p>
                <div class="cards-row">
                    <div class="pcard" :class="[{ red: isRed(p1.s) }, dealAnim ? 'deal' : '']" role="img" :aria-label="cardName(p1)">
                        <span class="corner" aria-hidden="true">{{ p1.r }}<br>{{ p1.s }}</span>
                        <span class="mid" aria-hidden="true"><span class="r">{{ p1.r }}</span><span class="s">{{ p1.s }}</span></span>
                        <span class="corner flip" aria-hidden="true">{{ p1.r }}<br>{{ p1.s }}</span>
                    </div>
                    <div class="pcard" :class="[{ red: isRed(p2.s) }, dealAnim ? 'deal' : '']" role="img" :aria-label="cardName(p2)">
                        <span class="corner" aria-hidden="true">{{ p2.r }}<br>{{ p2.s }}</span>
                        <span class="mid" aria-hidden="true"><span class="r">{{ p2.r }}</span><span class="s">{{ p2.s }}</span></span>
                        <span class="corner flip" aria-hidden="true">{{ p2.r }}<br>{{ p2.s }}</span>
                    </div>
                </div>
                <span class="hand-total">{{ handLabel }} vs dealer {{ upLabel }}</span>

                <div class="actions" role="group" aria-label="Your decision">
                    <button type="button" class="act hit" @click="answer('hit')" :disabled="phase !== 'decide'">HIT</button>
                    <button type="button" class="act stand" @click="answer('stand')" :disabled="phase !== 'decide'">STAND</button>
                    <button type="button" class="act double" @click="answer('double')" :disabled="phase !== 'decide'">DOUBLE</button>
                    <button type="button" class="act split" @click="answer('split')" :disabled="phase !== 'decide' || !isPair">SPLIT</button>
                    <button type="button" class="act surrender" @click="answer('surrender')" :disabled="phase !== 'decide' || !surrenderAllowed">SURRENDER</button>
                </div>
                <p class="keys-hint" aria-hidden="true">Keys: <kbd>H</kbd> hit · <kbd>S</kbd> stand · <kbd>D</kbd> double · <kbd>P</kbd> split · <kbd>U</kbd> surrender · <kbd>N</kbd> next</p>
            </div>

            <div v-if="phase === 'feedback'" class="feedback" :class="lastResult.correct ? 'good' : 'bad'">
                <p class="fb-head">
                    <span aria-hidden="true">{{ lastResult.correct ? '✓' : '✗' }}</span>
                    {{ lastResult.correct ? feedbackPraise : 'The book says: ' + actionName(lastResult.best) }}
                </p>
                <p class="fb-why" v-html="lastResult.why"></p>
                <div class="fb-row">
                    <button type="button" class="btn btn-primary" @click="nextHand">Next hand</button>
                    <button type="button" class="linkish" @click="showOnChart">See it on the chart</button>
                    <span style="font-size:0.82rem;color:var(--muted);">Streak: {{ stats.streak }}{{ stats.streak >= 5 ? ' 🔥' : '' }}</span>
                </div>
            </div>

            <div class="drill-row">
                <div class="focus-set" role="group" aria-label="What to practice">
                    <label v-for="f in FOCUSES" :key="f.key" class="focus-chip" :class="{ on: focus === f.key }">
                        <input type="radio" class="sr-only" name="focus" :value="f.key" v-model="focus" />
                        {{ f.name }}
                    </label>
                </div>
                <label class="surr-toggle">
                    <input type="checkbox" v-model="surrenderAllowed" />
                    This table allows surrender
                </label>
            </div>
        </section>

        <!-- ===================== CHART ===================== -->
        <section v-else-if="view === 'chart'" aria-label="Basic strategy chart">
            <p class="chart-note">The complete basic strategy for the most common game: <strong>4–8 decks, dealer stands on soft 17, double after split allowed</strong>. Find your hand on the left, the dealer&rsquo;s up-card along the top, the cell is the mathematically best play. It doesn&rsquo;t guarantee a win; it guarantees the smallest possible house edge.</p>
            <div class="legend" aria-hidden="true">
                <span><span class="lg c-H cellbox" style="margin:0;">H</span> Hit</span>
                <span><span class="lg c-S cellbox" style="margin:0;">S</span> Stand</span>
                <span><span class="lg c-D cellbox" style="margin:0;">D</span> Double (else hit)</span>
                <span><span class="lg c-Ds cellbox" style="margin:0;">Ds</span> Double (else stand)</span>
                <span><span class="lg c-P cellbox" style="margin:0;">P</span> Split</span>
                <span><span class="lg c-Su cellbox" style="margin:0;">Su</span> Surrender (else hit)</span>
            </div>

            <h2 class="chart-h">Hard totals</h2>
            <div class="chart-scroll" tabindex="0" role="region" aria-label="Hard totals strategy table">
                <table class="strat">
                    <caption class="sr-only">Best play for hard totals against each dealer up-card</caption>
                    <thead>
                        <tr><th scope="col">You have</th><th v-for="d in DEALERS" :key="'hh'+d" scope="col">{{ dLabel(d) }}</th></tr>
                    </thead>
                    <tbody>
                        <tr v-for="t in HARD_ROWS" :key="'hr'+t">
                            <th scope="row">{{ t === 8 ? '8 or less' : (t === 17 ? '17+' : t) }}</th>
                            <td v-for="d in DEALERS" :key="'hc'+t+'-'+d">
                                <div class="cellbox" :class="['c' + '-' + chartCode('hard', t, d), { hot: isHot('hard', t, d) }]" :id="cellId('hard', t, d)">{{ chartCode('hard', t, d) }}</div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <h2 class="chart-h">Soft totals (you have an ace)</h2>
            <div class="chart-scroll" tabindex="0" role="region" aria-label="Soft totals strategy table">
                <table class="strat">
                    <caption class="sr-only">Best play for soft totals against each dealer up-card</caption>
                    <thead>
                        <tr><th scope="col">You have</th><th v-for="d in DEALERS" :key="'sh'+d" scope="col">{{ dLabel(d) }}</th></tr>
                    </thead>
                    <tbody>
                        <tr v-for="t in SOFT_ROWS" :key="'sr'+t">
                            <th scope="row">A + {{ t - 11 }} <span style="color:var(--faint);font-weight:600;">(soft {{ t }})</span></th>
                            <td v-for="d in DEALERS" :key="'sc'+t+'-'+d">
                                <div class="cellbox" :class="['c' + '-' + chartCode('soft', t, d), { hot: isHot('soft', t, d) }]" :id="cellId('soft', t, d)">{{ chartCode('soft', t, d) }}</div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <h2 class="chart-h">Pairs</h2>
            <div class="chart-scroll" tabindex="0" role="region" aria-label="Pairs strategy table">
                <table class="strat">
                    <caption class="sr-only">Best play for pairs against each dealer up-card</caption>
                    <thead>
                        <tr><th scope="col">You have</th><th v-for="d in DEALERS" :key="'ph'+d" scope="col">{{ dLabel(d) }}</th></tr>
                    </thead>
                    <tbody>
                        <tr v-for="v in PAIR_ROWS" :key="'pr'+v">
                            <th scope="row">{{ pairLabel(v) }}</th>
                            <td v-for="d in DEALERS" :key="'pc'+v+'-'+d">
                                <div class="cellbox" :class="['c' + '-' + chartCode('pair', v, d), { hot: isHot('pair', v, d) }]" :id="cellId('pair', v, d)">{{ chartCode('pair', v, d) }}</div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <p class="chart-foot">Su = surrender if the table allows it; otherwise hit. D = double if you&rsquo;re allowed; otherwise hit. Ds = double if allowed; otherwise stand. Fives are missing from the pairs table on purpose, a pair of fives is just a ten. Never split it, double it.</p>
        </section>

        <!-- ===================== STATS ===================== -->
        <section v-else aria-label="Your stats">
            <div class="stat-grid">
                <div class="stat-card">
                    <div class="num">{{ stats.t === 0 ? ', ' : accuracy + '%' }}</div>
                    <div class="lbl">Accuracy</div>
                </div>
                <div class="stat-card">
                    <div class="num">{{ stats.t }}</div>
                    <div class="lbl">Hands drilled</div>
                </div>
                <div class="stat-card">
                    <div class="num">{{ stats.best }}</div>
                    <div class="lbl">Best streak</div>
                </div>
            </div>

            <div class="kind-bars" v-if="stats.t > 0">
                <div v-for="k in KINDS" :key="k.key" class="kind-bar">
                    <div class="kb-label">
                        <span>{{ k.name }}</span>
                        <span>{{ stats.kinds[k.key].t === 0 ? 'not drilled yet' : kindPct(k.key) + '% of ' + stats.kinds[k.key].t }}</span>
                    </div>
                    <div class="kb-track" role="img" :aria-label="k.name + ' accuracy ' + (stats.kinds[k.key].t === 0 ? 'not drilled yet' : kindPct(k.key) + ' percent')">
                        <div class="kb-fill" :style="{ width: (stats.kinds[k.key].t === 0 ? 0 : kindPct(k.key)) + '%' }"></div>
                    </div>
                </div>
            </div>
            <p v-else class="empty-note">No hands yet, play a few rounds in Practice and your numbers will show up here. Everything stays on this device.</p>

            <template v-if="missList.length">
                <h2 class="stats-h">Hands that keep getting you</h2>
                <ul class="miss-list">
                    <li v-for="m in missList" :key="m.key">
                        <span><span class="mkey">{{ m.key }}</span> <span class="mbest">, the book says {{ m.best }}</span></span>
                        <span class="mcount">missed ×{{ m.count }}</span>
                    </li>
                </ul>
            </template>

            <h2 class="stats-h">Know your enemy</h2>
            <p class="chart-note">How often the dealer busts, by up-card. This is the whole secret of basic strategy: when the dealer is likely to break, don&rsquo;t risk breaking first.</p>
            <table class="bust">
                <caption class="sr-only">Dealer bust probability by up-card</caption>
                <thead>
                    <tr><th scope="col">Dealer shows</th><th v-for="d in DEALERS" :key="'bd'+d" scope="col">{{ dLabel(d) }}</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <th scope="row">Bust chance</th>
                        <td v-for="d in DEALERS" :key="'bc'+d" :class="{ hotrow: d >= 4 && d <= 6 }">{{ BUST[d] }}%</td>
                    </tr>
                </tbody>
            </table>

            <p style="margin-top:1.6rem;">
                <button v-if="!resetArmed" type="button" class="linkish" @click="armReset">Reset my stats</button>
                <button v-else type="button" class="btn btn-ghost" @click="doReset">Press again to wipe everything</button>
            </p>
        </section>

        <p class="foot">A learning table, not a casino, no bets, no chips, no accounts, and your stats never leave this device. If you play for real money, set a limit and keep it fun.<br>Dealt by <a href="https://www.coffeeandfun.com/">Coffee &amp; Fun</a>.</p>
    </main>
{% endraw %}

    {% pageJs "blackjack-trainer" %}
</body>
</html>
