<!doctype html>
<html class="brand-color-background scroll-smooth antialiased" lang="en" data-theme="light" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary Meta Tags -->
    <title>Open Source - Coffee &amp; Fun LLC</title>
    <meta name="title" content="Open Source - Coffee &amp; Fun LLC" />
    <meta name="description" content="Small open-source tools from Coffee &amp; Fun. Explore Google Profanity Words, Remove PII, and Maths Captcha, with code and examples for your next project." />
    <meta name="keywords" content="open source, free software, MIT license, npm packages, Coffee &amp; Fun LLC, google profanity words, remove pii, maths captcha" />
    <meta name="author" content="Coffee &amp; Fun LLC" />
    <meta name="robots" content="index, follow" />
    <meta name="rating" content="safe for kids" />

    <link rel="canonical" href="https://www.coffeeandfun.com/open-source/" />
    <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coffee &amp; Fun" />
    <meta property="og:title" content="Open Source - Coffee &amp; Fun LLC" />
    <meta property="og:description" content="Small open-source tools from Coffee &amp; Fun. Explore Google Profanity Words, Remove PII, and Maths Captcha, with code and examples for your next project." />
    <meta property="og:url" content="https://www.coffeeandfun.com/open-source/" />
    <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/open-source.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Coffee &amp; Fun cup logo above a red badge reading Open Source" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bycoffeeandfun" />
    <meta name="twitter:creator" content="@bycoffeeandfun" />
    <meta name="twitter:title" content="Open Source - Coffee &amp; Fun LLC" />
    <meta name="twitter:description" content="Small open-source tools from Coffee &amp; Fun. Explore Google Profanity Words, Remove PII, and Maths Captcha, with code and examples for your next project." />
    <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/open-source.png" />
    <meta name="twitter:image:alt" content="Coffee &amp; Fun cup logo above a red badge reading Open Source" />

    <link rel="manifest" href="/assets/images/social/site.webmanifest" />
    <meta name="theme-color" content="#fef5ec" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="apple-touch-icon" href="/assets/images/social/192.png" />
    <link rel="icon" href="/assets/images/social/192.png" sizes="192x192" type="image/png" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        "name": "Open Source",
        "description": "Open-source tools, libraries, and useful starting points from Coffee & Fun LLC.",
        "url": "https://www.coffeeandfun.com/open-source/",
        "mainEntity": {
          "@type": "ItemList",
          "numberOfItems": {{ apps.opensource.size }},
          "itemListElement": [{% for pkg in apps.opensource %}{"@type":"ListItem","position":{{ forloop.index }},"name":{{ pkg.name | json }},"url":{{ pkg.link | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
        },
        "publisher": {
          "@id": "https://www.coffeeandfun.com/#organization"
        },
        "breadcrumb": {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Home",
              "item": "https://www.coffeeandfun.com/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Open Source",
              "item": "https://www.coffeeandfun.com/open-source/"
            }
          ]
        },
        "isPartOf": {
          "@id": "https://www.coffeeandfun.com/#website"
        }
      }
    </script>

    {% include schema-org.liquid %}

    {% bundledCss %}


    {% include scripts.html %}
    {% pageCss "product" %}
    {% pageCss "open-source" %}
  </head>

  <body class="cf-source-page">
    {% include header.liquid %}
    <main tabindex="-1" id="main-content">
      <section class="os-hero" aria-labelledby="source-title">
        <div class="os-wrap os-intro">
          <div class="os-margin-doodles" aria-hidden="true">
            <span class="os-doodle-code">{% include journal-mark.liquid, drawing: 'code' %}</span>
            <span class="os-doodle-branch">{% include open-source-doodles.liquid, sketch: 'branch' %}</span>
            <span class="os-doodle-puzzle">{% include open-source-doodles.liquid, sketch: 'puzzle' %}</span>
            <span class="os-margin-note">good things, shared.</span>
          </div>
          <h1 id="source-title">Open Source</h1>
          <p>Small tools to build on.<br>Room for your own bright ideas.</p>
          <div class="os-hero-links">
            <a class="os-button" href="#projects">Explore the projects</a>
            <a class="os-text-link" href="https://github.com/coffee-and-fun">Find us on GitHub</a>
          </div>
        </div>
      </section>
      {% include section-wave.liquid, waveFrom: '#fef5ec', waveTo: '#fffaf5' %}
      <section class="os-wrap os-projects" id="projects" aria-labelledby="projects-title" tabindex="-1">
        <div class="os-section-heading">
          <div><h2 id="projects-title">From our desk to yours.</h2><p>A few useful pieces for whatever you’re making.</p></div>
          <span aria-hidden="true">a little head start<svg viewBox="0 0 82 43" fill="none"><path d="M6 10C36 0 69 7 66 32M55 25L66 35L76 24"/></svg></span>
        </div>
        <div class="os-bento">
          {% for pkg in apps.opensource %}
          <a class="os-project os-project-{{ forloop.index }}" href="{{ pkg.link }}">
            <div class="os-project-art" aria-hidden="true"><img src="{{ pkg.image }}" alt="" width="800" height="420" {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">{% include catalog-source-doodles.liquid %}</div>
            <div class="os-project-copy">
              <span class="os-category">{% case forloop.index %}{% when 1 %}Text tools{% when 2 %}Privacy{% when 3 %}Form helpers{% endcase %}</span>
              <h3>{{ pkg.name }}</h3>
              <p>{% case forloop.index %}{% when 1 %}A word list and library for finding profanity in your app’s text.{% when 2 %}Find and remove personal information from text.{% when 3 %}Generate simple maths questions and check the answers.{% endcase %}</p>
              <span class="os-project-link">{% if pkg.link contains 'npmjs.com' %}View on npm{% else %}View on GitHub{% endif %}</span>
            </div>
          </a>
          {% endfor %}
          <aside class="os-note-card" aria-labelledby="sharing-title">
            <span class="os-note-label" aria-hidden="true">a note from us</span>
            <div class="os-note-art" aria-hidden="true">{% include open-source-doodles.liquid, sketch: 'notebook' %}</div>
            <h3 id="sharing-title">Good code gets<br>passed around.</h3>
            <p>We build on work people share. These are a few useful pieces we’re passing on, with more to come.</p>
            <a class="os-text-link" href="/blog/">Read our build notes</a>
          </aside>
        </div>
      </section>
      {% include section-wave.liquid, waveFrom: '#fffaf5', waveTo: '#eef0df' %}
      <section class="os-sharing" aria-labelledby="sharing-heading">
        <div class="os-wrap">
          <div class="os-sharing-intro"><span aria-hidden="true">{% include journal-mark.liquid, drawing: 'sprout' %}</span><div><h2 id="sharing-heading">Make it your own.</h2><p>Start small. Try something. Share what you learn.</p></div></div>
          <div class="os-help-grid">
            <article class="os-help-card"><span class="os-help-drawing" aria-hidden="true">{% include journal-mark.liquid, drawing: 'book' %}</span><h3>A good place to start.</h3><p>Each project’s README has setup steps and examples. Check its licence before you build on it.</p></article>
            <article class="os-help-card"><span class="os-help-drawing" aria-hidden="true">{% include journal-mark.liquid, drawing: 'pencil' %}</span><h3>Leave it a little better.</h3><p>Spotted a bug or have an idea? Open an issue or send a pull request on the project’s repository.</p></article>
            <article class="os-help-card os-help-community"><span class="os-help-drawing" aria-hidden="true">{% include open-source-doodles.liquid, sketch: 'chat' %}</span><h3>Show us what you made.</h3><p>We’d love to see where you take it.</p><a class="os-text-link" href="https://discord.com/invite/J6EeMvSBYg">Say hello on Discord</a></article>
          </div>
        </div>
      </section>
      {% include section-wave.liquid, waveFrom: '#eef0df', waveTo: '#fffaf5' %}
    </main>
    {% include footer.liquid %}
  </body>
</html>
