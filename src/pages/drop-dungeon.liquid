<!DOCTYPE html>
<html class="antialiased" lang="en" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary Meta Tags -->
    <title>Drop Dungeon: Roguelike Connect Four - Coffee & Fun LLC</title>
    <meta name="title" content="Drop Dungeon: Roguelike Connect Four - Coffee & Fun LLC" />
    <meta name="description" content="Connect four to clear the floor, grab a relic, and descend. A free roguelike twist on Connect 4 you can play solo or against a friend online, no signup." />
    <meta name="author" content="Coffee & Fun LLC" />
    <meta name="robots" content="index, follow" />

    <!-- Canonical URL -->
    <link rel="canonical" href="https://www.coffeeandfun.com/drop-dungeon/" />

    <!-- Favicon -->
    <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coffee & Fun" />
    <meta property="og:title" content="Drop Dungeon: Roguelike Connect Four - Coffee & Fun LLC" />
    <meta property="og:description" content="Connect four to clear the floor, grab a relic, and descend. A free roguelike twist on Connect 4 you can play solo or against a friend online, no signup." />
    <meta property="og:url" content="https://www.coffeeandfun.com/drop-dungeon/" />
    <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/drop-dungeon.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Gold Drop Dungeon lettering above a row of red and gold game discs" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bycoffeeandfun" />
    <meta name="twitter:title" content="Drop Dungeon: Roguelike Connect Four - Coffee & Fun LLC" />
    <meta name="twitter:description" content="Connect four to clear the floor, grab a relic, and descend. A free roguelike twist on Connect 4 you can play solo or against a friend online, no signup." />
    <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/drop-dungeon.png" />
    <meta name="twitter:image:alt" content="Gold Drop Dungeon lettering above a row of red and gold game discs" />

    <meta name="theme-color" content="#141009" />

    <!-- Structured Data -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "VideoGame",
        "name": "Drop Dungeon",
        "description": "A roguelike twist on Connect Four: clear seven mutating floors, collect relics, and outdrop the dungeon, solo against an escalating AI or head-to-head with a friend online.",
        "url": "https://www.coffeeandfun.com/drop-dungeon/",
        "genre": ["Strategy", "Roguelike"],
        "gamePlatform": "Web Browser",
        "playMode": ["SinglePlayer", "MultiPlayer"],
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
        "author": { "@type": "Organization", "name": "Coffee & Fun LLC" }
    }
    </script>

    <!-- Dungeon display font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Pirata+One&display=swap" rel="stylesheet" />

    <script src="https://unpkg.com/vue@3"></script>
    <script src="https://unpkg.com/peerjs@1.5.5/dist/peerjs.min.js"></script>

    {% pageCss "drop-dungeon" %}
</head>

<body>
    <div class="torch l" aria-hidden="true"></div>
    <div class="torch r" aria-hidden="true"></div>
{% raw %}
    <a href="#tool" class="skip">Skip to the game</a>

    <!-- Shown only if the CDN scripts fail, the app stays v-cloak-hidden. -->
    <div id="load-fallback" class="wrap" hidden>
        <p class="lede">The game couldn&rsquo;t load a couple of files it needs. Check your connection and refresh the page.</p>
    </div>
    <noscript>
        <div class="wrap"><p class="lede">Drop Dungeon needs JavaScript turned on to play.</p></div>
    </noscript>

    <main v-cloak id="app" class="wrap">

        <div class="topbar">
            <a href="/" class="home-link" aria-label="Back to coffeeandfun.com">
                <img src="/assets/images/brand/coffee-and-fun-logo-dark.png" alt="" width="40" height="40" decoding="async" />
                <span class="tip" aria-hidden="true">Back to coffeeandfun.com</span>
            </a>
            <button type="button" class="mute-btn" @click="toggleMute" :aria-pressed="muted ? 'true' : 'false'"
                    :aria-label="muted ? 'Sound is off, turn it on' : 'Sound is on, turn it off'">
                <span aria-hidden="true">{{ muted ? '🔇' : '🔊' }}</span>
            </button>
        </div>

        <!-- Live status for screen readers -->
        <div class="sr-only" role="status" aria-live="polite">{{ announcement }}</div>

        <!-- ===================== MENU ===================== -->
        <section v-if="screen === 'menu'" id="tool">
            <h1>Drop Dungeon</h1>
            <p class="lede">Connect four to clear the floor. Win, grab a relic, and descend, the dungeon fights dirtier the deeper you go. Seven floors stand between you and the bottom.</p>

            <div class="menu-choices">
                <button type="button" class="menu-card" @click="startSolo">
                    <span class="mc-ico" aria-hidden="true">🕯️</span>
                    <span>
                        <span class="mc-title">Descend alone</span>
                        <span class="mc-sub">You against the dungeon. It gets smarter every floor.</span>
                    </span>
                </button>
                <button type="button" class="menu-card" @click="startHost" :disabled="!peerOk">
                    <span class="mc-ico" aria-hidden="true">⚔️</span>
                    <span>
                        <span class="mc-title">Duel a friend, host</span>
                        <span class="mc-sub">Get an invite link. First to win 4 floors takes the run.</span>
                    </span>
                </button>
                <button type="button" class="menu-card" @click="screen = 'join'" :disabled="!peerOk">
                    <span class="mc-ico" aria-hidden="true">🔗</span>
                    <span>
                        <span class="mc-title">Duel a friend, join</span>
                        <span class="mc-sub">Got a link or a game code? Jump into their dungeon.</span>
                    </span>
                </button>
            </div>
            <p v-if="!peerOk" class="lede" style="margin-top:1rem; font-size:0.85rem;">Duels are unavailable right now, the connection library didn&rsquo;t load. Solo still works.</p>

            <details class="rules">
                <summary>How it works</summary>
                <p><strong>Each floor is a game of Connect&nbsp;Four</strong>, but the dungeon keeps changing the rules. Wider caverns, stones that belong to no one, wild gems that count for everyone, floors that crumble beneath you, and at the bottom&hellip; four isn&rsquo;t enough.</p>
                <ul>
                    <li><strong>Win a floor</strong> and you draft a relic, a one-use dirty trick.</li>
                    <li><strong>💣 Boulder</strong>, drop a stone that blocks a column&rsquo;s path.</li>
                    <li><strong>🔨 Smash</strong>, shatter the top disc of any column.</li>
                    <li><strong>🕳️ Undermine</strong>, pull the bottom disc out; everything above falls.</li>
                    <li><strong>⏳ Time warp</strong>, your opponent loses their next turn.</li>
                </ul>
                <p>Solo, one loss ends the run, that&rsquo;s dungeon law. In a duel it&rsquo;s first to four floors, and the <strong>loser</strong> of each floor drafts the relic. Stay gracious.</p>
            </details>
        </section>

        <!-- ===================== JOIN ===================== -->
        <section v-else-if="screen === 'join'" id="tool">
            <h1>Join a duel</h1>
            <p class="lede">Paste the game code from your friend&rsquo;s invite link, or if you opened their link, it&rsquo;s already filled in.</p>
            <div class="name-row">
                <div>
                    <label class="f-label" for="dd-name">Your name</label>
                    <input id="dd-name" class="field" type="text" v-model="myName" maxlength="20" placeholder="Sir Dropsalot" />
                </div>
            </div>
            <div class="name-row">
                <div>
                    <label class="f-label" for="dd-code">Game code</label>
                    <input id="dd-code" class="field" type="text" v-model="joinId" spellcheck="false" autocapitalize="off" placeholder="e.g. 3f2a1b…" />
                </div>
                <button type="button" class="btn btn-primary" @click="connectToHost" :disabled="!joinId.trim() || connecting">
                    {{ connecting ? 'Connecting…' : 'Join' }}
                </button>
            </div>
            <div v-if="netError" class="banner warn" role="alert">
                <span>{{ netError }}</span>
            </div>
            <p style="margin-top:1.2rem;"><button type="button" class="linkish" @click="backToMenu">&larr; Back</button></p>
        </section>

        <!-- ===================== LOBBY (host waiting) ===================== -->
        <section v-else-if="screen === 'lobby'" id="tool">
            <h1>Your dungeon awaits</h1>
            <div class="lobby-card">
                <h2 v-if="!peerId" class="pulse-dots">Digging the arena</h2>
                <template v-else>
                    <h2 class="pulse-dots">Waiting for your rival</h2>
                    <p>Send them this invite link, the duel starts the moment they arrive.</p>
                    <div class="invite-row">
                        <input class="field" type="text" readonly :value="inviteLink" aria-label="Invite link" @focus="$event.target.select()" />
                        <button type="button" class="btn btn-secondary" @click="copyInvite">{{ copied ? 'Copied ✓' : 'Copy link' }}</button>
                    </div>
                </template>
                <div class="name-row" style="margin-top:0.4rem;">
                    <div>
                        <label class="f-label" for="dd-hostname">Your name</label>
                        <input id="dd-hostname" class="field" type="text" v-model="myName" maxlength="20" placeholder="Dungeon Keeper" />
                    </div>
                </div>
            </div>
            <div v-if="netError" class="banner warn" role="alert"><span>{{ netError }}</span></div>
            <p style="margin-top:1.2rem;"><button type="button" class="linkish" @click="backToMenu">&larr; Cancel and go back</button></p>
        </section>

        <!-- ===================== GAME ===================== -->
        <section v-else-if="screen === 'game'" id="tool">
            <div class="game-head">
                <div>
                    <p class="floor-tag">Floor {{ floor + 1 }} of {{ FLOORS.length }}</p>
                    <h1 class="floor-name">{{ floorDef.name }}</h1>
                    <p class="floor-flavor">{{ floorDef.flavor }}</p>
                    <div class="floor-pips" aria-hidden="true">
                        <span v-for="(f, i) in FLOORS" :key="i" :class="{ done: i < floor, now: i === floor }"></span>
                    </div>
                </div>
                <div style="position: relative;">
                    <div class="scoreline">
                        <div class="player-chip" :class="{ turn: turn === 1 && !over }">
                            <span class="dot" :style="{ background: 'var(--p1)' }"></span>
                            <span class="pname">{{ nameOf(1) }}</span>
                            <span class="crowns">{{ crownStr(1) }}</span>
                        </div>
                        <span class="vs" aria-hidden="true">VS</span>
                        <div class="player-chip" :class="{ turn: turn === 2 && !over }">
                            <span class="dot" :style="{ background: 'var(--p2)' }"></span>
                            <span class="pname">{{ nameOf(2) }}</span>
                            <span class="crowns">{{ crownStr(2) }}</span>
                        </div>
                        <span v-if="emoteShown" class="emote-bubble" aria-hidden="true">{{ emoteShown }}</span>
                    </div>
                    <div v-if="isDuel" class="emote-row">
                        <button v-for="e in EMOTES" :key="e" type="button" class="emote-btn"
                                :aria-label="'Send ' + e + ' to your rival'" @click="sendEmote(e)">{{ e }}</button>
                    </div>
                </div>
            </div>

            <div class="board-zone" :style="{ maxWidth: boardMaxW }">
                <div class="board" :class="{ shake: shaking }" :style="{ gridTemplateColumns: 'repeat(' + bw + ', 1fr)' }">
                    <button v-for="c in bw" :key="'c' + (c-1) + '-' + boardEpoch" type="button" class="bcol"
                            :style="{ gridTemplateRows: 'repeat(' + bh + ', 1fr)' }"
                            :disabled="columnDisabled(c-1)"
                            :aria-label="colLabel(c-1)"
                            @click="clickColumn(c-1)"
                            @mouseenter="hoverCol = c-1" @mouseleave="hoverCol = -1"
                            @focus="hoverCol = c-1" @blur="hoverCol = -1">
                        <div v-for="r in bh" :key="'r' + (r-1)" class="cell"
                             :style="{ gridRow: bh - (r-1) }">
                            <div v-if="cellAt(c-1, r-1)" class="disc"
                                 :class="[discClass(cellAt(c-1, r-1)), { drop: cellAt(c-1, r-1).fresh, winner: isWinCell(c-1, r-1) }]"
                                 :style="cellAt(c-1, r-1).fresh ? { '--fd': (-(bh - (r-1)) * 108) + '%' } : null"></div>
                            <div v-else-if="showGhostAt(c-1, r-1)" class="ghost" :class="ghostClass"></div>
                            <div v-if="showSmashMarkAt(c-1, r-1)" class="ghost smash-mark" aria-hidden="true">🔨</div>
                            <div v-if="showMineMarkAt(c-1, r-1)" class="ghost mine-mark" aria-hidden="true">🕳️</div>
                        </div>
                    </button>
                </div>
            </div>

            <p class="status-line">
                {{ statusText }}
                <span v-if="statusSub" class="sub">{{ statusSub }}</span>
            </p>

            <div class="relic-tray" v-if="myRelicList.length">
                <button v-for="rk in myRelicList" :key="rk.kind" type="button" class="relic-btn"
                        :class="{ arming: targeting === rk.kind }"
                        :disabled="!canUseRelic(rk.kind)"
                        @click="armRelic(rk.kind)">
                    <span aria-hidden="true">{{ RELICS[rk.kind].icon }}</span>
                    {{ targeting === rk.kind ? 'Pick a column…' : RELICS[rk.kind].name }}
                    <span class="cnt">×{{ rk.count }}</span>
                </button>
                <button v-if="targeting" type="button" class="relic-btn" @click="targeting = null">Cancel</button>
            </div>

            <div class="game-foot-row">
                <button type="button" class="linkish" @click="abandonRun">Abandon run</button>
                <span style="font-size:0.78rem; color:var(--muted);">{{ isDuel ? 'First to 4 floors wins the run' : 'One loss ends the run, dungeon law' }}</span>
            </div>
        </section>

        <!-- ===================== DRAFT OVERLAY ===================== -->
        <div v-if="draftOpen" class="overlay" role="dialog" aria-modal="true" aria-label="Choose a relic">
            <div class="overlay-card">
                <template v-if="iAmDrafting">
                    <h2>{{ isDuel ? 'Spoils for the fallen' : 'The floor is yours' }}</h2>
                    <p class="oc-sub">{{ isDuel ? 'You lost the floor, so you loot the room. Pick one relic.' : 'Take a relic for the road down. Pick one.' }}</p>
                    <div class="draft-grid">
                        <button v-for="(kind, i) in draftOffer" :key="i" type="button" class="draft-card" @click="pickDraft(i)">
                            <span class="dc-ico" aria-hidden="true">{{ RELICS[kind].icon }}</span>
                            <span class="dc-name">{{ RELICS[kind].name }}</span>
                            <span class="dc-desc">{{ RELICS[kind].desc }}</span>
                        </button>
                    </div>
                </template>
                <template v-else>
                    <h2 class="pulse-dots">{{ oppName }} is looting the room</h2>
                    <p class="oc-sub">They lost the floor, so they draft a relic. The next floor starts when they&rsquo;ve chosen.</p>
                </template>
            </div>
        </div>

        <!-- ===================== FLOOR RESULT OVERLAY ===================== -->
        <div v-if="floorResult" class="overlay" role="dialog" aria-modal="true" aria-label="Floor result">
            <div class="overlay-card" style="text-align:center;">
                <span class="big-emoji" aria-hidden="true">{{ floorResult.emoji }}</span>
                <h2 class="big-title">{{ floorResult.title }}</h2>
                <p class="oc-sub">{{ floorResult.sub }}</p>
                <div class="overlay-actions">
                    <button type="button" class="btn btn-primary" @click="floorResultContinue">{{ floorResult.cta }}</button>
                </div>
            </div>
        </div>

        <!-- ===================== RUN END OVERLAY ===================== -->
        <div v-if="runEnd" class="overlay" role="dialog" aria-modal="true" aria-label="Run over">
            <div class="overlay-card">
                <span class="big-emoji" aria-hidden="true">{{ runEnd.won ? '🏆' : '💀' }}</span>
                <h2 class="big-title" style="text-align:center;">{{ runEnd.title }}</h2>
                <p class="oc-sub" style="text-align:center;">{{ runEnd.sub }}</p>
                <ul class="recap-list">
                    <li><span>Floors cleared</span><span>{{ runEnd.floors }}</span></li>
                    <li v-if="isDuel"><span>Floors won by {{ oppName }}</span><span>{{ crowns[oppPlayer] }}</span></li>
                    <li><span>Relics collected</span><span>{{ runEnd.relics }}</span></li>
                    <li><span>Discs dropped</span><span>{{ runEnd.moves }}</span></li>
                </ul>
                <div class="overlay-actions">
                    <button v-if="!isDuel" type="button" class="btn btn-primary" @click="startSolo">Run it again</button>
                    <template v-else-if="isHost">
                        <button v-if="!rematchOffered" type="button" class="btn btn-primary" @click="hostRematch">Offer a rematch</button>
                        <button v-else type="button" class="btn btn-primary" disabled>Waiting for {{ oppName }}…</button>
                    </template>
                    <template v-else>
                        <button v-if="rematchOffered" type="button" class="btn btn-primary" @click="joinerAcceptRematch">Accept rematch</button>
                        <button v-else type="button" class="btn btn-primary" disabled>Waiting for a rematch offer…</button>
                    </template>
                    <button type="button" class="btn btn-secondary" @click="backToMenu">Back to the door</button>
                </div>
            </div>
        </div>

        <p class="foot">Runs entirely in your browser. Duels connect you and your friend directly, no accounts, no servers keeping score. Forged by <a href="https://www.coffeeandfun.com/">Coffee &amp; Fun</a>.</p>
    </main>
{% endraw %}


    {% pageJs "drop-dungeon" %}
</body>
</html>
