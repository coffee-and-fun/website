<!DOCTYPE html>
<html class="antialiased" lang="en" data-theme="light" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary Meta Tags -->
    <title>Free Meta Tags Generator with Live Previews - Coffee & Fun LLC</title>
    <meta name="description" content="Fill in four fields and see exactly how your page will look on Google, Facebook, and X. Then copy one block of ready-made meta tags into your site." />
    <meta name="author" content="Coffee & Fun LLC" />
    <meta name="robots" content="index, follow" />

    <!-- Canonical URL -->
    <link rel="canonical" href="https://www.coffeeandfun.com/meta-tags/" />

    <!-- Favicon -->
    <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coffee & Fun" />
    <meta property="og:title" content="Free Meta Tags Generator with Live Previews - Coffee & Fun LLC" />
    <meta property="og:description" content="Fill in four fields and see exactly how your page will look on Google, Facebook, and X. Then copy one block of ready-made meta tags into your site." />
    <meta property="og:url" content="https://www.coffeeandfun.com/meta-tags/" />
    <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/meta-tags.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Meta Tags Generator card with a social media like counter and the words Preview, Edit and Create" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bycoffeeandfun" />
    <meta name="twitter:title" content="Free Meta Tags Generator with Live Previews - Coffee & Fun LLC" />
    <meta name="twitter:description" content="Fill in four fields and see exactly how your page will look on Google, Facebook, and X. Then copy one block of ready-made meta tags into your site." />
    <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/meta-tags.png" />
    <meta name="twitter:image:alt" content="Meta Tags Generator card with a social media like counter and the words Preview, Edit and Create" />

    <meta name="theme-color" content="#fef5ec" />

    <!-- Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "Free Meta Tags Generator",
        "description": "Preview how your page looks on Google, Facebook, and X, then copy ready-made meta tags into your site.",
        "url": "https://www.coffeeandfun.com/meta-tags/",
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "Web Browser",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "publisher": {
          "@id": "https://www.coffeeandfun.com/#organization"
        },
        "creator": {
          "@id": "https://www.coffeeandfun.com/#founder"
        },
        "isAccessibleForFree": true,
        "inLanguage": "en"
      }
    </script>

    <script src="https://unpkg.com/vue@3"></script>

    {% bundledCss %}
    {% pageCss "meta-tags" %}
    {% include sketch-styles.liquid %}
{% include schema-org.liquid %}

    </head>

<body>
    {% include header.liquid %}
{% raw %}
    <a href="#tool" class="skip">Skip to the tool</a>

    <main v-cloak id="main-content" class="wrap">

        <header id="tool">
            <h1 class="brand-heading text-3xl sm:text-4xl">Make your link look good everywhere</h1>
            <p class="lede">Fill in four things, watch exactly how your page will appear on Google, Facebook, and X, then copy one block of code into your site.</p>

            <!-- Sketch: sparkle top-right -->
            <div class="sketch-note sketch-float" style="top: -16px; right: 2%; --sketch-rotate: 8deg;">
                <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24">
                    <path d="M12 2 L13.5 10.5 L22 12 L13.5 13.5 L12 22 L10.5 13.5 L2 12 L10.5 10.5 Z" class="sketch-sparkle"/>
                </svg>
            </div>

            <!-- Sketch: squiggle under the heading, left edge -->
            <div class="sketch-note" style="top: 44%; left: -3%;">
                <svg aria-hidden="true" width="30" height="10" viewBox="0 0 34 12">
                    <path d="M2 6 C6 1, 10 11, 14 6 C18 1, 22 11, 26 6 C28 3, 30 5, 32 6" class="sketch-squiggle"/>
                </svg>
            </div>

            <!-- Sketch: "watch it change" pointing down at the previews.
                 aria-hidden in markup, not left to the partial's script, because
                 this one carries readable text and script runs late. -->
            <div class="sketch-note text-base" aria-hidden="true" style="bottom: -18px; right: 6%; transform: rotate(-4deg);">
                watch it change
                <svg aria-hidden="true" width="26" height="22" viewBox="0 0 28 24" style="position: relative; display: inline-block; margin-left: 2px; vertical-align: middle;">
                    <path d="M2 4 C10 4, 20 8, 24 20 M24 20 L17 17 M24 20 L25 12" class="sketch-arrow"/>
                </svg>
            </div>

            <!-- Sketch: dashed circle, right of the lede -->
            <div class="sketch-note sketch-float-slow" style="top: 58%; right: -2%; --sketch-rotate: -6deg;">
                <svg aria-hidden="true" width="26" height="26" viewBox="0 0 36 36">
                    <circle cx="18" cy="18" r="12" class="sketch-circle" transform="rotate(20 18 18)"/>
                </svg>
            </div>

            <!-- Sketch: small cross, far left -->
            <div class="sketch-note sketch-wiggle" style="top: 6px; left: -4%; --sketch-rotate: -12deg;">
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16">
                    <path d="M3 3 L13 13 M13 3 L3 13" class="sketch-cross"/>
                </svg>
            </div>
        </header>

        <!-- Live status for screen readers -->
        <div class="sr-only" role="status" aria-live="polite">{{ announcement }}</div>

        <div class="cols">

            <!-- ===== Step 1: the form ===== -->
            <section aria-labelledby="h-form">
                <h2 class="step-label" id="h-form">1, Tell people about your page</h2>

                <div class="field-group">
                    <label class="f-label" for="mt-title">Page title</label>
                    <input id="mt-title" class="field" type="text" v-model="meta.title"
                           placeholder="How to brew better coffee at home"
                           aria-describedby="mt-title-count" spellcheck="true" />
                    <div class="counter" id="mt-title-count">
                        <span>{{ meta.title.length }} characters</span>
                        <span v-if="meta.title.length > 60" class="over">{{ meta.title.length - 60 }} over Google&rsquo;s ~60, it may get cut off</span>
                        <span v-else>Google shows about 60</span>
                    </div>
                </div>

                <div class="field-group">
                    <label class="f-label" for="mt-desc">Short description</label>
                    <textarea id="mt-desc" class="field" v-model="meta.description"
                              placeholder="One or two sentences about the page."
                              aria-describedby="mt-desc-count" spellcheck="true"></textarea>
                    <div class="counter" id="mt-desc-count">
                        <span>{{ meta.description.length }} characters</span>
                        <span v-if="meta.description.length > 160" class="over">{{ meta.description.length - 160 }} over Google&rsquo;s ~160, it may get cut off</span>
                        <span v-else>Google shows about 160</span>
                    </div>
                </div>

                <div class="field-group">
                    <label class="f-label" for="mt-url">Page address</label>
                    <input id="mt-url" class="field" type="url" v-model="meta.url"
                           placeholder="https://yoursite.com/your-page"
                           aria-describedby="mt-url-hint" spellcheck="false" autocapitalize="off" autocomplete="url" inputmode="url" />
                    <p class="hint" :class="{ bad: urlWarning }" id="mt-url-hint">
                        {{ urlWarning || 'The full link to this exact page, starting with https://' }}
                    </p>
                </div>

                <div class="field-group">
                    <label class="f-label" for="mt-image">Preview image</label>
                    <input id="mt-image" class="field" type="url" v-model="meta.image"
                           placeholder="https://yoursite.com/photo.jpg"
                           aria-describedby="mt-image-hint" spellcheck="false" autocapitalize="off" inputmode="url" />
                    <p class="hint" :class="{ bad: imageWarning || imgFailed }" id="mt-image-hint">
                        <template v-if="imageWarning">{{ imageWarning }}</template>
                        <template v-else-if="imgFailed">We couldn&rsquo;t load that picture, double-check the link.</template>
                        <template v-else-if="imgDims && imgDims.w < 600">That picture is only {{ imgDims.w }} pixels wide, it may look blurry. 1200 &times; 630 works best.</template>
                        <template v-else-if="imgDims">Picture loaded, {{ imgDims.w }} &times; {{ imgDims.h }} pixels.</template>
                        <template v-else>A link to a picture that&rsquo;s already on your site, 1200 &times; 630 pixels works best. Social sites fetch it from your address, so it can&rsquo;t be a file on your computer.</template>
                    </p>
                </div>

                <details class="more">
                    <summary>More options</summary>

                    <div class="field-group">
                        <label class="f-label" for="mt-sitename">Website name <span class="opt">, optional</span></label>
                        <input id="mt-sitename" class="field" type="text" v-model="meta.siteName" placeholder="Your Site" />
                    </div>

                    <div class="field-group">
                        <label class="f-label" for="mt-handle">Your X (Twitter) handle <span class="opt">, optional</span></label>
                        <div class="prefix-input">
                            <span class="pfx" aria-hidden="true">@</span>
                            <input id="mt-handle" class="field" type="text" v-model="meta.handle"
                                   placeholder="yourname" aria-describedby="mt-handle-hint"
                                   spellcheck="false" autocapitalize="off" />
                        </div>
                        <p class="hint" :class="{ bad: handleWarning }" id="mt-handle-hint">
                            {{ handleWarning || 'Letters, numbers, and underscores, the @ is added for you.' }}
                        </p>
                    </div>

                    <div class="field-group">
                        <label class="f-label" for="mt-alt">Describe the picture <span class="opt">, optional</span></label>
                        <input id="mt-alt" class="field" type="text" v-model="meta.imageAlt"
                               placeholder="A pour-over coffee mid-brew"
                               aria-describedby="mt-alt-hint" />
                        <p class="hint" id="mt-alt-hint">Read aloud to people who can&rsquo;t see the picture.</p>
                    </div>

                    <div class="field-group">
                        <fieldset class="kind">
                            <legend>What kind of page is it?</legend>
                            <label><input type="radio" value="website" v-model="meta.pageType" name="pagetype" /> A regular page</label>
                            <label><input type="radio" value="article" v-model="meta.pageType" name="pagetype" /> An article or blog post</label>
                        </fieldset>
                    </div>
                </details>
            </section>

            <!-- ===== Step 2: previews ===== -->
            <section aria-labelledby="h-preview" class="sticky-col">
                <h2 class="step-label" id="h-preview">2, See how your link will look</h2>

                <div class="tabs tabs-box cf-preview-tabs" role="tablist" aria-label="Choose a preview" @keydown="onTabKey">
                    <button class="tab" role="tab" id="tab-google" aria-controls="panel-google" :aria-selected="previewTab === 'google' ? 'true' : 'false'"
                            :tabindex="previewTab === 'google' ? 0 : -1" @click="previewTab = 'google'">Google</button>
                    <button class="tab" role="tab" id="tab-facebook" aria-controls="panel-facebook" :aria-selected="previewTab === 'facebook' ? 'true' : 'false'"
                            :tabindex="previewTab === 'facebook' ? 0 : -1" @click="previewTab = 'facebook'">Facebook</button>
                    <button class="tab" role="tab" id="tab-x" aria-controls="panel-x" :aria-selected="previewTab === 'x' ? 'true' : 'false'"
                            :tabindex="previewTab === 'x' ? 0 : -1" @click="previewTab = 'x'">X</button>
                </div>

                <div class="sample-row">
                    <template v-if="usingSample">
                        <span class="sample-chip">{{ sampleNote }}</span>
                        <button v-if="formEmpty" type="button" class="btn btn-link btn-sm" style="--btn-color: var(--color-espresso)" @click="fillExample">Fill it in for me</button>
                    </template>
                </div>

                <div v-if="previewTab === 'google'" class="panel" role="tabpanel" id="panel-google" tabindex="0"
                     aria-label="Preview of your page as a Google search result">
                    <div class="g-card">
                        <div class="g-top">
                            <span class="g-fav" aria-hidden="true">{{ pMonogram }}</span>
                            <span class="g-id">
                                <span class="g-site">{{ pSite }}</span>
                                <span class="g-crumb">{{ pCrumb }}</span>
                            </span>
                        </div>
                        <p class="g-title">{{ pTitle }}</p>
                        <p class="g-desc">{{ pDesc }}</p>
                    </div>
                </div>

                <div v-if="previewTab === 'facebook'" class="panel" role="tabpanel" id="panel-facebook" tabindex="0"
                     aria-label="Preview of your link shared on Facebook">
                    <div class="fb-card">
                        <img :src="pImage" alt="" @error="onImgError" />
                        <div class="fb-bar">
                            <div class="fb-domain">{{ pDomain }}</div>
                            <p class="fb-title">{{ pTitle }}</p>
                            <p class="fb-desc">{{ pDesc }}</p>
                        </div>
                    </div>
                </div>

                <div v-if="previewTab === 'x'" class="panel" role="tabpanel" id="panel-x" tabindex="0"
                     aria-label="Preview of your link shared on X, formerly Twitter">
                    <div class="x-wrap">
                        <div class="x-card">
                            <img :src="pImage" alt="" @error="onImgError" />
                            <span class="x-pill">{{ pTitle }}</span>
                        </div>
                        <div class="x-from">From {{ pDomain }}</div>
                    </div>
                </div>
            </section>
        </div>

        <!-- ===== Step 3: the code ===== -->
        <section class="code-section" aria-labelledby="h-code">
            <h2 class="step-label" id="h-code">3, Copy the code into your page</h2>

            <p class="paste-hint">Paste it near the top of your page&rsquo;s <code>&lt;head&gt;</code>, the invisible section before your content. That&rsquo;s everything Google, Facebook, and X need.</p>

            <div v-if="hasCode" class="code-scroll" tabindex="0" role="region" aria-label="Your generated code">
                <pre ref="codePre">{{ generatedCode }}</pre>
            </div>
            <div v-else class="code-empty">
                Your code will appear here as you fill in step 1.
            </div>

            <div class="code-actions">
                <button type="button" class="btn btn-lg" style="--btn-color: var(--color-cocoa); --btn-fg: #fff" @click="copyCode" :disabled="!hasCode">
                    {{ copied ? 'Copied ✓' : 'Copy the code' }}
                </button>
            </div>
            <p v-if="!hasCode" class="copy-note">Add a title, description, address, or picture link above to build your code.</p>
            <p v-if="copyFailed" class="copy-note bad">Copy didn&rsquo;t work, the code above is selected, press Ctrl+C or Cmd+C.</p>
        </section>

        <p class="foot">Everything happens in your browser, nothing you type leaves this page.
            Want the theory behind these tags? Read <a href="/blog/what-every-meta-tag-does-in-2026/">what every meta tag actually does in 2026</a>.</p>
    </main>
{% endraw %}

    {% include modals.liquid %}
    {% include footer.liquid %}

    {% pageJs "meta-tags" %}
</body>
</html>
