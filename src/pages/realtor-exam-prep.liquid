<!DOCTYPE html>
<html class="antialiased" lang="en" data-theme="light" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Real Estate Exam Practice Questions, 15 at a Time - Coffee &amp; Fun LLC</title>
    <meta name="title" content="Real Estate Exam Practice Questions, 15 at a Time - Coffee & Fun LLC" />
    <meta name="description" content="Free practice questions for the real estate salesperson licensing exam. Short sets, an explanation for every answer, and stats showing which topics to revise next." />
    <meta name="author" content="Coffee & Fun LLC" />
    <meta name="robots" content="index, follow" />

    <link rel="canonical" href="https://www.coffeeandfun.com/realtor-exam-prep/" />
    <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coffee & Fun" />
    <meta property="og:title" content="Real Estate Exam Practice Questions, 15 at a Time" />
    <meta property="og:description" content="Short practice sets for the real estate licensing exam, with an explanation for every answer and stats on what to revise next. Free, no signup, saved on your device." />
    <meta property="og:url" content="https://www.coffeeandfun.com/realtor-exam-prep/" />
    <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/realtor-exam-prep.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Real estate exam practice questions, fifteen at a time" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bycoffeeandfun" />
    <meta name="twitter:title" content="Real Estate Exam Practice Questions, 15 at a Time" />
    <meta name="twitter:description" content="Short practice sets for the real estate licensing exam, with an explanation for every answer." />
    <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/realtor-exam-prep.png" />
    <meta name="twitter:image:alt" content="Real estate exam practice questions, fifteen at a time" />

    <meta name="theme-color" content="#3d2b1f" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebApplication",
            "@id": "https://www.coffeeandfun.com/realtor-exam-prep/#app",
            "name": "Real Estate Exam Practice",
            "description": "Practice questions for the national portion of the US real estate salesperson licensing exam, in short sets, with an explanation for every answer and progress tracking stored on the device.",
            "url": "https://www.coffeeandfun.com/realtor-exam-prep/",
            "applicationCategory": "EducationalApplication",
            "operatingSystem": "Web Browser",
            "browserRequirements": "Requires JavaScript",
            "isAccessibleForFree": true,
            "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
            "publisher": { "@id": "https://www.coffeeandfun.com/#organization" },
            "featureList": [
              "Short practice sets, 10 to 30 questions at a time",
              "An explanation and a memory tip for every answer",
              "Topic breakdown showing weakest areas",
              "Review of every question missed",
              "Weak questions resurface more often",
              "Progress stored on your device, no account"
            ]
          },
          {
            "@type": "BreadcrumbList",
            "@id": "https://www.coffeeandfun.com/realtor-exam-prep/#breadcrumb",
            "itemListElement": [
              { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.coffeeandfun.com/" },
              { "@type": "ListItem", "position": 2, "name": "Real Estate Exam Practice", "item": "https://www.coffeeandfun.com/realtor-exam-prep/" }
            ]
          }
        ]
      }
    </script>

    {% include schema-org.liquid %}

    {% bundledCss %}
    {% pageCss "realtor-exam-prep" %}
    {% include sketch-styles.liquid %}
</head>

<body class="bg-cream">
    {% include header.liquid %}

    <section class="bg-cocoa px-6 py-16 text-center sm:py-20">
        <div class="mx-auto max-w-3xl">
            <p class="text-sm font-bold uppercase tracking-widest text-[#fd776d] sm:text-base">Free study tool</p>
            <h1 class="mt-4 text-4xl font-bold tracking-tight text-cream sm:text-5xl">Real estate exam practice</h1>
            <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-[#d9c9b8]">
                Short sets of questions, an explanation for every answer, and a breakdown afterwards
                of which topics to go back to. Nothing to sign up for.
            </p>
        </div>
    </section>

    <main id="main-content" class="rep-wrap" data-rep>

        <!-- ============ start ============ -->
        <div data-screen="start">
            <div class="rep-panel">
                <h2>Start a set</h2>
                <p>
                    <strong><span data-rep-count>0</span> questions</strong> covering the national
                    portion of the salesperson exam: agency, ownership, land use, valuation,
                    financing, contracts, title, disclosures, leases and the maths.
                </p>

                <p class="rep-warn" data-rep-loaderr hidden></p>

                <div class="rep-controls">
                    <div class="rep-field">
                        <label for="rep-size">Questions in this set</label>
                        <select id="rep-size" data-rep-size>
                            <option value="10">10</option>
                            <option value="15" selected>15</option>
                            <option value="25">25</option>
                            <option value="30">30</option>
                        </select>
                    </div>
                    <div class="rep-field">
                        <label for="rep-topic">Topic</label>
                        <select id="rep-topic" data-rep-topicpick>
                            <option value="all">Everything, mixed</option>
                        </select>
                    </div>
                </div>

                <button type="button" class="rep-btn" data-rep-start disabled>Start</button>

                <p class="rep-note">
                    Questions you get wrong come back sooner and more often than ones you keep
                    getting right, so a mixed set gets harder in the places you need it to.
                </p>
            </div>

            <div class="rep-panel">
                <h2>Your progress</h2>
                <div data-rep-lifetime></div>
                <p class="rep-note">
                    Everything is stored in this browser on this device and never leaves it. There
                    is no account, which also means clearing your site data erases it, and it will
                    not follow you to your phone.
                </p>
                <button type="button" class="rep-btn rep-btn-ghost rep-btn-small" data-rep-reset>Reset all progress</button>
            </div>

            <div class="rep-panel">
                <h2>What this covers, and what it does not</h2>
                <p>
                    Every US state exam splits in two: a national section, which is the same
                    everywhere and is usually most of the paper, and a state section on your own
                    state's licence law. <strong>These questions are the national section only.</strong>
                </p>
                <p>
                    They were written from the standard national content outlines as a study aid.
                    They are not official prep material, not affiliated with any licensing body, and
                    not legal advice. Where a rule commonly varies between states, the explanation
                    says so. Always check against your own state's approved course.
                </p>
            </div>
        </div>

        <!-- ============ quiz ============ -->
        <div data-screen="quiz" hidden>
            <div class="rep-panel" data-rep-quiz tabindex="-1">
                <div class="rep-quizhead">
                    <span class="rep-progress" data-rep-progress></span>
                    <span class="rep-topicchip" data-rep-topic></span>
                </div>
                <div class="rep-track"><span data-rep-bar style="width:0%"></span></div>

                <p class="rep-question" data-rep-question></p>
                <ul class="rep-choices" data-rep-choices></ul>

                <div class="rep-feedback" data-rep-feedback hidden></div>

                <div class="rep-quizfoot">
                    <button type="button" class="rep-btn" data-rep-next hidden>Next question</button>
                    <button type="button" class="rep-btn rep-btn-ghost rep-btn-small" data-rep-quit>Quit set</button>
                </div>
            </div>
        </div>

        <!-- ============ results ============ -->
        <div data-screen="results" hidden>
            <div class="rep-panel" data-rep-results tabindex="-1">
                <h2>How you did</h2>
                <div class="rep-score">
                    <span class="rep-score-pct" data-rep-pct></span>
                    <span class="rep-score-raw" data-rep-score></span>
                    <p class="rep-score-verdict" data-rep-verdict></p>
                </div>

                <h2>By topic, weakest first</h2>
                <ul class="rep-topic-list" data-rep-topics></ul>

                <p class="rep-warn" data-rep-savewarn hidden>
                    Your progress could not be saved. If you are in private browsing, this set will
                    not be remembered.
                </p>

                <div class="rep-quizfoot">
                    <button type="button" class="rep-btn" data-rep-restart>Another set</button>
                    <button type="button" class="rep-btn rep-btn-ghost rep-btn-small" data-rep-again>Back to start</button>
                </div>
            </div>

            <div class="rep-panel" data-rep-missed-wrap hidden>
                <h2>What you got wrong</h2>
                <p>Read these once now and once before your next set. They are the ones that will show up again.</p>
                <ul class="rep-missed" data-rep-missed></ul>
            </div>

            <div class="rep-panel">
                <h2>Your progress overall</h2>
                <div data-rep-lifetime></div>
            </div>
        </div>

    </main>

    {% include modals.liquid %}
    {% include footer.liquid %}

    {% pageJs "realtor-exam-prep" %}
</body>
</html>
