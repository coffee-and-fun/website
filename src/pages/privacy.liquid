<!doctype html>
<html class="brand-color-background scroll-smooth antialiased" lang="en" data-theme="light" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- Primary Meta Tags -->
    <title>Privacy Statement - Coffee & Fun LLC</title>
    <meta name="title" content="Privacy Statement - Coffee & Fun LLC" />
    <meta name="description" content="Coffee & Fun LLC's privacy statement: our apps collect no personal data, use no trackers or third-party services, and everything runs locally on your device." />
    <meta name="keywords" content="privacy policy, data protection, no tracking, local apps, Coffee & Fun LLC, privacy statement" />
    <meta name="author" content="Coffee & Fun LLC" />
    <meta name="robots" content="index, follow" />
    <meta name="rating" content="safe for kids" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href="https://www.coffeeandfun.com/privacy/" />
    
    <!-- Favicon -->
    <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coffee & Fun" />
    <meta property="og:title" content="Privacy Statement - Coffee & Fun LLC" />
    <meta property="og:description" content="Coffee & Fun LLC's privacy statement: our apps collect no personal data, use no trackers or third-party services, and everything runs locally on your device." />
    <meta property="og:url" content="https://www.coffeeandfun.com/privacy/" />
    <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/privacy.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Coffee & Fun cup logo above a red badge reading Privacy Statement" />
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bycoffeeandfun" />
    <meta name="twitter:creator" content="@bycoffeeandfun" />
    <meta name="twitter:title" content="Privacy Statement - Coffee & Fun LLC" />
    <meta name="twitter:description" content="Coffee & Fun LLC's privacy statement: our apps collect no personal data, use no trackers or third-party services, and everything runs locally on your device." />
    <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/privacy.png" />
    <meta name="twitter:image:alt" content="Coffee & Fun cup logo above a red badge reading Privacy Statement" />
    <meta name="twitter:domain" content="coffeeandfun.com" />
    <meta name="twitter:url" content="https://www.coffeeandfun.com/privacy/" />
    
    <!-- PWA Manifest -->
    <link rel="manifest" href="/assets/images/social/site.webmanifest" />
    
    <!-- Theme & Mobile Meta -->
    <meta name="theme-color" content="#fef5ec" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    
    <!-- Icons -->
    <link rel="apple-touch-icon" href="/assets/images/social/192.png" />
    <link rel="icon" href="/assets/images/social/192.png" sizes="192x192" type="image/png" />
    
    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": "Privacy Statement",
        "description": "Coffee & Fun LLC privacy policy - no data collection, no tracking, complete user privacy protection",
        "url": "/privacy",
        "mainEntity": {
          "@type": "Organization",
          "name": "Coffee & Fun LLC",
          "url": "https://www.coffeeandfun.com",
          "sameAs": [
            "https://x.com/bycoffeeandfun"
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "email": "hello@coffeeandfun.com",
            "contactType": "customer service"
          }
        },
        "breadcrumb": {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Home",
              "item": "https://www.coffeeandfun.com"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Privacy Statement",
              "item": "/privacy"
            }
          ]
        },
        "publisher": {
          "@id": "https://www.coffeeandfun.com/#organization"
        },
        "isPartOf": {
          "@id": "https://www.coffeeandfun.com/#website"
        }
      }
    </script>

    {% include schema-org.liquid %}

    {% bundledCss %}


    {% include scripts.html %}
      {% include sketch-styles.liquid %}
</head>
  
  <body>
    {% assign showFun = true %}
    {% assign showMiddleBadgeWithText = true %}
    {% include header.liquid %}

    <main id="main-content">

      <!-- Hero -->
      <section class="relative mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 pt-20 sm:pt-28 pb-10 sm:pb-14 text-center overflow-visible">
        <h1 class="brand-heading text-4xl sm:text-5xl lg:text-6xl leading-[1.15] sm:leading-[1.15] lg:leading-[1.15] mb-5">
          Privacy Statement
        </h1>
        <p class="text-lg sm:text-xl text-stone-600 max-w-2xl mx-auto leading-relaxed">
          Our apps and extensions do not collect anything about you. No accounts, no tracking, no quiet phoning home. This page explains exactly what that means, and is honest about the one place it does not apply yet.
        </p>

        <!-- Trust row -->
        <p class="mt-8 text-xl sm:text-2xl text-caramel" style="font-family: 'Caveat', cursive;">
          No tracking in apps&nbsp;&nbsp;&middot;&nbsp;&nbsp;No selling data&nbsp;&nbsp;&middot;&nbsp;&nbsp;Ever
        </p>

        <!-- Sketch: "pinky promise!" with arrow sweeping down-left onto the heading -->
        <div class="sketch-note text-lg sm:text-xl" style="top: 12px; right: 19%; transform: rotate(-5deg);">
          pinky promise!
          <svg width="86" height="84" style="bottom: -80px; left: -44px;">
            <path d="M80 4 C72 30, 50 54, 14 74" class="sketch-arrow"/>
            <path d="M14 60 L10 78 L30 72" class="sketch-arrow"/>
          </svg>
        </div>

        <!-- Sketch: padlock doodle left of heading -->
        <div class="sketch-note" style="top: 24%; left: 5%; transform: rotate(-8deg);">
          <svg width="26" height="30" viewBox="0 0 26 30">
            <rect x="3" y="13" width="20" height="14" rx="3" fill="none" stroke="var(--color-mocha)" stroke-width="2" stroke-linejoin="round" opacity="0.4"/>
            <path d="M7 13 L7 9 C7 5, 9 2, 13 2 C17 2, 19 5, 19 9 L19 13" fill="none" stroke="var(--color-mocha)" stroke-width="2" stroke-linecap="round" opacity="0.4"/>
            <circle cx="13" cy="20" r="2" fill="var(--color-coral)" opacity="0.45"/>
          </svg>
        </div>

        <!-- Sketch: checkmark right -->
        <div class="sketch-note sketch-wiggle" style="top: 45%; right: 6%; --sketch-rotate: 5deg;">
          <svg width="20" height="18" viewBox="0 0 22 20">
            <path d="M3 10 L9 16 L19 4" class="sketch-check"/>
          </svg>
        </div>

        <!-- Sketch: heart near trust row -->
        <div class="sketch-note sketch-float-slow" style="top: 62%; left: 8%; --sketch-rotate: -10deg;">
          <svg width="20" height="18" viewBox="0 0 24 22">
            <path d="M12 21 C12 21, 2 14, 2 7 C2 3, 5 1, 8 2 C10 3, 11 5, 12 6 C13 5, 14 3, 16 2 C19 1, 22 3, 22 7 C22 14, 12 21, 12 21 Z" class="sketch-heart"/>
          </svg>
        </div>

        <!-- Sketch: star top-left -->
        <div class="sketch-note" style="top: 12%; left: -1%; transform: rotate(-12deg);">
          <svg width="24" height="24" viewBox="0 0 30 30">
            <path d="M15 2 L17 11 L26 11 L19 17 L22 26 L15 21 L8 26 L11 17 L4 11 L13 11 Z" fill="none" stroke="#fd6155" stroke-width="1.5" stroke-linejoin="round" opacity="0.4"/>
          </svg>
        </div>

        <!-- Sketch: swirl bottom-right -->
        <div class="sketch-note" style="bottom: 4%; right: 2%;">
          <svg width="26" height="26" viewBox="0 0 30 30">
            <path d="M15 15 C15 10, 20 8, 22 12 C24 16, 20 20, 15 18 C10 16, 8 10, 12 6 C16 2, 24 4, 26 10" class="sketch-swirl"/>
          </svg>
        </div>

        <!-- Sketch: squiggle bottom-left -->
        <div class="sketch-note" style="bottom: 8%; left: 2%;">
          <svg width="50" height="14" viewBox="0 0 50 14">
            <path d="M2 8 C8 2, 14 12, 20 7 C26 2, 32 12, 38 7 C44 2, 48 10, 48 7" class="sketch-squiggle"/>
          </svg>
        </div>
      </section>

      <!-- Privacy Content -->
      <section class="relative mx-auto max-w-2xl px-4 sm:px-6 lg:px-8 pb-16 overflow-visible">
        <!-- Sketch: vertical squiggle in left margin -->
        <div class="sketch-note" style="top: 8%; left: -6%;">
          <svg width="14" height="60" viewBox="0 0 14 60">
            <path d="M7 2 C2 10, 12 18, 7 26 C2 34, 12 42, 7 50 C4 56, 10 58, 7 58" class="sketch-squiggle"/>
          </svg>
        </div>

        <!-- Sketch: "the short version: we can't see anything" -->
        <div class="sketch-note text-base sm:text-lg" style="top: -10px; right: -8%; transform: rotate(4deg); opacity: 0.75;">
          the short version:<br/>we can't see anything!
        </div>

        <!-- Sketch: three dots mid-right -->
        <div class="sketch-note" style="top: 38%; right: -5%;">
          <svg width="8" height="24" viewBox="0 0 8 24">
            <circle cx="4" cy="4" r="2.5" class="sketch-dots"/>
            <circle cx="4" cy="12" r="2.5" class="sketch-dots"/>
            <circle cx="4" cy="20" r="2.5" class="sketch-dots"/>
          </svg>
        </div>

        <!-- Sketch: tiny heart mid-left -->
        <div class="sketch-note sketch-float-slow" style="top: 55%; left: -6%; --sketch-rotate: 10deg;">
          <svg width="16" height="14" viewBox="0 0 24 22">
            <path d="M12 21 C12 21, 2 14, 2 7 C2 3, 5 1, 8 2 C10 3, 11 5, 12 6 C13 5, 14 3, 16 2 C19 1, 22 3, 22 7 C22 14, 12 21, 12 21 Z" class="sketch-heart-filled"/>
          </svg>
        </div>

        <!-- Sketch: lightning bolt right -->
        <div class="sketch-note sketch-wiggle" style="top: 70%; right: -5%; --sketch-rotate: 8deg;">
          <svg width="12" height="22" viewBox="0 0 16 28">
            <path d="M10 0 L4 12 L10 12 L6 28" class="sketch-lightning"/>
          </svg>
        </div>

        <article class="space-y-10 text-pretty">

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">The short version</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              Our apps and extensions collect nothing about you. Nothing at all. This website is a little different, and we explain that below rather than pretending otherwise. We have never sold anyone's information and never will.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">Our apps collect nothing</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              None of our <a class="underline decoration-2 underline-offset-2" style="color: var(--color-caramel);" href="/apps/">apps or browser extensions</a> collect your personal information, your device details, or what you do with them. There is no account to make and nothing to log in to. We do not want your information, so we do not ask for it.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">No analytics or trackers inside them</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              There are no hidden trackers, no analytics scripts and no fingerprinting in our app code. Nobody, including us, is counting what you click. What you do in our apps is genuinely your business.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">Your work stays on your device</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              Our apps do their work on your own computer or phone. Your notes, images and files are saved there, not on a server of ours. Many of them keep working with the internet switched off entirely, which is the easiest proof that nothing is being sent anywhere.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">This website is different, and we are fixing that</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              We should be straight with you. coffeeandfun.com itself is not as clean as our apps. It currently uses two outside services:
            </p>
            <ul class="mt-4 space-y-3 text-lg text-stone-600 leading-relaxed list-disc pl-6">
              <li><strong class="text-stone-900">Google Analytics</strong>, which counts how many people visit and which pages they read.</li>
              <li><strong class="text-stone-900">Crisp</strong>, the little chat bubble, so you can message us without opening your email.</li>
            </ul>
            <p class="text-lg text-stone-600 leading-relaxed mt-4">
              Neither of these is in our apps. They only run on this website. We are working on removing them so the site matches the standard we hold the apps to, and we will update this page when that is done.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">Things we will never do</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              We will never sell your information, hand it to advertisers, or build a profile of you. There is no business model here that depends on knowing about you. We make things and some of them cost a few pounds. That is it.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">Safe for younger users</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              Because our apps collect nothing, there is nothing collected about children either. No sign up, no name, no email, no age. Parents and teachers can hand our tools to a class without filling in a form.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">Helperbird</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              Helperbird has accounts and subscriptions, so it necessarily works differently and keeps its own privacy policy. Visit <a class="underline decoration-2 underline-offset-2" style="color: var(--color-caramel);" href="https://www.helperbird.com" rel="noopener">helperbird.com</a> for that.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">Asking us about your data</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              You are welcome to ask what we hold about you. For our apps the answer is nothing, and we are happy to say so in writing. Email <a class="underline decoration-2 underline-offset-2" style="color: var(--color-caramel);" href="mailto:hello@coffeeandfun.com">hello@coffeeandfun.com</a> and a person will reply.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">When this page changes</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              We update this page when something real changes, and the date below tells you when. Our promise about the apps is not going to move. New features will never arrive by quietly starting to collect something. See also our <a class="underline decoration-2 underline-offset-2" style="color: var(--color-caramel);" href="/security/">security page</a> and our <a class="underline decoration-2 underline-offset-2" style="color: var(--color-caramel);" href="/terms/">terms and refunds</a>.
            </p>
          </section>

          <p class="text-sm text-stone-500 pt-4">Last updated: 4 August 2026.</p>

        </article>
      </section>

      <!-- Questions CTA -->
      <section class="relative mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 pb-24 sm:pb-32 text-center overflow-visible">
        <!-- Sketch: "we'll answer anything!" near heading -->
        <div class="sketch-note text-base sm:text-lg" style="top: -6px; right: 8%; transform: rotate(4deg);">
          <svg width="18" height="16" viewBox="0 0 22 20" style="position: relative; display: inline-block; margin-right: 3px; vertical-align: middle;">
            <path d="M3 10 L9 16 L19 4" class="sketch-check"/>
          </svg>
          we'll answer anything!
        </div>

        <h2 class="brand-heading text-3xl sm:text-4xl lg:text-5xl leading-[1.25] mb-4">
          Questions or Concerns?
        </h2>
        <p class="text-lg sm:text-xl text-stone-600 max-w-xl mx-auto leading-relaxed mb-8">
          Have a question or want to double-check something? We're happy to help.
        </p>

        <div class="relative inline-block">
          <a
            class="btn btn-lg rounded-lg px-8 sm:px-10 font-semibold text-white border-0 bg-caramel hover:bg-espresso shadow-[0_10px_15px_-3px_rgba(122,78,49,0.35)] hover:shadow-xl hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-espresso focus-visible:ring-offset-2 transition-all duration-200"
            href="mailto:hello@coffeeandfun.com"
            title="Email Coffee & Fun"
          >
            Email Us
          </a>
        </div>

        <div class="relative inline-block w-full">
          <p class="mt-6 text-sm text-stone-500">
            Or write to <a href="mailto:hello@coffeeandfun.com" class="underline hover:text-stone-700 transition-colors" style="color: var(--color-mocha);">hello@coffeeandfun.com</a>
          </p>
          <!-- Sketch: wavy underline under email -->
          <div class="sketch-note" style="bottom: -8px; left: 50%; transform: translateX(-50%);">
            <svg width="100" height="10" viewBox="0 0 100 10">
              <path d="M2 7 C12 2, 22 10, 35 5 C48 0, 58 10, 72 5 C85 0, 92 8, 98 4" class="sketch-underline"/>
            </svg>
          </div>
        </div>
      </section>

    </main>

    {% include modals.liquid %}
    {% include footer.liquid %}
  </body>
</html>