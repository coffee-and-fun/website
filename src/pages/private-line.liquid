<!DOCTYPE html>
<html class="antialiased" lang="en" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary Meta Tags -->
    <title>Private Line: End-to-End Encrypted Chat - Coffee & Fun LLC</title>
    <meta name="description" content="An end-to-end encrypted chat for exactly two people, right in your browser: no accounts, no stored messages, and everything vanishes when you close the tab." />
    <meta name="author" content="Coffee & Fun LLC" />
    <meta name="robots" content="index, follow" />

    <!-- Canonical URL -->
    <link rel="canonical" href="https://www.coffeeandfun.com/private-line/" />

    <!-- Favicon -->
    <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coffee & Fun" />
    <meta property="og:title" content="Private Line: End-to-End Encrypted Chat - Coffee & Fun LLC" />
    <meta property="og:description" content="An end-to-end encrypted chat for exactly two people, right in your browser: no accounts, no stored messages, and everything vanishes when you close the tab." />
    <meta property="og:url" content="https://www.coffeeandfun.com/private-line/" />
    <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/private-line.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Private Line, end-to-end encrypted one-to-one chat by Coffee & Fun" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bycoffeeandfun" />
    <meta name="twitter:title" content="Private Line: End-to-End Encrypted Chat - Coffee & Fun LLC" />
    <meta name="twitter:description" content="An end-to-end encrypted chat for exactly two people, right in your browser: no accounts, no stored messages, and everything vanishes when you close the tab." />
    <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/private-line.png" />
    <meta name="twitter:image:alt" content="Private Line, end-to-end encrypted one-to-one chat by Coffee & Fun" />

    <meta name="theme-color" content="#0e1512" />

    <!-- Structured Data -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "Private Line",
        "description": "A browser-based, end-to-end encrypted one-to-one chat. Ephemeral ECDH key agreement and AES-256-GCM encryption run entirely on your device; the matchmaking server never sees message contents. No accounts, no stored history.",
        "url": "https://www.coffeeandfun.com/private-line/",
        "applicationCategory": "CommunicationApplication",
        "operatingSystem": "Web Browser",
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
        "author": { "@type": "Organization", "name": "Coffee & Fun LLC" }
    }
    </script>

    <script src="https://unpkg.com/vue@3"></script>
    <script src="https://unpkg.com/peerjs@1.5.5/dist/peerjs.min.js"></script>

    {% pageCss "private-line" %}
</head>

<body>
{% raw %}
    <a href="#tool" class="skip">Skip to the chat</a>

    <div id="load-fallback" class="wrap" hidden>
        <p class="lede">Private Line needs a secure connection and a couple of files that didn&rsquo;t load. Make sure you&rsquo;re on <strong>https</strong>, check your connection, and refresh.</p>
    </div>
    <noscript>
        <div class="wrap"><p class="lede">Private Line needs JavaScript turned on to encrypt your messages.</p></div>
    </noscript>

    <main v-cloak id="app" class="wrap">

        <div class="topbar">
            <a href="/" class="home-link" aria-label="Back to coffeeandfun.com">
                <img src="/assets/images/brand/coffee-and-fun-logo-dark.png" alt="" width="48" height="48" decoding="async" />
                <span class="tip" aria-hidden="true">Back to coffeeandfun.com</span>
            </a>
            <span class="lock-badge" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                End-to-end encrypted
            </span>
        </div>

        <!-- Live status for screen readers -->
        <div class="sr-only" role="status" aria-live="polite">{{ announcement }}</div>

        <!-- ===================== START ===================== -->
        <section v-if="screen === 'start'" id="tool">
            <h1>Private Line</h1>
            <p class="lede">A private chat for exactly two people, encrypted end-to-end right here in your browser. No account, no history, nothing kept, when you both close the tab, it&rsquo;s gone.</p>

            <div class="menu-choices">
                <button type="button" class="menu-card" @click="startHost" :disabled="!ready">
                    <span class="mc-ico" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                    </span>
                    <span>
                        <span class="mc-title">Start a private room</span>
                        <span class="mc-sub">Get an invite link to send to the one person you want to talk to.</span>
                    </span>
                </button>
                <button type="button" class="menu-card" @click="screen = 'join'" :disabled="!ready">
                    <span class="mc-ico" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.5 1.5"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7L12 19"/></svg>
                    </span>
                    <span>
                        <span class="mc-title">Join with a link</span>
                        <span class="mc-sub">Someone sent you a Private Line? Paste the code and connect.</span>
                    </span>
                </button>
            </div>
            <p v-if="!ready" class="lede" style="margin-top:1rem;font-size:0.85rem;">{{ readyError || 'Setting up encryption…' }}</p>

            <details class="rules">
                <summary>How private is this, really?</summary>
                <p><strong>Your messages are encrypted on your device and decrypted on theirs</strong>, with keys that are created fresh for this one conversation and never leave either browser. The matchmaking server only helps the two of you find each other; it never sees a single message. Every message is also padded to the same size before it&rsquo;s sent, so its length gives nothing away.</p>
                <ul>
                    <li><strong>Check the safety phrase.</strong> When you connect, both screens show the same short phrase. Read it out loud to each other, on a call or in person. If it matches, you can trust no one has slipped in between. If it doesn&rsquo;t, stop.</li>
                    <li><strong>Nothing is stored.</strong> No accounts, no logs, no history. Close the tab and the whole conversation and its keys are gone.</li>
                    <li><strong>It hides what you say, not that you talked.</strong> You connect directly, phone to phone, so the two of you can see each other&rsquo;s IP address, and the server that introduces you knows you connected, never <em>what</em> you said. It&rsquo;s for a private word between people who already know each other, not for staying anonymous.</li>
                    <li><strong>It&rsquo;s a fun, honest privacy tool</strong>, great for a quick private word. It hasn&rsquo;t been independently audited, so don&rsquo;t bet your life on it.</li>
                </ul>
            </details>
        </section>

        <!-- ===================== JOIN ===================== -->
        <section v-else-if="screen === 'join'" id="tool">
            <h1>Join a Private Line</h1>
            <p class="lede">Paste the code from the invite link. If you opened their link, it&rsquo;s already here.</p>
            <div class="name-row">
                <div>
                    <label class="f-label" for="pl-name">Your name (shown to them)</label>
                    <input id="pl-name" class="field" type="text" v-model="myName" maxlength="24" placeholder="Anonymous" />
                </div>
            </div>
            <div class="name-row">
                <div>
                    <label class="f-label" for="pl-code">Invite code</label>
                    <input id="pl-code" class="field" type="text" v-model="joinId" spellcheck="false" autocapitalize="off" placeholder="paste the code here" />
                </div>
                <button type="button" class="btn btn-primary" @click="connectToHost" :disabled="!joinId.trim() || connecting">
                    {{ connecting ? 'Connecting…' : 'Connect' }}
                </button>
            </div>
            <div v-if="netError" class="banner warn" role="alert"><span>{{ netError }}</span></div>
            <p style="margin-top:1.2rem;"><button type="button" class="linkish" @click="backToStart">&larr; Back</button></p>
        </section>

        <!-- ===================== LOBBY (host waiting) ===================== -->
        <section v-else-if="screen === 'lobby'" id="tool">
            <h1>Your room is open</h1>
            <div class="lobby-card">
                <h2 v-if="!peerId" class="pulse-dots">Setting up the line</h2>
                <template v-else>
                    <h2 class="pulse-dots">Waiting for them to join</h2>
                    <p>Send this invite link to the one person you want to talk to. The chat opens the moment they arrive, and for your privacy the link works only once, if you get cut off, just open a fresh room.</p>
                    <div class="invite-row">
                        <input class="field" type="text" readonly :value="inviteLink" aria-label="Invite link" @focus="$event.target.select()" />
                        <button type="button" class="btn btn-ghost" @click="copyInvite">{{ copied ? 'Copied ✓' : 'Copy link' }}</button>
                    </div>
                </template>
                <div class="name-row" style="margin-top:0.4rem;">
                    <div>
                        <label class="f-label" for="pl-hostname">Your name (shown to them)</label>
                        <input id="pl-hostname" class="field" type="text" v-model="myName" maxlength="24" placeholder="Anonymous" />
                    </div>
                </div>
            </div>
            <div v-if="netError" class="banner warn" role="alert"><span>{{ netError }}</span></div>
            <p style="margin-top:1.2rem;"><button type="button" class="linkish" @click="backToStart">&larr; Cancel</button></p>
        </section>

        <!-- ===================== CHAT ===================== -->
        <section v-else-if="screen === 'chat'" id="tool" class="chat-shell">
            <div class="chat-head">
                <div class="peer-id">
                    <span class="peer-dot" :class="{ off: !connected }" aria-hidden="true"></span>
                    <span>
                        <span class="peer-name">{{ theirName || 'Your guest' }}</span>
                        <span class="peer-state" style="display:block">{{ connected ? (secured ? 'Encrypted · connected' : 'Securing…') : 'Disconnected' }}</span>
                    </span>
                </div>
                <button type="button" class="btn btn-ghost" style="padding:0.5rem 0.9rem;font-size:0.85rem;" @click="leaveChat">Leave</button>
            </div>

            <div v-if="secured" class="safety" :class="{ verified }">
                <p class="s-head">
                    <span aria-hidden="true">{{ verified ? '🛡️' : '🔑' }}</span>
                    {{ verified ? 'Safety phrase verified' : 'Check your safety phrase' }}
                </p>
                <p class="s-sub" v-if="!verified">Both of you should see the <strong>same</strong> words. Say them out loud on a call or in person. If they match, you can trust no one has slipped in between. If they don&rsquo;t, someone might have, leave and try again.</p>
                <p class="s-sub" v-else>You confirmed these words match on both screens. This line is genuinely just the two of you.</p>
                <p class="sr-only" id="phrase-label">Your safety phrase, {{ safetyWords.length }} words to read aloud:</p>
                <p class="phrase">{{ safetyWords.join('  ') }}</p>
                <div class="safety-actions" v-if="!verified">
                    <button type="button" class="btn btn-primary" style="padding:0.55rem 1.1rem;font-size:0.9rem;" @click="markVerified">They match, I&rsquo;m sure</button>
                </div>
                <div class="safety-actions" v-else>
                    <span class="verified-tag" aria-hidden="true">🛡️ Verified</span>
                </div>
            </div>

            <div class="msg-log" ref="log" role="log" aria-live="polite" aria-label="Conversation">
                <p v-if="messages.length === 0" class="msg-empty">This line is open and encrypted. Say hello, messages appear here and are never saved anywhere.</p>
                <div v-for="m in messages" :key="m.id" class="bubble" :class="m.kind">
                    <span v-if="m.kind === 'theirs'" class="sr-only">{{ theirName || 'They' }} said: </span>
                    <span v-else-if="m.kind === 'mine'" class="sr-only">You said: </span>
                    {{ m.text }}
                    <span v-if="m.kind !== 'system'" class="stamp" aria-hidden="true">{{ m.time }}</span>
                </div>
            </div>

            <p class="typing" aria-hidden="true">{{ theirTyping ? (theirName || 'They') + ' is typing…' : '' }}</p>

            <form class="composer" @submit.prevent="sendMessage">
                <label class="sr-only" for="pl-msg">Type a message</label>
                <textarea id="pl-msg" ref="composer" class="field" v-model="draft" rows="1"
                          :placeholder="connected ? (secured ? 'Type a message…' : 'Securing the line…') : 'They left, this line is closed'"
                          :disabled="!connected || !secured"
                          @input="onType" @keydown="onComposerKey"></textarea>
                <button type="submit" class="send-btn" :disabled="!connected || !secured || !draft.trim()" aria-label="Send message">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg>
                </button>
            </form>
            <div class="chat-foot-row">
                <label class="typing-toggle">
                    <input type="checkbox" v-model="sendTyping" @change="onTypingToggle" />
                    Let them see when I&rsquo;m typing
                </label>
                <button type="button" class="linkish" @click="leaveChat">End this chat</button>
            </div>
            <p class="lock-note" aria-hidden="true" style="text-align:center;margin:0.5rem 0 0;">🔒 Encrypted on your device · nothing stored</p>
        </section>

        <p class="foot">The matchmaking server helps you connect but never sees your messages, they&rsquo;re encrypted on your device and decrypted on theirs. No accounts, no logs, nothing kept.<br>A privacy tool from <a href="https://www.coffeeandfun.com/">Coffee &amp; Fun</a>.</p>
    </main>
{% endraw %}

    {% pageJs "private-line" %}
</body>
</html>
