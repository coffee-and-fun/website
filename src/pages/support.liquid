<!DOCTYPE html>
<html class="brand-color-background scroll-smooth antialiased" lang="en" data-theme="light" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Support for Our Apps and Extensions - Coffee & Fun LLC</title>
    <meta name="title" content="Support for Our Apps and Extensions - Coffee & Fun LLC" />
    <meta name="description" content="Get help with any Coffee & Fun app or extension. Send us a question through the contact form or email hello@coffeeandfun.com and a real human will reply." />
    <meta name="author" content="Coffee & Fun LLC" />
    <meta name="robots" content="index, follow" />
    <meta name="rating" content="safe for kids" />

    <link rel="canonical" href="https://www.coffeeandfun.com/support/" />
    <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />
    <link rel="apple-touch-icon" href="/assets/images/social/192.png" />
    <link rel="icon" href="/assets/images/social/192.png" sizes="192x192" type="image/png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coffee & Fun" />
    <meta property="og:title" content="Support for Our Apps and Extensions - Coffee & Fun LLC" />
    <meta property="og:description" content="Get help with any Coffee & Fun app or extension. Send us a question through the contact form or email hello@coffeeandfun.com and a real human will reply." />
    <meta property="og:url" content="https://www.coffeeandfun.com/support/" />
    <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/support.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Coffee & Fun logo, a tilted red coffee cup with the tagline crafting software, one brew at a time" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bycoffeeandfun" />
    <meta name="twitter:title" content="Support for Our Apps and Extensions - Coffee & Fun LLC" />
    <meta name="twitter:description" content="Get help with any Coffee & Fun app or extension. Send us a question through the contact form or email hello@coffeeandfun.com and a real human will reply." />
    <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/support.png" />
    <meta name="twitter:image:alt" content="Coffee & Fun logo, a tilted red coffee cup with the tagline crafting software, one brew at a time" />

    <link rel="manifest" href="/assets/images/social/site.webmanifest" />
    <meta name="theme-color" content="#fef5ec" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    {% include schema-org.liquid %}

    {% bundledCss %}
    {% include scripts.html %}
    {% pageCss "product" %}
    {% pageCss "support" %}


    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ContactPage",
        "name": "Support for Our Apps and Extensions - Coffee & Fun LLC",
        "description": "Get help with any Coffee & Fun app or extension. Send us a question through the contact form or email hello@coffeeandfun.com and a real human will reply.",
        "url": "https://www.coffeeandfun.com/support/",
        "publisher": {
          "@id": "https://www.coffeeandfun.com/#organization"
        },
        "isPartOf": {
          "@id": "https://www.coffeeandfun.com/#website"
        }
      }
    </script>
</head>

<body class="cf-support-page">
    {% include header.liquid %}
    <main id="main-content" tabindex="-1">
      <section class="sp-support" aria-labelledby="support-title">
        <div class="sp-background" aria-hidden="true">
          <span class="sp-sketch sp-envelope">{% include support-doodles.liquid, drawing: 'envelope' %}</span>
          <span class="sp-sketch sp-chat">{% include support-doodles.liquid, drawing: 'conversation' %}</span>
          <span class="sp-sketch sp-cup">{% include journal-mark.liquid, drawing: 'cup' %}</span>
          <span class="sp-sketch sp-star">{% include about-doodles.liquid, drawing: 'spark' %}</span>
          <span class="sp-sketch sp-plane">{% include journal-mark.liquid, drawing: 'plane' %}</span>
          <span class="sp-margin-note">straight to<br>the humans.</span>
        </div>
        <div class="sp-intro">
          <h1 id="support-title">How can we help?</h1>
          <p>Questions, ideas, or a little app trouble?<br> Leave us a note. We’re here to help.</p>
        </div>
        <div class="sp-contact" id="contact">
          <div id="support-form-slot">
            <div class="sp-form-preview">
              <h2>Leave us a note.</h2>
              <p>Our contact form is hosted on Google Forms.<br> Load it here whenever you’re ready.</p>
              <button type="button" id="load-support-form" class="sp-button" aria-controls="support-form-slot" hidden>Load contact form</button>
              <noscript><p>You can open the form below or email us directly.</p></noscript>
            </div>
          </div>
          <p id="support-form-status" class="sp-form-status" role="status"></p>
          <a class="sp-form-external" href="https://docs.google.com/forms/d/e/1FAIpQLSeOBpyxmu3enhScTOuJtYAx2jNK2wr9scFKtbQrj0AjqJfdEQ/viewform">Open in Google Forms</a>
        </div>
        <p class="sp-email">More of an email person?<br><a href="mailto:hello@coffeeandfun.com">hello@coffeeandfun.com</a></p>
      </section>
    </main>
    {% include footer.liquid %}
    {% pageJs "support" %}
</body>
</html>
