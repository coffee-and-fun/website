<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>US Citizenship Test Practice &amp; Civics Flashcards | Coffee &amp; Fun</title>
  <meta name="description" content="Study for the 2008 or 2025 US citizenship civics test with free swipe flashcards, hints, missed-question review, state answers, and a printable cheat sheet." />
  <meta name="author" content="Coffee & Fun LLC" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://www.coffeeandfun.com/citizenship-test/" />
  <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />
  <meta name="theme-color" content="#142b50" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Coffee & Fun" />
  <meta property="og:title" content="US Citizenship Test Practice & Civics Flashcards" />
  <meta property="og:description" content="One card at a time. Learn with hints, revisit mistakes, find your state answers, and print a study cheat sheet. Both 2008 and 2025 tests." />
  <meta property="og:url" content="https://www.coffeeandfun.com/citizenship-test/" />
  <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/citizenship-test.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="US citizenship test practice from Coffee & Fun" />
  <meta property="og:locale" content="en_US" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@bycoffeeandfun" />
  <meta name="twitter:title" content="US Citizenship Test Practice & Civics Flashcards" />
  <meta name="twitter:description" content="Free civics flashcards, memory tips, mistake review, state answers, and a printable cheat sheet." />
  <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/citizenship-test.png" />
  <meta name="twitter:image:alt" content="US citizenship test practice from Coffee & Fun" />
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebApplication",
        "@id": "https://www.coffeeandfun.com/citizenship-test/#app",
        "name": "US Citizenship Test Practice",
        "url": "https://www.coffeeandfun.com/citizenship-test/",
        "description": "Free study cards for the 100-question 2008 and 128-question 2025 USCIS civics tests, with hints, mistake review, state information and a printable cheat sheet.",
        "applicationCategory": "EducationalApplication",
        "operatingSystem": "Any",
        "browserRequirements": "JavaScript is required for interactive study cards.",
        "inLanguage": "en-US",
        "isAccessibleForFree": true,
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
        "publisher": { "@id": "https://www.coffeeandfun.com/#organization" },
        "featureList": ["2008 and 2025 USCIS civics question banks", "Swipe and keyboard study cards", "Question-specific hints", "Missed-question review", "State and territory answers", "Printable study cheat sheet", "65/20 question sets", "Progress saved in this browser"]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.coffeeandfun.com/" },
          { "@type": "ListItem", "position": 2, "name": "US Citizenship Test Practice", "item": "https://www.coffeeandfun.com/citizenship-test/" }
        ]
      }
    ]
  }
  </script>
  {% include schema-org.liquid %}
  {% bundledCss %}
  {% pageCss "citizenship-test" %}
</head>
<body class="ct-body">
  <a class="ct-skip-link" href="#main-content">Skip to study cards</a>
  <main id="main-content" class="ct-app" data-ct>
    <header class="ct-app-header">
      <a class="ct-app-brand" href="/citizenship-test/" aria-label="US citizenship study home"><span class="ct-flag" aria-hidden="true">🇺🇸</span><div><h1>U.S. citizenship</h1><p>One question at a time</p></div></a>
      <button type="button" class="ct-settings-button" data-open-settings aria-label="Study settings and your state"><span aria-hidden="true">⚙</span><span>Set up</span></button>
    </header>
    <button type="button" class="ct-test-label" data-test-label data-open-settings>2025 test · Filed Oct 20, 2025 or later ›</button>
    <div class="ct-notice" data-load-error role="alert" hidden>We couldn’t load your cards. <button type="button" data-retry>Try again</button> Or download the <a href="https://www.uscis.gov/sites/default/files/document/questions-and-answers/2025-Civics-Test-128-Questions-and-Answers.pdf">official questions (PDF)</a>.</div>
    <p class="ct-notice" data-save-error role="status" hidden>Progress couldn’t be saved in this browser. You can keep studying, but closing the page may lose this session.</p>
    <noscript><p class="ct-notice">Enable JavaScript for interactive cards. You can download the official <a href="https://www.uscis.gov/sites/default/files/document/questions-and-answers/OoC_100_Questions_2008_Civics_Test_V1.pdf">2008 questions</a> or <a href="https://www.uscis.gov/sites/default/files/document/questions-and-answers/2025-Civics-Test-128-Questions-and-Answers.pdf">2025 questions</a>.</p></noscript>
    <div data-workspace hidden>
      <section data-panel="study" aria-label="Study cards">
        <div class="ct-deck">
          <div class="ct-session-head"><span data-session-name>Study cards</span><span data-count></span></div>
          <progress class="ct-progress" data-session-progress max="10" value="0" aria-label="Questions completed in this set"></progress>
          <div data-card-area>
            <article class="ct-card" data-card aria-labelledby="ct-question" aria-describedby="ct-card-instruction">
              <div class="ct-card-top"><span class="ct-topic" data-card-topic></span><button type="button" class="ct-save" data-bookmark aria-pressed="false" aria-label="Save this card">☆</button></div>
              <p class="ct-question-number" data-question-number></p>
              <h2 id="ct-question" tabindex="-1" data-question></h2>
              <p id="ct-card-instruction" class="ct-card-instruction">Say it out loud. Then check your answer.</p>
              <div class="ct-card-tools"><button type="button" data-hint-button aria-expanded="false" aria-controls="ct-hint">Need a hint?</button><button type="button" data-listen aria-label="Listen to the question" hidden>♪ Listen</button></div>
              <div id="ct-hint" class="ct-hint" data-hint hidden></div>
              <div class="ct-answer" data-answer hidden></div>
              <button type="button" class="ct-btn ct-reveal" data-reveal>Show answer</button>
            </article>
            <div class="ct-grade" data-grade hidden>
              <p>Did you know it before looking?</p>
              <div class="ct-grade-buttons"><button type="button" class="ct-btn ct-again" data-wrong><span aria-hidden="true">↶</span> Study again</button><button type="button" class="ct-btn ct-knew" data-right>Got it <span aria-hidden="true">✓</span></button></div>
            </div>
            <div class="ct-under-card"><button type="button" class="ct-text-btn" data-undo disabled>↶ Undo</button><p data-gesture-help>Swipe after revealing</p><button type="button" class="ct-text-btn" data-skip>Skip</button></div>
          </div>
          <div class="ct-result" data-result hidden><span class="ct-result-icon" aria-hidden="true">★</span><h2 tabindex="-1" data-result-title></h2><p data-result-copy></p><div class="ct-result-stats" data-result-stats></div><div class="ct-result-actions"><button type="button" class="ct-btn" data-next>Keep studying</button><button type="button" class="ct-btn ct-btn-outline" data-repeat>Repeat missed cards</button><button type="button" class="ct-text-btn" data-result-undo>Undo last answer</button></div></div>
        </div>
      </section>
      <section data-panel="review" aria-labelledby="ct-review-title" hidden>
        <div class="ct-section-head"><h2 id="ct-review-title" tabindex="-1">Your progress</h2><p data-review-summary></p></div>
        <div class="ct-totals" data-totals></div>
        <button type="button" class="ct-btn ct-full" data-review-start>Review missed cards</button>
        <p class="ct-small ct-review-help">Two correct answers without a hint moves a card out of review.</p>
        <div class="ct-review-list" data-review-list></div>
        <details class="ct-extra"><summary>Progress by topic</summary><div class="ct-review-topics" data-review-topics></div></details>
        <details class="ct-extra"><summary>Past mistakes</summary><div data-mistake-history></div></details>
        <details class="ct-extra"><summary>More ways to practice</summary>
          <button type="button" class="ct-btn ct-btn-outline ct-full" data-exam>Try a practice interview</button>
          <div class="ct-field"><label for="ct-mode">Practice cards</label><select id="ct-mode"><option value="all">All questions</option><option value="missed">Questions I got wrong</option><option value="review">Missed + hinted questions</option><option value="saved">Saved cards</option><option value="unseen">Questions I haven’t tried</option></select></div>
          <div class="ct-field"><label for="ct-topic">Topic</label><select id="ct-topic"><option value="">All topics</option></select></div>
          <button type="button" class="ct-btn ct-full" data-new>Start practice</button>
        </details>
      </section>
      <section data-panel="sheet" aria-labelledby="ct-sheet-title" hidden>
        <div class="ct-section-head"><h2 id="ct-sheet-title" tabindex="-1">Your cheat sheet</h2><p>A quick refresher, wherever you study.</p></div>
        <button type="button" class="ct-btn ct-full" data-print>Print / save PDF</button>
        <div class="ct-facts">
          <article><span class="ct-fact-number">2 · 4 · 6</span><h3>Years in office</h3><p>House: <strong>2 years.</strong><br />President: <strong>4 years.</strong><br />Senate: <strong>6 years.</strong></p></article>
          <article><span class="ct-fact-number">1776 / 1787</span><h3>Founding documents</h3><p><strong>Declaration:</strong> July 4, 1776.<br /><strong>Constitution:</strong> 1787.<br /><strong>Bill of Rights:</strong> first 10 amendments.</p></article>
          <article><span class="ct-fact-number">3 branches</span><h3>Who does what?</h3><p><strong>Congress</strong> makes laws.<br /><strong>President</strong> carries them out.<br /><strong>Courts</strong> interpret them.</p></article>
          <article><span class="ct-fact-number">13 / 50</span><h3>Stars &amp; stripes</h3><p><strong>13 stripes:</strong> original colonies.<br /><strong>50 stars:</strong> today's states.<br /><strong>Anthem:</strong> The Star-Spangled Banner.</p></article>
        </div>
        <h3>Your local &amp; current answers</h3><p class="ct-small" data-sheet-date></p><div class="ct-local-summary" data-sheet-officials></div>
        <button type="button" class="ct-text-btn" data-open-settings>Update your state &amp; answers</button>
        <details class="ct-extra"><summary>Browse all questions &amp; hints</summary>
          <div class="ct-sheet-filters"><div class="ct-field"><label for="ct-search">Search questions or answers</label><input type="search" id="ct-search" placeholder="Try “Constitution”" /></div><label class="ct-check"><input type="checkbox" id="ct-sheet-missed" /> Only cards needing practice</label></div>
          <label class="ct-check"><input type="checkbox" id="ct-print-questions" /> Include these questions when printing</label>
          <p class="ct-small" data-sheet-count role="status"></p><div data-sheet-content></div>
        </details>
        <div class="ct-faq" id="ct-guide">
          <details><summary>Which test do I need?</summary><p>Filed Form N-400 <strong>before October 20, 2025</strong>? Study the 2008 test: 100 questions, up to 10 asked, 6 correct to pass. Filed <strong>on or after October 20, 2025</strong>? Study the 2025 test: 128 questions, up to 20 asked, 12 correct to pass. Choose by filing date, not interview date. Eligible 65/20 applicants study their version’s designated 20 questions; 6 of 10 correct passes. <a href="https://www.uscis.gov/citizenship/find-study-materials-and-resources/study-for-the-test">Check USCIS guidance.</a></p></details>
          <details><summary>About the questions &amp; this app</summary><p>Questions and accepted answers come from the official <a href="https://www.uscis.gov/sites/default/files/document/questions-and-answers/OoC_100_Questions_2008_Civics_Test_V1.pdf">2008 USCIS list (PDF)</a> and <a href="https://www.uscis.gov/sites/default/files/document/questions-and-answers/2025-Civics-Test-128-Questions-and-Answers.pdf">2025 USCIS list (PDF)</a>. Memory tips are written by Coffee &amp; Fun, not USCIS. Some official answers simplify history; hints add context where useful.</p><p>This covers civics. The interview also covers your application and, unless an exception applies, English reading, writing, and speaking. <a href="https://my.uscis.gov/citizenship/what_to_expect">What to expect.</a> Practice scores use your own assessment and cannot guarantee an interview result.</p></details>
          <details><summary>Where is my progress saved?</summary><p>Only in this browser, on this device. Progress does not sync between your phone and laptop. Private browsing or clearing browser data may erase it. Save a PDF of your cheat sheet to take it with you.</p></details>
        </div>
        <p class="ct-disclaimer">Free study app by <a href="/">Coffee &amp; Fun</a>. Not affiliated with USCIS. <a href="https://www.uscis.gov/citizenship/testupdates">Verify current answers</a> before your interview.</p>
      </section>
      <nav class="ct-nav" aria-label="Study sections">
        <button type="button" data-view="study" aria-pressed="true"><span aria-hidden="true">▤</span>Study</button>
        <button type="button" data-view="review" aria-pressed="false"><span aria-hidden="true">↻</span>Progress<span class="ct-nav-count" data-review-count>0</span></button>
        <button type="button" data-view="sheet" aria-pressed="false"><span aria-hidden="true">≡</span>Cheat sheet</button>
      </nav>
    </div>
    <p class="ct-loading" data-loading role="status">Getting your cards ready…</p>
    <p class="ct-sr-only" data-status role="status" aria-live="polite" aria-atomic="true"></p>
    <dialog class="ct-dialog" id="ct-settings-dialog" aria-labelledby="ct-settings-title">
      <div class="ct-dialog-header"><h2 id="ct-settings-title">Your study setup</h2><button type="button" class="ct-text-btn" data-close-settings>Done</button></div>
      <p class="ct-small">A couple of details to get the right answers.</p>
      <div class="ct-settings">
        <div class="ct-field"><label for="ct-version">When did you file Form N-400?</label><select id="ct-version" data-setting="version"><option value="2025">On / after Oct 20, 2025 · 2025 test</option><option value="2008">Before Oct 20, 2025 · 2008 test</option></select></div>
        <p class="ct-version-note" data-version-note></p>
        <div class="ct-field"><label for="ct-place">Where do you live?</label><select id="ct-place" data-setting="place"><option value="">Choose your state or territory</option></select></div>
        <div data-representative-setup></div>
      </div>
      <section data-panel="state" aria-label="Current officials">
        <details class="ct-extra"><summary>Your state &amp; current officials</summary><p class="ct-small" data-reference-date></p><p class="ct-small" data-place-note></p><div class="ct-official-grid" data-officials></div><p class="ct-small">Your saved answer overrides the reference. Clear it to use the reference again.</p></details>
      </section>
      <details class="ct-extra"><summary>65/20 special consideration</summary><label class="ct-check"><input id="ct-senior" type="checkbox" data-setting="senior" /> Use the special 20-question bank</label><p class="ct-small">For applicants age 65 or older who have been lawful permanent residents for at least 20 years. Up to 10 questions asked; 6 correct passes.</p></details>
      <details class="ct-extra"><summary>How to use the cards</summary><p class="ct-small">Say your answer out loud before revealing it. Swipe left to study again or right if you knew it. The buttons do the same thing. Get a review card correct twice without a hint to clear it.</p><p class="ct-small">With the card focused: Space reveals, ← marks for practice, → marks correct, H shows a hint, and U undoes. Keyboard shortcuts work only in the card area.</p></details>
      <details class="ct-reset ct-extra"><summary>Reset progress</summary><p class="ct-small">Clear saved cards, answers, and progress for both tests in this browser.</p><button type="button" class="ct-text-btn" data-reset>Reset this study tool</button><div data-reset-confirm hidden><p>Clear all your study data?</p><button type="button" class="ct-btn" data-reset-yes>Yes, clear everything</button><button type="button" class="ct-text-btn" data-reset-no>Keep my progress</button></div></details>
    </dialog>
    <section class="ct-print-only" data-print-content aria-label="Printable citizenship cheat sheet"></section>
  </main>
  {% pageJs "citizenship-study" %}
  {% pageJs "citizenship-test" %}
</body>
</html>
