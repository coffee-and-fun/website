<!DOCTYPE html>
<html class="antialiased" lang="en" data-theme="light" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>US Citizenship Test Practice, 2008 Civics Questions - Coffee &amp; Fun LLC</title>
    <meta name="title" content="US Citizenship Test Practice, 2008 Civics Questions - Coffee & Fun LLC" />
    <meta name="description" content="Practise the official 100 civics questions for the US naturalization test, 10 at a time, with answers for your state. For N-400 applications filed before 20 October 2025." />
    <meta name="author" content="Coffee & Fun LLC" />
    <meta name="robots" content="index, follow" />

    <link rel="canonical" href="https://www.coffeeandfun.com/citizenship-test/" />
    <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coffee & Fun" />
    <meta property="og:title" content="US Citizenship Test Practice, 2008 Civics Questions" />
    <meta property="og:description" content="The official 100 civics questions, 10 at a time, with answers for your state. Free, no signup, saved on your device." />
    <meta property="og:url" content="https://www.coffeeandfun.com/citizenship-test/" />
    <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/citizenship-test.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="US citizenship test practice, the official 100 civics questions" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bycoffeeandfun" />
    <meta name="twitter:title" content="US Citizenship Test Practice, 2008 Civics Questions" />
    <meta name="twitter:description" content="The official 100 civics questions, 10 at a time, with answers for your state." />
    <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/citizenship-test.png" />
    <meta name="twitter:image:alt" content="US citizenship test practice, the official 100 civics questions" />

    <meta name="theme-color" content="#3d2b1f" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebApplication",
            "@id": "https://www.coffeeandfun.com/citizenship-test/#app",
            "name": "US Citizenship Civics Test Practice",
            "description": "Practise the official 100 USCIS civics questions for the 2008 naturalization test, ten at a time, with the answers that depend on your state filled in by you and stored on your device.",
            "url": "https://www.coffeeandfun.com/citizenship-test/",
            "applicationCategory": "EducationalApplication",
            "operatingSystem": "Web Browser",
            "browserRequirements": "Requires JavaScript",
            "isAccessibleForFree": true,
            "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
            "publisher": { "@id": "https://www.coffeeandfun.com/#organization" },
            "featureList": [
              "All 100 official USCIS civics questions, 2008 version",
              "Ten at a time, matching the real oral test",
              "Answers adjusted for your state or territory",
              "Tracks which questions you keep missing",
              "Optional 65/20 mode for the 20 question set",
              "Stored on your device, no account"
            ]
          },
          {
            "@type": "BreadcrumbList",
            "@id": "https://www.coffeeandfun.com/citizenship-test/#breadcrumb",
            "itemListElement": [
              { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.coffeeandfun.com/" },
              { "@type": "ListItem", "position": 2, "name": "US Citizenship Test Practice", "item": "https://www.coffeeandfun.com/citizenship-test/" }
            ]
          }
        ]
      }
    </script>

    {% include schema-org.liquid %}

    {% bundledCss %}
    {% pageCss "citizenship-test" %}
    {% include sketch-styles.liquid %}
</head>

<body class="bg-cream">
    {% include header.liquid %}

    {% include tool-hero.liquid %}

    <main id="main-content" class="ct-wrap" data-ct>

        <!-- ============ setup ============ -->
        <div data-screen="setup">
            <div class="ct-panel">
                <h2>Where is your interview?</h2>
                <p>Four of the hundred questions depend on where you live. Pick your state or territory and the rest of this page adjusts.</p>

                <p class="ct-warn" data-ct-loaderr hidden></p>

                <div class="ct-field">
                    <label for="ct-place">State or territory</label>
                    <select id="ct-place" data-ct-place>
                        <option value="">Choose...</option>
                    </select>
                </div>
                <p class="ct-placenote" data-ct-placenote hidden></p>
            </div>

            <div class="ct-panel">
                <h2>Your own answers</h2>
                <p>
                    Nine answers are not fixed. Four depend on where you live and five change with
                    elections and appointments. <strong>USCIS does not print these answers either</strong>,
                    it tells applicants to check its own updates page before the interview. So type
                    yours in once and this will test you on them.
                </p>
                <div data-ct-mine></div>
                <p class="ct-ready" data-ct-ready></p>
            </div>

            <div class="ct-panel">
                <h2>Start</h2>
                <div class="ct-check">
                    <input type="checkbox" id="ct-senior" data-ct-senior />
                    <label for="ct-senior">
                        Use the 20 question set only. Applicants who are 65 or older and have been a
                        permanent resident for 20 or more years are tested from a smaller bank.
                    </label>
                </div>
                <button type="button" class="ct-btn" data-ct-start disabled>Start 10 questions</button>
                <p class="ct-note">
                    Questions you miss come back sooner. Nothing is uploaded, and clearing your
                    browser data will erase your progress.
                </p>
            </div>

            <div class="ct-panel">
                <h2>Your progress</h2>
                <div data-ct-stats></div>
                <button type="button" class="ct-btn ct-btn-ghost ct-btn-small" style="margin-top:1rem" data-ct-reset>Reset everything</button>
            </div>

            <div class="ct-panel">
                <h2>About these questions</h2>
                <p>
                    These are the official 100 questions and answers, taken word for word from the
                    USCIS document <em>Civics Questions and Answers (2008 version)</em>, rev. 08/21.
                    Nothing has been reworded.
                </p>
                <p>
                    <strong>This is the right test if you filed Form N-400 before 20 October 2025.</strong>
                    Applications filed on or after that date use the 2025 test instead, which has 128
                    questions and a different pass mark.
                </p>
                <p class="ct-note">
                    A study aid, not affiliated with USCIS and not legal advice. Check
                    <a href="https://www.uscis.gov/citizenship/testupdates" target="_blank" rel="noopener">uscis.gov/citizenship/testupdates<span class="sr-only"> (opens in a new tab)</span></a>
                    for current office holders before your interview.
                </p>
            </div>
        </div>

        <!-- ============ quiz ============ -->
        <div data-screen="quiz" hidden>
            <div class="ct-panel">
                <div class="ct-qhead">
                    <span class="ct-count" data-ct-count></span>
                    <span class="ct-official" data-ct-num></span>
                </div>
                <div class="ct-track"><span data-ct-bar style="width:0%"></span></div>

                <p class="ct-q" data-ct-q></p>

                <div class="ct-answer" data-ct-answer hidden></div>

                <div class="ct-actions">
                    <button type="button" class="ct-btn" data-ct-reveal>Show the answer</button>
                    <div data-ct-mark hidden style="display:contents">
                        <p class="ct-marklead">Did you get it right, out loud, before looking?</p>
                        <button type="button" class="ct-btn ct-btn-right" data-ct-right>Yes, I knew it</button>
                        <button type="button" class="ct-btn ct-btn-wrong" data-ct-wrong>No, I did not</button>
                    </div>
                    <button type="button" class="ct-btn ct-btn-ghost ct-btn-small" data-ct-quit>Quit</button>
                </div>
            </div>
        </div>

        <!-- ============ results ============ -->
        <div data-screen="results" hidden>
            <div class="ct-panel">
                <h2>How you did</h2>
                <div class="ct-score">
                    <span class="ct-score-num" data-ct-score></span>
                    <span class="ct-pass" data-ct-pass></span>
                </div>
                <p class="ct-passnote" data-ct-passnote></p>

                <p class="ct-warn" data-ct-savewarn hidden>Progress could not be saved. In private browsing this set will not be remembered.</p>

                <div class="ct-actions">
                    <button type="button" class="ct-btn" data-ct-again>Another 10</button>
                    <button type="button" class="ct-btn ct-btn-ghost ct-btn-small" data-ct-home>Back to start</button>
                </div>
            </div>

            <div class="ct-panel" data-ct-missedwrap hidden>
                <h2>What to go over</h2>
                <ul class="ct-missed" data-ct-missed></ul>
            </div>

            <div class="ct-panel">
                <h2>Your progress</h2>
                <div data-ct-stats></div>
            </div>
        </div>

    </main>

    {% include modals.liquid %}
    {% include footer.liquid %}

    {% pageJs "citizenship-test" %}
</body>
</html>
