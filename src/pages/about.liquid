          href="https://discord.com/invite/J6EeMvSBYg"
          target="_blank"
          rel="noopener noreferrer"
          title="Join the Coffee & Fun Discord"
        >
          Join the Discord
        </a>
      </div>

      <!-- Sketch: three dots bottom-right -->
      <div class="sketch-note" style="bottom: 18%; right: 10%;">
          <svg aria-hidden="true" width="24" height="8" viewBox="0 0 24 8">
              <circle cx="4" cy="4" r="2.5" class="sketch-dots"/>
              <circle cx="12" cy="4" r="2.5" class="sketch-dots"/>
              <circle cx="20" cy="4" r="2.5" class="sketch-dots"/>
          </svg>
      </div>

      <!-- Sketch: floating star bottom-left -->
      <div class="sketch-note sketch-float-slow" style="bottom: 20%; left: 8%; --sketch-rotate: -15deg;">
          <svg aria-hidden="true" width="22" height="22" viewBox="0 0 30 30">
              <path d="M15 2 L17 11 L26 11 L19 17 L22 26 L15 21 L8 26 L11 17 L4 11 L13 11 Z" fill="none" stroke="#a36942" stroke-width="1.5" stroke-linejoin="round" opacity="0.3"/>
          </svg>
