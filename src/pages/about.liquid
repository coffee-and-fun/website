      </p>
      <div class="relative flex flex-wrap justify-center gap-3">
        <!-- Sketch: "come say hi!" with arrow pointing down at the buttons -->
        <div class="sketch-note text-lg sm:text-xl" style="bottom: 52px; left: 19%; transform: rotate(-6deg);">
          come say hi!
          <svg aria-hidden="true" width="50" height="42" style="bottom: -36px; right: -32px;">
              <path d="M6 4 C18 16, 32 26, 44 36" class="sketch-arrow-coral"/>
              <path d="M33 34 L46 38 L42 25" class="sketch-arrow-coral"/>
          </svg>
        </div>
        <a
          class="btn btn-lg rounded-lg px-8 sm:px-10 font-semibold text-white border-0 bg-caramel hover:bg-espresso shadow-[0_10px_15px_-3px_rgba(122,78,49,0.35)] hover:shadow-xl hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-espresso focus-visible:ring-offset-2 transition-all duration-200"
