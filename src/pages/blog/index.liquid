<!DOCTYPE html>
<html class="brand-color-background scroll-smooth antialiased" lang="en" data-theme="light" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- Primary Meta Tags -->
    <title>Coffee & Fun Blog - Research, Announcements, and Guides</title>
    <meta name="title" content="Coffee & Fun Blog - Research, Announcements, and Guides" />
    <meta name="description" content="The Coffee & Fun blog: build notes, product guides, research deep dives, and honest reviews from a tiny studio making accessible apps and free web tools." />
    <meta name="keywords" content="Coffee & Fun blog, product updates, app guides, announcements, research, digital experiences, software development" />
    <meta name="author" content="Coffee & Fun LLC" />
    <meta name="robots" content="index, follow" />
    <meta name="rating" content="safe for kids" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href="https://www.coffeeandfun.com/blog/" />
    
    <!-- Favicon -->
    <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />
    <link rel="apple-touch-icon" href="/assets/images/social/192.png" />
    <link rel="icon" href="/assets/images/social/192.png" sizes="192x192" type="image/png" />
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coffee & Fun" />
    <meta property="og:title" content="Coffee & Fun Blog - Research, Announcements, and Guides" />
    <meta property="og:description" content="The Coffee & Fun blog: build notes, product guides, research deep dives, and honest reviews from a tiny studio making accessible apps and free web tools." />
    <meta property="og:url" content="https://www.coffeeandfun.com/blog/" />
    <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/blog.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Coffee & Fun Blog - Latest Updates and Guides" />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bycoffeeandfun" />
    <meta name="twitter:creator" content="@bycoffeeandfun" />
    <meta name="twitter:title" content="Coffee & Fun Blog - Research, Announcements, and Guides" />
    <meta name="twitter:description" content="Discover the latest updates, product guides, research insights, and announcements from Coffee & Fun LLC." />
    <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/blog.png" />
    <meta name="twitter:image:alt" content="Coffee & Fun Blog - Latest Updates and Guides" />
    <meta name="twitter:domain" content="coffeeandfun.com" />
    <meta name="twitter:url" content="https://www.coffeeandfun.com/blog/" />
    
    <!-- PWA Meta Tags -->
    <link rel="manifest" href="/assets/images/social/site.webmanifest" />
    <meta name="theme-color" content="#fef5ec" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Coffee & Fun Blog" />
    
    <!-- Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Blog",
        "@id": "https://www.coffeeandfun.com/blog/",
        "name": "Coffee & Fun Blog",
        "description": "Official blog featuring research, announcements, guides, and updates from Coffee & Fun LLC",
        "url": "https://www.coffeeandfun.com/blog/",
        "image": "https://www.coffeeandfun.com/assets/images/social/pages/blog.png",
        "publisher": {
          "@id": "https://www.coffeeandfun.com/#organization"
        },
        "mainEntity": {
          "@type": "ItemList",
          "numberOfItems": {{ blog.posts.size }},
          "itemListElement": [{% for post in blog.posts %}{"@type":"ListItem","position":{{ forloop.index }},"name":{{ post.name | strip | json }},"url":"https://www.coffeeandfun.com{{ post.link }}"}{% unless forloop.last %},{% endunless %}{% endfor %}]
        },
        "isPartOf": {
          "@id": "https://www.coffeeandfun.com/#website"
        }
      }
    </script>
    
    {% include schema-org.liquid %}

    {% bundledCss %}
    {% pageCss "product" %}

    {% pageCss "blog" %}
    
    
    {% include scripts.html %}
</head>

<body class="cf-blog-page">
{% include header.liquid %}
<main tabindex="-1" id="main-content">
  <section class="bl-hero" aria-labelledby="blog-title">
    <div class="bl-wrap bl-intro">
      <div class="bl-doodles" aria-hidden="true">
        <span class="bl-doodle-book">{% include journal-mark.liquid, drawing: 'book' %}</span>
        <svg class="bl-doodle-glasses" viewBox="0 0 130 85" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M17 44L14 21L29 16M104 42L110 18L123 19M23 42C7 45 11 69 29 69C49 69 49 39 29 40ZM81 40C64 44 68 68 88 67C107 66 107 37 88 39ZM45 47Q57 37 70 47M38 10L42 20M54 5L54 17"/></svg>
        <svg class="bl-doodle-star" viewBox="0 0 85 85" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M33 9L39 32L60 37L40 45L33 67L26 45L5 39L26 32ZM67 60L70 80M61 70L79 69"/></svg>
        <span class="bl-doodle-pencil">{% include journal-mark.liquid, drawing: 'pencil' %}</span>
        <span class="bl-note">one more page…</span>
      </div>
      <h1 id="blog-title">Our Blog</h1>
      <p>Research, guides, and the occasional rabbit hole.</p>
    </div>
    <div class="bl-controls bl-wrap" role="search" aria-label="Search the blog">
      <label class="bl-search" for="blogSearchInput"><span class="bl-sr-only">Search blog posts</span><span class="bl-search-field"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="6.5"/><path d="M15 15L21 21"/></svg><input id="blogSearchInput" type="search" placeholder="Search stories…" autocomplete="off"></span></label>
      <div class="bl-filter-area"><div class="bl-filters" id="filterTabs" role="group" aria-label="Filter stories by topic"><button class="filter-tab active" type="button" data-filter="all" aria-pressed="true">All</button><button class="filter-tab" type="button" data-filter="guide" aria-pressed="false">Guides</button><button class="filter-tab" type="button" data-filter="hack" aria-pressed="false">Research</button><button class="filter-tab" type="button" data-filter="update" aria-pressed="false">Updates</button><button class="filter-tab" type="button" data-filter="company" aria-pressed="false">News</button><button class="filter-tab" type="button" data-filter="web" aria-pressed="false">Web</button></div><span class="bl-filter-note" aria-hidden="true">follow your curiosity<svg viewBox="0 0 65 35" fill="none"><path d="M58 5Q28 6 7 25M13 12L6 26L24 27"/></svg></span></div>
      <div class="bl-results-line"><p id="blogStatus" class="bl-sr-only" role="status" aria-live="polite">{{ blog.posts.size }} stories to explore.</p><button type="button" id="clearBlog" hidden>Clear search &amp; filters</button></div>
    </div>
  </section>
  {% include section-wave.liquid, waveFrom: '#fef5ec', waveTo: '#fffaf5' %}
  <section class="bl-stories bl-wrap" aria-labelledby="stories-heading">
    <div class="bl-section-heading"><div><h2 id="stories-heading">From our notebook</h2><p>Things we’ve built, tried, and figured out.</p></div><span aria-hidden="true">a little light reading<svg viewBox="0 0 75 40" fill="none"><path d="M6 6C36 0 67 7 60 31M49 23L60 34L70 23"/></svg></span></div>
    <div class="bl-grid" id="blogGrid">{% for post in blog.posts %}{% include blog-card.liquid %}{% endfor %}</div>
    <div class="bl-empty" id="noResults" hidden><span aria-hidden="true">{% include journal-mark.liquid, drawing: 'book' %}</span><h3>No stories found just yet.</h3><p>Try another word or clear the filters above.</p></div>
    <div class="bl-pagination" id="blogPagination" hidden><p id="blogProgress"></p><button type="button" id="loadMoreStories" aria-controls="blogGrid">Load more stories <span aria-hidden="true">+</span></button></div>
  </section>
  {% include section-wave.liquid, waveFrom: '#fffaf5', waveTo: '#f6ebe1' %}
  <section class="bl-more" aria-label="Keep exploring"><div class="bl-wrap bl-more-grid">
    <a href="/resources/" class="bl-more-card"><div><span class="bl-hand">stay a little longer</span><h2>The reading room</h2><p>Guides, experiments, and a podcast on the way.</p></div><span aria-hidden="true">{% include journal-mark.liquid, drawing: 'headphones' %}</span></a>
    <a href="/apps/" class="bl-more-card"><div><span class="bl-hand">made for your everyday</span><h2>Apps &amp; free tools</h2><p>Put a little curiosity to work.</p></div><span aria-hidden="true">{% include journal-mark.liquid, drawing: 'laptop' %}</span></a>
  </div></section>
  {% include section-wave.liquid, waveFrom: '#f6ebe1', waveTo: '#fffaf5' %}
</main>
{% include footer.liquid %}
{% pageJs "blog" %}
</body>
</html>
