<!DOCTYPE html>
<html class="brand-color-background scroll-smooth antialiased" lang="en" data-theme="light" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- Primary Meta Tags -->
    <title>Coffee & Fun LLC - Crafting Software, One Brew at a Time</title>
    <meta name="title" content="Coffee & Fun LLC - Crafting Software, One Brew at a Time" />
    <meta name="description" content="Coffee & Fun is an independent software company making apps, free tools and useful hacks, with practical guides, research notes and a podcast coming soon." />
    <meta name="keywords" content="Coffee & Fun LLC, software development, browser extensions, accessibility apps, Incognito Bear, Robert James Gabriel, user experience, digital innovation" />
    <meta name="author" content="Coffee & Fun LLC" />
    <meta name="robots" content="index, follow" />
    <meta name="rating" content="safe for kids" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href="https://www.coffeeandfun.com/" />
    
    <!-- Favicon -->
    <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />
    <link rel="apple-touch-icon" href="/assets/images/social/192.png" />
    <link rel="icon" href="/assets/images/social/192.png" sizes="192x192" type="image/png" />
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coffee & Fun" />
    <meta property="og:title" content="Coffee & Fun LLC - Crafting Software, One Brew at a Time" />
    <meta property="og:description" content="Coffee & Fun is an independent software company making apps, free tools and useful hacks, with practical guides, research notes and a podcast coming soon." />
    <meta property="og:url" content="https://www.coffeeandfun.com/" />
    <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/home.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A tipping red coffee cup above the Coffee & Fun logo and the slogan Crafting Software, One Brew at a Time." />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bycoffeeandfun" />
    <meta name="twitter:creator" content="@bycoffeeandfun" />
    <meta name="twitter:title" content="Coffee & Fun LLC - Crafting Software, One Brew at a Time" />
    <meta name="twitter:description" content="Coffee & Fun is an independent software company making apps, free tools and useful hacks, with practical guides, research notes and a podcast coming soon." />
    <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/home.png" />
    <meta name="twitter:image:alt" content="A tipping red coffee cup above the Coffee & Fun logo and the slogan Crafting Software, One Brew at a Time." />
    <meta name="twitter:domain" content="coffeeandfun.com" />
    <meta name="twitter:url" content="https://www.coffeeandfun.com/" />
    
    <!-- PWA Meta Tags -->
    <link rel="manifest" href="/assets/images/social/site.webmanifest" />
    <meta name="theme-color" content="#fef5ec" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Coffee & Fun" />
    
    <!-- Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebPage",
            "@id": "https://www.coffeeandfun.com/#webpage",
            "url": "https://www.coffeeandfun.com/",
            "name": "Coffee & Fun LLC",
            "description": "Apps, free tools, practical guides and research notes from independent software company Coffee & Fun LLC.",
            "isPartOf": {
              "@id": "https://www.coffeeandfun.com/#website"
            },
            "about": {
              "@id": "https://www.coffeeandfun.com/#organization"
            },
            "publisher": {
              "@id": "https://www.coffeeandfun.com/#organization"
            }
          }
        ]
      }
    </script>
    
    {% include schema-org.liquid %}

    {% bundledCss %}
    {% pageCss "home" %}
    <link rel="preload" href="/assets/fonts/Pacifico-Regular.woff2" as="font" type="font/woff2" crossorigin>
    
    
    {% include scripts.html %}


</head>

<body class="cf-home-page">
{% include header.liquid %}
<main id="main-content" tabindex="-1">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-wrap home-hero-inner">
      {% include journal-doodles.liquid, journalStyle: "home" %}
      {% include journal-extras.liquid, journalExtra: "hero" %}
      <span class="home-margin-note" aria-hidden="true">we do love coffee!<svg viewBox="0 0 100 64" fill="none"><path d="M88 5C77 33 45 46 12 50M20 36L10 51L28 56" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      <a class="home-announcement" href="{{ announcement.url }}">{{ announcement.text }} <span aria-hidden="true">↗</span></a>
      <h1 id="home-title"><span>Crafting Software,</span><span>One Brew at a Time</span></h1>
      <p class="home-intro">We make apps, browser extensions, and free web tools that make everyday life a little easier.<br>Built with care, curiosity, and a little fun.</p>
      <div class="home-actions"><a class="home-button" href="/apps/">Explore apps <span aria-hidden="true">↗</span></a><a class="home-button home-button-outline" href="/resources/">Read &amp; explore <span aria-hidden="true">↗</span></a></div>
      <p class="home-handwritten">Made with care. And quite a lot of coffee.</p>
      <svg class="home-doodle home-doodle-cup" viewBox="0 0 70 85" fill="none" aria-hidden="true"><path d="M10 30H49V57C49 77 10 77 10 57V30ZM49 37H56C71 37 71 57 49 57M5 78H57M20 19C10 8 28 7 21 0M37 19C28 9 44 7 37 0" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <svg class="home-doodle home-doodle-star" viewBox="0 0 70 70" fill="none" aria-hidden="true"><path d="M34 3L40 25L64 22L46 38L57 60L35 49L15 65L22 40L3 27L28 25Z" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/></svg>
    </div>
  </section>
  {% include section-wave.liquid, waveFrom: "#fef5ec", waveTo: "#fffaf5" %}
  <section id="explore" class="home-collection home-wrap" aria-label="Explore Coffee and Fun">
    {% include journal-extras.liquid, journalExtra: "shelf" %}
    <p class="home-collection-note">Find your next favorite <svg viewBox="0 0 64 70" fill="none" aria-hidden="true" focusable="false"><path d="M12 6C34 2 50 18 39 30C29 40 17 34 24 25C34 14 56 40 41 61M30 51L41 62L54 51" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></p>
    <div class="home-bento">
      <a class="home-tile home-tile-apps" href="/apps/"><div class="home-tile-art"><img src="/assets/images/bento/bento-apps.png" alt="" width="1868" height="960" loading="lazy"></div><div class="home-tile-copy"><h2>Apps &amp; tools</h2><p>Useful things. A playful streak.</p></div></a>
      <a class="home-tile home-tile-reading" href="/resources/"><div class="home-tile-art"><img src="/assets/images/bento/bento-blog.png" alt="" width="1868" height="960" loading="lazy"></div><div class="home-tile-copy"><h2>Read &amp; explore</h2><p>Research, guides, and good rabbit holes.</p></div></a>
      <a class="home-tile home-tile-support" href="/support/"><div class="home-tile-art"><img src="/assets/images/bento/bento-support.png" alt="" width="1868" height="960" loading="lazy"></div><div class="home-tile-copy"><h2>A little help</h2><p>Real people, ready to lend a hand.</p></div></a>
      <a class="home-tile home-tile-story" href="/about/"><div class="home-tile-art"><img src="/assets/images/bento/bento-roadmap.png" alt="" width="1868" height="960" loading="lazy"></div><div class="home-tile-copy"><h2>Our story</h2><p>The people behind your next favorite app.</p></div></a>
    </div>
  </section>
  {% include section-wave.liquid, waveFrom: "#fffaf5", waveTo: "#f9e7d8" %}
  <section class="home-closing"><div class="home-wrap">{% include journal-doodles.liquid, journalStyle: "closing" %}<p class="home-handwritten">There’s always something brewing.</p><h2>A little curiosity<br><span>goes a long way.</span></h2><p>Our latest experiments, useful discoveries, and a podcast on the way.</p><a class="home-button" href="/blog/">From the workshop <span aria-hidden="true">↗</span></a></div></section>
</main>
{% include footer.liquid %}
</body></html>
