<!DOCTYPE html>
<html class="antialiased" lang="en" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary Meta Tags -->
    <title>Free Text Case Converter - Coffee & Fun LLC</title>
    <meta name="title" content="Free Text Case Converter - Coffee & Fun LLC" />
    <meta name="description" content="Paste your text and convert it to uppercase, lowercase, sentence case, Title Case, camelCase, snake_case, or kebab-case, free and right in your browser." />
    <meta name="author" content="Coffee & Fun LLC" />
    <meta name="robots" content="index, follow" />

    <!-- Canonical URL -->
    <link rel="canonical" href="https://www.coffeeandfun.com/text-converter/" />

    <!-- Favicon -->
    <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coffee & Fun" />
    <meta property="og:title" content="Free Text Case Converter - Coffee & Fun LLC" />
    <meta property="og:description" content="Paste your text and convert it to uppercase, lowercase, sentence case, Title Case, camelCase, snake_case, or kebab-case, free and right in your browser." />
    <meta property="og:url" content="https://www.coffeeandfun.com/text-converter/" />
    <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/text-converter.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Text Case Converter card listing uppercase, lowercase and Title Case styles" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bycoffeeandfun" />
    <meta name="twitter:title" content="Free Text Case Converter - Coffee & Fun LLC" />
    <meta name="twitter:description" content="Paste your text and convert it to uppercase, lowercase, sentence case, Title Case, camelCase, snake_case, or kebab-case, free and right in your browser." />
    <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/text-converter.png" />
    <meta name="twitter:image:alt" content="Text Case Converter card listing uppercase, lowercase and Title Case styles" />

    <meta name="theme-color" content="#f4f4f2" />

    <!-- Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "Free Text Case Converter",
        "description": "Convert text to uppercase, lowercase, sentence case, Title Case, alternating case, camelCase, snake_case, or kebab-case, with live results, text statistics, and tidy-up tools.",
        "url": "https://www.coffeeandfun.com/text-converter/",
        "applicationCategory": "UtilitiesApplication",
        "operatingSystem": "Web Browser",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "featureList": [
          "UPPERCASE and lowercase conversion",
          "Sentence case and Title Case",
          "camelCase, snake_case, and kebab-case",
          "aLtErNaTiNg case",
          "Live word, character, sentence, and line counts",
          "Tidy up spacing and line breaks",
          "Copy or download the result"
        ],
        "publisher": {
          "@id": "https://www.coffeeandfun.com/#organization"
        },
        "creator": {
          "@id": "https://www.coffeeandfun.com/#founder"
        },
        "isAccessibleForFree": true,
        "inLanguage": "en"
      }
    </script>

    <script src="https://unpkg.com/vue@3"></script>

    {% pageCss "text-converter" %}
    {% include sketch-styles.liquid %}
{% include schema-org.liquid %}

    </head>

<body>
{% raw %}
    <a href="#tool" class="skip">Skip to the tool</a>

    <main v-cloak id="app" class="wrap">

        <div class="topbar">
            <a href="/" class="home-link" aria-label="Back to coffeeandfun.com">
                <img src="/assets/images/brand/coffee-and-fun-logo-dark.png" alt="" width="40" height="40" decoding="async" />
                <span class="tip" aria-hidden="true">Back to coffeeandfun.com</span>
            </a>
        </div>

        <header id="tool">
            <h1>Change the case of any text</h1>
            <p class="lede">Type or paste your words, pick a style, and the result updates as you type, ready to copy. Nothing you write leaves your browser.</p>
        </header>

        <!-- Live status for screen readers -->
        <div class="sr-only" role="status" aria-live="polite">{{ announcement }}</div>

        <!-- ===== Step 1: input ===== -->
        <section class="step" aria-labelledby="h-text">
            <h2 class="step-label" id="h-text">1, Your text</h2>
            <label class="sr-only" for="tc-input">Your text</label>
            <textarea id="tc-input" ref="input" class="msg" v-model="inputText"
                      placeholder="Type or paste anything…"
                      aria-describedby="tc-stats" spellcheck="true"></textarea>
            <div class="io-row">
                <span class="counter" id="tc-stats">{{ statsLine }}</span>
                <span>
                    <button v-if="!inputText && !undoAvailable" type="button" class="linkish" @click="fillExample">Try an example</button>
                    <button v-else-if="undoAvailable" type="button" class="linkish" @click="undoClear">Undo clear</button>
                    <button v-else type="button" class="linkish" @click="clearText">Clear</button>
                </span>
            </div>
        </section>

        <!-- ===== Step 2: style ===== -->
        <section class="step" aria-labelledby="h-style">
            <fieldset class="cases">
                <legend><h2 class="step-label" id="h-style">2, Pick a style</h2></legend>
                <div class="chips">
                    <label class="chip" v-for="c in cases" :key="c.key" :class="{ on: caseChoice === c.key }">
                        <input type="radio" class="sr-only" name="case" :value="c.key" v-model="caseChoice"
                               :aria-describedby="c.desc ? 'desc-' + c.key : null" @change="announce(c.name + ' selected.')" />
                        <span class="chip-name">{{ c.name }}</span>
                        <span class="chip-eg" aria-hidden="true">{{ c.eg }}</span>
                        <span v-if="c.desc" :id="'desc-' + c.key" class="sr-only">{{ c.desc }}</span>
                    </label>
                </div>
            </fieldset>

            <fieldset class="tidy-set">
                <legend>Tidy up</legend>
                <div class="tidy-row">
                    <label class="tidy">
                        <input type="checkbox" v-model="tidySpaces" @change="announce(tidySpaces ? 'Removing extra spaces from the result.' : 'Keeping spaces as typed.')" />
                        Remove extra spaces
                    </label>
                    <label class="tidy">
                        <input type="checkbox" v-model="joinLines" @change="announce(joinLines ? 'Removing line breaks from the result. Paragraphs are kept.' : 'Keeping line breaks as typed.')" />
                        Remove line breaks <span style="color:var(--muted)">&nbsp;(keeps paragraphs)</span>
                    </label>
                </div>
            </fieldset>
        </section>

        <!-- ===== Step 3: result ===== -->
        <section class="step" aria-labelledby="h-result">
            <h2 class="step-label" id="h-result">3, Your result</h2>

            <template v-if="inputText">
                <label class="sr-only" for="tc-output">Your converted text</label>
                <textarea id="tc-output" ref="output" class="msg" readonly :value="result"></textarea>
            </template>
            <div v-else class="code-empty">Your converted text will appear here as you type.</div>

            <div class="result-actions">
                <button type="button" class="btn btn-primary" @click="copyResult" :disabled="!result">
                    {{ copied ? 'Copied ✓' : 'Copy result' }}
                </button>
                <button type="button" class="btn btn-secondary" @click="downloadResult" :disabled="!result">
                    Download .txt
                </button>
            </div>
            <p v-if="!inputText" class="copy-note">Type or paste some text above first.</p>
            <p v-else-if="!result" class="copy-note">Nothing to copy yet, this style keeps only letters and numbers, and there aren&rsquo;t any.</p>
            <p v-if="copyFailed" class="copy-note bad">Copy didn&rsquo;t work, the text is selected, press Ctrl+C or Cmd+C.</p>
        </section>

        <p class="foot">Everything happens in your browser, nothing you type leaves this page.</p>
    </main>
{% endraw %}

    {% include footer.liquid %}

    {% pageJs "text-converter" %}
</body>
</html>
