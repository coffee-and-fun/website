    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "Focus Timer",
        "description": "A free, ADHD-friendly Pomodoro focus timer. Tiny sprint presets, one task at a time, visible progress, finish-time display, gentle chimes, desktop notifications, colorblind-safe design.",
        "url": "https://www.coffeeandfun.com/focus-timer/",
        "applicationCategory": "ProductivityApplication",
        "operatingSystem": "Any (web browser)",
        "browserRequirements": "Requires JavaScript.",
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
        "featureList": [
            "Tiny sprint presets (10, 15, 25, 45 minutes) to make starting easier",
            "One-task line instead of a busy to-do list",
            "Progress bar and tab-title countdown, time made visible",
            "Shows the clock time your sprint will finish",
            "Gentle chime and optional desktop notifications",
            "Colorblind-safe, keyboard-friendly, respects reduced motion",
            "No account, no tracking, everything stays on your device"
        ],
        "publisher": {
            "@type": "Organization",
            "name": "Coffee & Fun LLC",
            "url": "https://www.coffeeandfun.com",
            "sameAs": ["https://x.com/bycoffeeandfun"]
        }
    }
    </script>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
            { "@type": "Question", "name": "What is the Pomodoro Technique?",
              "acceptedAnswer": { "@type": "Answer", "text": "A time-management method that breaks work into focused sprints, traditionally 25 minutes, with short breaks between them and a longer break after about four. The fixed, visible countdown makes it easier to start and easier to notice time passing." } },
            { "@type": "Question", "name": "Why does this timer help with ADHD?",
              "acceptedAnswer": { "@type": "Answer", "text": "Three reasons. Starting is the hard part, so the sprint presets go down to 10 minutes, small enough that starting feels easy. Time blindness makes minutes invisible, so a progress bar fills as you work, the tab title counts down, and the timer shows the actual clock time you'll finish. And decisions are distractions, so there's one task line, one big button, and nothing else fighting for your attention." } },
            { "@type": "Question", "name": "Can I change the sprint and break lengths?",
              "acceptedAnswer": { "@type": "Answer", "text": "Yes. Use the quick presets (10, 15, 25, or 45 minutes) or open Settings to set any focus, short-break, and long-break lengths, how many sprints make a round, and whether the next session starts automatically." } },
            { "@type": "Question", "name": "Is it colorblind friendly?",
              "acceptedAnswer": { "@type": "Answer", "text": "Yes. The three mode colors differ in warmth and lightness, not just hue, so they stay distinguishable across the common types of color vision deficiency, and color is never the only signal anyway: every mode also has an icon and a word, states are spelled out in plain language, and progress is shown by a filling bar and a countdown." } },
            { "@type": "Question", "name": "Is it free, and does it need an account?",
              "acceptedAnswer": { "@type": "Answer", "text": "Completely free, no account, no tracking. It runs entirely in your browser, and your settings and task are saved on your own device only." } }
        ]
    }
    </script>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.coffeeandfun.com/" },
            { "@type": "ListItem", "position": 2, "name": "Apps", "item": "https://www.coffeeandfun.com/apps/" },
            { "@type": "ListItem", "position": 3, "name": "Focus Timer", "item": "https://www.coffeeandfun.com/focus-timer/" }
        ]
    }
    </script>

    {% bundledCss %}

    {% pageCss "focus-timer" %}
</head>

<body>
    <a href="#timer" class="skip-link">Skip to the timer</a>

    <div class="app theme-focus" id="app-root">
        <div class="top-progress" id="top-progress" aria-hidden="true"></div>

        <header class="topbar">
            <a href="/" class="brand" aria-label="Focus Timer, back to coffeeandfun.com home">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 7v5l3 3"/></svg>
                <h1 class="brand-name">Focus Timer</h1>
            </a>
            <button type="button" class="topbar-btn" id="settings-btn" aria-haspopup="dialog">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                Settings
            </button>
        </header>

        <main id="timer" class="stage">
            <!-- Live region for discrete announcements only -->
            <p class="sr-only" role="status" aria-live="polite" id="announce"></p>

            <section class="panel" aria-label="Timer">

                <div class="digits" role="timer" aria-live="off" id="digits">25:00</div>
                <div class="bar-track" aria-hidden="true"><div class="bar-fill" id="bar-fill"></div></div>

                <button type="button" class="start-btn" id="start-btn">Start</button>

                <div class="mini-controls" role="group" aria-label="More controls">
                    <button type="button" class="mini-btn" id="reset-btn" aria-label="Reset the current timer">
                        <span aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg></span>
                        <span class="mini-label" aria-hidden="true">Reset</span>
                    </button>
                    <button type="button" class="mini-btn" id="skip-btn" aria-label="Skip to the next session">
                        <span aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4l10 8-10 8z"/><path d="M19 5v14"/></svg></span>
                        <span class="mini-label" aria-hidden="true">Skip</span>
                    </button>
                    <button type="button" class="mini-btn" id="sound-btn" aria-pressed="true">
                        <span aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg></span>
                        <span class="mini-label" id="sound-label">Chime on</span>
                    </button>
                </div>
            </section>

            <div class="session">
                <p class="count" id="sprint-count">#1</p>
                <p class="msg" id="session-msg">Time to focus!</p>
                <p class="sub" id="session-sub">Press start when you&rsquo;re ready</p>
                <p class="cadence" id="beans-caption">Long break after 4 sprints</p>
            </div>

            <div id="presets-block">
                <p class="presets-title" id="presets-title">How long can you focus right now?</p>
                <div class="presets" role="group" aria-labelledby="presets-title">
                    <button type="button" class="preset-btn" data-mins="10" aria-label="Set focus length to 10 minutes" aria-pressed="false"><span class="mins">10 min</span><span class="word" aria-hidden="true">tiny</span></button>
                    <button type="button" class="preset-btn" data-mins="15" aria-label="Set focus length to 15 minutes" aria-pressed="false"><span class="mins">15 min</span><span class="word" aria-hidden="true">short</span></button>
                    <button type="button" class="preset-btn" data-mins="25" aria-label="Set focus length to 25 minutes" aria-pressed="true"><span class="mins">25 min</span><span class="word" aria-hidden="true">classic</span></button>
                    <button type="button" class="preset-btn" data-mins="45" aria-label="Set focus length to 45 minutes" aria-pressed="false"><span class="mins">45 min</span><span class="word" aria-hidden="true">deep</span></button>
                </div>
                <p class="presets-hint">If starting feels hard, start tiny.</p>
            </div>

            <div class="task-block" id="one-thing">
                <div class="task-head">
                    <h2 id="task-heading">Task</h2>
                </div>
                <div class="task-box">
                    <label class="sr-only" for="intention">What are you working on?</label>
                    <input id="intention" type="text" maxlength="120" autocomplete="off" spellcheck="false"
                        placeholder="What are you working on?" />
                    <button type="button" class="clear-intention" id="clear-intention" aria-label="Clear your task">&#10005;</button>
                </div>
            </div>

            <p class="kbd-hint"><span aria-hidden="true"><kbd>Space</kbd> start / pause &middot; <kbd>R</kbd> reset &middot; <kbd>S</kbd> skip</span><span class="sr-only">Keyboard shortcuts: Space starts or pauses, R resets, S skips to the next session. You can turn them off in Settings.</span></p>
        </main>
    </div>

    <!-- ===== Crawlable supporting content ===== -->
    <div class="content">
        <div class="content-inner">
            <section aria-labelledby="h-see">
                <h2 id="h-see">Time you can see</h2>
                <p>If your brain doesn&rsquo;t <em>feel</em> minutes passing, a very ADHD thing called <strong>time blindness</strong>, a countdown is just a number that surprises you later. So this timer shows time three ways at once:</p>
                <ul class="plain">
                    <li><strong>A bar that fills</strong> across the top as your sprint runs.</li>
                    <li><strong>A tab title that counts down</strong>, so you can see it from any other tab.</li>
                    <li><strong>The clock time you&rsquo;ll finish</strong>, &ldquo;done around 3:42&rdquo;. &ldquo;25 minutes&rdquo; is abstract; &ldquo;3:42&rdquo; is something you can hold onto.</li>
                </ul>
            </section>

            <section aria-labelledby="h-how">
                <h2 id="h-how">How it works</h2>
                <div class="step-grid">
                    <div class="how-step"><div class="n" aria-hidden="true">1</div><h3>Name one task</h3><p>Type a single task under the timer. Not a list, one thing. That&rsquo;s the whole plan.</p></div>
                    <div class="how-step"><div class="n" aria-hidden="true">2</div><h3>Pick a length</h3><p>10, 15, 25, or 45 minutes. If starting feels impossible, choose tiny. Ten focused minutes beats zero perfect ones.</p></div>
                    <div class="how-step"><div class="n" aria-hidden="true">3</div><h3>Focus, then rest</h3><p>Work until the chime, then take a real break, stand up, stretch, look out a window. Then go again.</p></div>
                </div>
            </section>

            <section aria-labelledby="h-brains">
                <h2 id="h-brains">Made for ADHD brains (and every other kind)</h2>
                <p>Every choice here is deliberate:</p>
                <ul class="plain">
                    <li><strong>Starting is the hard part</strong>, so the presets go down to 10 minutes and the start button is the biggest thing on the page.</li>
                    <li><strong>Decisions are distractions</strong>, so there&rsquo;s one task line and one button, not a project manager.</li>
                    <li><strong>Nothing relies on color alone.</strong> Each mode has its own background color, picked to stay distinct in every common type of color vision, and it always comes with an icon and a word, with states written out in plain language.</li>
                    <li><strong>Motion is optional.</strong> If your system asks for reduced motion, transitions stop and everything holds still.</li>
                    <li><strong>Keyboard first.</strong> Space starts and pauses, R resets, S skips, and you can turn the shortcuts off in Settings.</li>
                    <li><strong>Private by default.</strong> No account, no tracking, your settings and task live in your browser and nowhere else.</li>
                </ul>
            </section>

            <aside class="hb-banner" aria-labelledby="hb-title">
                <div class="hb-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                </div>
                <div class="hb-text">
                    <p class="hb-kicker">From the same team</p>
                    <h2 id="hb-title">Struggle to read the web? Try Helperbird.</h2>
                    <p>Dyslexia-friendly fonts, read-aloud, colour overlays, a reading ruler and more, a browser extension that reshapes any page to suit how you read.</p>
                </div>
                <a class="hb-cta" href="https://www.helperbird.com/?utm_source=coffeeandfun&amp;utm_medium=referral&amp;utm_campaign=focus-timer" target="_blank" rel="noopener">
                    Check out Helperbird<span class="sr-only"> (opens in a new tab)</span>
                </a>
            </aside>

            <section aria-labelledby="h-faq">
                <h2 id="h-faq">Questions, answered</h2>
                <div class="faq">
                    <details>
                        <summary>What is the Pomodoro Technique?</summary>
                        <p>A time-management method that breaks work into focused sprints, traditionally 25 minutes, with short breaks between them and a longer break after about four. The fixed, visible countdown makes it easier to start and easier to notice time passing.</p>
                    </details>
                    <details>
                        <summary>Why does this timer help with ADHD?</summary>
                        <p>Three reasons. Starting is the hard part, so the sprint presets go down to 10 minutes, small enough that starting feels easy. Time blindness makes minutes invisible, so a progress bar fills as you work, the tab title counts down, and the timer shows the actual clock time you&rsquo;ll finish. And decisions are distractions, so there&rsquo;s one task line, one big button, and nothing else fighting for your attention.</p>
                    </details>
                    <details>
                        <summary>Can I change the sprint and break lengths?</summary>
                        <p>Yes. Use the quick presets (10, 15, 25, or 45 minutes) or open Settings to set any focus, short-break, and long-break lengths, how many sprints make a round, and whether the next session starts automatically.</p>
                    </details>
                    <details>
                        <summary>Is it colorblind friendly?</summary>
                        <p>Yes. The three mode colors differ in warmth and lightness, not just hue, so they stay distinguishable across the common types of color vision deficiency, and color is never the only signal anyway: every mode also has an icon and a word, states are spelled out in plain language, and progress is shown by a filling bar and a countdown.</p>
                    </details>
                    <details>
                        <summary>Is it free, and does it need an account?</summary>
                        <p>Completely free, no account, no tracking. It runs entirely in your browser, and your settings and task are saved on your own device only.</p>
                    </details>
                </div>
            </section>

            <section aria-labelledby="h-related">
                <h2 id="h-related">Pairs well with</h2>
                <div class="related-grid">
                    <a class="related-card" href="/procrastinot/">
                        <h3>ProcrastiNOT</h3>
                        <p>Blocks the sites that eat your sprints. You have to solve math to turn it off, future you says thanks.</p>
                    </a>
                    <a class="related-card" href="/word-clock/">
                        <h3>Word Clock</h3>
                        <p>The time, written out in words. A calmer way to check the clock between sprints.</p>
                    </a>
                    <a class="related-card" href="/flip/">
                        <h3>Flip a Coin</h3>
                        <p>Can&rsquo;t decide which task goes first? Let the coin pick so you can get started.</p>
                    </a>
                </div>
            </section>
        </div>
    </div>

    <p class="foot-note">Free &amp; private, a web app by <a href="https://www.coffeeandfun.com/">Coffee &amp; Fun</a>.</p>

    <!-- Settings dialog -->
    <dialog class="settings" id="settings-dialog" aria-labelledby="settings-title">
        <form method="dialog" class="settings-inner">
            <h2 id="settings-title">Timer settings</h2>
            <div class="settings-grid">
                <label>Focus (minutes)
                    <input type="number" id="set-focus" min="1" max="90" inputmode="numeric" /></label>
                <label>Short break (minutes)
                    <input type="number" id="set-short" min="1" max="30" inputmode="numeric" /></label>
                <label>Long break (minutes)
                    <input type="number" id="set-long" min="1" max="60" inputmode="numeric" /></label>
                <label>Sprints per long break
                    <input type="number" id="set-every" min="2" max="8" inputmode="numeric" /></label>
            </div>
            <div class="settings-toggles">
                <label><input type="checkbox" id="set-auto-breaks" /> Start breaks automatically</label>
                <label><input type="checkbox" id="set-auto-focus" /> Start the next focus automatically</label>
                <label><input type="checkbox" id="set-notify" /> Desktop notifications</label>
                <label><input type="checkbox" id="set-keys" /> Keyboard shortcuts (Space, R, S)</label>
            </div>
            <p class="notify-blocked" id="notify-blocked" role="alert" hidden>Notifications are blocked for this site, you can allow them from the address bar. The chime still works.</p>
            <div class="settings-actions">
                <button type="submit" class="btn-done">Done</button>
            </div>
        </form>
    </dialog>

    {% pageJs "focus-timer" %}
</body>
</html>
