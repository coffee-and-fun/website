										</div>
										<div v-if="receipt.returnPolicy">
											<strong>Returns</strong>
											<p class="preserve-lines">{{ receipt.returnPolicy }}</p>
										</div>
										<p v-if="receipt.template === 'classic'" class="preserve-lines thank-you">
											{{ receipt.footerNote || 'Thank you for your business!' }}
										</p>
									</div>
									<div v-if="!isInvoice" class="document-barcode">
										<p v-if="receipt.template !== 'retail'">
											{{
												receipt.template === 'compact'
													? '# ITEMS SOLD ' + itemCount
													: itemCount + (itemCount === 1 ? ' item' : ' items')
											}}
										</p>
										<p v-if="receipt.template === 'compact'" class="compact-tc">
											TC# {{ barcodeText }}
										</p>
										<svg
											:viewBox="'0 0 ' + barcode.width + ' 45'"
											preserveAspectRatio="none"
											aria-hidden="true"
										>
											<rect
												v-for="(bar, index) in barcode.bars"
												:key="index"
												:x="bar.x"
												y="0"
												:width="bar.width"
												height="45"
												fill="currentColor"
											/>
										</svg>
										<p v-if="receipt.template === 'classic'" class="barcode-text">
											{{ barcodeText }}
										</p>
									</div>
									<p
										v-if="receipt.template === 'retail' || receipt.template === 'compact'"
										class="preserve-lines thank-you after-barcode"
									>
										{{ receipt.footerNote || 'Thank you for your business!' }}
									</p>
									<div v-if="receipt.template === 'compact'" class="compact-bottom">
										<svg
											class="compact-qr"
											:viewBox="'0 0 ' + qr.size + ' ' + qr.size"
											aria-hidden="true"
											shape-rendering="crispEdges"
										>
											<rect
												v-for="(cell, index) in qr.cells"
												:key="index"
												:x="cell.x"
												:y="cell.y"
												width="1"
												height="1"
												fill="currentColor"
											/>
										</svg>
									</div>
									<p class="document-footnote">
										{{
											isInvoice
												? receipt.receiptNumber +
													' · ' +
													money(totals.balance) +
													(receipt.dueDate ? ' due ' + displayDate(receipt.dueDate) : ' amount due')
												: 'Created for bookkeeping'
										}}
									</p>
								</article>
							</div>
							<div class="export-panel">
								<div class="export-total">
									<span
										>Document total <small>{{ receipt.currency }}</small></span
									><strong>{{ money(totals.total) }}</strong>
								</div>
								<button
									type="button"
									class="button primary-button"
									@click="generatePDF"
									:disabled="busy || logoBusy"
									:aria-busy="busy"
									aria-describedby="export-purpose"
								>
									<svg
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.8"
										aria-hidden="true"
									>
										<path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5" /></svg
									>{{ busy ? 'Preparing document…' : 'Download PDF' }}</button
								><button
									type="button"
									class="button print-button"
									@click="printReceipt"
									:disabled="busy || logoBusy"
								>
									Print document
								</button>
								<p class="export-hint">
									{{
										isInvoice
											? 'A4 PDF · ready to send or print'
											: '80 mm PDF · ready for a receipt printer'
									}}
									<br><span id="export-purpose">For bookkeeping only.</span>
								</p>
								<p v-if="exportError" role="alert" class="field-error">{{ exportError }}</p>
							</div>
							<p class="preview-note">Your selected style is used for the PDF and printout.</p>
						</div>
					</aside>
				</div>
				<div class="mobile-actions">
					<button
						type="button"
						class="mobile-preview"
						@click="setMobileView(mobileView === 'edit' ? 'preview' : 'edit')"
						:aria-controls="mobileView === 'edit' ? 'preview' : 'receipt-form'"
					>
						{{ mobileView === 'edit' ? 'Preview' : 'Edit receipt' }}
						<span>{{ money(totals.total) }}</span></button
					><button
						type="button"
						class="button primary-button"
						@click="generatePDF"
						:disabled="busy || logoBusy"
					>
						<span>{{ busy ? 'Preparing…' : 'Download PDF' }}</span>
						<small>For bookkeeping only.</small>
					</button>
				</div>
				<div class="toast-region" role="status" aria-live="polite" aria-atomic="true">
					<p v-if="toast" class="toast-message"><span aria-hidden="true">✓</span>{{ toast }}</p>
				</div>
				<p class="sr-only" role="status">{{ totalAnnouncement }}</p>
			</div>
			{% endraw %}
			<details class="tool-guide">
				<summary>Need a hand? <span>How it works &amp; common questions</span></summary>
				<div class="guide-content">
					<div>
						<h2>A receipt in three steps</h2>
						<ol>
							<li>Add your business name and items.</li>
							<li>Choose a style. Add any optional details.</li>
							<li>Download your PDF or print.</li>
						</ol>
						<p>
							Classic, Retail, and Compact use 80mm paper. Invoice uses A4 and includes customer details.
						</p>
					</div>
					<div class="faq">
						<h2>Good to know</h2>
						<details>
							<summary>Is it free?</summary>
							<p>Yes. Every template and PDF download is free. No account needed.</p>
						</details>
						<details>
							<summary>Where is my information saved?</summary>
							<p>
								Your draft stays in this browser on this device. Receipt data and logos are not uploaded.
								Use “Clear saved data” to remove it.
							</p>
						</details>
						<details>
							<summary>Can I change styles later?</summary>
							<p>
								Yes. Your own details stay in place when you switch. Retail and Compact include editable
								sample store details to get you started.
							</p>
						</details>
						<details>
							<summary>How do tax and discounts work?</summary>
							<p>
								Discounts apply before tax. Line totals, discounts, and tax round to the currency’s
								smallest unit so the amounts add up. Free items and quantities with up to three decimal
								places are supported.
							</p>
						</details>
					</div>
				</div>
			</details>

		</main>

	{% include footer.liquid %}
</body>
</html>
