<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Free Receipt &amp; Invoice Generator | PDF Templates | Coffee &amp; Fun</title>
		<meta
			name="description"
			content="Create and download receipts or invoices for free. Choose four templates, add your logo, calculate tax and discounts, and export an 80mm receipt or A4 PDF."
		/>
		<link rel="canonical" href="https://www.coffeeandfun.com/receipt-generator/" />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#f7f5ff" />
		<link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Coffee &amp; Fun" />
		<meta property="og:title" content="Free Receipt &amp; Invoice Generator" />
		<meta
			property="og:description"
			content="Your details. Four layouts. Ready to download. Create receipts and invoices with free PDF templates, tax calculations, and local draft saving."
		/>
		<meta property="og:url" content="https://www.coffeeandfun.com/receipt-generator/" />
		<meta
			property="og:image"
			content="https://www.coffeeandfun.com/assets/images/social/pages/receipt-generator.png"
		/>
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Free receipt generator by Coffee &amp; Fun" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Free Receipt &amp; Invoice Generator" />
		<meta
			name="twitter:description"
			content="Four receipt and invoice layouts. Free PDF downloads. No account needed."
		/>
		<meta
			name="twitter:image"
			content="https://www.coffeeandfun.com/assets/images/social/pages/receipt-generator.png"
		/>
		<meta name="twitter:image:alt" content="Free receipt generator by Coffee &amp; Fun" />
		{% include schema-org.liquid %}
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "WebApplication",
				"@id": "https://www.coffeeandfun.com/receipt-generator/#app",
				"name": "Free Receipt & Invoice Generator",
				"url": "https://www.coffeeandfun.com/receipt-generator/",
				"description": "Create receipts and invoices with four templates, tax and discount calculations, and free PDF downloads.",
				"applicationCategory": "BusinessApplication",
				"operatingSystem": "Any",
				"browserRequirements": "Requires JavaScript and a modern web browser",
				"isAccessibleForFree": true,
				"inLanguage": "en",
				"offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
				"publisher": { "@id": "https://www.coffeeandfun.com/#organization" },
				"featureList": [
					"Four receipt and invoice templates",
					"80mm receipt and A4 invoice PDF export",
					"Tax and discount calculations",
					"Six currencies",
					"Local draft saving",
					"Custom business logo"
				]
			}
		</script>
		{% pageCss "receipt-generator" %}
		<script src="/assets/vendor/vue-3.5.43.global.prod.js" defer></script>
		{% pageJs "receipt-core" %}
		<script src="/assets/vendor/qrcode-2.0.4.js" defer></script>
		{% pageJs "receipt-pdf" %} {% pageJs "receipt-generator" %}
	</head>
	<body>
{% assign toolPage = true %}
{% assign skipTarget = 'main-content' %}
{% include header.liquid %}

		<a class="skip-link" href="#main-content">Skip to receipt generator</a>

		<main tabindex="-1" id="main-content">
			<div class="page-intro">
				<div>
					<p class="eyebrow">FREE &amp; NO SIGN-UP</p>
					<h1>Receipts, made <span>easy.</span></h1>
					<p class="intro-copy">
						Add your details. Pick a style. Download.
						<span class="sr-only">Free receipt and invoice generator.</span>
					</p>
				</div>
				<span class="intro-note"
					><svg
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.6"
						aria-hidden="true"
					>
						<rect x="5" y="10" width="14" height="11" rx="3" />
						<path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg
					>Only saved on your device</span
				>
			</div>
			<noscript
				><p class="notice">
					Enable JavaScript to use the receipt editor. Your receipt is created in your browser; no
					account is needed.
				</p></noscript
			>
			<p id="receipt-loading" class="loading-notice">
				Loading your receipt editor… If it does not appear, refresh the page.
			</p>
			{% raw %}
			<!-- prettier-ignore -->
			<div id="app" v-cloak>
				<div class="studio-tools">
					<fieldset class="template-picker">
						<legend>Pick a style</legend>
						<div class="template-options">
							<label
								v-for="template in templates"
								:key="template.id"
								class="template-option"
								:class="['style-' + template.id, { selected: receipt.template === template.id }]"
							>
								<input
									type="radio"
									name="receipt-template"
									:value="template.id"
									v-model="receipt.template"
									:aria-describedby="'template-hint-' + template.id"
								/>
								<span class="template-thumb" :class="'thumb-' + template.id" aria-hidden="true"
									><span class="mini-paper"
										><b>{{ template.id === 'invoice' ? 'Invoice' : 'STORE' }}</b
										><i></i><i></i><strong></strong><span class="mini-barcode"></span></span
								></span>
								<span class="template-copy"
									><strong>{{ template.name }}</strong
									><span class="sr-only" :id="'template-hint-' + template.id"
										>{{ template.description }}. {{ template.size }}.</span
									></span
								><span class="template-check" aria-hidden="true">{{
									receipt.template === template.id ? '✓' : ''
								}}</span>
							</label>
						</div>
					</fieldset>
					<div class="workspace-toolbar">
						<button type="button" class="button text-button" @click="loadExample">
							Try an example <span aria-hidden="true">↗</span></button
						><button type="button" class="button text-button" @click="resetReceipt">
							Start fresh <span aria-hidden="true">＋</span>
						</button>
					</div>
				</div>
				<div class="mobile-view-switch" role="group" aria-label="Workspace view">
					<button
						type="button"
						aria-controls="receipt-form"
						:aria-pressed="mobileView === 'edit'"
						@click="setMobileView('edit')"
					>
						Edit receipt</button
					><button
						type="button"
						aria-controls="preview"
						:aria-pressed="mobileView === 'preview'"
						@click="setMobileView('preview')"
					>
						Preview
					</button>
				</div>
				<div class="workspace" :data-mobile-view="mobileView">
					<form id="receipt-form" class="receipt-editor" novalidate @submit.prevent="generatePDF">
						<div
							v-if="shownErrors.length"
							id="error-summary"
							class="error-summary"
							tabindex="-1"
							aria-labelledby="errors-title"
						>
							<h2 id="errors-title">A few details need attention</h2>
							<p>
								Your document has {{ shownErrors.length }}
								{{ shownErrors.length === 1 ? 'issue' : 'issues' }}. Your work is still saved.
							</p>
							<ul>
								<li v-for="error in shownErrors" :key="error.field + error.message">
									<a :href="'#' + error.field" @click.prevent="focusField(error.field)">{{
										error.message
									}}</a>
								</li>
							</ul>
						</div>
						<section class="essentials" aria-labelledby="editor-title">
							<div class="editor-heading">
								<h2 id="editor-title">Your receipt</h2>
								<span class="save-indicator" role="status" :title="saveStatus"
									><span aria-hidden="true"></span>{{ shortSaveStatus }}</span
								>
							</div>
							<div class="business-basics">
								<div class="field">
									<label for="f-bizname">Business name <span aria-hidden="true">*</span></label>
									<input
										id="f-bizname"
										type="text"
										v-model="receipt.businessName"
										required
										autocomplete="organization"
										placeholder="e.g. Sunday Supply"
										maxlength="100"
										@blur="touch('f-bizname')"
										:aria-invalid="!!errorFor('f-bizname')"
										:aria-describedby="errorFor('f-bizname') ? 'f-bizname-error' : null"
									/>

									<p v-if="errorFor('f-bizname')" id="f-bizname-error" class="field-error">
										{{ errorFor('f-bizname') }}
									</p>
								</div>
								<div class="field">
									<label for="f-currency">Currency</label
									><select id="f-currency" v-model="receipt.currency">
										<option v-for="currency in currencies" :key="currency.code" :value="currency.code">
											{{ currency.code }} — {{ currency.symbol }}
										</option>
									</select>
								</div>
							</div>
							<div class="items-section">
								<div class="item-list">
									<div
										v-for="(item, index) in receipt.items"
										:key="item.id"
										class="item-edit"
										role="group"
										:aria-label="'Item ' + (index + 1)"
									>
										<div class="field item-desc-field">
											<label :for="'item-desc-' + item.id" :class="{ 'sr-only': index > 0 }">Item</label
											><input
												:id="'item-desc-' + item.id"
												type="text"
												v-model="item.description"
												maxlength="200"
												placeholder="e.g. Coffee"
												:aria-label="'Item ' + (index + 1) + ' description'"
												@blur="touch('item-desc-' + item.id)"
												@keydown.enter.prevent="focusField('item-qty-' + item.id)"
												:aria-invalid="!!errorFor('item-desc-' + item.id)"
												:aria-describedby="
													errorFor('item-desc-' + item.id) ? 'item-desc-' + item.id + '-error' : null
												"
											/>
											<p
												v-if="errorFor('item-desc-' + item.id)"
												:id="'item-desc-' + item.id + '-error'"
												class="field-error"
											>
												{{ errorFor('item-desc-' + item.id) }}
											</p>
										</div>
										<div class="field item-qty-field">
											<label :for="'item-qty-' + item.id" :class="{ 'sr-only': index > 0 }">Qty</label
											><input
												:id="'item-qty-' + item.id"
												type="number"
												v-model="item.quantity"
												min="0.001"
												max="999999"
												step="0.001"
												inputmode="decimal"
												:aria-label="'Item ' + (index + 1) + ' quantity (Qty)'"
												@blur="touch('item-qty-' + item.id)"
												@keydown.enter.prevent="focusField('item-price-' + item.id)"
												:aria-invalid="!!errorFor('item-qty-' + item.id)"
												:aria-describedby="
													errorFor('item-qty-' + item.id) ? 'item-qty-' + item.id + '-error' : null
												"
											/>
											<p
												v-if="errorFor('item-qty-' + item.id)"
												:id="'item-qty-' + item.id + '-error'"
												class="field-error"
											>
												{{ errorFor('item-qty-' + item.id) }}
											</p>
										</div>
										<div class="field item-price-field">
											<label :for="'item-price-' + item.id" :class="{ 'sr-only': index > 0 }"
												>Price ({{ currencyInfo.symbol }})</label
											><input
												:id="'item-price-' + item.id"
												type="number"
												v-model="item.price"
												:step="currencyInfo.decimals ? '0.01' : '1'"
												min="0"
												inputmode="decimal"
												:placeholder="currencyInfo.decimals ? '0.00' : '0'"
												:aria-label="'Item ' + (index + 1) + ' price (' + currencyInfo.symbol + ')'"
												@blur="touch('item-price-' + item.id)"
												@keydown.enter.prevent="addItem"
												:aria-invalid="!!errorFor('item-price-' + item.id)"
												:aria-describedby="
													errorFor('item-price-' + item.id) ? 'item-price-' + item.id + '-error' : null
												"
											/>
											<p
												v-if="errorFor('item-price-' + item.id)"
												:id="'item-price-' + item.id + '-error'"
												class="field-error"
											>
												{{ errorFor('item-price-' + item.id) }}
											</p>
										</div>
										<button
											type="button"
											class="icon-button"
											@click="removeItem(index)"
											:aria-label="'Remove item ' + (index + 1)"
										>
											<svg
												viewBox="0 0 24 24"
												fill="none"
												stroke="currentColor"
												stroke-width="1.6"
												aria-hidden="true"
											>
												<path d="m7 7 10 10M17 7 7 17" />
											</svg>
										</button>
									</div>
								</div>
								<button
									type="button"
									class="button add-item"
									@click="addItem"
									:disabled="receipt.items.length >= 200"
								>
									<span aria-hidden="true">＋</span> Add item
								</button>
							</div>
							<div class="quick-total">
								<span
									>Total <small>{{ receipt.currency }}</small></span
								><strong>{{ money(totals.total) }}</strong>
							</div>
						</section>
						<div class="optional-heading">MAKE IT YOURS <span>optional</span></div>
						<details class="option-panel" id="business-options">
							<summary>
								<span><strong>Business details</strong><small>Address, contact &amp; logo</small></span
								><span class="expand-icon" aria-hidden="true">＋</span>
							</summary>
							<div class="option-content">
								<div class="field">
									<label for="f-address">Business address</label
									><textarea
										id="f-address"
										v-model="receipt.businessAddress"
										rows="2"
										maxlength="500"
										autocomplete="street-address"
										placeholder="Street address, city, ZIP or postal code"
									></textarea>
								</div>
								<div class="field-grid">
									<div class="field">
										<label for="f-email">Email</label>
										<input
											id="f-email"
											type="email"
											v-model="receipt.businessEmail"
											autocomplete="email"
											maxlength="100"
											placeholder="hello@example.com"
											@blur="touch('f-email')"
											:aria-invalid="!!errorFor('f-email')"
											:aria-describedby="errorFor('f-email') ? 'f-email-error' : null"
										/>

										<p v-if="errorFor('f-email')" id="f-email-error" class="field-error">
											{{ errorFor('f-email') }}
										</p>
									</div>
									<div class="field">
										<label for="f-phone">Phone</label>
										<input
											id="f-phone"
											type="tel"
											v-model="receipt.businessPhone"
											autocomplete="tel"
											maxlength="40"
											placeholder="(555) 123-4567"
											@blur="touch('f-phone')"
											:aria-invalid="!!errorFor('f-phone')"
											:aria-describedby="errorFor('f-phone') ? 'f-phone-error' : null"
										/>

										<p v-if="errorFor('f-phone')" id="f-phone-error" class="field-error">
											{{ errorFor('f-phone') }}
										</p>
									</div>
								</div>
								<div class="logo-upload">
									<div class="logo-tile" :class="{ 'has-logo': receipt.logo }">
										<img v-if="receipt.logo" :src="receipt.logo" alt="Uploaded business logo" /><span
											v-else
											aria-hidden="true"
											>＋</span
										>
									</div>
									<div>
										<label for="f-logo">{{ logoBusy ? 'Preparing your logo…' : 'Add your logo' }}</label
										><input
											id="f-logo"
											type="file"
											accept="image/png,image/jpeg,image/webp"
											@change="handleLogoUpload"
											:disabled="logoBusy"
											aria-describedby="logo-hint"
										/>
										<p id="logo-hint" class="field-hint">PNG, JPG, or WebP · up to 5 MB</p>
									</div>
									<button
										v-if="receipt.logo"
										type="button"
										class="button text-button"
										@click="removeLogo"
									>
										Remove
									</button>
								</div>
								<div class="card-footer">
									<button type="button" class="button text-button" @click="saveBusinessInfo">
										Save business details</button
									><button
										v-if="hasSavedBusinessInfo"
										type="button"
										class="button text-button"
										@click="loadBusinessInfo(false)"
									>
										Load saved
									</button>
								</div>
							</div>
						</details>
						<details class="option-panel" id="total-options">
							<summary>
								<span
									><strong>Tax &amp; payment</strong><small>{{ adjustmentsSummary }}</small></span
								><span class="expand-icon" aria-hidden="true">＋</span>
							</summary>
							<div class="option-content">
								<div class="field-grid">
									<div class="field">
										<label for="f-tax">Tax rate (%)</label>
										<input
											id="f-tax"
											type="number"
											v-model="receipt.taxRate"
											min="0"
											max="100"
											step="0.01"
											inputmode="decimal"
											placeholder="0"
											@blur="touch('f-tax')"
											:aria-invalid="!!errorFor('f-tax')"
											:aria-describedby="errorFor('f-tax') ? 'f-tax-error' : null"
										/>

										<p v-if="errorFor('f-tax')" id="f-tax-error" class="field-error">
											{{ errorFor('f-tax') }}
										</p>
									</div>
									<div class="field">
										<label for="f-discount">Discount</label>
										<div class="joined-input">
											<input
												id="f-discount"
												type="number"
												v-model="receipt.discountValue"
												min="0"
												:max="receipt.discountType === 'percent' ? '100' : null"
												:step="
													receipt.discountType === 'percent' || currencyInfo.decimals ? '0.01' : '1'
												"
												inputmode="decimal"
												placeholder="0"
												@blur="touch('f-discount')"
												:aria-invalid="!!errorFor('f-discount')"
												:aria-describedby="errorFor('f-discount') ? 'f-discount-error' : null"
											/><select v-model="receipt.discountType" aria-label="Discount type">
												<option value="percent">%</option>
												<option value="fixed">{{ currencyInfo.symbol }}</option>
											</select>
										</div>
										<p v-if="errorFor('f-discount')" id="f-discount-error" class="field-error">
											{{ errorFor('f-discount') }}
										</p>
									</div>
								</div>
								<p class="field-hint">Discounts apply before tax.</p>
								<div class="field">
									<label for="f-pay">Payment method</label
									><select id="f-pay" v-model="receipt.paymentMethod">
										<option v-for="method in paymentMethods" :key="method">{{ method }}</option>
									</select>
								</div>
								<div v-if="receipt.paymentMethod === 'Cash' || isInvoice">
									<div class="field">
										<label for="f-paid">{{
											isInvoice ? 'Amount already paid (optional)' : 'Cash received (optional)'
										}}</label>
										<input
											id="f-paid"
											type="number"
											v-model="receipt.amountPaid"
											min="0"
											:step="currencyInfo.decimals ? '0.01' : '1'"
											inputmode="decimal"
											placeholder="0"
											@blur="touch('f-paid')"
											:aria-invalid="!!errorFor('f-paid')"
											:aria-describedby="errorFor('f-paid') ? 'f-paid-error' : null"
										/>

										<p v-if="errorFor('f-paid')" id="f-paid-error" class="field-error">
											{{ errorFor('f-paid') }}
										</p>
									</div>
									<p v-if="cashEntered" class="payment-result">
										{{
											totals.change >= 0
												? isInvoice
													? 'Overpayment'
													: 'Change to give'
												: 'Balance due'
										}}<strong>{{ money(Math.abs(totals.change)) }}</strong>
									</p>
								</div>
							</div>
						</details>
						<details class="option-panel" id="document-options">
							<summary>
								<span
									><strong>Date &amp; receipt number</strong
									><small>{{ displayDate(receipt.date) }} · {{ receipt.receiptNumber }}</small></span
								><span class="expand-icon" aria-hidden="true">＋</span>
							</summary>
							<div class="option-content">
								<div class="field-grid">
									<div class="field">
										<label for="f-date">Date <span aria-hidden="true">*</span></label>
										<input
											id="f-date"
											type="date"
											v-model="receipt.date"
											required
											@blur="touch('f-date')"
											:aria-invalid="!!errorFor('f-date')"
											:aria-describedby="errorFor('f-date') ? 'f-date-error' : null"
										/>

										<p v-if="errorFor('f-date')" id="f-date-error" class="field-error">
											{{ errorFor('f-date') }}
										</p>
									</div>
									<div class="field">
										<label for="f-time">Time <span aria-hidden="true">*</span></label>
										<input
											id="f-time"
											type="time"
											v-model="receipt.time"
											required
											@blur="touch('f-time')"
											:aria-invalid="!!errorFor('f-time')"
											:aria-describedby="errorFor('f-time') ? 'f-time-error' : null"
										/>

										<p v-if="errorFor('f-time')" id="f-time-error" class="field-error">
											{{ errorFor('f-time') }}
										</p>
									</div>
									<div class="field">
										<label for="f-number">{{ numberLabel }} <span aria-hidden="true">*</span></label>
										<input
											id="f-number"
											type="text"
											v-model="receipt.receiptNumber"
											required
											maxlength="24"
											placeholder="RCP-0001"
											@blur="touch('f-number')"
											:aria-invalid="!!errorFor('f-number')"
											:aria-describedby="errorFor('f-number') ? 'f-number-error' : null"
										/>

										<p v-if="errorFor('f-number')" id="f-number-error" class="field-error">
