<!DOCTYPE html>
<html class="brand-color-background scroll-smooth antialiased" lang="en" data-theme="light" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Free Receipt Generator for Bookkeeping - Coffee & Fun LLC</title>
    <meta name="title" content="Free Receipt Generator for Bookkeeping - Coffee & Fun LLC" />
    <meta name="description" content="Create realistic thermal-style replacement receipts for bookkeeping, with barcode, tax and discount math, and an 80mm PDF download, all in your browser." />
    <meta name="keywords" content="receipt generator, receipt maker, bookkeeping tool, replacement receipt, business receipt, PDF receipt, thermal receipt, tax calculator, Coffee & Fun" />
    <meta name="author" content="Coffee & Fun LLC" />
    <meta name="robots" content="index, follow" />

    <link rel="canonical" href="https://www.coffeeandfun.com/receipt-generator/" />
    <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />
    <link rel="apple-touch-icon" href="/assets/images/social/192.png" />
    <link rel="icon" href="/assets/images/social/192.png" sizes="192x192" type="image/png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coffee & Fun" />
    <meta property="og:title" content="Free Receipt Generator for Bookkeeping - Coffee & Fun LLC" />
    <meta property="og:description" content="Create realistic thermal-style replacement receipts for bookkeeping, with barcode, tax and discount math, and an 80mm PDF download, all in your browser." />
    <meta property="og:url" content="https://www.coffeeandfun.com/receipt-generator/" />
    <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/receipt-generator.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Receipt Generator card with an illustrated paper receipt and the Coffee & Fun logo" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bycoffeeandfun" />
    <meta name="twitter:creator" content="@bycoffeeandfun" />
    <meta name="twitter:title" content="Free Receipt Generator for Bookkeeping - Coffee & Fun LLC" />
    <meta name="twitter:description" content="Create realistic thermal-style replacement receipts for bookkeeping, with barcode, tax and discount math, and an 80mm PDF download, all in your browser." />
    <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/receipt-generator.png" />
    <meta name="twitter:image:alt" content="Receipt Generator card with an illustrated paper receipt and the Coffee & Fun logo" />

    <link rel="manifest" href="/assets/images/social/site.webmanifest" />
    <meta name="theme-color" content="#fef5ec" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Receipt Generator" />

    {% include schema-org.liquid %}

    {% bundledCss %}
    {% include scripts.html %}
    {% include sketch-styles.liquid %}

    <script src="https://unpkg.com/vue@3"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    {% pageCss "receipt-generator" %}

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "@id": "https://www.coffeeandfun.com/receipt-generator/#webpage",
        "url": "https://www.coffeeandfun.com/receipt-generator/",
        "name": "Free Receipt Generator",
        "description": "Generate realistic thermal-style replacement receipts for bookkeeping with our privacy-focused tool.",
        "isPartOf": {
          "@id": "https://www.coffeeandfun.com/#website"
        },
        "applicationCategory": "BusinessApplication",
        "publisher": {
          "@id": "https://www.coffeeandfun.com/#organization"
        },
        "creator": {
          "@id": "https://www.coffeeandfun.com/#founder"
        },
        "isAccessibleForFree": true,
        "inLanguage": "en",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "featureList": [
          "Realistic 80mm thermal receipt PDF",
          "Scannable Code 39 barcode",
          "Tax and discount calculations",
          "Multi-currency support",
          "Cash tendered and change",
          "Auto-incrementing receipt numbers",
          "Draft autosave",
          "Local processing",
          "No data tracking"
        ]
      }
    </script>
</head>

<body>
    {% assign showFun = true %}
    {% assign showMiddleBadgeWithText = true %}
    {% include header.liquid %}

    <main id="main-content">
        <div v-cloak id="app" style="max-width: 960px; margin: 0 auto; padding: 2rem 1.25rem 4rem;">

            <!-- Header -->
            <header style="text-align: center; margin-bottom: 2.5rem;">
                <div class="rc-frame" style="margin-bottom: 0.6rem;" aria-hidden="true">* * * * * * * * * * * *</div>
                <h1 class="brand-heading" style="font-size: 2rem; margin-bottom: 0.5rem;">Receipt Generator</h1>
                <div class="rc-frame" style="margin-bottom: 0.9rem;" aria-hidden="true">* * * * * * * * * * * *</div>
                <p class="page-sub" style="margin-bottom: 0.75rem;">Create realistic replacement receipts for bookkeeping</p>
                <div style="display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap; align-items: center;">
                    <span class="privacy-pill">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        All data stays in your browser
                    </span>
                    <button @click="loadExample" class="btn-brand btn-ghost-brand btn-sm-brand">Try an example receipt</button>
                </div>
            </header>

            <!-- Screen reader announcements: total updates (debounced) -->
            <div class="sr-only" role="status">{% raw %}{{ totalAnnouncement }}{% endraw %}</div>

            <div style="display: grid; grid-template-columns: 1fr; gap: 2rem;" class="receipt-layout">

                <!-- LEFT: Form -->
                <div style="display: flex; flex-direction: column; gap: 1.5rem;">

                    <!-- Business Info -->
                    <fieldset class="form-section">
                        <legend class="section-title">Business Information</legend>
                        <div style="display: flex; flex-direction: column; gap: 0.85rem;">
                            <div>
                                <label class="form-label" for="f-bizname">Company Name *</label>
                                <input id="f-bizname" type="text" v-model="receipt.businessName" placeholder="Your Business Name" class="form-input" autocomplete="organization" />
                            </div>
                            <div>
                                <label class="form-label" for="f-address">Address</label>
                                <textarea id="f-address" v-model="receipt.businessAddress" placeholder="123 Main St, City, State ZIP" class="form-input" rows="2"></textarea>
                            </div>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
                                <div>
                                    <label class="form-label" for="f-phone">Phone</label>
                                    <input id="f-phone" type="tel" v-model="receipt.businessPhone" placeholder="(555) 123-4567" class="form-input" autocomplete="tel" />
                                </div>
                                <div>
                                    <label class="form-label" for="f-email">Email</label>
                                    <input id="f-email" type="email" v-model="receipt.businessEmail" placeholder="info@business.com" class="form-input" autocomplete="email" />
                                </div>
                            </div>
                            <div>
                                <label class="form-label" for="f-logo">Logo <span class="optional-tag">(optional, printed black &amp; white, like a real register)</span></label>
                                <input id="f-logo" type="file" @change="handleLogoUpload" accept="image/png,image/jpeg,image/webp" class="form-input" style="padding: 0.4rem;" />
                                <button v-if="receipt.logo" @click="removeLogo" class="btn-brand btn-danger btn-sm-brand" style="margin-top: 0.5rem;">Remove Logo</button>
                            </div>
                            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                <button @click="saveBusinessInfo(false)" class="btn-brand btn-ghost-brand btn-sm-brand">Remember my details</button>
                                <button v-if="hasSavedBusinessInfo" @click="loadBusinessInfo(false)" class="btn-brand btn-ghost-brand btn-sm-brand">Load saved details</button>
                            </div>
                        </div>
                    </fieldset>

                    <!-- Receipt Details -->
                    <fieldset class="form-section">
                        <legend class="section-title">Receipt Details</legend>
                        <div style="display: flex; flex-direction: column; gap: 0.85rem;">
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
                                <div>
                                    <label class="form-label" for="f-rcpnum">Receipt Number</label>
                                    <input id="f-rcpnum" type="text" v-model="receipt.receiptNumber" placeholder="RCP-0001" maxlength="16" class="form-input" />
                                </div>
                                <div>
                                    <label class="form-label" for="f-date">Date *</label>
                                    <input id="f-date" type="date" v-model="receipt.date" class="form-input" />
                                </div>
                            </div>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
                                <div>
                                    <label class="form-label" for="f-pay">Payment Method</label>
                                    <select id="f-pay" v-model="receipt.paymentMethod" class="form-input">
                                        <option>Cash</option>
                                        <option>Credit Card</option>
                                        <option>Debit Card</option>
                                        <option>Check</option>
                                        <option>Bank Transfer</option>
                                        <option>Other</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label" for="f-currency">Currency</label>
                                    <select id="f-currency" v-model="receipt.currency" class="form-input">
                                        <option v-for="c in currencies" :key="c.code" :value="c.code">{% raw %}{{ c.code }} ({{ c.symbol }}){% endraw %}</option>
                                    </select>
                                </div>
                            </div>
                            <div>
                                <label class="form-label" for="f-cashier">Served By <span class="optional-tag">(optional)</span></label>
                                <input id="f-cashier" type="text" v-model="receipt.cashier" placeholder="Cashier or staff name" class="form-input" />
                            </div>
                        </div>
                    </fieldset>

                    <!-- Items -->
                    <fieldset class="form-section">
                        <legend class="section-title">Items</legend>
                        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                            <div v-for="(item, index) in receipt.items" :key="index" class="item-row" role="group" :aria-label="'Item ' + (index + 1)">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                                    <span style="font-size: 0.75rem; font-weight: 600; color: var(--color-caramel);">{% raw %}ITEM {{ index + 1 }}{% endraw %}</span>
                                    <button v-if="receipt.items.length > 1" @click="removeItem(index)" :aria-label="'Remove item ' + (index + 1)" class="item-remove">&times;</button>
                                </div>
                                <div style="display: grid; grid-template-columns: 1fr auto auto; gap: 0.5rem;">
                                    <input type="text" :id="'item-desc-' + index" v-model="item.description" placeholder="Description" :aria-label="'Item ' + (index + 1) + ' description'" @keydown.enter.prevent="focusEl('item-qty-' + index)" class="form-input" style="font-size: 0.85rem; padding: 0.45rem 0.65rem;" />
                                    <input type="number" :id="'item-qty-' + index" v-model.number="item.quantity" placeholder="Qty" min="0" step="1" :aria-label="'Item ' + (index + 1) + ' quantity'" @keydown.enter.prevent="focusEl('item-price-' + index)" @wheel="$event.target.blur()" class="form-input" style="width: 4rem; font-size: 0.85rem; padding: 0.45rem 0.5rem; text-align: center;" />
                                    <input type="number" :id="'item-price-' + index" v-model.number="item.price" placeholder="Price" step="0.01" min="0" :aria-label="'Item ' + (index + 1) + ' unit price'" @keydown.enter.prevent="addItem(true)" @wheel="$event.target.blur()" class="form-input" style="width: 5.5rem; font-size: 0.85rem; padding: 0.45rem 0.5rem;" />
                                </div>
                                <div v-if="item.description && item.quantity > 0 && item.price > 0" class="line-total">{% raw %}Line total: {{ formatMoney(item.quantity * item.price) }}{% endraw %}</div>
                            </div>
                            <button ref="addItemBtn" @click="addItem(true)" class="btn-brand btn-secondary-brand" style="width: 100%; justify-content: center;">+ Add Item</button>
                            <p class="sr-only">Tip: press Enter to move between item fields; Enter on a price adds the next item.</p>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-top: 1rem;">
                            <div>
                                <label class="form-label" for="f-tax">Tax Rate (%)</label>
                                <input id="f-tax" type="number" v-model.number="receipt.taxRate" placeholder="0" step="0.01" min="0" max="100" @wheel="$event.target.blur()" class="form-input" />
                            </div>
                            <div>
                                <label class="form-label" for="f-discount">Discount <span class="optional-tag">(optional)</span></label>
                                <div style="display: flex; gap: 0.4rem;">
                                    <input id="f-discount" type="number" v-model.number="receipt.discountValue" placeholder="0" step="0.01" min="0" @wheel="$event.target.blur()" class="form-input" style="flex: 1; min-width: 0;" />
                                    <select v-model="receipt.discountType" aria-label="Discount type" class="form-input" style="width: 4.75rem; padding-left: 0.5rem; padding-right: 1.5rem;">
                                        <option value="percent">%</option>
                                        <option value="fixed">{% raw %}{{ currencyInfo.symbol }}{% endraw %}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </fieldset>

                    <!-- Cash payment (only for cash) -->
                    <fieldset class="form-section" v-if="receipt.paymentMethod === 'Cash'">
                        <legend class="section-title">Cash Payment</legend>
                        <div>
                            <label class="form-label" for="f-paid">Amount Received <span class="optional-tag">(optional)</span></label>
                            <input id="f-paid" type="number" v-model.number="receipt.amountPaid" placeholder="0.00" step="0.01" min="0" @wheel="$event.target.blur()" class="form-input" style="max-width: 10rem;" />
                            <div v-if="receipt.amountPaid > 0" style="margin-top: 0.5rem; font-size: 0.85rem; color: var(--color-espresso);">
                                <span v-if="changeDue >= 0">{% raw %}Change to give: {{ formatMoney(changeDue) }}{% endraw %}</span>
                                <span v-else style="color: #c0392b;">{% raw %}Short by: {{ formatMoney(-changeDue) }}{% endraw %}</span>
                            </div>
                        </div>
                    </fieldset>

                    <!-- Receipt note -->
                    <fieldset class="form-section">
                        <legend class="section-title">Receipt Note</legend>
                        <div>
                            <label class="form-label" for="f-note">Footer Message <span class="optional-tag">(optional)</span></label>
                            <input id="f-note" type="text" v-model="receipt.footerNote" maxlength="80" placeholder="Thank you for your business!" class="form-input" />
                        </div>
                    </fieldset>
                </div>

                <!-- RIGHT: Preview -->
                <div>
                    <div style="position: sticky; top: 1.5rem;">
                        <div class="panel-card">
                            <h2 class="section-title">Preview</h2>

                            <div class="receipt-stage">
                                <div id="receipt-preview" class="receipt-paper" aria-label="Live receipt preview">
                                    <img v-if="receipt.logo" :src="receipt.logo" alt="" class="rc-logo" />
                                    <div class="rc-name">{% raw %}{{ receipt.businessName || 'Your Business' }}{% endraw %}</div>
                                    <div v-if="receipt.businessAddress" class="rc-center rc-small" style="white-space: pre-line;">{% raw %}{{ receipt.businessAddress }}{% endraw %}</div>
                                    <div v-if="hasContactInfo" class="rc-center rc-small">
                                        <span v-if="receipt.businessPhone">{% raw %}{{ receipt.businessPhone }}{% endraw %}</span>
                                        <span v-if="receipt.businessPhone && receipt.businessEmail"> &middot; </span>
                                        <span v-if="receipt.businessEmail">{% raw %}{{ receipt.businessEmail }}{% endraw %}</span>
                                    </div>

                                    <div class="rc-sep" aria-hidden="true">------------------------------------------</div>

                                    <div class="rc-row rc-small"><span>DATE {% raw %}{{ posDate }}{% endraw %}</span><span>TIME {% raw %}{{ posTime }}{% endraw %}</span></div>
                                    <div class="rc-row rc-small"><span>{% raw %}{{ posRegisterLine }}{% endraw %}</span><span>{% raw %}{{ receiptDisplayNumber }}{% endraw %}</span></div>

                                    <div class="rc-sep" aria-hidden="true">------------------------------------------</div>

                                    <div v-if="validItems.length">
                                        <div v-for="(item, index) in validItems" :key="index" style="margin-bottom: 3px;">
                                            <div class="rc-row">
                                                <span class="rc-item-desc">{% raw %}{{ item.description }}{% endraw %}</span>
                                                <span>{% raw %}{{ formatMoney(item.quantity * item.price) }}{% endraw %}</span>
                                            </div>
                                            <div v-if="item.quantity > 1" class="rc-small">&nbsp;&nbsp;{% raw %}{{ item.quantity }} @ {{ formatMoney(item.price) }}{% endraw %}</div>
                                        </div>
                                    </div>
                                    <div v-else class="rc-center rc-small" style="padding: 8px 0; color: #1a1a1a; opacity: 0.55;">NO ITEMS YET</div>

                                    <div class="rc-sep" aria-hidden="true">------------------------------------------</div>

                                    <div class="rc-row"><span>SUBTOTAL</span><span>{% raw %}{{ formatMoney(subtotal) }}{% endraw %}</span></div>
                                    <div v-if="discountAmount > 0" class="rc-row"><span>{% raw %}DISCOUNT{{ receipt.discountType === 'percent' ? ' ' + receipt.discountValue + '%' : '' }}{% endraw %}</span><span>{% raw %}-{{ formatMoney(discountAmount) }}{% endraw %}</span></div>
                                    <div v-if="receipt.taxRate > 0" class="rc-row"><span>{% raw %}TAX {{ receipt.taxRate }}%{% endraw %}</span><span>{% raw %}{{ formatMoney(taxAmount) }}{% endraw %}</span></div>

                                    <div class="rc-sep" aria-hidden="true">******************************************</div>

                                    <div class="rc-row rc-total"><span>TOTAL</span><span>{% raw %}{{ formatMoney(total) }}{% endraw %}</span></div>
                                    <div class="rc-row rc-small"><span>TENDER</span><span style="text-transform: uppercase;">{% raw %}{{ receipt.paymentMethod }}{% endraw %}</span></div>
                                    <template v-if="receipt.paymentMethod === 'Cash' && receipt.amountPaid > 0">
                                        <div class="rc-row rc-small"><span>CASH</span><span>{% raw %}{{ formatMoney(receipt.amountPaid) }}{% endraw %}</span></div>
                                        <div class="rc-row rc-small"><span>{% raw %}{{ changeDue >= 0 ? 'CHANGE' : 'BALANCE DUE' }}{% endraw %}</span><span>{% raw %}{{ formatMoney(absChange) }}{% endraw %}</span></div>
                                    </template>

                                    <div class="rc-sep" aria-hidden="true">------------------------------------------</div>

                                    <div v-if="receipt.cashier" class="rc-center rc-small" style="margin-top: 4px;">{% raw %}YOU WERE SERVED BY {{ receipt.cashier.toUpperCase() }}{% endraw %}</div>
                                    <div class="rc-center rc-small" :style="{ marginTop: receipt.cashier ? '0' : '4px' }">{% raw %}{{ (receipt.footerNote || 'Thank you for your business!').toUpperCase() }}{% endraw %}</div>
                                    <div class="rc-center rc-small">{% raw %}{{ itemCount }} ITEM{{ itemCount === 1 ? '' : 'S' }}{% endraw %}</div>

                                    <img v-if="barcodeUrl" :src="barcodeUrl" alt="" class="rc-barcode" aria-hidden="true" />
                                    <div class="rc-center rc-small" style="letter-spacing: 2px;">{% raw %}{{ barcodePayload }}{% endraw %}</div>
                                    <div class="rc-center rc-small" style="margin-top: 6px; opacity: 0.75;">GENERATED FOR BOOKKEEPING PURPOSES</div>
                                </div>
                            </div>

                            <!-- Actions -->
                            <div style="margin-top: 1rem;">
                                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                    <button @click="generatePDF" :disabled="!isValidReceipt" class="btn-brand btn-primary-brand">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                        Download PDF
                                    </button>
                                    <button @click="printReceipt" :disabled="!isValidReceipt" class="btn-brand btn-secondary-brand">Print</button>
                                    <button @click="resetReceipt" class="btn-brand btn-ghost-brand">New Receipt</button>
                                </div>
                                <p class="validation-hint" role="status">
                                    <template v-if="!isValidReceipt">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                                        <span>{% raw %}To download, add {{ missingList }}, or {% endraw %}<button @click="loadExample" style="background:none;border:none;padding:0;font:inherit;color:var(--color-espresso);text-decoration:underline;cursor:pointer;">load the example</button>.</span>
                                    </template>
                                </p>
                                <p style="margin-top: 0.5rem; font-size: 0.75rem; color: #767676;">The PDF downloads at real 80mm thermal-receipt size with a scannable barcode.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mobile action bar -->
            <div class="mobile-actionbar">
                <div>
                    <div class="ma-label">Total</div>
                    <div class="ma-total">{% raw %}{{ formatMoney(total) }}{% endraw %}</div>
                </div>
                <button @click="generatePDF" :disabled="!isValidReceipt" class="btn-brand btn-primary-brand">Download PDF</button>
            </div>

            <!-- Toast notification: live region stays mounted so announcements are reliable -->
            <div role="status" aria-live="polite">
                <span v-if="toast" class="toast-msg">{% raw %}{{ toast }}{% endraw %}</span>
            </div>
        </div>
    </main>


    {% pageJs "receipt-generator" %}

    {% include modals.liquid %}
    {% include footer.liquid %}
</body>
</html>
