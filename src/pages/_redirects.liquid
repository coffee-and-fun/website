---
permalink: /_redirects
# No file extension by design: Cloudflare Pages looks for exactly "_redirects".
eleventyAllowMissingExtension: true
eleventyExcludeFromCollections: true
layout: null
---
# Cloudflare Pages redirects, generated from src/_data/redirects.json.
# Real HTTP 301s, which search engines consolidate properly. Add a row to the
# JSON to retire another URL; do not edit this file by hand.
#
# Both the trailing-slash and bare forms are emitted so either spelling of an
# old inbound link lands correctly.
{% for r in redirects %}
# {{ r.note }}
{{ r.from }} {{ r.to }} 301
{{ r.from | remove_last: "/" }} {{ r.to }} 301
{%- endfor %}
