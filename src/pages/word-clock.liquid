<!DOCTYPE html>
<html class="antialiased" lang="en" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- Primary Meta Tags -->
  <title>Word Clock: Time in Words - Coffee & Fun LLC</title>
  <meta name="title" content="Word Clock: Time in Words - Coffee & Fun LLC" />
  <meta name="description" content="A word clock that spells out the time, the right words light up in a grid of letters. IT IS TWENTY MINUTES PAST TEN. Free, no sign-up, runs in your browser." />
  <meta name="keywords" content="word clock, time display, clock widget, time in words, digital clock, Coffee and Fun" />
  <meta name="author" content="Coffee & Fun LLC" />
  <meta name="publisher" content="Coffee & Fun LLC" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.coffeeandfun.com/word-clock/" />
  <meta property="og:title" content="Word Clock: Time in Words - Coffee & Fun LLC" />
  <meta property="og:description" content="A word clock that spells out the time, the right words light up in a grid of letters. IT IS TWENTY MINUTES PAST TEN. Free, no sign-up, runs in your browser." />
  <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/word-clock.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Coffee & Fun logo card: a tipping coffee cup and the tagline Crafting software, one brew at a time" />
  <meta property="og:site_name" content="Coffee & Fun" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content="https://www.coffeeandfun.com/word-clock/" />
  <meta name="twitter:title" content="Word Clock: Time in Words - Coffee & Fun LLC" />
  <meta name="twitter:description" content="A word clock that spells out the time, the right words light up in a grid of letters. IT IS TWENTY MINUTES PAST TEN. Free, no sign-up, runs in your browser." />
  <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/word-clock.png" />
  <meta name="twitter:image:alt" content="Coffee & Fun logo card: a tipping coffee cup and the tagline Crafting software, one brew at a time" />
  <meta name="twitter:site" content="@bycoffeeandfun" />
  <meta name="twitter:creator" content="@bycoffeeandfun" />

  <!-- PWA & Mobile -->
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="Word Clock" />
  <meta name="theme-color" content="#fef5ec" />

  <!-- Search Engine -->
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <link rel="canonical" href="https://www.coffeeandfun.com/word-clock/" />

  <!-- Favicon -->
  <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />
  <link rel="apple-touch-icon" href="/assets/images/brand/apple-touch-icon.png" />

  <!-- Structured Data -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Word Clock",
      "description": "A word clock that spells out the current time, the right words light up in a grid of letters.",
      "url": "https://www.coffeeandfun.com/word-clock/",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "Any",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "creator": {
        "@id": "https://www.coffeeandfun.com/#founder"
      },
      "publisher": {
        "@id": "https://www.coffeeandfun.com/#organization"
      },
      "isAccessibleForFree": true,
      "inLanguage": "en"
    }
  </script>

    {% bundledCss %}
    {% pageCss "word-clock" %}
  {% include sketch-styles.liquid %}
{% include schema-org.liquid %}

    </head>

<body>
  {% include header.liquid %}
  <a href="#tool" class="skip">Skip to the clock</a>

  <main id="main-content" class="wrap">

    <header id="tool">
      <h1>The time, spelled out in letters</h1>
    </header>

    <!-- Spoken time for screen readers, updated once a minute -->
    <p class="sr-only" role="status" aria-live="polite" id="spoken-time"></p>

    <section class="clock-card" id="clock-card" aria-label="Word clock">
      <noscript>
        <p class="noscript-note">The clock needs JavaScript to light up, turn it on and reload to see the time in words.</p>
      </noscript>
      <div class="letters" id="letters" aria-hidden="true"></div>
      <p class="plain-time" id="digital-time"></p>
      <p class="plain-date" id="digital-date"></p>
      <p class="fs-hint">Press Esc to leave full screen</p>
    </section>

    <div class="controls">
      <label class="ctl">
        <input type="checkbox" id="opt-24h" />
        24-hour time
      </label>
      <label class="ctl">
        <input type="checkbox" id="opt-smooth" checked />
        Smooth fade
      </label>
      <button type="button" class="btn-fs" id="btn-fullscreen">Full screen</button>
    </div>

    <!-- The description sits under the clock rather than above it. It still
         carries the page's search terms and is read in a natural place, but it
         no longer takes height away from the thing people came for. -->
    <p class="lede">A grid of letters where the right words light up, IT IS TWENTY MINUTES PAST TEN. Leave it open on a spare screen, or take it full screen and watch the minutes drift by.</p>

    <p class="foot">The clock runs entirely in your browser, nothing to install, nothing tracked.</p>
  </main>

  {% include modals.liquid %}
  {% include footer.liquid %}

    {% pageJs "word-clock" %}
</body>
</html>
