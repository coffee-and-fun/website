<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>Craigslist Feed Builder &amp; Listing Watcher - Coffee &amp; Fun LLC</title>
  <meta name="description" content="Build Craigslist searches for any city, save them as watches, and track new listings alongside any RSS feed. Prices, new-item alerts, dark mode. Everything stays in your browser." />
  <meta name="keywords" content="craigslist rss, craigslist feed builder, craigslist search alerts, craigslist notifications, rss watcher, listing tracker, marketplace alerts" />
  <meta name="author" content="Coffee &amp; Fun LLC" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://www.coffeeandfun.com/craigslist-feed-builder/" />
  <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />
  <meta name="theme-color" content="#f1f3f4" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Coffee &amp; Fun" />
  <meta property="og:title" content="Craigslist Feed Builder &amp; Listing Watcher - Coffee &amp; Fun LLC" />
  <meta property="og:description" content="Build Craigslist searches for any city, save them as watches, and track new listings alongside any RSS feed. Everything stays in your browser." />
  <meta property="og:url" content="https://www.coffeeandfun.com/craigslist-feed-builder/" />
  <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/home.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Coffee &amp; Fun card with the coffee cup logo and the tagline Crafting software, one brew at a time" />
  <meta property="og:locale" content="en_US" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@bycoffeeandfun" />
  <meta name="twitter:title" content="Craigslist Feed Builder &amp; Listing Watcher - Coffee &amp; Fun LLC" />
  <meta name="twitter:description" content="Build Craigslist searches for any city, save them as watches, and track new listings alongside any RSS feed. Everything stays in your browser." />
  <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/home.png" />
  <meta name="twitter:image:alt" content="Coffee &amp; Fun card with the coffee cup logo and the tagline Crafting software, one brew at a time" />

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Craigslist Feed Builder & Listing Watcher",
      "description": "Build Craigslist search URLs for any city and category, save them as watches, and track new listings alongside any RSS or Atom feed. Runs entirely in the browser with nothing stored on a server.",
      "url": "https://www.coffeeandfun.com/craigslist-feed-builder/",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "Web Browser",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "publisher": { "@id": "https://www.coffeeandfun.com/#organization" },
      "creator": { "@id": "https://www.coffeeandfun.com/#founder" },
      "isAccessibleForFree": true,
      "inLanguage": "en"
    }
  </script>

  <script src="https://unpkg.com/vue@3"></script>

  {% bundledCss %}
{% include schema-org.liquid %}
</head>

<body class="bg-base-200 min-h-dvh">
  <div v-cloak id="app">
   <div :class="{ 'text-sm': settings.size === 0, 'text-base': settings.size === 1, 'text-lg': settings.size === 2, 'text-xl': settings.size === 3 }">

    <a href="#main-content" class="btn btn-primary sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50">Skip to your watches</a>

    <div class="mx-auto max-w-3xl px-4 py-6 sm:py-10">
      <div class="bg-base-100 rounded-[2rem] px-5 py-8 sm:px-12 sm:py-14">

        <!-- Chrome, kept to two controls -->
        <div class="mb-10 flex items-center justify-between">
          <a href="/" class="btn btn-sm btn-ghost rounded-full gap-1 px-3 font-semibold">
            <svg viewBox="0 -960 960 960" class="size-4" fill="currentColor" aria-hidden="true"><path d="M400-80 0-480l400-400 71 71-329 329 329 329-71 71Z"/></svg>
            Coffee &amp; Fun
          </a>
          <div class="flex items-center gap-1">
            <button class="btn btn-sm btn-ghost rounded-full px-3 font-semibold" @click="checkAll" :disabled="checking || !watches.length">
              <span v-if="checking" class="loading loading-spinner loading-xs"></span>
              <span>{% raw %}{{ checking ? 'Checking' : 'Check' }}{% endraw %}</span>
            </button>
            <button class="btn btn-sm btn-circle btn-ghost" @click="showSettings = true" aria-label="Settings">
              <svg viewBox="0 -960 960 960" class="size-5" fill="currentColor" aria-hidden="true"><path d="m370-80-16-128q-13-5-24.5-12T307-235l-119 50L78-375l103-78q-1-7-1-13.5v-27q0-6.5 1-13.5L78-585l110-190 119 50q11-8 23-15t24-12l16-128h220l16 128q13 5 24.5 12t22.5 15l119-50 110 190-103 78q1 7 1 13.5v27q0 6.5-2 13.5l103 78-110 190-118-50q-11 8-23 15t-24 12L590-80H370Zm112-260q58 0 99-41t41-99q0-58-41-99t-99-41q-59 0-99.5 41T342-480q0 58 40.5 99t99.5 41Z"/></svg>
            </button>
          </div>
        </div>

        <main id="main-content">

          <!-- Masthead -->
          <div class="text-center">
            <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">Listing Watcher</h1>
            <p class="mx-auto mt-4 max-w-md leading-relaxed opacity-60">
              Searches you are keeping an eye on.<br class="hidden sm:inline" />
              Anything new gets flagged when you open this page.
            </p>
          </div>

          <!-- Watches -->
          <div class="mt-12 flex flex-wrap items-center gap-3">
            <h2 class="text-primary text-xs font-bold tracking-widest uppercase">Watching</h2>
            <span class="bg-base-300 h-px flex-1"></span>
            <button class="btn btn-primary btn-sm rounded-full px-4" @click="newWatch('craigslist')">Add a search</button>
            <button class="btn btn-secondary btn-sm btn-outline rounded-full px-4" @click="newWatch('feed')">Add a feed</button>
          </div>

          <p v-if="!watches.length" class="py-12 text-center leading-relaxed opacity-60">
            Nothing yet. Build a Craigslist search for any city, or paste an RSS feed.
          </p>

          <ul v-else class="mt-2">
            <li v-for="w in watches" :key="w.id" class="border-base-200 flex items-center gap-4 border-b py-5 last:border-0">
              <div class="avatar avatar-placeholder shrink-0" aria-hidden="true">
                <div class="w-11 rounded-full text-gray-900"
                  :class="{ 'bg-violet-300': w.colour === 'primary', 'bg-rose-300': w.colour === 'secondary', 'bg-teal-300': w.colour === 'accent', 'bg-sky-300': w.colour === 'info', 'bg-lime-300': w.colour === 'success', 'bg-amber-300': w.colour === 'warning', 'bg-orange-300': w.colour === 'error' }">
                  <span class="text-sm font-bold">{% raw %}{{ initials(w.name) }}{% endraw %}</span>
                </div>
              </div>

              <button class="min-w-0 flex-1 text-left" @click="active = active === w.id ? 'all' : w.id"
                :aria-pressed="active === w.id ? 'true' : 'false'">
                <span class="block truncate font-bold">{% raw %}{{ w.name }}{% endraw %}</span>
                <span class="block truncate text-sm opacity-50">{% raw %}{{ source(w) }}{% endraw %}</span>
              </button>

              <a v-if="(status[w.id] || {}).state === 'blocked'" class="badge badge-warning badge-sm gap-1 font-semibold whitespace-nowrap"
                 :href="urlFor(w)" target="_blank" rel="noopener">Open it</a>
              <span v-else-if="(counts[w.id] || {}).fresh" class="badge badge-primary badge-sm font-bold">{% raw %}{{ counts[w.id].fresh }}{% endraw %} new</span>
              <span v-else class="badge badge-ghost badge-sm">{% raw %}{{ (counts[w.id] || {}).total || 0 }}{% endraw %}</span>

              <button class="btn btn-ghost btn-sm btn-circle opacity-40 hover:opacity-100" @click="editWatch(w)"
                :aria-label="'Edit ' + w.name">
                <svg viewBox="0 -960 960 960" class="size-4" fill="currentColor" aria-hidden="true"><path d="M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T817-647L290-120H120Z"/></svg>
              </button>
            </li>
          </ul>

          <!-- Listings -->
          <template v-if="watches.length">
            <div class="mt-12 flex items-center gap-4">
              <h2 class="text-accent text-xs font-bold tracking-widest uppercase">
                {% raw %}{{ active === 'all' ? 'Listings' : 'Just this watch' }}{% endraw %}
              </h2>
              <span class="bg-base-300 h-px flex-1"></span>
              <button v-if="active !== 'all'" class="link link-primary text-sm font-semibold no-underline" @click="active = 'all'">Show all</button>
              <button v-if="freshCount" class="link link-primary text-sm font-semibold no-underline" @click="markSeen">Mark all seen</button>
            </div>

            <p v-if="!shown.length" class="mx-auto max-w-md py-12 text-center leading-relaxed opacity-60">
              Craigslist blocks reading its searches from a browser, so those open in a tab
              instead. Feeds that allow it will fill this in.
            </p>

            <ul v-else class="mt-2">
              <li v-for="i in shown" :key="i.watchId + i.key" class="border-base-200 border-b last:border-0">
                <a class="flex items-start gap-4 py-5" :href="i.link" target="_blank" rel="noopener">
                  <span class="mt-2 size-2 shrink-0 rounded-full"
                    :class="{ 'bg-violet-400': i.colour === 'primary', 'bg-rose-400': i.colour === 'secondary', 'bg-teal-400': i.colour === 'accent', 'bg-sky-400': i.colour === 'info', 'bg-lime-400': i.colour === 'success', 'bg-amber-400': i.colour === 'warning', 'bg-orange-400': i.colour === 'error' }"
                    aria-hidden="true"></span>
                  <span class="min-w-0 flex-1">
                    <span class="flex flex-wrap items-baseline gap-x-2">
                      <span class="font-bold">{% raw %}{{ i.title }}{% endraw %}</span>
                      <span v-if="i.fresh" class="badge badge-primary badge-xs font-bold">New</span>
                    </span>
                    <span v-if="i.desc" class="mt-1 line-clamp-2 block text-sm opacity-60">{% raw %}{{ i.desc }}{% endraw %}</span>
                    <span class="mt-1 block text-xs opacity-40">{% raw %}{{ i.watchName }}{{ i.time ? ' · ' + ago(i.time) : '' }}{% endraw %}</span>
                  </span>
                  <span v-if="i.price" class="badge badge-success badge-outline shrink-0 font-bold">{% raw %}{{ i.price }}{% endraw %}</span>
                </a>
              </li>
            </ul>
          </template>

          <p class="mt-12 text-center text-xs opacity-40">
            {% raw %}{{ checkedAt ? 'Checked ' + ago(checkedAt) : 'Not checked yet' }}{% endraw %} · Everything stays in this browser
          </p>
        </main>
      </div>
    </div>

    <!-- Watch editor -->
    <div v-if="editing" class="modal modal-open" role="dialog">
      <div class="modal-box max-w-lg rounded-[1.75rem] p-8">
        <h3 class="text-2xl font-extrabold tracking-tight">
          {% raw %}{{ editing.id ? 'Edit watch' : (editing.kind === 'craigslist' ? 'New search' : 'New feed') }}{% endraw %}
        </h3>

        <fieldset class="fieldset">
          <legend class="fieldset-legend">Name</legend>
          <input v-model="editing.name" class="input w-full" placeholder="Cheap couches" />
        </fieldset>

        <template v-if="editing.kind === 'craigslist'">
          <div class="grid gap-3 sm:grid-cols-2">
            <fieldset class="fieldset">
              <legend class="fieldset-legend">City</legend>
              <input v-model="editing.site" class="input w-full" list="cl-sites" placeholder="sfbay" autocapitalize="off" spellcheck="false" />
              <datalist id="cl-sites">
                <option v-for="s in sites" :key="s[0]" :value="s[0]">{% raw %}{{ s[1] }}{{ s[2] ? ', ' + s[2] : '' }}{{ s[3] ? ' (' + s[3] + ')' : '' }}{% endraw %}</option>
              </datalist>
              <p class="label">{% raw %}{{ sites.length ? sites.length + ' craigslist sites' : 'Loading sites…' }}{% endraw %}</p>
            </fieldset>
            <fieldset class="fieldset">
              <legend class="fieldset-legend">Category</legend>
              <select v-model="editing.category" class="select w-full">
                <optgroup v-for="(list, group) in categoryGroups" :key="group" :label="group">
                  <option v-for="c in list" :key="c[0]" :value="c[0]">{% raw %}{{ c[1] }}{% endraw %}</option>
                </optgroup>
              </select>
            </fieldset>
          </div>

          <fieldset class="fieldset">
            <legend class="fieldset-legend">Search terms</legend>
            <input v-model="editing.query" class="input w-full" placeholder="couch, playstation, bike" />
          </fieldset>

          <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            <fieldset class="fieldset"><legend class="fieldset-legend">Min $</legend><input v-model="editing.minPrice" type="number" inputmode="numeric" min="0" class="input w-full" /></fieldset>
            <fieldset class="fieldset"><legend class="fieldset-legend">Max $</legend><input v-model="editing.maxPrice" type="number" inputmode="numeric" min="0" class="input w-full" /></fieldset>
            <fieldset class="fieldset"><legend class="fieldset-legend">Postcode</legend><input v-model="editing.postal" inputmode="numeric" class="input w-full" /></fieldset>
            <fieldset class="fieldset"><legend class="fieldset-legend">Miles</legend><input v-model="editing.distance" type="number" inputmode="numeric" min="0" class="input w-full" /></fieldset>
          </div>

          <label class="label cursor-pointer justify-start gap-3 py-3">
            <input type="checkbox" v-model="editing.hasImage" class="checkbox checkbox-primary checkbox-sm" />
            <span>Only listings with a photo</span>
          </label>
        </template>

        <fieldset v-else class="fieldset">
          <legend class="fieldset-legend">Feed address</legend>
          <input v-model="editing.feedUrl" type="url" inputmode="url" class="input w-full" placeholder="https://example.com/feed.xml" autocapitalize="off" spellcheck="false" />
        </fieldset>

        <p class="mt-4 font-mono text-xs break-all opacity-40">{% raw %}{{ preview || '—' }}{% endraw %}</p>

        <div class="modal-action mt-8">
          <button v-if="editing.id" class="btn btn-ghost text-error mr-auto rounded-full" @click="removeWatch(editing)">Delete</button>
          <button class="btn btn-ghost rounded-full" @click="editing = null">Cancel</button>
          <button class="btn btn-primary rounded-full px-6" :disabled="!canSave" @click="saveWatch">Save</button>
        </div>
      </div>
      <div class="modal-backdrop bg-neutral/30" @click="editing = null"></div>
    </div>

    <!-- Settings -->
    <div v-if="showSettings" class="modal modal-open" role="dialog">
      <div class="modal-box max-w-lg rounded-[1.75rem] p-8">
        <h3 class="text-2xl font-extrabold tracking-tight">Settings</h3>

        <fieldset class="fieldset">
          <legend class="fieldset-legend">Theme</legend>
          <div class="join">
            <button v-for="t in ['system','light','dark']" :key="t"
              class="btn join-item capitalize" :class="{ 'btn-primary': settings.theme === t }"
              @click="setTheme(t)">{% raw %}{{ t }}{% endraw %}</button>
          </div>
        </fieldset>

        <fieldset class="fieldset">
          <legend class="fieldset-legend">Text size</legend>
          <div class="join">
            <button v-for="(s, i) in sizes" :key="s"
              class="btn join-item" :class="{ 'btn-primary': settings.size === i }"
              @click="setSize(i)">{% raw %}{{ s }}{% endraw %}</button>
          </div>
        </fieldset>

        <label class="label cursor-pointer justify-start gap-3 py-3">
          <input type="checkbox" class="checkbox checkbox-primary checkbox-sm" :checked="settings.checkOnLoad"
            @change="settings.checkOnLoad = $event.target.checked; persist()" />
          <span>Check when the page opens</span>
        </label>

        <label class="label cursor-pointer justify-start gap-3 py-3">
          <input type="checkbox" class="checkbox checkbox-primary checkbox-sm" :checked="settings.notifications" @change="toggleNotifications" />
          <span>Notify me about new listings</span>
        </label>

        <fieldset class="fieldset">
          <legend class="fieldset-legend">Read through a proxy (optional)</legend>
          <input v-model="settings.proxy" @change="persist" class="input w-full" placeholder="https://your-proxy.example/?url={url}" autocapitalize="off" spellcheck="false" />
          <p class="label whitespace-normal">Browsers refuse to read another site's feed unless that site allows it, and almost none do. Craigslist blocks it outright and dropped RSS, so its searches open in a tab. Put your own proxy here and use {url} for the address. Nothing is sent anywhere until you fill this in.</p>
        </fieldset>

        <div class="modal-action mt-8">
          <button class="btn btn-ghost text-error mr-auto rounded-full" @click="clearAll">Clear everything</button>
          <button class="btn btn-primary rounded-full px-6" @click="showSettings = false">Done</button>
        </div>
      </div>
      <div class="modal-backdrop bg-neutral/30" @click="showSettings = false"></div>
    </div>

    <div v-if="note" class="toast toast-center z-50">
      <div class="alert alert-info rounded-full">{% raw %}{{ note }}{% endraw %}</div>
    </div>
   </div>
  </div>

  {% pageJs "craigslist-feed-builder" %}
</body>
</html>
