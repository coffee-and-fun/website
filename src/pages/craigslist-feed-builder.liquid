<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>Craigslist Feed Builder &amp; Listing Watcher - Coffee &amp; Fun LLC</title>
  <meta name="description" content="Build Craigslist searches for any city, save them as watches, and track new listings alongside any RSS feed. Prices, new-item alerts, dark mode. Everything stays in your browser." />
  <meta name="keywords" content="craigslist rss, craigslist feed builder, craigslist search alerts, craigslist notifications, rss watcher, listing tracker, marketplace alerts" />
  <meta name="author" content="Coffee &amp; Fun LLC" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://www.coffeeandfun.com/craigslist-feed-builder/" />
  <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />
  <meta name="theme-color" content="#f1f3f4" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Coffee &amp; Fun" />
  <meta property="og:title" content="Craigslist Feed Builder &amp; Listing Watcher - Coffee &amp; Fun LLC" />
  <meta property="og:description" content="Build Craigslist searches for any city, save them as watches, and track new listings alongside any RSS feed. Everything stays in your browser." />
  <meta property="og:url" content="https://www.coffeeandfun.com/craigslist-feed-builder/" />
  <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/home.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Coffee &amp; Fun card with the coffee cup logo and the tagline Crafting software, one brew at a time" />
  <meta property="og:locale" content="en_US" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@bycoffeeandfun" />
  <meta name="twitter:title" content="Craigslist Feed Builder &amp; Listing Watcher - Coffee &amp; Fun LLC" />
  <meta name="twitter:description" content="Build Craigslist searches for any city, save them as watches, and track new listings alongside any RSS feed. Everything stays in your browser." />
  <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/home.png" />
  <meta name="twitter:image:alt" content="Coffee &amp; Fun card with the coffee cup logo and the tagline Crafting software, one brew at a time" />

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Craigslist Feed Builder & Listing Watcher",
      "description": "Build Craigslist search URLs for any city and category, save them as watches, and track new listings alongside any RSS or Atom feed. Runs entirely in the browser with nothing stored on a server.",
      "url": "https://www.coffeeandfun.com/craigslist-feed-builder/",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "Web Browser",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "publisher": { "@id": "https://www.coffeeandfun.com/#organization" },
      "creator": { "@id": "https://www.coffeeandfun.com/#founder" },
      "isAccessibleForFree": true,
      "inLanguage": "en"
    }
  </script>

  <script src="https://unpkg.com/vue@3"></script>

  {% bundledCss %}
{% include schema-org.liquid %}
</head>

  <script src="https://unpkg.com/vue@3"></script>
</head>

<body class="bg-base-200 min-h-screen">
  <div v-cloak id="app">
   <div :class="{ 'text-sm': settings.size === 0, 'text-base': settings.size === 1, 'text-lg': settings.size === 2, 'text-xl': settings.size === 3 }">

    <a href="#main-content" class="btn btn-primary sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50">Skip to the watches</a>

    <div class="navbar bg-base-100 border-b border-base-300 sticky top-0 z-30 px-2 sm:px-4">
      <div class="flex-1 gap-2">
        <a href="/" class="btn btn-ghost btn-circle" aria-label="Coffee &amp; Fun home">
          <svg viewBox="0 -960 960 960" class="size-6" fill="currentColor" aria-hidden="true"><path d="M400-80 0-480l400-400 71 71-329 329 329 329-71 71Z"/></svg>
        </a>
        <span class="text-lg font-semibold">Listing Watcher</span>
      </div>
      <div class="flex-none gap-1">
        <button class="btn btn-primary btn-soft" @click="checkAll" :disabled="checking || !watches.length">
          <span v-if="checking" class="loading loading-spinner loading-sm"></span>
          <svg v-else viewBox="0 -960 960 960" class="size-5" fill="currentColor" aria-hidden="true"><path d="M480-160q-134 0-227-93t-93-227q0-134 93-227t227-93q69 0 132 28.5T720-690v-110h80v280H520v-80h168q-32-56-87.5-88T480-720q-100 0-170 70t-70 170q0 100 70 170t170 70q77 0 139-44t87-116h84q-28 106-114 173t-196 67Z"/></svg>
          <span class="hidden sm:inline">{% raw %}{{ checking ? 'Checking' : 'Check now' }}{% endraw %}</span>
        </button>
        <button class="btn btn-ghost btn-circle" @click="showSettings = true" aria-label="Settings">
          <svg viewBox="0 -960 960 960" class="size-6" fill="currentColor" aria-hidden="true"><path d="m370-80-16-128q-13-5-24.5-12T307-235l-119 50L78-375l103-78q-1-7-1-13.5v-27q0-6.5 1-13.5L78-585l110-190 119 50q11-8 23-15t24-12l16-128h220l16 128q13 5 24.5 12t22.5 15l119-50 110 190-103 78q1 7 1 13.5v27q0 6.5-2 13.5l103 78-110 190-118-50q-11 8-23 15t-24 12L590-80H370Zm112-260q58 0 99-41t41-99q0-58-41-99t-99-41q-59 0-99.5 41T342-480q0 58 40.5 99t99.5 41Z"/></svg>
        </button>
      </div>
    </div>

    <main id="main-content" class="mx-auto max-w-6xl p-4 sm:p-6">
      <div class="grid gap-6 lg:grid-cols-3">

        <aside class="lg:col-span-1">
          <div class="card bg-base-100 shadow-sm lg:sticky lg:top-24">
            <div class="card-body p-3">
              <ul class="menu w-full p-0">
                <li>
                  <button :class="{ 'menu-active': active === 'all' }" @click="active = 'all'">
                    <span class="flex-1 text-left font-medium">All listings</span>
                    <span v-if="freshCount" class="badge badge-primary badge-sm">{% raw %}{{ freshCount }}{% endraw %}</span>
                    <span v-else class="opacity-50">{% raw %}{{ items.length }}{% endraw %}</span>
                  </button>
                </li>
                <li v-for="w in watches" :key="w.id">
                  <button :class="{ 'menu-active': active === w.id }" @click="active = w.id">
                    <span class="status" :class="{ 'status-primary': w.colour === 'primary', 'status-secondary': w.colour === 'secondary', 'status-accent': w.colour === 'accent', 'status-info': w.colour === 'info', 'status-success': w.colour === 'success', 'status-warning': w.colour === 'warning', 'status-error': w.colour === 'error' }" aria-hidden="true"></span>
                    <span class="flex-1 truncate text-left font-medium">{% raw %}{{ w.name }}{% endraw %}</span>
                    <span v-if="(counts[w.id] || {}).fresh" class="badge badge-primary badge-sm">{% raw %}{{ counts[w.id].fresh }}{% endraw %}</span>
                    <span v-else class="opacity-50">{% raw %}{{ (counts[w.id] || {}).total || 0 }}{% endraw %}</span>
                  </button>
                </li>
              </ul>

              <div class="divider my-1"></div>

              <button class="btn btn-primary btn-block" @click="newWatch('craigslist')">Craigslist search</button>
              <button class="btn btn-block" @click="newWatch('feed')">Any RSS feed</button>
            </div>
          </div>
        </aside>

        <section class="lg:col-span-2 flex flex-col gap-4">

          <div class="flex flex-wrap items-center gap-3">
            <span class="opacity-60">{% raw %}{{ checkedAt ? 'Checked ' + ago(checkedAt) : 'Not checked yet' }}{% endraw %}</span>
            <button v-if="freshCount" class="btn btn-ghost btn-sm" @click="markSeen">Mark all seen</button>
          </div>

          <div v-for="w in blocked" :key="'b' + w.id" role="alert" class="alert alert-warning alert-soft">
            <svg viewBox="0 -960 960 960" class="size-5" fill="currentColor" aria-hidden="true"><path d="M40-120l440-760 440 760H40Zm138-80h604L480-720 178-200Zm302-40q17 0 28.5-11.5T520-280q0-17-11.5-28.5T480-320q-17 0-28.5 11.5T440-280q0 17 11.5 28.5T480-240Zm-40-120h80v-200h-80v200Z"/></svg>
            <span><strong>{% raw %}{{ w.name }}{% endraw %}</strong> — {% raw %}{{ status[w.id].message }}{% endraw %}.</span>
            <a class="btn btn-sm" :href="urlFor(w)" target="_blank" rel="noopener">Open it</a>
          </div>

          <div v-if="!watches.length" class="card bg-base-100 shadow-sm">
            <div class="card-body items-center py-14 text-center">
              <h2 class="card-title">Watch something</h2>
              <p class="max-w-sm opacity-70">Build a Craigslist search for any city, or paste an RSS feed. New listings get flagged each time you open this page.</p>
              <button class="btn btn-primary mt-2" @click="newWatch('craigslist')">Build your first search</button>
            </div>
          </div>

          <div v-else-if="!shown.length" class="card bg-base-100 shadow-sm">
            <div class="card-body items-center py-14 text-center">
              <h2 class="card-title">Nothing here yet</h2>
              <p class="max-w-md opacity-70">Craigslist blocks reading its searches from a browser, so those open in a tab instead. Feeds that allow it will fill this in.</p>
            </div>
          </div>

          <ul v-else class="list bg-base-100 rounded-box shadow-sm">
            <li v-for="i in shown" :key="i.watchId + i.key" class="list-row items-center">
              <span class="status" :class="{ 'status-primary': i.colour === 'primary', 'status-secondary': i.colour === 'secondary', 'status-accent': i.colour === 'accent', 'status-info': i.colour === 'info', 'status-success': i.colour === 'success', 'status-warning': i.colour === 'warning', 'status-error': i.colour === 'error' }" aria-hidden="true"></span>
              <a class="min-w-0 flex-1" :href="i.link" target="_blank" rel="noopener">
                <div class="flex flex-wrap items-center gap-2">
                  <span v-if="i.fresh" class="badge badge-primary badge-sm">New</span>
                  <span class="truncate font-medium">{% raw %}{{ i.title }}{% endraw %}</span>
                </div>
                <div class="text-xs opacity-60">{% raw %}{{ i.watchName }}{{ i.time ? ' · ' + ago(i.time) : '' }}{% endraw %}</div>
                <p v-if="i.desc" class="mt-1 line-clamp-2 text-sm opacity-70">{% raw %}{{ i.desc }}{% endraw %}</p>
              </a>
              <span v-if="i.price" class="badge badge-success badge-soft font-semibold">{% raw %}{{ i.price }}{% endraw %}</span>
            </li>
          </ul>
        </section>
      </div>
    </main>

    <!-- Watch editor -->
    <div v-if="editing" class="modal modal-open" role="dialog">
      <div class="modal-box max-w-lg">
        <h3 class="text-lg font-semibold">
          {% raw %}{{ editing.id ? 'Edit watch' : (editing.kind === 'craigslist' ? 'New Craigslist search' : 'New feed') }}{% endraw %}
        </h3>

        <fieldset class="fieldset">
          <legend class="fieldset-legend">Name</legend>
          <input v-model="editing.name" class="input w-full" placeholder="Cheap couches" />
        </fieldset>

        <template v-if="editing.kind === 'craigslist'">
          <div class="grid gap-3 sm:grid-cols-2">
            <fieldset class="fieldset">
              <legend class="fieldset-legend">City</legend>
              <input v-model="editing.site" class="input w-full" list="cl-sites" placeholder="sfbay" autocapitalize="off" spellcheck="false" />
              <datalist id="cl-sites"><option v-for="s in sites" :key="s" :value="s"></option></datalist>
              <p class="label">The bit before .craigslist.org</p>
            </fieldset>
            <fieldset class="fieldset">
              <legend class="fieldset-legend">Category</legend>
              <select v-model="editing.category" class="select w-full">
                <option v-for="c in categories" :key="c.id" :value="c.id">{% raw %}{{ c.label }}{% endraw %}</option>
              </select>
            </fieldset>
          </div>

          <fieldset class="fieldset">
            <legend class="fieldset-legend">Search terms</legend>
            <input v-model="editing.query" class="input w-full" placeholder="couch, playstation, bike" />
          </fieldset>

          <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            <fieldset class="fieldset"><legend class="fieldset-legend">Min $</legend><input v-model="editing.minPrice" type="number" inputmode="numeric" min="0" class="input w-full" /></fieldset>
            <fieldset class="fieldset"><legend class="fieldset-legend">Max $</legend><input v-model="editing.maxPrice" type="number" inputmode="numeric" min="0" class="input w-full" /></fieldset>
            <fieldset class="fieldset"><legend class="fieldset-legend">Postcode</legend><input v-model="editing.postal" inputmode="numeric" class="input w-full" /></fieldset>
            <fieldset class="fieldset"><legend class="fieldset-legend">Miles</legend><input v-model="editing.distance" type="number" inputmode="numeric" min="0" class="input w-full" /></fieldset>
          </div>

          <label class="label cursor-pointer justify-start gap-3 py-2">
            <input type="checkbox" v-model="editing.hasImage" class="checkbox checkbox-primary" />
            <span>Only listings with a photo</span>
          </label>
        </template>

        <fieldset v-else class="fieldset">
          <legend class="fieldset-legend">Feed address</legend>
          <input v-model="editing.feedUrl" type="url" inputmode="url" class="input w-full" placeholder="https://example.com/feed.xml" autocapitalize="off" spellcheck="false" />
        </fieldset>

        <div class="bg-base-200 rounded-box mt-3 p-3">
          <p class="text-xs font-semibold opacity-60">This builds</p>
          <p class="mt-1 font-mono text-xs break-all opacity-80">{% raw %}{{ preview || '—' }}{% endraw %}</p>
        </div>

        <div class="modal-action">
          <button v-if="editing.id" class="btn btn-error btn-ghost mr-auto" @click="removeWatch(editing)">Delete</button>
          <a v-if="preview" class="btn btn-ghost" :href="preview" target="_blank" rel="noopener">Preview</a>
          <button class="btn" @click="editing = null">Cancel</button>
          <button class="btn btn-primary" :disabled="!canSave" @click="saveWatch">Save</button>
        </div>
      </div>
      <div class="modal-backdrop bg-neutral/40" @click="editing = null"></div>
    </div>

    <!-- Settings -->
    <div v-if="showSettings" class="modal modal-open" role="dialog">
      <div class="modal-box max-w-lg">
        <h3 class="text-lg font-semibold">Settings</h3>

        <fieldset class="fieldset">
          <legend class="fieldset-legend">Theme</legend>
          <div class="join">
            <button v-for="t in ['system','light','dark']" :key="t"
              class="btn join-item capitalize" :class="{ 'btn-primary': settings.theme === t }"
              @click="setTheme(t)">{% raw %}{{ t }}{% endraw %}</button>
          </div>
        </fieldset>

        <fieldset class="fieldset">
          <legend class="fieldset-legend">Text size</legend>
          <div class="join">
            <button v-for="(s, i) in sizes" :key="s"
              class="btn join-item" :class="{ 'btn-primary': settings.size === i }"
              @click="setSize(i)">{% raw %}{{ s }}{% endraw %}</button>
          </div>
        </fieldset>

        <label class="label cursor-pointer justify-start gap-3 py-2">
          <input type="checkbox" class="checkbox checkbox-primary" :checked="settings.checkOnLoad"
            @change="settings.checkOnLoad = $event.target.checked; persist()" />
          <span>Check when the page opens</span>
        </label>

        <label class="label cursor-pointer justify-start gap-3 py-2">
          <input type="checkbox" class="checkbox checkbox-primary" :checked="settings.notifications" @change="toggleNotifications" />
          <span>Notify me about new listings</span>
        </label>

        <fieldset class="fieldset">
          <legend class="fieldset-legend">Read through a proxy (optional)</legend>
          <input v-model="settings.proxy" @change="persist" class="input w-full" placeholder="https://your-proxy.example/?url={url}" autocapitalize="off" spellcheck="false" />
          <p class="label whitespace-normal">Browsers refuse to read another site's feed unless that site allows it, and almost none do. Craigslist blocks it outright and dropped RSS, so its searches open in a tab. Put your own proxy here and use {url} for the address. Nothing is sent anywhere until you fill this in.</p>
        </fieldset>

        <div class="modal-action">
          <button class="btn btn-error btn-ghost mr-auto" @click="clearAll">Clear everything</button>
          <button class="btn btn-primary" @click="showSettings = false">Done</button>
        </div>
      </div>
      <div class="modal-backdrop bg-neutral/40" @click="showSettings = false"></div>
    </div>

    <div v-if="note" class="toast toast-center z-50">
      <div class="alert alert-info">{% raw %}{{ note }}{% endraw %}</div>
    </div>
   </div>
  </div>

  {% pageJs "craigslist-feed-builder" %}
</body>
</html>
