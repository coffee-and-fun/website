<!DOCTYPE html>
<html class="antialiased" lang="en" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary Meta Tags -->
    <title>Free Time Zone Converter - Coffee & Fun LLC</title>
    <meta name="title" content="Free Time Zone Converter - Coffee & Fun LLC" />
    <meta name="description" content="Pick a city and instantly see the local time there, how far ahead or behind you they are, and whether it's a decent hour to call. Live, free, and private." />
    <meta name="author" content="Coffee & Fun LLC" />
    <meta name="robots" content="index, follow" />

    <!-- Canonical URL -->
    <link rel="canonical" href="https://www.coffeeandfun.com/timezone-converter/" />

    <!-- Favicon -->
    <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coffee & Fun" />
    <meta property="og:title" content="Free Time Zone Converter - Coffee & Fun LLC" />
    <meta property="og:description" content="Pick a city and instantly see the local time there, how far ahead or behind you they are, and whether it's a decent hour to call. Live, free, and private." />
    <meta property="og:url" content="https://www.coffeeandfun.com/timezone-converter/" />
    <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/timezone-converter.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Smiling cartoon Earth with two clocks and the words Time Zone Converter, what time is it there?" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bycoffeeandfun" />
    <meta name="twitter:title" content="Free Time Zone Converter - Coffee & Fun LLC" />
    <meta name="twitter:description" content="Pick a city and instantly see the local time there, how far ahead or behind you they are, and whether it's a decent hour to call. Live, free, and private." />
    <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/timezone-converter.png" />
    <meta name="twitter:image:alt" content="Smiling cartoon Earth with two clocks and the words Time Zone Converter, what time is it there?" />

    <meta name="theme-color" content="#f4f4f2" />

    <!-- Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "Free Time Zone Converter",
        "description": "See the live local time in any city, how far ahead or behind you it is, and whether it's a reasonable hour to call. Handles daylight saving automatically.",
        "url": "https://www.coffeeandfun.com/timezone-converter/",
        "applicationCategory": "UtilitiesApplication",
        "operatingSystem": "Web Browser",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "featureList": [
          "Live local time in 400+ places",
          "Plain-English time difference",
          "Good-time-to-call indicator",
          "Plan a call at any date and time",
          "Automatic daylight saving handling"
        ],
        "publisher": {
          "@id": "https://www.coffeeandfun.com/#organization"
        },
        "creator": {
          "@id": "https://www.coffeeandfun.com/#founder"
        },
        "isAccessibleForFree": true,
        "inLanguage": "en"
      }
    </script>

    <script src="https://unpkg.com/vue@3"></script>
    <script src="https://cdn.jsdelivr.net/npm/luxon@3.4.4/build/global/luxon.min.js"></script>

    {% pageCss "timezone-converter" %}
    {% include sketch-styles.liquid %}
{% include schema-org.liquid %}

    </head>

<body>
{% raw %}
    <a href="#tool" class="skip">Skip to the tool</a>

    <!-- Shown only if the CDN scripts fail, the app stays v-cloak-hidden. -->
    <div id="load-fallback" class="wrap" hidden>
        <p class="lede">This tool couldn&rsquo;t load a couple of files it needs. Check your connection and refresh the page.</p>
    </div>
    <noscript>
        <div class="wrap"><p class="lede">This tool needs JavaScript turned on to work.</p></div>
    </noscript>

    <main v-cloak id="app" class="wrap">

        <div class="topbar">
            <a href="/" class="home-link" aria-label="Back to coffeeandfun.com">
                <img src="/assets/images/brand/coffee-and-fun-logo-dark.png" alt="" width="40" height="40" decoding="async" />
                <span class="tip" aria-hidden="true">Back to coffeeandfun.com</span>
            </a>
        </div>

        <header id="tool">
            <h1>See what time it is there</h1>
            <p class="lede">Pick a place and see the local time right now, plus whether it&rsquo;s a decent hour to call. Planning ahead? You can check any time, too.</p>
        </header>

        <p class="your-line">
            It&rsquo;s <strong><time :datetime="myNow.toISO()">{{ fmtTime(myNow) }}</time> on {{ fmtWeekday(myNow) }}</strong> for you in {{ cityName(fromZone) }}.
            <button type="button" class="linkish" @click="showFromPicker = !showFromPicker"
                    :aria-expanded="showFromPicker ? 'true' : 'false'" aria-controls="from-picker">
                {{ showFromPicker ? 'Hide the time zone list' : 'Not ' + cityName(fromZone) + '?' }}
            </button>
        </p>

        <div v-if="showFromPicker" class="from-picker" id="from-picker">
            <label class="f-label" for="tz-from">Your time zone</label>
            <select id="tz-from" class="field" v-model="fromZone">
                <optgroup v-for="g in zoneGroups" :key="g.label" :label="g.label">
                    <option v-for="z in g.items" :key="z.value" :value="z.value">{{ z.label }}</option>
                </optgroup>
            </select>
            <p class="hint">
                Tip: with the list open, type a city name to jump to it.
                <button v-if="fromZone !== detectedZone" type="button" class="linkish small" @click="fromZone = detectedZone">Use my detected time zone ({{ cityName(detectedZone) }})</button>
            </p>
        </div>

        <!-- Live status for screen readers -->
        <div class="sr-only" role="status" aria-live="polite">{{ announcement }}</div>

        <!-- ===== Step 1: pick their city ===== -->
        <section class="step" aria-labelledby="h-city">
            <fieldset class="cities">
                <legend><h2 class="step-label" id="h-city">1, Pick their city</h2></legend>
                <div class="chips">
                    <label class="chip" v-for="c in cities" :key="c.zone" :class="{ on: toZone === c.zone }">
                        <input type="radio" class="sr-only" name="place" :value="c.zone" v-model="toZone" @change="announcePick" />
                        <span class="chip-name">{{ c.name }}</span>
                        <span class="chip-eg"><time :datetime="zoneNowISO(c.zone)">{{ fmtTime(now.setZone(c.zone)) }}</time></span>
                    </label>
                </div>
            </fieldset>

            <div class="elsewhere">
                <label class="f-label" for="tz-to">Somewhere else, all 400+ places</label>
                <select id="tz-to" class="field" v-model="toZone" aria-describedby="tz-to-hint" @change="announcePick">
                    <optgroup v-for="g in zoneGroups" :key="g.label" :label="g.label">
                        <option v-for="z in g.items" :key="z.value" :value="z.value">{{ z.label }}</option>
                    </optgroup>
                </select>
                <p class="hint" id="tz-to-hint">Tip: with the list open, type a city name to jump to it.</p>
            </div>
        </section>

        <!-- ===== Step 2: the answer ===== -->
        <section class="step" aria-labelledby="h-there">
            <h2 class="step-label" id="h-there">2, The time there</h2>

            <div class="result">
                <span v-if="!pinned" class="live-tag"><span class="live-dot" aria-hidden="true"></span> live</span>
                <p class="big-time">
                    <time :datetime="theirDT.toISO()">{{ fmtTime(theirDT) }}</time>
                    <span class="day">{{ fmtWeekday(theirDT) }}</span>
                </p>
                <p class="sentence" v-html="sentenceHtml"></p>
                <p class="status">
                    <svg v-if="isNightThere" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                    <svg v-else width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
                    <span>{{ statusText }}</span>
                </p>
                <p class="zone-meta">{{ zoneMeta }}</p>
            </div>

            <div class="io-row">
                <button type="button" class="linkish small" @click="copyLine">{{ copied ? 'Copied ✓' : 'Copy this line' }}</button>
                <span v-if="copyFailed" class="copy-note bad">Copy didn&rsquo;t work, select the sentence and press Ctrl+C or Cmd+C.</span>
            </div>

            <!-- Planning -->
            <details class="more" ref="plan" @toggle="onPlanToggle">
                <summary>Planning a call? Check a different time</summary>

                <fieldset class="whose">
                    <legend>The time you type below is&hellip;</legend>
                    <label><input type="radio" value="mine" v-model="anchor" name="whose" @change="announceAnchor" /> my time</label>
                    <label><input type="radio" value="theirs" v-model="anchor" name="whose" @change="announceAnchor" /> their time in {{ cityName(toZone) }}</label>
                </fieldset>

                <div class="plan-grid">
                    <div>
                        <label class="f-label" for="tz-date">On this date</label>
                        <input id="tz-date" class="field" type="date" v-model="planDate" min="1900-01-01" max="2100-12-31" />
                    </div>
                    <div>
                        <label class="f-label" for="tz-time">At this time</label>
                        <input id="tz-time" class="field" type="time" v-model="planTime" />
                    </div>
                </div>

                <p v-if="gapNote" class="gap-note">{{ gapNote }}</p>

                <p class="plan-actions">
                    <button type="button" class="linkish" @click="backToNow">Back to right now</button>
                </p>
            </details>
        </section>

        <p class="foot">Daylight saving is handled for you, automatically. Everything happens in your browser.</p>
    </main>
{% endraw %}

    {% include footer.liquid %}

    {% pageJs "timezone-converter" %}
</body>
</html>
