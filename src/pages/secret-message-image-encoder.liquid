    <title>Free Secret Message Image Encoder - Coffee & Fun LLC</title>
    <meta name="title" content="Free Secret Message Image Encoder - Coffee & Fun LLC" />
    <meta name="description" content="Hide secret messages inside images with steganography, then decode them later. Everything runs locally in your browser, and nothing is ever uploaded." />
    <meta name="keywords" content="steganography, hide text in image, secret message, image encoder, privacy tool, Coffee & Fun" />
    <meta name="author" content="Coffee & Fun LLC" />
    <meta name="robots" content="index, follow" />

    <!-- Canonical URL -->
    <link rel="canonical" href="https://www.coffeeandfun.com/secret-message-image-encoder/" />

    <!-- Favicon -->
    <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />

    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coffee & Fun" />
    <meta property="og:title" content="Free Secret Message Image Encoder - Coffee & Fun LLC" />
    <meta property="og:description" content="Hide secret messages inside images with steganography, then decode them later. Everything runs locally in your browser, and nothing is ever uploaded." />
    <meta property="og:url" content="https://www.coffeeandfun.com/secret-message-image-encoder/" />
    <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/secret-message-image-encoder.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Free Secret Message Image Encoder by Coffee & Fun - Hide Text in Images" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bycoffeeandfun" />
    <meta name="twitter:creator" content="@bycoffeeandfun" />
    <meta name="twitter:title" content="Free Secret Message Image Encoder - Coffee & Fun LLC" />
    <meta name="twitter:description" content="Hide secret messages inside images with steganography, then decode them later. Everything runs locally in your browser, and nothing is ever uploaded." />
    <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/secret-message-image-encoder.png" />
    <meta name="twitter:image:alt" content="Free Secret Message Image Encoder by Coffee & Fun - Hide Text in Images" />
    <meta name="twitter:domain" content="coffeeandfun.com" />
    <meta name="twitter:url" content="https://www.coffeeandfun.com/secret-message-image-encoder/" />

    <!-- PWA and Mobile Enhancement -->
    <meta name="theme-color" content="#fef5ec" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Secret Message Encoder" />

    <!-- Enhanced Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "@id": "https://www.coffeeandfun.com/secret-message-image-encoder/#webpage",
        "url": "https://www.coffeeandfun.com/secret-message-image-encoder/",
        "name": "Free Secret Message Image Encoder",
        "description": "Hide secret messages in images using steganography with our privacy-focused tool.",
        "about": {
          "@type": "Thing",
          "name": "Steganography Tool"
        },
        "applicationCategory": "UtilitiesApplication",
        "publisher": {
          "@id": "https://www.coffeeandfun.com/#organization"
        },
        "creator": {
          "@id": "https://www.coffeeandfun.com/#founder"
        },
        "isAccessibleForFree": true,
        "inLanguage": "en",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "featureList": [
          "Hide text in images",
          "Reveal hidden messages",
          "Automatic timestamping",
          "Local processing",
          "No data tracking",
          "PNG export"
        ]
      }
    </script>

    <script src="https://unpkg.com/vue@3"></script>

    {% bundledCss %}
    {% pageCss "secret-message-image-encoder" %}
    {% include sketch-styles.liquid %}
{% include schema-org.liquid %}

    </head>

<body>
    {% include header.liquid %}

    <a href="#tool" class="skip">Skip to the tool</a>

    <!-- Shown only if the Vue CDN fails, the app stays v-cloak-hidden. -->
    <div id="load-fallback" class="wrap" hidden>
        <p class="lede">This tool couldn&rsquo;t load a file it needs. Check your connection and refresh the page.</p>
    </div>
    <noscript>
        <div class="wrap"><p class="lede">This tool needs JavaScript turned on to work.</p></div>
    </noscript>
{% raw %}
    <main v-cloak id="main-content" class="wrap">

        <header id="tool">
            <h1 class="brand-heading text-3xl sm:text-4xl">Hide a message inside a picture</h1>
            <p class="lede">Type a secret, drop in any picture, and get back one that looks identical, with your words tucked invisibly inside.</p>

            <!-- Sketch: sparkle top-right -->
            <div class="sketch-note sketch-float" style="top: -14px; right: -4%; --sketch-rotate: 8deg;">
                <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24">
                    <path d="M12 2 L13.5 10.5 L22 12 L13.5 13.5 L12 22 L10.5 13.5 L2 12 L10.5 10.5 Z" class="sketch-sparkle"/>
                </svg>
            </div>

            <!-- Sketch: "shhh…" pointing down at the mode switch -->
            <div class="sketch-note text-base" style="bottom: -18px; right: 5%; transform: rotate(-4deg);">
                shhh&hellip;
                <svg aria-hidden="true" width="26" height="22" viewBox="0 0 28 24" style="position: relative; display: inline-block; margin-left: 2px; vertical-align: middle;">
                    <path d="M2 4 C10 4, 20 8, 24 20 M24 20 L17 17 M24 20 L25 12" class="sketch-arrow"/>
                </svg>
            </div>

            <!-- Sketch: squiggle under the heading, left edge -->
            <div class="sketch-note" style="top: 48%; left: -3%;">
                <svg aria-hidden="true" width="30" height="10" viewBox="0 0 34 12">
                    <path d="M2 6 C6 1, 10 11, 14 6 C18 1, 22 11, 26 6 C28 3, 30 5, 32 6" class="sketch-squiggle"/>
                </svg>
            </div>

            <!-- Sketch: dashed circle, right of the lede -->
            <div class="sketch-note sketch-float-slow" style="top: 55%; right: -2%; --sketch-rotate: -6deg;">
                <svg aria-hidden="true" width="26" height="26" viewBox="0 0 36 36">
                    <circle cx="18" cy="18" r="12" class="sketch-circle" transform="rotate(20 18 18)"/>
                </svg>
            </div>

            <!-- Sketch: small cross, far left -->
            <div class="sketch-note sketch-wiggle" style="top: 8px; left: -4%; --sketch-rotate: -12deg;">
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16">
                    <path d="M3 3 L13 13 M13 3 L3 13" class="sketch-cross"/>
                </svg>
            </div>
        </header>

        <!-- Live status for screen readers -->
        <div class="sr-only" role="status" aria-live="polite">{{ announcement }}</div>

        <!-- Mode switch: real daisyUI tabs over native radios, so arrow keys work. -->
        <fieldset class="cf-mode-set">
            <legend class="sr-only">Choose what to do</legend>
            <div class="tabs tabs-box cf-mode-tabs">
                <input type="radio" name="cf-mode" class="tab" id="tab-encode" aria-label="Hide"
                       value="encode" v-model="mode" @change="setMode(mode)" />
                <input type="radio" name="cf-mode" class="tab" id="tab-decode" aria-label="Reveal"
                       value="decode" v-model="mode" @change="setMode(mode)" />
            </div>
        </fieldset>

        <!-- ===== HIDE ===== -->
        <section v-if="mode === 'encode'" role="tabpanel" aria-labelledby="tab-encode">

            <section class="cf-step" aria-labelledby="h-pic">
                <h2 class="step-label" id="h-pic">1, Pick a picture</h2>
                <label v-if="!originalImage" for="enc-file" class="drop" :class="{ drag: dragEnc }"
                       @dragover.prevent="dragEnc = true" @dragleave="dragEnc = false" @drop.prevent="dropEncode">
                    <div class="ico"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg></div>
                    <div class="main">Drop a picture, or click to choose</div>
                    <!-- aria-hidden but still the aria-describedby target: a node referenced
                         directly by aria-describedby stays in the description, aria-hidden only
                         keeps it out of the wrapping label's accessible name, so the format
                         guidance is spoken once as a description instead of twice. -->
                    <div class="sub" id="enc-file-help" aria-hidden="true">JPG, PNG, or WEBP, anything works</div>
                    <input id="enc-file" ref="imageInput" type="file" accept="image/*" class="sr-only" @change="handleImageUpload" aria-describedby="enc-file-help" />
                </label>

                <div v-else class="thumb-row">
                    <img :src="originalImage" alt="" class="thumb" />
                    <div class="thumb-meta">
                        <div class="name">{{ encName || 'Your picture' }}</div>
                        <div class="dim">{{ encW }} × {{ encH }} px · fits about {{ capacity.toLocaleString() }} characters</div>
                    </div>
                    <button type="button" class="btn btn-ghost btn-sm" @click="resetEncoder" aria-label="Remove picture and start over">Change</button>
                </div>
            </section>

            <section class="cf-step" aria-labelledby="h-msg">
                <h2 class="step-label" id="h-msg">2, Your secret message</h2>
                <label class="sr-only" for="enc-msg">Your secret message</label>
                <textarea id="enc-msg" class="msg" v-model="secretMessage"
                          placeholder="Meet me by the old oak at noon…"
                          aria-describedby="enc-count"></textarea>
                <div id="enc-count" class="counter">
                    <span>{{ secretMessage.length.toLocaleString() }} characters</span>
                    <span v-if="originalImage" :class="{ over: overCapacity }">
                        {{ overCapacity ? (secretMessage.length - capacity).toLocaleString() + ' too many for this picture' : (capacity - secretMessage.length).toLocaleString() + ' left' }}
                    </span>
                </div>
            </section>

            <section class="cf-step" aria-labelledby="h-hide">
                <h2 class="step-label" id="h-hide">3, Hide it</h2>
                <button type="button" class="btn btn-lg cf-go" style="--btn-color: var(--color-cocoa); --btn-fg: #fff"
                        @click="encodeMessage" :disabled="!canEncode">
                    <span v-if="processing" class="loading loading-spinner loading-sm" aria-hidden="true"></span>
                    {{ processing ? 'Hiding…' : 'Hide message in picture' }}
                </button>
                <p v-if="!originalImage || !secretMessage.trim()" class="copy-note">Pick a picture and type a message first.</p>
                <div v-if="originalImage && overCapacity" class="banner warn">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4"/><path d="M12 17h.01"/><circle cx="12" cy="12" r="10"/></svg>
                    <span>Your message is longer than this picture can hold. Shorten it, or use a bigger picture.</span>
                </div>
            </section>

            <div v-if="encodedImage" class="result">
                <img :src="encodedImage" alt="Your picture with the message hidden inside, it looks identical to the original" class="out" />
                <div class="result-actions">
                    <button type="button" class="btn btn-lg" style="--btn-color: var(--color-cocoa); --btn-fg: #fff" @click="downloadEncodedImage">Download picture</button>
                    <button type="button" class="btn btn-lg btn-outline" style="--btn-color: var(--color-cocoa)" @click="resetEncoder">Hide another</button>
                </div>
                <div class="note">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                    <span>Done. Save it as a PNG and share it. The message survives only if the file stays a PNG, sending it through apps that re-compress images (like some chats) can wipe it.</span>
                </div>
            </div>
        </section>

        <!-- ===== REVEAL ===== -->
        <section v-if="mode === 'decode'" role="tabpanel" aria-labelledby="tab-decode">

            <h2 class="panel-title">Reveal a hidden message</h2>
            <p class="lede">Upload a picture made here and read the message hidden in it. Everything happens on your device.</p>

            <section class="cf-step" aria-labelledby="h-upload">
                <h2 class="step-label" id="h-upload">1, Upload the picture</h2>
                <label v-if="!decodeImage" for="dec-file" class="drop" :class="{ drag: dragDec }"
                       @dragover.prevent="dragDec = true" @dragleave="dragDec = false" @drop.prevent="dropDecode">
                    <div class="ico"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg></div>
                    <div class="main">Drop the PNG, or click to choose</div>
                    <div class="sub" id="dec-file-help" aria-hidden="true">Must be a PNG made with this tool</div>
                    <input id="dec-file" ref="decodeInput" type="file" accept="image/png" class="sr-only" @change="handleDecodeImageUpload" aria-describedby="dec-file-help" />
                </label>

                <div v-else class="thumb-row">
                    <img :src="decodeImage" alt="" class="thumb" />
                    <div class="thumb-meta">
                        <div class="name">{{ decName || 'PNG uploaded' }}</div>
                        <div class="dim">Ready to reveal</div>
                    </div>
                    <button type="button" class="btn btn-ghost btn-sm" @click="resetDecoder" aria-label="Remove picture and start over">Change</button>
                </div>

                <button v-if="!decodeImage" type="button" class="btn btn-link cf-sample" style="--btn-color: var(--color-espresso)"
                        @click="loadSample" :disabled="processing">
                    No secret picture yet? Try decoding this one, we hid something inside
                </button>
            </section>

            <section v-if="decodeImage" class="cf-step" aria-labelledby="h-read">
                <h2 class="step-label" id="h-read">2, Read it</h2>
                <button type="button" class="btn btn-lg cf-go" style="--btn-color: var(--color-cocoa); --btn-fg: #fff"
                        @click="decodeMessage" :disabled="processing">
                    <span v-if="processing" class="loading loading-spinner loading-sm" aria-hidden="true"></span>
                    {{ processing ? 'Reading…' : 'Reveal hidden message' }}
                </button>
            </section>

            <div v-if="decodeError" class="banner warn" role="alert">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4"/><path d="M12 17h.01"/><circle cx="12" cy="12" r="10"/></svg>
                <span>{{ decodeError }}</span>
            </div>

            <div v-if="decodedMessage" class="result">
                <p class="stamp" v-if="decodedTimestamp">Hidden on {{ decodedTimestamp }}</p>
                <div class="revealed">{{ decodedMessage }}</div>
                <div class="result-actions">
                    <button type="button" class="btn btn-lg" style="--btn-color: var(--color-cocoa); --btn-fg: #fff" @click="copyToClipboard">{{ copied ? 'Copied ✓' : 'Copy message' }}</button>
                    <button type="button" class="btn btn-lg btn-outline" style="--btn-color: var(--color-cocoa)" @click="resetDecoder">Reveal another</button>
                </div>
            </div>
        </section>

        <p class="note" style="margin-top: 2.5rem;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <span>Your pictures never leave your browser. Everything is processed on your own device, nothing is uploaded.
                It works offline, and there is no sign-up.
                Curious how the trick works? <a href="/blog/how-image-steganography-works/">Read the plain-English explainer</a>.</span>
        </p>

        <!-- hidden work canvases -->
        <div style="position:absolute; width:0; height:0; overflow:hidden;" aria-hidden="true">
            <canvas ref="encodeCanvas"></canvas>
            <canvas ref="decodeCanvas"></canvas>
        </div>
    </main>
{% endraw %}

    {% include modals.liquid %}
    {% include footer.liquid %}

    {% pageJs "secret-message-image-encoder" %}
</body>
</html>
