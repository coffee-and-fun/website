<!DOCTYPE html>
<html class="scroll-smooth antialiased" lang="en" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary Meta Tags -->
    <title>Free Secret Message Image Encoder - Coffee & Fun LLC</title>
    <meta name="title" content="Free Secret Message Image Encoder - Coffee & Fun LLC" />
    <meta name="description" content="Hide secret messages inside images with steganography, then decode them later. Everything runs locally in your browser, and nothing is ever uploaded." />
    <meta name="keywords" content="steganography, hide text in image, secret message, image encoder, privacy tool, Coffee & Fun" />
    <meta name="author" content="Coffee & Fun LLC" />
    <meta name="robots" content="index, follow" />

    <!-- Canonical URL -->
    <link rel="canonical" href="https://www.coffeeandfun.com/secret-message-image-encoder/" />

    <!-- Favicon -->
    <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />

    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coffee & Fun" />
    <meta property="og:title" content="Free Secret Message Image Encoder - Coffee & Fun LLC" />
    <meta property="og:description" content="Hide secret messages inside images with steganography, then decode them later. Everything runs locally in your browser, and nothing is ever uploaded." />
    <meta property="og:url" content="https://www.coffeeandfun.com/secret-message-image-encoder/" />
    <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/secret-message-image-encoder.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Free Secret Message Image Encoder by Coffee & Fun - Hide Text in Images" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bycoffeeandfun" />
    <meta name="twitter:creator" content="@bycoffeeandfun" />
    <meta name="twitter:title" content="Free Secret Message Image Encoder - Coffee & Fun LLC" />
    <meta name="twitter:description" content="Hide secret messages inside images with steganography, then decode them later. Everything runs locally in your browser, and nothing is ever uploaded." />
    <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/secret-message-image-encoder.png" />
    <meta name="twitter:image:alt" content="Free Secret Message Image Encoder by Coffee & Fun - Hide Text in Images" />
    <meta name="twitter:domain" content="coffeeandfun.com" />
    <meta name="twitter:url" content="https://www.coffeeandfun.com/secret-message-image-encoder/" />

    <!-- PWA and Mobile Enhancement -->
    <meta name="theme-color" content="#111114" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Secret Message Encoder" />

    <!-- Enhanced Structured Data -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "WebPage",
                "@id": "https://www.coffeeandfun.com/secret-message-image-encoder/#webpage",
                "url": "https://www.coffeeandfun.com/secret-message-image-encoder/",
                "name": "Free Secret Message Image Encoder",
                "description": "Hide secret messages in images using steganography with our privacy-focused tool.",
                "about": { "@type": "Thing", "name": "Steganography Tool" },
                "mainEntity": {
                    "@type": "SoftwareApplication",
                    "name": "Free Secret Message Image Encoder",
                    "description": "Privacy-focused web-based tool for hiding and revealing secret messages in images using steganography",
                    "url": "https://www.coffeeandfun.com/secret-message-image-encoder/",
                    "applicationCategory": "UtilityApplication",
                    "operatingSystem": "Web Browser",
                    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
                    "featureList": ["Hide text in images", "Reveal hidden messages", "Automatic timestamping", "Local processing", "No data tracking", "PNG export"]
                }
            }
        ]
    }
    </script>

    <script src="https://unpkg.com/vue@3"></script>

    {% pageCss "secret-message-image-encoder" %}
</head>

<body>
    <a href="#tool" class="skip">Skip to the tool</a>

    <div v-cloak id="app" class="wrap">

        <div class="topbar">
            <a href="/" class="home-link" aria-label="Back to coffeeandfun.com">
                <img src="/assets/images/brand/coffee-and-fun-logo-dark.png" alt="" width="40" height="40" decoding="async" />
                <span class="tip" aria-hidden="true">Back to coffeeandfun.com</span>
            </a>
        </div>

        <header id="tool">
            <h1>{% raw %}{{ mode === 'encode' ? 'Hide a message inside a picture' : 'Reveal a hidden message' }}{% endraw %}</h1>
            <p class="lede">{% raw %}{{ mode === 'encode'
                ? 'Type a secret, drop in any picture, and get back one that looks identical, with your words tucked invisibly inside.'
                : 'Upload a picture made here and read the message hidden in it. Everything happens on your device.' }}{% endraw %}</p>
        </header>

        <!-- Live status for screen readers -->
        <div class="sr-only" role="status" aria-live="polite">{% raw %}{{ announcement }}{% endraw %}</div>

        <!-- Mode tabs -->
        <div class="tabs" role="tablist" aria-label="Choose what to do">
            <button class="tab" role="tab" id="tab-encode" :aria-selected="mode === 'encode' ? 'true' : 'false'"
                    @click="setMode('encode')">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                Hide
            </button>
            <button class="tab" role="tab" id="tab-decode" :aria-selected="mode === 'decode' ? 'true' : 'false'"
                    @click="setMode('decode')">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
                Reveal
            </button>
        </div>

        <!-- ===== HIDE ===== -->
        <section v-if="mode === 'encode'" role="tabpanel" aria-labelledby="tab-encode">

            <div class="step">
                <span class="step-label" id="pic-label">1, Pick a picture</span>
                <label v-if="!originalImage" for="enc-file" class="drop" :class="{ drag: dragEnc }"
                       @dragover.prevent="dragEnc = true" @dragleave="dragEnc = false" @drop.prevent="dropEncode">
                    <div class="ico"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg></div>
                    <div class="main">Drop a picture, or click to choose</div>
                    <div class="sub">JPG, PNG, or WEBP, anything works</div>
                    <input id="enc-file" ref="imageInput" type="file" accept="image/*" class="sr-only" @change="handleImageUpload" aria-labelledby="pic-label" />
                </label>

                <div v-else class="thumb-row">
                    <img :src="originalImage" alt="" class="thumb" />
                    <div class="thumb-meta">
                        <div class="name">{% raw %}{{ encName || 'Your picture' }}{% endraw %}</div>
                        <div class="dim">{% raw %}{{ encW }} × {{ encH }} px · fits about {{ capacity.toLocaleString() }} characters{% endraw %}</div>
                    </div>
                    <button class="btn btn-ghost" @click="resetEncoder" aria-label="Remove picture and start over">Change</button>
                </div>
            </div>

            <div class="step">
                <label class="step-label" for="enc-msg">2, Your secret message</label>
                <textarea id="enc-msg" class="msg" v-model="secretMessage"
                          placeholder="Meet me by the old oak at noon…"
                          aria-describedby="enc-count"></textarea>
                <div id="enc-count" class="counter">
                    <span>{% raw %}{{ secretMessage.length.toLocaleString() }}{% endraw %} characters</span>
                    <span v-if="originalImage" :class="{ over: overCapacity }">
                        {% raw %}{{ overCapacity ? (secretMessage.length - capacity).toLocaleString() + ' too many for this picture' : (capacity - secretMessage.length).toLocaleString() + ' left' }}{% endraw %}
                    </span>
                </div>
            </div>

            <div class="step">
                <span class="step-label" aria-hidden="true">3, Hide it</span>
                <button class="btn btn-primary" @click="encodeMessage"
                        :disabled="!canEncode">
                    <span v-if="processing" class="spin" aria-hidden="true"></span>
                    {% raw %}{{ processing ? 'Hiding…' : 'Hide message in picture' }}{% endraw %}
                </button>
                <div v-if="originalImage && overCapacity" class="banner warn">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4"/><path d="M12 17h.01"/><circle cx="12" cy="12" r="10"/></svg>
                    <span>Your message is longer than this picture can hold. Shorten it, or use a bigger picture.</span>
                </div>
            </div>

            <div v-if="encodedImage" class="result">
                <img :src="encodedImage" alt="Your picture with the message hidden inside, it looks identical to the original" class="out" />
                <div class="result-actions">
                    <button class="btn btn-primary" @click="downloadEncodedImage">Download picture</button>
                    <button class="btn btn-secondary" @click="resetEncoder">Hide another</button>
                </div>
                <div class="note">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                    <span>Done. Save it as a PNG and share it. The message survives only if the file stays a PNG, sending it through apps that re-compress images (like some chats) can wipe it.</span>
                </div>
            </div>
        </section>

        <!-- ===== REVEAL ===== -->
        <section v-if="mode === 'decode'" role="tabpanel" aria-labelledby="tab-decode">

            <div class="step">
                <span class="step-label" id="dec-label">1, Upload the picture</span>
                <label v-if="!decodeImage" for="dec-file" class="drop" :class="{ drag: dragDec }"
                       @dragover.prevent="dragDec = true" @dragleave="dragDec = false" @drop.prevent="dropDecode">
                    <div class="ico"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg></div>
                    <div class="main">Drop the PNG, or click to choose</div>
                    <div class="sub">Must be a PNG made with this tool</div>
                    <input id="dec-file" ref="decodeInput" type="file" accept="image/png" class="sr-only" @change="handleDecodeImageUpload" aria-labelledby="dec-label" />
                </label>

                <div v-else class="thumb-row">
                    <img :src="decodeImage" alt="" class="thumb" />
                    <div class="thumb-meta">
                        <div class="name">{% raw %}{{ decName || 'PNG uploaded' }}{% endraw %}</div>
                        <div class="dim">Ready to reveal</div>
                    </div>
                    <button class="btn btn-ghost" @click="resetDecoder" aria-label="Remove picture and start over">Change</button>
                </div>

                <button v-if="!decodeImage" type="button" class="sample-btn" @click="loadSample" :disabled="processing">
                    No secret picture yet? Try decoding this one, we hid something inside
                </button>
            </div>

            <div v-if="decodeImage" class="step">
                <span class="step-label" aria-hidden="true">2, Read it</span>
                <button class="btn btn-primary" @click="decodeMessage" :disabled="processing">
                    <span v-if="processing" class="spin" aria-hidden="true"></span>
                    {% raw %}{{ processing ? 'Reading…' : 'Reveal hidden message' }}{% endraw %}
                </button>
            </div>

            <div v-if="decodeError" class="banner warn" role="alert">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4"/><path d="M12 17h.01"/><circle cx="12" cy="12" r="10"/></svg>
                <span>{% raw %}{{ decodeError }}{% endraw %}</span>
            </div>

            <div v-if="decodedMessage" class="result">
                <p class="stamp" v-if="decodedTimestamp">Hidden on {% raw %}{{ decodedTimestamp }}{% endraw %}</p>
                <div class="revealed">{% raw %}{{ decodedMessage }}{% endraw %}</div>
                <div class="result-actions">
                    <button class="btn btn-primary" @click="copyToClipboard">{% raw %}{{ copied ? 'Copied ✓' : 'Copy message' }}{% endraw %}</button>
                    <button class="btn btn-secondary" @click="resetDecoder">Reveal another</button>
                </div>
            </div>
        </section>

        <p class="note" style="margin-top: 2.5rem;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <span>Your pictures never leave your browser. Everything is processed on your own device, nothing is uploaded.
                Curious how the trick works? <a href="/blog/how-image-steganography-works/">Read the plain-English explainer</a>.</span>
        </p>

        <!-- hidden work canvases -->
        <div style="position:absolute; width:0; height:0; overflow:hidden;" aria-hidden="true">
            <canvas ref="encodeCanvas"></canvas>
            <canvas ref="decodeCanvas"></canvas>
        </div>
    </div>

    <footer class="foot">
        A free tool by <a href="/">Coffee &amp; Fun</a> · Works offline · No sign-up
    </footer>

    {% pageJs "secret-message-image-encoder" %}
</body>
</html>
