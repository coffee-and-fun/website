<!DOCTYPE html>
<html
  class="brand-color-background scroll-smooth antialiased"
  lang="en"
  data-theme="light"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- Primary Meta Tags -->
    <title>MP3 to Transcript with Chrome AI - Coffee & Fun LLC</title>
    <meta name="title" content="MP3 to Transcript with Chrome AI - Coffee & Fun LLC" />
    <meta name="description" content="Turn MP3 audio into text with Chrome's built-in AI LanguageModel API. A free demo that transcribes meetings, interviews, and recordings in your browser." />
    <meta name="keywords" content="MP3 transcription, audio to text, AI transcription, Chrome AI, speech to text, audio transcription tool, LanguageModel API" />
    <meta name="author" content="Coffee & Fun LLC" />
    <meta name="robots" content="index, follow" />
    <meta name="rating" content="safe for kids" />

    <!-- Canonical URL -->
    <link rel="canonical" href="https://www.coffeeandfun.com/mp3-transcript/" />

    <!-- Favicon -->
    <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />
    <link rel="apple-touch-icon" href="/assets/images/social/192.png" />
    <link rel="icon" href="/assets/images/social/192.png" sizes="192x192" type="image/png" />

    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coffee & Fun" />
    <meta property="og:title" content="MP3 to Transcript with Chrome AI - Coffee & Fun LLC" />
    <meta property="og:description" content="Turn MP3 audio into text with Chrome's built-in AI LanguageModel API. A free demo that transcribes meetings, interviews, and recordings in your browser." />
    <meta property="og:url" content="https://www.coffeeandfun.com/mp3-transcript/" />
    <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/mp3-transcript.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="MP3 Transcript card with the Coffee & Fun coffee cup logo on a cream background" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bycoffeeandfun" />
    <meta name="twitter:creator" content="@bycoffeeandfun" />
    <meta name="twitter:title" content="MP3 to Transcript with Chrome AI - Coffee & Fun LLC" />
    <meta name="twitter:description" content="Turn MP3 audio into text with Chrome's built-in AI LanguageModel API. A free demo that transcribes meetings, interviews, and recordings in your browser." />
    <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/mp3-transcript.png" />
    <meta name="twitter:image:alt" content="MP3 Transcript card with the Coffee & Fun coffee cup logo on a cream background" />
    <meta name="twitter:domain" content="coffeeandfun.com" />
    <meta name="twitter:url" content="https://www.coffeeandfun.com/mp3-transcript/" />

    <!-- PWA Manifest -->
    <link rel="manifest" href="/assets/images/social/site.webmanifest" />

    <!-- Theme & Mobile Meta -->
    <meta name="theme-color" content="#fef5ec" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "@id": "https://www.coffeeandfun.com/mp3-transcript#webpage",
        "url": "https://www.coffeeandfun.com/mp3-transcript",
        "name": "MP3 to Transcript with Chrome AI",
        "description": "Turn MP3 audio into text with Chrome's built-in AI LanguageModel API, right in your browser",
        "isPartOf": {
          "@id": "https://www.coffeeandfun.com/#website"
        },
        "about": {
          "@type": "Thing",
          "name": "Audio Transcription Tool"
        },
        "applicationCategory": "MultimediaApplication",
        "publisher": {
          "@id": "https://www.coffeeandfun.com/#organization"
        },
        "creator": {
          "@id": "https://www.coffeeandfun.com/#founder"
        },
        "isAccessibleForFree": true,
        "inLanguage": "en",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "featureList": [
          "MP3 audio file transcription",
          "AI-powered speech recognition",
          "Real-time text output",
          "Local processing for privacy",
          "Chrome AI integration"
        ]
      }
    </script>

    {% include schema-org.liquid %}

    {% bundledCss %}
    {% include scripts.html %}

    <!-- Preload favicon -->
    <link rel="preload" href="/assets/images/brand/favicon.png" as="image" />


    {% pageCss "mp3-transcript" %}
      {% include sketch-styles.liquid %}
</head>

  <body class="brand-color-background scroll-smooth antialiased">
    {% include header.liquid %}

    <main id="main-content" class="mx-auto max-w-7xl p-6 space-y-6">
      <h1 class="brand-heading text-3xl sm:text-4xl leading-[1.3] sm:leading-[1.3]">🎙️ MP3 to Text using Chrome AI</h1>

      <div
        role="alert"
        class="alert alert-info items-center p-4"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          class="h-6 w-6 shrink-0 stroke-current"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
          ></path>
        </svg>
        <span id="messageAI">New software update available.</span>
      </div>

      <p class="text-lg">
        This page demonstrates how to use the Chrome AI LanguageModel API to
        transcribe MP3 audio files into text. It checks for model availability
        and allows you to upload an MP3 file for transcription.
      </p>

      <hr class="my-4" />

      <p class="text-sm text-stone-600">
        Note: This feature requires the Chrome AI LanguageModel API, which is
        currently available in Chrome Canary. Ensure you have enabled the
        necessary flags:
      </p>

      <ul class="list-disc pl-6 text-sm text-stone-600">
        <li>
          <a
            href="chrome://flags/#enable-language-model-api"
            target="_blank"
            rel="noopener noreferrer"
            class="underline hover:text-espresso transition-colors" style="color: var(--color-caramel);"
          >
            Enable LanguageModel API
          </a>
        </li>
        <li>
          <a
            href="chrome://flags/#enable-language-model-api-prompting"
            target="_blank"
            rel="noopener noreferrer"
            class="underline hover:text-espresso transition-colors" style="color: var(--color-caramel);"
          >
            Enable Prompting for LanguageModel API
          </a>
        </li>
      </ul>

      <fieldset class="fieldset">
        <legend class="fieldset-legend">Pick a file</legend>
        <input
          type="file"
          id="audioInput"
          accept=".mp3"
          class="file-input file-input-info"
        />
        <label class="label">Max size 2MB</label>
      </fieldset>

      <button class="btn btn-lg btn-info" id="transcribe">Transcribe</button>

      <div id="transcript"></div>
        {% include related-tools.liquid %}
    </main>

    {% pageJs "mp3-transcript" %}

    {% include modals.liquid %}
    {% include footer.liquid %}
  </body>
</html>