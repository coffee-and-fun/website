<!DOCTYPE html>
<html class="scroll-smooth antialiased" lang="en" data-theme="light" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- Primary Meta Tags -->
  <title>Silicon Dreams: Tech Founders Text Adventure - Coffee & Fun LLC</title>
  <meta name="title" content="Silicon Dreams: Tech Founders Text Adventure - Coffee & Fun LLC" />
  <meta name="description" content="A free retro text adventure through Silicon Valley history. Your choices decide whether you become a famous tech founder or the teacher who inspired them all." />
  <meta name="keywords" content="text adventure, RPG, Silicon Valley history, Apple founding, Microsoft founding, Google founding, Steve Jobs, Bill Gates, Larry Page, retro game, interactive fiction, 80s text adventure, Coffee and Fun" />
  <meta name="author" content="Coffee & Fun LLC" />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

  <link rel="canonical" href="https://www.coffeeandfun.com/silicon-dreams/" />

  <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />
  <link rel="apple-touch-icon" href="/assets/images/social/192.png" />
  <link rel="icon" href="/assets/images/social/192.png" sizes="192x192" type="image/png" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Coffee & Fun" />
  <meta property="og:title" content="Silicon Dreams: Tech Founders Text Adventure - Coffee & Fun LLC" />
  <meta property="og:description" content="A free retro text adventure through Silicon Valley history. Your choices decide whether you become a famous tech founder or the teacher who inspired them all." />
  <meta property="og:url" content="https://www.coffeeandfun.com/silicon-dreams/" />
  <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/silicon-dreams.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Silicon Dreams, text adventure cover art" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@bycoffeeandfun" />
  <meta name="twitter:creator" content="@bycoffeeandfun" />
  <meta name="twitter:title" content="Silicon Dreams: Tech Founders Text Adventure - Coffee & Fun LLC" />
  <meta name="twitter:description" content="A free retro text adventure through Silicon Valley history. Your choices decide whether you become a famous tech founder or the teacher who inspired them all." />
  <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/silicon-dreams.png" />
  <meta name="twitter:image:alt" content="Silicon Dreams text adventure cover" />
  <meta name="twitter:domain" content="coffeeandfun.com" />
  <meta name="twitter:url" content="https://www.coffeeandfun.com/silicon-dreams/" />

  <meta name="theme-color" content="#0a0a0a" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black" />
  <meta name="apple-mobile-web-app-title" content="Silicon Dreams" />

  <!-- Retro CRT font (VT323) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=VT323&display=swap" rel="stylesheet" />

  <!-- Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Game",
    "name": "Silicon Dreams",
    "description": "A retro 1980s-style text adventure RPG about the founders of Apple, Microsoft, and Google. Real historical events shape branching choices that determine which Silicon Valley legend you become, or whether you become the teacher who inspired them all.",
    "url": "https://www.coffeeandfun.com/silicon-dreams/",
    "applicationCategory": "GameApplication",
    "genre": ["Interactive Fiction", "RPG", "Educational"],
    "operatingSystem": "Any",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "creator": {
      "@type": "Organization",
      "name": "Coffee & Fun LLC",
      "url": "https://www.coffeeandfun.com"
    }
  }
  </script>

  {% bundledCss %}
  {% include scripts.html %}

    {% pageCss "silicon-dreams" %}
</head>
<body>
  <a href="#scene" class="skip-link">Skip to game</a>
  <div class="terminal-shell" role="main">
    <div class="terminal-frame" aria-live="polite">
      <div class="terminal-header">
        <span>COCO-DOS v2.0</span>
        <span class="status-block" id="status-block">READY</span>
      </div>

      <pre class="ascii-banner" aria-hidden="true">
   ____  _ _ _                ____
  / ___|(_) (_) ___ ___  _ __ |  _ \ _ __ ___  __ _ _ __ ___  ___
  \___ \| | | |/ __/ _ \| '_ \| | | | '__/ _ \/ _` | '_ ` _ \/ __|
   ___) | | | | (_| (_) | | | | |_| | | |  __/ (_| | | | | | \__ \
  |____/|_|_|_|\___\___/|_| |_|____/|_|  \___|\__,_|_| |_| |_|___/
        A Coffee &amp; Fun text adventure, 1971 to 2025
      </pre>

      <div class="scene-meta" id="scene-meta">SYSTEM // BOOT</div>
      <div class="scene-text" id="scene-text" tabindex="-1" aria-atomic="true">Loading...</div>

      <ul class="choices-list" id="choices" aria-label="Choices"></ul>

      <div class="footer-bar">
        <span id="progress-block" aria-live="polite">SCENE 0</span>
        <div>
          <button type="button" id="skip-btn" aria-label="Skip typewriter animation">SKIP</button>
          <button type="button" id="restart-btn" aria-label="Restart adventure">RESTART</button>
        </div>
      </div>
    </div>

    <noscript>
      <div style="max-width:880px;margin:1rem auto;border:2px solid #b87800;padding:1rem;color:#ffb000;font-family:'Courier New',monospace;">
        <h2>Silicon Dreams</h2>
        <p>This is a text adventure RPG about the founding of Apple, Microsoft, and Google. Enable JavaScript to play.</p>
        <p>It's a 15-20 minute playthrough. Your choices, based on real historical events, decide whether you become Steve Jobs, Bill Gates, Larry Page, or the teacher who inspired them all.</p>
      </div>
    </noscript>
  </div>

    {% pageJs "silicon-dreams" %}
</body>
</html>
