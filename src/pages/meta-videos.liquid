<!DOCTYPE html>
<html class="antialiased" lang="en" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary Meta Tags -->
    <title>Video Metadata Viewer & Remover - Coffee & Fun LLC</title>
    <meta name="description" content="See the hidden metadata inside your videos, GPS location, device, and timestamps, then download a clean copy with it removed, all in your browser." />
    <meta name="keywords" content="video metadata, video EXIF, video privacy, metadata removal, video editor, MP4 metadata, Coffee and Fun" />
    <meta name="author" content="Coffee & Fun LLC" />
    <meta name="publisher" content="Coffee & Fun LLC" />
    <meta name="copyright" content="Coffee & Fun LLC" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <!-- Canonical URL -->
    <link rel="canonical" href="https://www.coffeeandfun.com/meta-videos/" />

    <!-- Favicon -->
    <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coffee & Fun" />
    <meta property="og:title" content="Video Metadata Viewer & Remover - Coffee & Fun LLC" />
    <meta property="og:description" content="See the hidden metadata inside your videos, GPS location, device, and timestamps, then download a clean copy with it removed, all in your browser." />
    <meta property="og:url" content="https://www.coffeeandfun.com/meta-videos/" />
    <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/meta-videos.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Video Metadata Viewer & Remover card with a video file icon and the Coffee & Fun cup logo" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bycoffeeandfun" />
    <meta name="twitter:creator" content="@bycoffeeandfun" />
    <meta name="twitter:title" content="Video Metadata Viewer & Remover - Coffee & Fun LLC" />
    <meta name="twitter:description" content="See the hidden metadata inside your videos, GPS location, device, and timestamps, then download a clean copy with it removed, all in your browser." />
    <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/meta-videos.png" />
    <meta name="twitter:image:alt" content="Video Metadata Viewer & Remover card with a video file icon and the Coffee & Fun cup logo" />

    <meta name="theme-color" content="#fef5ec" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Video Metadata" />

    <!-- Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "@id": "https://www.coffeeandfun.com/meta-videos#webpage",
        "url": "https://www.coffeeandfun.com/meta-videos",
        "name": "Video Metadata Viewer & Remover",
        "description": "See the hidden metadata inside your videos and download a clean copy with it removed, all in your browser.",
        "isPartOf": {
          "@id": "https://www.coffeeandfun.com/#website"
        },
        "about": {
          "@type": "Thing",
          "name": "Video Metadata Tool"
        },
        "applicationCategory": "UtilitiesApplication",
        "publisher": {
          "@id": "https://www.coffeeandfun.com/#organization"
        },
        "creator": {
          "@id": "https://www.coffeeandfun.com/#founder"
        },
        "isAccessibleForFree": true,
        "inLanguage": "en",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "featureList": [
          "View video metadata",
          "GPS and location warnings",
          "Remove metadata without re-encoding",
          "Local processing",
          "No uploads"
        ]
      }
    </script>

    <script src="https://unpkg.com/vue@3"></script>

    {% bundledCss %}
    {% pageCss "meta-videos" %}
    {% include sketch-styles.liquid %}
{% include schema-org.liquid %}

    </head>

<body>
    {% assign showFun = true %}
    {% include header.liquid %}
{% raw %}
    <a href="#tool" class="skip">Skip to the tool</a>

    <main v-cloak id="app" class="wrap">

        <header id="tool">
            <h1>See what your videos know about you</h1>
            <p class="lede">Phone videos quietly carry your location, your device, and the exact moment you pressed record. Drop one in to read everything, then download a clean copy with that data blanked out. Nothing is uploaded; it all happens on your device.</p>
        </header>

        <!-- Live status for screen readers -->
        <div class="sr-only" role="status" aria-live="polite">{{ announcement }}</div>

        <!-- ===== Step 1: pick a video ===== -->
        <section class="step" aria-labelledby="h-pick">
            <h2 class="step-label" id="h-pick">1, Pick a video</h2>

            <label v-if="!file" for="vid-file" class="drop" :class="{ drag: dragOver }"
                   @dragover.prevent="dragOver = true" @dragleave="dragOver = false" @drop.prevent="onDrop">
                <div class="ico"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 10 6-4v12l-6-4"/><rect x="2" y="6" width="14" height="12" rx="2"/></svg></div>
                <div class="main">Drop a video here, or click to choose</div>
                <div class="sub">MP4, MOV, WebM, MKV, AVI, most video formats work</div>
                <input id="vid-file" ref="fileInput" type="file" accept="video/*,.mp4,.mov,.m4v,.3gp,.webm,.mkv,.avi" class="sr-only" @change="onFileChange" aria-labelledby="h-pick" />
            </label>

            <template v-else>
                <div class="thumb-row">
                    <video class="thumb" :src="previewUrl" muted playsinline preload="metadata"
                           tabindex="-1" aria-hidden="true" @loadedmetadata="onPreviewMeta"></video>
                    <div class="thumb-meta">
                        <div class="name">{{ fileName }}</div>
                        <div class="dim">{{ formatFileSize(fileSize) }}<template v-if="videoInfo.duration"> · {{ formatDuration(videoInfo.duration) }}</template><template v-if="videoInfo.width"> · {{ videoInfo.width }} × {{ videoInfo.height }}</template></div>
                    </div>
                    <button type="button" class="btn-brand btn-ghost-brand" @click="reset" aria-label="Remove this video and start over">Change</button>
                </div>

                <details class="more">
                    <summary>Watch this video</summary>
                    <video class="player" :src="previewUrl" controls preload="metadata">
                        Your browser can&rsquo;t play this video here, but the metadata below is still read straight from the file.
                    </video>
                </details>
            </template>

            <p v-if="busyReading" class="status" role="status">
                <span class="spin dark" aria-hidden="true"></span>
                <span>{{ statusText }}<template v-if="phase === 'reading' && progress > 0">, {{ progress }}%</template></span>
            </p>
            <div v-if="phase === 'reading'" class="bar" aria-hidden="true">
                <div class="bar-fill" :style="{ width: progress + '%' }"></div>
            </div>

            <div v-if="errorText" class="banner warn" role="alert" style="margin-top: 0.9rem;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4"/><path d="M12 17h.01"/><circle cx="12" cy="12" r="10"/></svg>
                <span>{{ errorText }}</span>
            </div>
        </section>

        <!-- ===== Step 2: what's inside ===== -->
        <section v-if="hasResults" class="step" aria-labelledby="h-inside">
            <h2 class="step-label" id="h-inside">2, What&rsquo;s inside</h2>

            <div class="chip-row">
                <span class="chip-stat">{{ fieldCount }} metadata field{{ fieldCount === 1 ? '' : 's' }}</span>
                <span v-if="hasGpsData" class="chip-stat bad">Location data found</span>
                <span v-if="hasPersonalData" class="chip-stat bad">Personal info found</span>
            </div>

            <div v-if="privacyFindings.length" class="banner warn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4"/><path d="M12 17h.01"/><circle cx="12" cy="12" r="10"/></svg>
                <div>
                    <strong>Worth knowing before you share this file:</strong>
                    <ul class="plain">
                        <li v-for="finding in privacyFindings" :key="finding">{{ finding }}</li>
                    </ul>
                </div>
            </div>

            <div v-for="group in groupedMetadata" :key="group.name" class="meta-card">
                <h3>{{ group.name }}</h3>
                <table class="kv">
                    <caption class="sr-only">{{ group.name }} metadata read from this video</caption>
                    <tbody>
                        <tr v-for="row in group.rows" :key="row.key">
                            <th scope="row">{{ row.key }}</th>
                            <td>{{ row.value }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <p v-for="n in parseNotes" :key="n" class="note">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                <span>{{ n }}</span>
            </p>
        </section>

        <!-- ===== Step 3: clean it ===== -->
        <section v-if="hasResults" class="step" aria-labelledby="h-clean">
            <h2 class="step-label" id="h-clean">3, Clean it</h2>

            <template v-if="!cleaned">
                <p class="hint-p">{{ cleanExplainer }}</p>
                <button type="button" class="btn-brand btn-primary-brand" @click="cleanVideo" :disabled="phase === 'cleaning'">
                    <span v-if="phase === 'cleaning'" class="spin" aria-hidden="true"></span>
                    {{ phase === 'cleaning' ? 'Cleaning…' : cleanButtonLabel }}
                </button>
                <p v-if="phase === 'cleaning'" class="status" role="status">{{ statusText }}</p>
            </template>

            <div v-else class="result">
                <p class="result-title">{{ cleaned.removed.length ? 'Done, here’s what was blanked out:' : (canRewrite ? 'Already clean' : 'Copied as-is') }}</p>
                <ul v-if="cleaned.removed.length" class="removed">
                    <li v-for="r in cleaned.removed" :key="r">{{ r }}</li>
                </ul>
                <p v-if="cleaned.note" class="hint-p">{{ cleaned.note }}</p>
                <p class="stamp">Original {{ formatFileSize(fileSize) }} → clean copy {{ formatFileSize(cleaned.size) }}. The picture and sound are copied bit-for-bit, no re-encoding, no quality loss.</p>
                <div class="result-actions">
                    <button type="button" class="btn-brand btn-primary-brand" @click="downloadClean">Download clean copy</button>
                    <button type="button" class="btn-brand btn-secondary-brand" @click="reset">Clean another video</button>
                </div>
            </div>
        </section>

        <p class="note" style="margin-top: 2.5rem;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <span>Your videos never leave your browser. Reading and cleaning both happen on your own device, nothing is uploaded, nothing is tracked.</span>
        </p>

        <!-- ===== About ===== -->
        <section class="about" aria-labelledby="h-about" style="margin-top: 3rem;">
            <h2 class="step-label" id="h-about">About video metadata</h2>
            <h3>What is video metadata?</h3>
            <p>Video files carry more than pictures and sound. Depending on what recorded them, they can include GPS coordinates, the device make and model, creation timestamps, the software that edited them, and sometimes names or other personal details.</p>
            <h3>Why remove it?</h3>
            <p>Metadata can reveal when and where a video was recorded and what recorded it. Blanking it before you share a file protects your privacy, the video itself looks and plays exactly the same.</p>
        </section>

        <p class="foot">Everything happens in your browser, your videos never leave this page.</p>
    </main>
{% endraw %}

    {% include modals.liquid %}
    {% include footer.liquid %}

    {% pageJs "meta-videos" %}
</body>
</html>
