<!DOCTYPE html>
<html class="antialiased" lang="en" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary Meta Tags -->
    <title>Vibe Check: Daily Mood Puzzle Game - Coffee & Fun LLC</title>
    <meta name="title" content="Vibe Check: Daily Mood Puzzle Game - Coffee & Fun LLC" />
    <meta name="description" content="Guess the day's vibe from four emoji clues. You get four tries, everyone gets the same puzzle, and a new one lands at midnight. Play free and share your score." />
    <meta name="keywords" content="daily puzzle, word game, emoji game, vibe check, mood game, puzzle game, daily challenge" />
    <meta name="author" content="Coffee & Fun LLC" />
    <meta name="robots" content="index, follow" />
    <meta name="rating" content="general" />

    <link rel="canonical" href="https://www.coffeeandfun.com/vibe-check/" />

    <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />
    <link rel="apple-touch-icon" href="/assets/images/social/192.png" />
    <link rel="icon" href="/assets/images/social/192.png" sizes="192x192" type="image/png" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coffee & Fun" />
    <meta property="og:title" content="Vibe Check: Daily Mood Puzzle Game - Coffee & Fun LLC" />
    <meta property="og:description" content="Guess the day's vibe from four emoji clues. You get four tries, everyone gets the same puzzle, and a new one lands at midnight. Play free and share your score." />
    <meta property="og:url" content="https://www.coffeeandfun.com/vibe-check/" />
    <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/vibe-check.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Coffee & Fun logo card: a tipping coffee cup and the tagline Crafting software, one brew at a time" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bycoffeeandfun" />
    <meta name="twitter:creator" content="@bycoffeeandfun" />
    <meta name="twitter:title" content="Vibe Check: Daily Mood Puzzle Game - Coffee & Fun LLC" />
    <meta name="twitter:description" content="Guess the day's vibe from four emoji clues. You get four tries, everyone gets the same puzzle, and a new one lands at midnight. Play free and share your score." />
    <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/vibe-check.png" />
    <meta name="twitter:image:alt" content="Coffee & Fun logo card: a tipping coffee cup and the tagline Crafting software, one brew at a time" />
    <meta name="twitter:domain" content="coffeeandfun.com" />
    <meta name="twitter:url" content="https://www.coffeeandfun.com/vibe-check/" />

    <!-- Web App Manifest -->
    <link rel="manifest" href="/assets/images/social/site.webmanifest" />
    <meta name="theme-color" content="#fef5ec" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="VIBE CHECK" />

    <!-- Schema.org structured data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "VideoGame",
        "@id": "https://www.coffeeandfun.com/vibe-check/",
        "name": "Vibe Check: Daily Mood Puzzle Game",
        "description": "Guess the day's vibe from four emoji clues. Four tries per day, the same puzzle for everyone, and a new one at midnight.",
        "url": "https://www.coffeeandfun.com/vibe-check/",
        "image": "https://www.coffeeandfun.com/assets/images/social/pages/vibe-check.png",
        "applicationCategory": "GameApplication",
        "operatingSystem": "Any",
        "browserRequirements": "Requires JavaScript. Requires HTML5.",
        "softwareVersion": "1.0",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "creator": {
          "@id": "https://www.coffeeandfun.com/#founder"
        },
        "publisher": {
          "@id": "https://www.coffeeandfun.com/#organization"
        },
        "isAccessibleForFree": true,
        "inLanguage": "en",
        "gamePlatform": "Web Browser",
        "playMode": "SinglePlayer"
      }
    </script>

    <script src="https://unpkg.com/vue@3"></script>

    {% bundledCss %}
    {% pageCss "vibe-check" %}
    {% include sketch-styles.liquid %}
{% include schema-org.liquid %}

    </head>

<body>
    {% include header.liquid %}
{% raw %}
    <a href="#tool" class="skip">Skip to the game</a>

    <main v-cloak id="main-content" class="wrap">

        <header id="tool">
            <h1>VIBE CHECK <span aria-hidden="true">✨</span></h1>
            <p class="lede">Four emoji, one mood. You get four tries to name it, everyone in the world gets the same puzzle today.</p>
            <p class="puzzle-meta"><span aria-hidden="true">📅</span> Puzzle #{{ puzzleNumber }}</p>
        </header>

        <!-- Live status for screen readers -->
        <div class="sr-only" role="status" aria-live="polite">{{ announcement }}</div>

        <section class="card-brand" aria-label="Today's vibe puzzle">

            <!-- ===== Playing ===== -->
            <div v-if="gameState === 'playing'">
                <h2 class="step-label" style="text-align:center">Today's clues</h2>
                <div class="clues">
                    <span v-for="(emoji, index) in currentPuzzle.clues"
                          :key="index"
                          class="clue"
                          :style="'animation-delay:' + (index * 0.1) + 's'">{{ emoji }}</span>
                </div>

                <p class="tries">
                    <span v-for="i in maxAttempts" :key="i" class="try-dot" aria-hidden="true">{{ attempts >= i ? '❌' : '💚' }}</span>
                    <span class="tries-text">{{ maxAttempts - attempts }} {{ maxAttempts - attempts === 1 ? 'try' : 'tries' }} left</span>
                </p>

                <h2 class="step-label" style="text-align:center">What's the vibe?</h2>
                <div class="choices">
                    <button v-for="option in currentPuzzle.options"
                            :key="option"
                            type="button"
                            class="choice"
                            :class="{ wrong: isWrong(option) }"
                            @click="makeGuess(option)">
                        <span v-if="isWrong(option)" class="wrong-mark" aria-hidden="true">✗</span>
                        {{ option }}
                        <span v-if="isWrong(option)" class="sr-only">, not it</span>
                    </button>
                </div>

                <div v-if="feedback" class="banner warn">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
                    <p><strong>{{ feedback.message }}</strong></p>
                </div>
            </div>

            <!-- ===== Won ===== -->
            <div v-else-if="gameState === 'won'" class="outcome">
                <span class="result-emoji" aria-hidden="true">{{ resultEmoji }}</span>
                <h2 class="result-title">Vibe captured! <span aria-hidden="true">✨</span></h2>

                <div class="banner good">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                    <div>
                        <p><span class="sr-only">Correct, </span><span class="answer">{{ currentPuzzle.answer }}</span></p>
                        <p>{{ currentPuzzle.description }}</p>
                    </div>
                </div>

                <p class="stats-brand">
                    <span class="blocks" aria-hidden="true">{{ shareBlocks }}</span>
                    Solved in {{ attempts }} of {{ maxAttempts }} {{ attempts === 1 ? 'try' : 'tries' }}
                </p>

                <button type="button" class="btn-brand btn-primary-brand" @click="shareResults">
                    {{ copied ? 'Copied ✓' : '📤 Share your vibe' }}
                </button>
                <p v-if="copyFailed" class="copy-note bad">Copy didn&rsquo;t work, your result is selected below, press Ctrl+C or Cmd+C.</p>
                <pre v-if="copyFailed" class="share-pre" ref="sharePre" tabindex="0" aria-label="Your shareable result">{{ shareText }}</pre>

                <p class="tomorrow">Come back tomorrow for a new vibe! <span aria-hidden="true">🌅</span></p>
            </div>

            <!-- ===== Lost ===== -->
            <div v-else class="outcome">
                <span class="result-emoji" aria-hidden="true">😢</span>
                <h2 class="result-title">Vibe missed!</h2>

                <div class="banner warn">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
                    <div>
                        <p>The answer was <span class="answer">{{ currentPuzzle.answer }}</span></p>
                        <p>{{ currentPuzzle.description }}</p>
                    </div>
                </div>

                <p class="stats-brand">
                    <span class="blocks" aria-hidden="true">{{ shareBlocks }}</span>
                    Out of tries, {{ attempts }} of {{ maxAttempts }} used
                </p>

                <button type="button" class="btn-brand btn-primary-brand" @click="shareResults">
                    {{ copied ? 'Copied ✓' : '📤 Share your attempt' }}
                </button>
                <p v-if="copyFailed" class="copy-note bad">Copy didn&rsquo;t work, your result is selected below, press Ctrl+C or Cmd+C.</p>
                <pre v-if="copyFailed" class="share-pre" ref="sharePre" tabindex="0" aria-label="Your shareable result">{{ shareText }}</pre>

                <p class="tomorrow">Come back tomorrow for a new vibe! <span aria-hidden="true">🌅</span></p>
            </div>
        </section>

        <!-- How to play -->
        <section class="how" aria-labelledby="h-how">
            <h2 class="step-label" id="h-how">How to play</h2>
            <ol>
                <li>Read the four emoji clues.</li>
                <li>Pick the mood they add up to, you get four tries.</li>
                <li>Share your result and dare your friends to beat it.</li>
            </ol>
            <p class="midnight"><span aria-hidden="true">✨</span> A new vibe lands every midnight, same puzzle for everyone.</p>
        </section>

        <p class="foot">Your daily result is saved in this browser, nothing you play leaves this page.</p>
{% endraw %}
        {% include related-tools.liquid %}
    </main>

    {% include modals.liquid %}
    {% include footer.liquid %}

    {% pageJs "vibe-check" %}
</body>
</html>
