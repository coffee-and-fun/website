<!DOCTYPE html>
<html class="brand-color-background scroll-smooth antialiased" lang="en" data-theme="light" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>Email Signature Generator - Coffee & Fun LLC</title>
  <meta name="title" content="Email Signature Generator - Coffee & Fun LLC" />
  <meta name="description" content="Create an HTML email signature with photos, social icons, and a live preview, then copy it into Gmail, Outlook, or Apple Mail, or download it for Thunderbird." />
  <meta name="keywords" content="email signature generator, html email signature, gmail signature, outlook signature, professional signature, signature maker, Coffee & Fun" />
  <meta name="author" content="Coffee & Fun LLC" />
  <meta name="robots" content="index, follow" />

  <link rel="canonical" href="https://www.coffeeandfun.com/email-signature-generator/" />
  <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />
  <link rel="apple-touch-icon" href="/assets/images/social/192.png" />
  <link rel="icon" href="/assets/images/social/192.png" sizes="192x192" type="image/png" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Coffee & Fun" />
  <meta property="og:title" content="Email Signature Generator - Coffee & Fun LLC" />
  <meta property="og:description" content="Create an HTML email signature with photos, social icons, and a live preview, then copy it into Gmail, Outlook, or Apple Mail, or download it for Thunderbird." />
  <meta property="og:url" content="https://www.coffeeandfun.com/email-signature-generator/" />
  <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/email-signature-generator.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="A yellow envelope with a notification badge above the words Email Signature Generator" />
  <meta property="og:locale" content="en_US" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@bycoffeeandfun" />
  <meta name="twitter:creator" content="@bycoffeeandfun" />
  <meta name="twitter:title" content="Email Signature Generator - Coffee & Fun LLC" />
  <meta name="twitter:description" content="Create an HTML email signature with photos, social icons, and a live preview, then copy it into Gmail, Outlook, or Apple Mail, or download it for Thunderbird." />
  <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/email-signature-generator.png" />
  <meta name="twitter:image:alt" content="A yellow envelope with a notification badge above the words Email Signature Generator" />
  <meta name="twitter:domain" content="coffeeandfun.com" />
  <meta name="twitter:url" content="https://www.coffeeandfun.com/email-signature-generator/" />

  <link rel="manifest" href="/assets/images/social/site.webmanifest" />
  <meta name="theme-color" content="#fef5ec" />

  {% bundledCss %}
  {% include scripts.html %}
  {% include sketch-styles.liquid %}

  <script src="https://unpkg.com/vue@3"></script>

    {% pageCss "email-signature-generator" %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Email Signature Generator",
    "description": "Create an HTML email signature with photos, social icons, and a live preview, then copy it into Gmail, Outlook, or Apple Mail, or download it for Thunderbird.",
    "url": "https://www.coffeeandfun.com/email-signature-generator/",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Web Browser",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "featureList": ["Six signature templates", "Live email preview", "Rich one-click copy for Gmail, Outlook and Apple Mail", "Copy HTML source and download .html for Thunderbird", "Photo support with hosted-image guidance", "Social links", "Autosave", "Local processing"],
    "creator": {
      "@type": "Organization",
      "name": "Coffee & Fun LLC",
      "url": "https://www.coffeeandfun.com"
    }
  }
  </script>
</head>

<body>
  {% assign showFun = true %}
  {% assign showMiddleBadgeWithText = true %}
  {% include header.liquid %}

  <main v-cloak id="main-content" class="mx-auto max-w-7xl py-12 px-4 sm:px-6">

    <!-- Header -->
    <header class="text-center mb-10">
      <h1 class="brand-heading text-3xl sm:text-4xl lg:text-5xl leading-[1.3] sm:leading-[1.3] mb-3">
        Email Signature Generator
      </h1>
      <p class="text-lg text-stone-600 mb-4">
        Type your details, watch the email preview update, copy it into Gmail or Outlook. Done.
      </p>
      <div class="flex gap-3 justify-center flex-wrap items-center">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-sm font-medium text-emerald-800 bg-emerald-50 border border-emerald-200">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          Everything stays in your browser
        </span>
        <button @click="loadExample" class="btn-brand btn-ghost-brand btn-sm-brand">Try an example</button>
      </div>
    </header>

    <!-- Screen reader announcements -->
    <div class="sr-only" role="status" aria-live="polite">{% raw %}{{ announcement }}{% endraw %}</div>

    <!-- Premium banner -->
    <div v-if="!hasPremiumAccess" class="rounded-2xl shadow-xl p-6 sm:p-8 mb-8 text-white" style="background: linear-gradient(120deg, var(--color-mocha), var(--color-coral-deep));">
      <div class="flex flex-col md:flex-row items-center justify-between gap-5">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold mb-1"><span aria-hidden="true">✨</span> Unlock all six templates</h2>
          <p class="text-white">Corporate, Creative, Elegant and Tech templates plus custom colors, one-time $5.</p>
        </div>
        <button
          @click="initializeStripePayment"
          :disabled="isProcessingPayment"
          class="px-7 py-3.5 bg-white text-espresso rounded-full font-bold hover:bg-cream transition-colors whitespace-nowrap disabled:opacity-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-transparent">
          <span v-if="!isProcessingPayment">Get premium, $5</span>
          <span v-else>Redirecting…</span>
        </button>
      </div>
    </div>

    <div v-else class="bg-emerald-50 border-l-4 border-emerald-400 p-5 rounded-xl mb-8">
      <h2 class="text-lg font-bold text-emerald-900">Premium unlocked, all templates and colors are yours.</h2>
    </div>

    <div class="grid lg:grid-cols-2 gap-8">

      <!-- LEFT: Form -->
      <div class="space-y-6">

        <!-- Template picker -->
        <fieldset class="form-section">
          <legend class="section-title">Template</legend>
          <div class="grid grid-cols-2 gap-3" role="group" aria-label="Choose a signature template">
            <button v-for="template in templates"
                 :key="template.id"
                 type="button"
                 @click="selectTemplate(template)"
                 :aria-pressed="selectedTemplate && selectedTemplate.id === template.id ? 'true' : 'false'"
                 class="template-card">
              <span class="block text-2xl mb-1.5" aria-hidden="true">{% raw %}{{ template.icon }}{% endraw %}</span>
              <span class="block font-bold text-stone-900">{% raw %}{{ template.name }}{% endraw %}</span>
              <span class="block text-xs text-stone-600 mt-0.5">{% raw %}{{ template.description }}{% endraw %}</span>
              <span v-if="template.premium && !hasPremiumAccess"
                    class="inline-block mt-2 px-2 py-0.5 bg-amber-100 text-espresso text-xs font-bold rounded-full">
                Premium<span class="sr-only">, requires upgrade</span>
              </span>
            </button>
          </div>
        </fieldset>

        <!-- About you -->
        <fieldset class="form-section">
          <legend class="section-title">About You <span class="optional-tag" aria-hidden="true">, saved automatically</span></legend>
          <div class="space-y-4">
            <div>
              <label class="form-label" for="sig-name">Full Name *</label>
              <input id="sig-name" v-model="formData.name" type="text" placeholder="Alex Example" autocomplete="name" class="sig-input" />
            </div>
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="form-label" for="sig-title">Job Title</label>
                <input id="sig-title" v-model="formData.title" type="text" placeholder="Product Designer" autocomplete="organization-title" class="sig-input" />
              </div>
              <div>
                <label class="form-label" for="sig-company">Company</label>
                <input id="sig-company" v-model="formData.company" type="text" placeholder="Example Studio" autocomplete="organization" class="sig-input" />
              </div>
            </div>
            <div>
              <label class="form-label" for="sig-email">Email *</label>
              <input id="sig-email" v-model="formData.email" type="email" placeholder="alex@example.com" autocomplete="email" inputmode="email" class="sig-input" />
            </div>

            <details class="sig-details" :open="openMore" @toggle="openMore = $event.target.open">
              <summary>More contact details</summary>
              <div class="space-y-4">
                <div class="grid sm:grid-cols-2 gap-4">
                  <div>
                    <label class="form-label" for="sig-phone">Phone</label>
                    <input id="sig-phone" v-model="formData.phone" type="tel" placeholder="+1 (555) 010-1234" autocomplete="tel" inputmode="tel" class="sig-input" />
                  </div>
                  <div>
                    <label class="form-label" for="sig-website">Website</label>
                    <input id="sig-website" v-model="formData.website" type="url" placeholder="https://example.com" autocomplete="url" inputmode="url" class="sig-input" />
                  </div>
                </div>
                <div>
                  <label class="form-label" for="sig-address">Address</label>
                  <input id="sig-address" v-model="formData.address" type="text" placeholder="123 Main St, City, State" autocomplete="street-address" class="sig-input" />
                </div>
              </div>
            </details>

            <details class="sig-details" :open="openExtras" @toggle="openExtras = $event.target.open">
              <summary>Extras <span class="optional-tag" style="text-transform:none;">(pronouns, calendar, hours)</span></summary>
              <div class="space-y-4">
                <div class="grid sm:grid-cols-2 gap-4">
                  <div>
                    <label class="form-label" for="sig-pronouns">Pronouns</label>
                    <input id="sig-pronouns" v-model="formData.pronouns" type="text" placeholder="They/Them" class="sig-input" />
                  </div>
                  <div>
                    <label class="form-label" for="sig-department">Department</label>
                    <input id="sig-department" v-model="formData.department" type="text" placeholder="Engineering" class="sig-input" />
                  </div>
                </div>
                <div>
                  <label class="form-label" for="sig-calendar">Calendar Booking Link</label>
                  <input id="sig-calendar" v-model="formData.calendarLink" type="url" placeholder="https://calendly.com/yourname" inputmode="url" class="sig-input" aria-describedby="sig-calendar-hint" />
                  <p id="sig-calendar-hint" class="text-xs text-stone-500 mt-1">Calendly, Cal.com, or any booking link</p>
                </div>
                <div class="grid sm:grid-cols-2 gap-4">
                  <div>
                    <label class="form-label" for="sig-hours">Office Hours</label>
                    <input id="sig-hours" v-model="formData.officeHours" type="text" placeholder="9 AM - 5 PM" class="sig-input" />
                  </div>
                  <div>
                    <label class="form-label" for="sig-timezone">Timezone</label>
                    <input id="sig-timezone" v-model="formData.timezone" type="text" placeholder="PST (UTC-8)" class="sig-input" />
                  </div>
                </div>
                <div>
                  <label class="form-label" for="sig-email2">Secondary Email</label>
                  <input id="sig-email2" v-model="formData.secondaryEmail" type="email" placeholder="alternate@example.com" inputmode="email" class="sig-input" />
                </div>
              </div>
            </details>
          </div>
        </fieldset>

        <!-- Photo -->
        <fieldset class="form-section">
          <legend class="section-title">Photo <span class="optional-tag">(optional)</span></legend>

          <div class="space-y-4">
            <div>
              <label class="form-label" for="sig-photo-url">Hosted Image URL <span class="optional-tag">(best for Gmail &amp; Outlook)</span></label>
              <input id="sig-photo-url" v-model="formData.photoUrl" type="url" placeholder="https://yoursite.com/photo.jpg" inputmode="url" class="sig-input" aria-describedby="sig-photo-hint" />
              <p id="sig-photo-hint" class="text-xs text-stone-500 mt-1">A square image that's already online, e.g. from your website or Gravatar.</p>
            </div>

            <label v-if="!uploadedPhoto" for="photo-input"
                 @drop.prevent="handlePhotoDrop"
                 @dragover.prevent="isPhotoUploading = true"
                 @dragleave="isPhotoUploading = false"
                 :class="{ 'drag-over': isPhotoUploading }"
                 class="drop-zone p-6 text-center cursor-pointer">
              <svg class="w-10 h-10 mx-auto text-stone-500 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <span class="block text-stone-700 font-semibold mb-1">…or upload a photo</span>
              <span class="block text-sm text-stone-500">PNG or JPG, we'll crop it square automatically</span>
              <input
                id="photo-input"
                ref="photoInput"
                type="file"
                @change="handlePhotoSelect"
                accept="image/png,image/jpeg,image/jpg"
                class="sr-only" />
            </label>

            <div v-else class="flex items-center justify-between bg-cream/60 rounded-xl p-3 border border-[#e7e0d8]">
              <div class="flex items-center gap-3">
                <img :src="uploadedPhoto" alt="Your uploaded profile photo" class="w-14 h-14 rounded-full object-cover border-2 border-white shadow" />
                <span class="text-sm text-stone-700">Photo uploaded &amp; squared</span>
              </div>
              <button @click="removePhoto" class="btn-brand btn-ghost-brand btn-sm-brand">Remove</button>
            </div>

            <div v-if="uploadedPhoto && !formData.photoUrl" class="rounded-xl bg-amber-50 border border-amber-200 p-3 text-sm text-amber-900">
              <strong>Heads up:</strong> Gmail and Outlook.com usually remove photos embedded this way. For those, paste a hosted image URL above, or add the photo with Gmail's own image button after pasting.
            </div>
          </div>
        </fieldset>

        <!-- Social links -->
        <fieldset class="form-section">
          <legend class="section-title">Social Links <span class="optional-tag">(optional)</span></legend>

          <div class="space-y-3">
            <div v-for="social in shownSocials" :key="social.id" class="flex items-center gap-2">
              <span class="w-8 text-xl text-center" aria-hidden="true">{% raw %}{{ social.icon }}{% endraw %}</span>
              <div class="flex-1">
                <label :for="'social-' + social.id" class="form-label" style="margin-bottom: 0.2rem;">{% raw %}{{ social.label }}{% endraw %}</label>
                <input :id="'social-' + social.id"
                       v-model="formData.social[social.id]"
                       type="url"
                       inputmode="url"
                       :placeholder="social.placeholder"
                       class="sig-input" />
              </div>
              <button @click="hideSocial(social.id)" class="btn-brand btn-ghost-brand btn-sm-brand self-end" :aria-label="'Remove ' + social.label + ' field'">&times;</button>
            </div>
          </div>

          <div v-if="hiddenSocials.length" class="flex flex-wrap gap-2 mt-4">
            <button v-for="social in hiddenSocials" :key="social.id"
              @click="showSocial(social.id)"
              class="social-pill"
              :aria-label="'Add ' + social.label + ' field'">
              <span aria-hidden="true">+</span> {% raw %}{{ social.label }}{% endraw %}
            </button>
          </div>
        </fieldset>

        <!-- Colors (premium) -->
        <fieldset v-if="hasPremiumAccess" class="form-section">
          <legend class="section-title">Accent Colors</legend>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="form-label" for="sig-primary-color">Primary Color</label>
              <input id="sig-primary-color" v-model="formData.primaryColor" type="color" class="w-full h-12 rounded-xl cursor-pointer border-2 border-[#e7e0d8]" />
            </div>
            <div>
              <label class="form-label" for="sig-text-color">Text Color</label>
              <input id="sig-text-color" v-model="formData.textColor" type="color" class="w-full h-12 rounded-xl cursor-pointer border-2 border-[#e7e0d8]" />
            </div>
          </div>
        </fieldset>

        <div class="text-center">
          <button @click="clearAllData" class="text-sm text-stone-500 underline hover:text-espresso focus:outline-none focus-visible:ring-2 focus-visible:ring-espresso rounded px-2 py-1">
            Start over
          </button>
        </div>
      </div>

      <!-- RIGHT: Live email preview -->
      <div>
        <div class="lg:sticky lg:top-6 space-y-5">

          <!-- Compose window -->
          <div class="compose-window" role="region" aria-label="Live signature preview, shown inside a sample email">
            <div class="compose-chrome" aria-hidden="true">
              <span class="compose-dot" style="background:#ff5f57;"></span>
              <span class="compose-dot" style="background:#febc2e;"></span>
              <span class="compose-dot" style="background:#28c840;"></span>
              <span class="compose-title">New Message</span>
            </div>
            <div class="compose-field" aria-hidden="true">
              <span class="cf-label">To:</span>
              <span>Your future contacts</span>
            </div>
            <div class="compose-field" aria-hidden="true">
              <span class="cf-label">Subject:</span>
              <span>{% raw %}{{ isSignatureValid ? 'Check out my new signature' : 'Your signature will look like this' }}{% endraw %}</span>
            </div>
            <div class="compose-body">
              <p aria-hidden="true">Hi there,</p>
              <p aria-hidden="true" class="mt-2">Here's the new signature, it updates live as you type.</p>
              <p aria-hidden="true" class="mt-2">Best,</p>
              <div class="compose-sig">
                <span v-if="!isSignatureValid" class="sample-badge">Sample</span>
                <div class="signature-preview" v-html="previewSignature"></div>
              </div>
            </div>
          </div>

          <!-- Copy actions -->
          <div class="form-section" style="background: white; border-radius: 1rem; padding: 1.25rem; border: 1.5px solid #e7e0d8;">
            <div class="flex flex-wrap gap-2.5 items-center">
              <button
                @click="copySignature"
                :disabled="!isSignatureValid"
                aria-describedby="copy-hint"
                class="btn-brand btn-primary-brand" style="padding: 0.75rem 1.6rem; font-size: 0.95rem;">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                {% raw %}{{ copied ? 'Copied!' : 'Copy signature' }}{% endraw %}
              </button>
              <button @click="copyHtmlCode" :disabled="!isSignatureValid" class="btn-brand btn-secondary-brand btn-sm-brand">Copy HTML code</button>
              <button @click="downloadHtml" :disabled="!isSignatureValid" class="btn-brand btn-ghost-brand btn-sm-brand">Download .html</button>
            </div>
            <p id="copy-hint" class="text-sm text-stone-500 mt-3">
              <template v-if="isSignatureValid">"Copy signature" pastes straight into Gmail, Outlook, or Apple Mail settings.</template>
              <template v-else>Enter your name and email to enable copying, or <button @click="loadExample" class="underline text-espresso font-medium focus:outline-none focus-visible:ring-2 focus-visible:ring-espresso rounded">load the example</button>.</template>
            </p>
          </div>

          <!-- Setup guide -->
          <div style="background: white; border-radius: 1rem; padding: 1.25rem 1.5rem; border: 1.5px solid #e7e0d8;">
            <h2 class="text-sm font-bold text-caramel uppercase tracking-wide mb-3">Add it to your email app</h2>
            <div class="flex flex-wrap gap-2 mb-4" role="tablist" aria-label="Email client instructions">
              <button v-for="client in setupClients" :key="client.id"
                role="tab"
                :aria-selected="setupTab === client.id ? 'true' : 'false'"
                @click="setSetupTab(client.id)"
                class="setup-tab">
                {% raw %}{{ client.name }}{% endraw %}
              </button>
            </div>

            <ol v-if="setupTab === 'gmail'" role="tabpanel" class="text-sm text-stone-700 space-y-1.5 list-decimal list-inside">
              <li>Click "Copy signature" above</li>
              <li>Open <a href="https://mail.google.com/mail/u/0/#settings/general" target="_blank" rel="noopener" class="text-espresso underline">Gmail Settings → General</a></li>
              <li>Scroll to "Signature" → click "+ Create new"</li>
              <li>Paste (Ctrl+V / Cmd+V) into the editor</li>
              <li>Scroll down and hit "Save Changes"</li>
            </ol>
            <ol v-if="setupTab === 'outlook'" role="tabpanel" class="text-sm text-stone-700 space-y-1.5 list-decimal list-inside">
              <li>Click "Copy signature" above</li>
              <li>Open <a href="https://outlook.office.com/mail/" target="_blank" rel="noopener" class="text-espresso underline">Outlook Web</a> → Settings → "Compose and reply"</li>
              <li>Paste into the signature editor</li>
              <li>Turn on "Automatically include my signature"</li>
              <li>Save. (Outlook desktop: File → Options → Mail → Signatures, then paste)</li>
            </ol>
            <ol v-if="setupTab === 'apple'" role="tabpanel" class="text-sm text-stone-700 space-y-1.5 list-decimal list-inside">
              <li>Click "Copy signature" above</li>
              <li>Open Mail → Settings (Cmd+,) → "Signatures" tab</li>
              <li>Pick your account, click "+"</li>
              <li>Paste, then <strong>uncheck</strong> "Always match my default font"</li>
              <li>Close settings, done</li>
            </ol>
            <ol v-if="setupTab === 'thunderbird'" role="tabpanel" class="text-sm text-stone-700 space-y-1.5 list-decimal list-inside">
              <li>Click "Download .html" above</li>
              <li>Thunderbird → Settings → Account Settings</li>
              <li>Check "Attach the signature from a file instead"</li>
              <li>Select the downloaded file, check "Use HTML"</li>
              <li>Click OK</li>
            </ol>

            <p class="text-xs text-stone-500 mt-4 pt-3 border-t border-stone-100">
              Tip: send yourself a test email first, and check it on your phone.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile action bar -->
    <div class="mobile-actionbar">
      <span class="text-sm text-stone-600">{% raw %}{{ isSignatureValid ? 'Signature ready' : 'Add name + email' }}{% endraw %}</span>
      <button @click="copySignature" :disabled="!isSignatureValid" class="btn-brand btn-primary-brand">
        {% raw %}{{ copied ? 'Copied!' : 'Copy signature' }}{% endraw %}
      </button>
    </div>

    <!-- Toast (live region stays mounted) -->
    <div role="status" aria-live="polite">
      <span v-if="toast" class="toast-msg">{% raw %}{{ toast }}{% endraw %}</span>
    </div>
  </main>

  {% include modals.liquid %}
  {% include footer.liquid %}

    {% pageJs "email-signature-generator" %}
</body>
</html>
