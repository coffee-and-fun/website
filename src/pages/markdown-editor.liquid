    <main id="main-content">

        <!-- ============ HERO ============ -->
        <section class="pt-20 sm:pt-28 pb-16 sm:pb-24" aria-labelledby="hero-heading">
            <div class="mx-auto max-w-4xl px-6 text-center">
                <h1 id="hero-heading" class="t-hero">
                    It’s just a <span class="nowrap">markdown editor.</span><br />
                    <span class="t-accent">Until it isn’t.</span>
                </h1>
                <p class="t-sub mx-auto mt-7 max-w-2xl">
                    Write markdown on the left, watch it come to life on the right.
                    Every word stays on your device, no account, no cloud, no subscription.
                </p>
                <div class="mt-9 flex flex-col sm:flex-row items-center justify-center gap-3.5">
                    <a href="#get" class="btn-fill">Get it free for your browser</a>
                    <a href="https://apps.apple.com/us/app/markdown-editor-for-safari/id6578456621" target="_blank" rel="noopener noreferrer" class="btn-quiet">$5 once on Apple&nbsp;devices</a>
                </div>
                <p class="mt-5 text-[0.95rem]" style="color:var(--text-3);">
                    Free on Chrome, Edge &amp; Firefox&ensp;·&ensp;One-time $5 on Mac, iPad, iPhone &amp; Safari
                </p>
            </div>

            <!-- The real thing: an actual screenshot of the app, night theme -->
            <div class="mx-auto max-w-6xl px-4 sm:px-6 mt-14 sm:mt-16">
                <figure>
                    <div class="app-shot">
                        <picture>
                            <source type="image/webp"
                                    srcset="/assets/images/apps/markdown-editor-app.webp 1440w, /assets/images/apps/markdown-editor-app@2x.webp 2880w"
                                    sizes="(min-width: 1152px) 1104px, 100vw" />
                            <img src="/assets/images/apps/markdown-editor-app@2x.png"
                                 srcset="/assets/images/apps/markdown-editor-app.png 1440w, /assets/images/apps/markdown-editor-app@2x.png 2880w"
                                 sizes="(min-width: 1152px) 1104px, 100vw"
                                 alt="Markdown Editor in its night theme: markdown source and toolbar on the left, live preview on the right, pet cat at the bottom."
                                 width="1440" height="860" fetchpriority="high" decoding="async" />
                        </picture>
                    </div>
                    <figcaption class="mt-6 text-center text-[0.95rem]" style="color:var(--text-3);">
                        Not a mockup, the actual editor, night theme, pet cat on duty.
                    </figcaption>
                </figure>
            </div>
        </section>

        <!-- ============ FEATURES ============ -->
        <section id="features" class="py-20 sm:py-32 scroll-mt-16" aria-labelledby="features-heading">
            <div class="mx-auto max-w-6xl px-6">
                <div class="max-w-2xl mb-16">
                    <h2 id="features-heading" class="t-section">Everything you need.<br /><span style="color:var(--text-3);">Nothing to set up.</span></h2>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
                    <div class="tile reveal">
                        <div class="tile-icon" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg></div>
                        <h3 class="mb-1.5">Live preview</h3>
                        <p>GitHub-flavored rendering as you type, tables, task lists, footnotes, front matter, and synced scrolling.</p>
                    </div>
                    <div class="tile reveal">
                        <div class="tile-icon" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M6 8h.01M10 8h.01M14 8h.01M18 8h.01M6 12h.01M10 12h.01M14 12h.01M18 12h.01M7 16h10"/></svg></div>
                        <h3 class="mb-1.5">Toolbar &amp; shortcuts</h3>
                        <p>Bold, italic, links, and lists in one tap, or ⌘B, ⌘I, and ⌘K when your hands never leave the keys.</p>
                    </div>
                    <div class="tile reveal">
                        <div class="tile-icon" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></div>
                        <h3 class="mb-1.5">Version history</h3>
                        <p>Automatic snapshots while you write. The paragraph you deleted an hour ago is two clicks from home.</p>
                    </div>
                    <div class="tile reveal">
                        <div class="tile-icon" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg></div>
                        <h3 class="mb-1.5">Find &amp; replace</h3>
                        <p>⌘F through long documents with match case, then replace one match or every match at once.</p>
                    </div>
                    <div class="tile reveal">
                        <div class="tile-icon" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M7 12h13M10 18h10"/></svg></div>
                        <h3 class="mb-1.5">Outline</h3>
                        <p>Every heading in a sidebar, so a 5,000-word document feels as small as a note.</p>
                    </div>
                    <div class="tile reveal">
                        <div class="tile-icon" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 15l2 2 4-4"/></svg></div>
                        <h3 class="mb-1.5">Templates &amp; smart paste</h3>
                        <p>Start from a README or meeting notes, and anything pasted from the web becomes clean markdown.</p>
                    </div>
                    <div class="tile reveal">
                        <div class="tile-icon" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 4H6v3l5 5-5 5v3h12v-3l-5-5 5-5z"/></svg></div>
                        <h3 class="mb-1.5">Math &amp; diagrams</h3>
                        <p>KaTeX equations and Mermaid flowcharts render right in the preview, your thesis and your architecture doc, both covered.</p>
                    </div>
                    <div class="tile reveal">
                        <div class="tile-icon" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg></div>
                        <h3 class="mb-1.5">Goals &amp; focus</h3>
                        <p>Word goals with a progress ring, reading time, a WPM meter, and typewriter scrolling that keeps your cursor centered.</p>
                    </div>
                    <div class="tile reveal">
                        <div class="tile-icon" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg></div>
                        <h3 class="mb-1.5">Beautiful exports</h3>
                        <p>Download .md, print, export themed HTML, back everything up as a .zip, or send a doc to ChatGPT, Claude, or Perplexity.</p>
                    </div>
                </div>

                <div class="mt-20 flex flex-wrap items-center gap-x-7 gap-y-4">
                    <span class="text-sm font-semibold" style="color:var(--text);">Eight themes</span>
                    <span class="theme-dot-item"><span class="theme-dot" style="background:#38bdf8;"></span>Night</span>
                    <span class="theme-dot-item"><span class="theme-dot" style="background:#ff79c6;"></span>Dracula</span>
                    <span class="theme-dot-item"><span class="theme-dot" style="background:#db924b;"></span>Coffee</span>
                    <span class="theme-dot-item"><span class="theme-dot" style="background:#ff865b;"></span>Sunset</span>
                    <span class="theme-dot-item"><span class="theme-dot" style="background:#9fe88d;"></span>Dim</span>
                    <span class="theme-dot-item"><span class="theme-dot" style="background:#5e81ac;"></span>Nord</span>
                    <span class="theme-dot-item"><span class="theme-dot" style="background:#65c3c8;"></span>Cupcake</span>
                    <span class="theme-dot-item"><span class="theme-dot" style="background:#e779c1;"></span>Synthwave</span>
                </div>
            </div>
        </section>

        <!-- ============ CHAOS ZONE ============ -->
        <section class="well-band py-20 sm:py-32" aria-labelledby="chaos-heading">
            <div class="mx-auto max-w-4xl px-6 text-center">
                <h2 id="chaos-heading" class="t-section">All work and no play?<br /><span class="t-accent">Not here.</span></h2>
