            "Typewriter scrolling and full-width mode",
            "Eight color themes",
            "Themed HTML export, print, and .zip backup of every document",
            "Send documents to ChatGPT, Claude, or Perplexity",
            "Localized in 70 languages",
            "Works offline — no account, documents stay on your device"
        ],
        "creator": { "@type": "Organization", "name": "Coffee & Fun LLC", "url": "https://www.coffeeandfun.com" }
    }
    </script>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
            { "@type": "Question", "name": "Is Markdown Editor free?",
              "acceptedAnswer": { "@type": "Answer", "text": "The browser extension is completely free on Chrome, Edge, and Firefox. On Apple devices, the Mac, iPad, and iPhone app — which includes the Safari extension — is a single $5 purchase. No subscription, ever." } },
            { "@type": "Question", "name": "Do all platforms get the same features?",
              "acceptedAnswer": { "@type": "Answer", "text": "Yes. Every feature ships on every platform — Chrome, Edge, Firefox, Safari, Mac, iPad, and iPhone. If a feature can't work everywhere, we don't ship it." } },
            { "@type": "Question", "name": "Does it work offline?",
              "acceptedAnswer": { "@type": "Answer", "text": "Yes. Everything runs locally. Your documents are stored on your own device, and you can write with no internet connection at all." } },
            { "@type": "Question", "name": "Where are my documents stored?",
              "acceptedAnswer": { "@type": "Answer", "text": "On your device, in your browser's or app's local storage. Nothing is uploaded, there is no account, and you can download any document as a .md file or back up your whole library as a .zip at any time." } },
            { "@type": "Question", "name": "What flavor of markdown does it support?",
              "acceptedAnswer": { "@type": "Answer", "text": "GitHub-flavored markdown, plus footnotes, front matter, highlights, KaTeX math equations, and Mermaid diagrams." } },
            { "@type": "Question", "name": "What languages is it available in?",
              "acceptedAnswer": { "@type": "Answer", "text": "Markdown Editor is localized in 70 languages, from Arabic to Zulu — every language the Chrome Web Store supports." } },
            { "@type": "Question", "name": "What is the chaos zone?",
              "acceptedAnswer": { "@type": "Answer", "text": "A drawer of completely optional toys: a pet cat that wanders your screen, Matrix rain, vaporwave mode, a combo counter, typewriter sounds, emoji rain, and more. Every toy is off by default." } }
        ]
