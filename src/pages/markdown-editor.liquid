    {% bundledCss %}
    {% include scripts.html %}

    <!-- JetBrains Mono — the editor's typeface, self-hosted -->
    <link rel="preload" href="/assets/fonts/jetbrains-mono-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/jetbrains-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />

    <style>
        /* ============================================================
           This page follows the Markdown Editor app's own design system:
           daisyUI "night" theme (slate #0f172a base, sky #38bdf8 primary,
           indigo #818cf8 secondary, pink #f471b5 accent) + JetBrains Mono.
           ============================================================ */
        @font-face {
            font-family: 'JetBrains Mono';
            font-style: normal;
            font-weight: 400;
            font-display: swap;
            src: url('/assets/fonts/jetbrains-mono-latin-400-normal.woff2') format('woff2');
        }
        @font-face {
            font-family: 'JetBrains Mono';
            font-style: normal;
            font-weight: 700;
            font-display: swap;
            src: url('/assets/fonts/jetbrains-mono-latin-700-normal.woff2') format('woff2');
        }
        @font-face {
            font-family: 'JetBrains Mono';
            font-style: normal;
            font-weight: 800;
            font-display: swap;
            src: url('/assets/fonts/jetbrains-mono-latin-800-normal.woff2') format('woff2');
        }

        :root {
            --n-base: #0f172a;      /* night base-100 */
            --n-deep: #0b1120;      /* darker wells */
            --n-panel: #1e293b;     /* cards, panes */
            --n-border: #334155;    /* hairlines */
            --n-text: #e2e8f0;      /* body text */
            --n-muted: #94a3b8;     /* secondary text */
            --n-faint: #64748b;     /* tertiary text */
            --n-primary: #38bdf8;   /* night primary (sky) */
            --n-primary-ink: #082f49; /* text on primary */
            --n-secondary: #818cf8; /* indigo */
            --n-accent: #f471b5;    /* pink */
            --n-success: #2dd4bf;
            --n-warning: #f4bf50;
            --mono: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', Consolas, 'Courier New', monospace;
        }

        html { background-color: var(--n-base); }
        .night-page { background-color: var(--n-base); color: var(--n-text); }

        /* ===== Display type — the editor's monospace voice ===== */
        .display-hero {
            font-family: var(--mono);
            font-weight: 800;
            letter-spacing: -0.045em;
            line-height: 1.1;
            color: var(--n-text);
            font-size: clamp(2rem, 5.4vw, 3.8rem);
        }
        .display-section {
            font-family: var(--mono);
            font-weight: 800;
            letter-spacing: -0.035em;
            line-height: 1.15;
            color: var(--n-text);
            font-size: clamp(1.5rem, 3.4vw, 2.4rem);
        }
        .md-prefix { color: var(--n-primary); font-weight: 700; }

        /* Inline-code highlight — how the editor would say it */
        .code-hl {
            background: var(--n-panel);
            border: 1px solid var(--n-border);
            border-radius: 0.5em;
            padding: 0.04em 0.28em;
            color: var(--n-primary);
            white-space: nowrap;
        }
        .code-hl-pink { color: var(--n-accent); }

        /* Blinking block cursor */
        .cursor-blink {
            display: inline-block;
            width: 0.55em;
            height: 1em;
            margin-left: 0.12em;
            background: var(--n-primary);
            vertical-align: text-bottom;
            animation: blink 1.1s steps(1) infinite;
        }
        @keyframes blink { 50% { opacity: 0; } }

        .mono { font-family: var(--mono); }

        /* ===== Buttons — daisyUI-night btn language ===== */
        .btn-md-primary, .btn-md-ghost, .btn-md-dark, .store-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.6rem;
            border-radius: 0.75rem;
            padding: 0.9rem 1.7rem;
            font-weight: 700;
            font-size: 1rem;
            line-height: 1.2;
            transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
        }
        .btn-md-primary {
            background: var(--n-primary);
            color: var(--n-primary-ink);
            box-shadow: 0 10px 30px -10px rgba(56, 189, 248, 0.45);
        }
        .btn-md-primary:hover { transform: translateY(-2px); box-shadow: 0 16px 36px -10px rgba(56, 189, 248, 0.55); }
        .btn-md-ghost {
            background: transparent;
            color: var(--n-text);
            border: 1.5px solid var(--n-border);
        }
        .btn-md-ghost:hover { transform: translateY(-2px); border-color: var(--n-primary); }
        .btn-md-dark {
            background: var(--n-base);
            color: var(--n-text);
        }
        .btn-md-dark:hover { transform: translateY(-2px); }
        a:focus-visible, summary:focus-visible, button:focus-visible {
            outline: 3px solid var(--n-primary);
            outline-offset: 3px;
            border-radius: 0.5rem;
        }

        /* ===== Top bar — styled like the app's own header ===== */
        .app-topbar {
            position: sticky;
            top: 0;
            z-index: 40;
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--n-border);
        }

        /* ===== Cards ===== */
        .feature-card {
            background: var(--n-panel);
            border: 1px solid var(--n-border);
            border-radius: 1rem;
            padding: 1.6rem;
            transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        }
        .feature-card:hover {
            transform: translateY(-4px);
            border-color: rgba(56, 189, 248, 0.5);
            box-shadow: 0 20px 40px -24px rgba(56, 189, 248, 0.35);
        }
        .feature-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 2.9rem;
            height: 2.9rem;
            border-radius: 0.75rem;
            background: var(--n-base);
            border: 1px solid var(--n-border);
            margin-bottom: 1rem;
            font-size: 1.3rem;
        }

        /* ===== Chaos section ===== */
        .chaos-section { background: var(--n-deep); }
        .chaos-card {
            background: rgba(148, 163, 184, 0.07);
            border: 1px solid rgba(148, 163, 184, 0.15);
            border-radius: 0.9rem;
            padding: 1.1rem 1.2rem;
            transition: transform 0.2s ease, border-color 0.2s ease;
        }
        .chaos-card:hover { transform: translateY(-3px); border-color: rgba(244, 113, 181, 0.6); }

        /* ===== Theme chips — the app's actual 8 themes ===== */
        .theme-chip {
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
            border-radius: 9999px;
            padding: 0.5rem 1rem 0.5rem 0.6rem;
            font-family: var(--mono);
            font-size: 0.85rem;
            font-weight: 700;
            border: 1px solid var(--n-border);
            background: var(--n-panel);
            color: var(--n-text);
            transition: transform 0.2s ease, border-color 0.2s ease;
        }
        .theme-chip:hover { transform: translateY(-2px); border-color: var(--n-primary); }
        .theme-swatch {
            width: 1.5rem;
            height: 1.5rem;
            border-radius: 9999px;
            border: 2px solid rgba(148, 163, 184, 0.35);
            flex-shrink: 0;
        }

        /* ===== Editor mockup — the app, as it actually looks (night theme) ===== */
        .mock-window {
            background: var(--n-panel);
            border: 1px solid var(--n-border);
            border-radius: 1rem;
            box-shadow: 0 50px 100px -50px rgba(0, 0, 0, 0.8), 0 0 60px -30px rgba(56, 189, 248, 0.25);
            overflow: hidden;
        }
        .mock-editor { font-family: var(--mono); font-size: 0.82rem; line-height: 1.8; color: #cbd5e1; background: var(--n-base); }
        .mock-editor .tok { color: var(--n-secondary); }
        .mock-editor .tok-h { color: var(--n-primary); font-weight: 700; }
        .mock-editor .tok-b { color: var(--n-text); font-weight: 700; }
        .mock-editor .tok-c { color: var(--n-accent); }
        .mock-preview { font-size: 0.9rem; line-height: 1.7; color: #cbd5e1; }
        .mock-preview h3 { font-size: 1.2rem; font-weight: 800; color: #f1f5f9; letter-spacing: -0.02em; margin-bottom: 0.35rem; }
        .mock-preview blockquote { border-left: 3px solid var(--n-primary); padding-left: 0.75rem; color: var(--n-muted); font-style: italic; margin: 0.5rem 0; }
        .mock-preview code { background: var(--n-base); border: 1px solid var(--n-border); border-radius: 0.375rem; padding: 0.1rem 0.35rem; font-size: 0.78rem; font-family: var(--mono); color: var(--n-accent); }
        .mock-check { display: flex; align-items: center; gap: 0.5rem; margin: 0.15rem 0; }
        .mock-checkbox { width: 0.95rem; height: 0.95rem; border-radius: 0.25rem; border: 1.5px solid var(--n-faint); flex-shrink: 0; }
        .mock-checkbox.done { background: var(--n-primary); border-color: var(--n-primary); position: relative; }
        .mock-checkbox.done::after { content: "✓"; position: absolute; inset: 0; color: var(--n-primary-ink); font-size: 0.7rem; line-height: 0.95rem; text-align: center; font-weight: 700; }
        .mock-toolbtn {
            display: inline-flex; align-items: center; justify-content: center;
            min-width: 1.7rem; height: 1.7rem; padding: 0 0.4rem;
            border-radius: 0.4rem; background: var(--n-panel); border: 1px solid var(--n-border);
            font-size: 0.72rem; color: var(--n-muted);
        }

        /* Mono comment annotations (instead of doodles) */
        .code-note {
            position: absolute;
            font-family: var(--mono);
            font-size: 0.8rem;
            color: var(--n-faint);
            pointer-events: none;
            white-space: nowrap;
            z-index: 10;
        }
        @media (max-width: 767px) { .code-note { display: none; } }

        .goal-ring { transform: rotate(-90deg); }
        .goal-ring .track { stroke: var(--n-border); }
        .goal-ring .fill { stroke: var(--n-accent); stroke-linecap: round; }

        /* The pet cat strolls along the top of the mock window */
        @keyframes cat-stroll {
            0%   { transform: translateX(0) scaleX(1); }
            45%  { transform: translateX(150px) scaleX(1); }
            50%  { transform: translateX(150px) scaleX(-1); }
            95%  { transform: translateX(0) scaleX(-1); }
            100% { transform: translateX(0) scaleX(1); }
        }
        .mock-cat { display: inline-block; animation: cat-stroll 18s ease-in-out infinite; }

        /* ===== Step numbers ===== */
        .step-num {
            font-family: var(--mono);
            font-weight: 800;
            font-size: 3.2rem;
            line-height: 1;
            letter-spacing: -0.04em;
            color: transparent;
            -webkit-text-stroke: 2px var(--n-primary);
            opacity: 0.9;
        }

        /* ===== FAQ ===== */
        details.faq {
            background: var(--n-panel);
            border: 1px solid var(--n-border);
            border-radius: 0.9rem;
            transition: border-color 0.2s ease;
        }
        details.faq:hover { border-color: rgba(56, 189, 248, 0.5); }
        details.faq summary {
            cursor: pointer;
            list-style: none;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 1.1rem 1.35rem;
            font-weight: 700;
            color: var(--n-text);
        }
        details.faq summary::-webkit-details-marker { display: none; }
        details.faq summary .faq-chevron { transition: transform 0.2s ease; flex-shrink: 0; color: var(--n-primary); }
        details.faq[open] summary .faq-chevron { transform: rotate(180deg); }
        details.faq .faq-body { padding: 0 1.35rem 1.2rem; color: var(--n-muted); line-height: 1.7; }

        /* ===== CTA band ===== */
        .cta-band { background: linear-gradient(120deg, var(--n-primary) 0%, var(--n-secondary) 100%); }

        /* ===== Scroll reveal ===== */
        .reveal { opacity: 0; transform: translateY(18px); transition: opacity 0.6s ease, transform 0.6s ease; }
        .reveal.revealed { opacity: 1; transform: none; }

        @media (prefers-reduced-motion: reduce) {
            .reveal { opacity: 1; transform: none; transition: none; }
            .mock-cat, .cursor-blink { animation: none; }
            .btn-md-primary, .btn-md-ghost, .btn-md-dark, .store-btn, .feature-card, .chaos-card, .theme-chip { transition: none; }
        }

        /* ===== Store buttons ===== */
        .store-btn { padding: 0.75rem 1.3rem; border-radius: 0.75rem; }
        .store-btn-slate {
            background: var(--n-base);
            border: 1.5px solid var(--n-border);
            color: var(--n-text);
        }
        .store-btn-slate:hover { transform: translateY(-2px); border-color: var(--n-primary); }
        .store-btn-primary {
            background: var(--n-primary);
            color: var(--n-primary-ink);
        }
        .store-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 14px 30px -12px rgba(56, 189, 248, 0.5); }
    </style>
</head>

<body class="night-page">

