    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Is Markdown Editor free?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The browser extension is completely free on Chrome, Edge, and Firefox, every feature included. On Apple devices, the Mac, iPad, and iPhone app (which includes the Safari extension) is a single $5 purchase. No subscription, ever."
            }
          },
          {
            "@type": "Question",
            "name": "Do all platforms really get the same features?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, it’s a house rule. Every feature ships on every platform: Chrome, Edge, Firefox, Safari, Mac, iPad, and iPhone. If something can’t work everywhere, we don’t ship it anywhere."
            }
          },
          {
            "@type": "Question",
            "name": "Does it work offline?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Completely. Everything runs locally, you can write a novel on a plane with airplane mode on. Nothing about the editor needs the internet."
            }
          },
          {
            "@type": "Question",
            "name": "Where are my documents stored?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "On your own device, in the browser’s or app’s local storage. Nothing is uploaded and there’s no account. You can download any document as a .md file, or back up your entire library as a .zip, whenever you want."
            }
          },
          {
            "@type": "Question",
            "name": "What flavor of markdown is supported?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "GitHub-flavored markdown, tables, task lists, strikethrough, plus footnotes, front matter, highlights, KaTeX math equations, and Mermaid diagrams."
            }
          },
          {
            "@type": "Question",
            "name": "What languages is it available in?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Seventy, every language the Chrome Web Store supports, from Arabic to Zulu, each one hand-translated rather than machine-dumped."
            }
          },
          {
            "@type": "Question",
            "name": "OK, but what is the chaos zone?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A drawer of completely optional toys hiding in Settings: a pet cat that wanders your screen, Matrix rain, vaporwave mode, a fighting-game combo counter, typewriter sounds, emoji rain, a rage-quit alarm, and more. Everything is off by default. We just believe software is allowed to be fun."
            }
          }
        ],
        "publisher": {
          "@id": "https://www.coffeeandfun.com/#organization"
        },
        "isPartOf": {
          "@id": "https://www.coffeeandfun.com/#website"
        }
      }
    </script>
