                    <li class="chaos-pill"><span aria-hidden="true">⌨️</span> Typewriter sounds</li>
                    <li class="chaos-pill"><span aria-hidden="true">🎉</span> Emoji rain</li>
                    <li class="chaos-pill"><span aria-hidden="true">🎵</span> Music mode</li>
                    <li class="chaos-pill"><span aria-hidden="true">🚨</span> Rage-quit alarm</li>
                    <li class="chaos-pill"><span aria-hidden="true">📈</span> WPM on fire</li>
                </ul>
            </div>
        </section>

        <!-- ============ PRICING / GET IT ============ -->
        <section id="get" class="py-20 sm:py-32 scroll-mt-16" aria-labelledby="pricing-heading">
            <div class="mx-auto max-w-5xl px-6">
