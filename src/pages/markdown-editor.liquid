        "description": "A markdown editor with live GitHub-flavored preview, formatting toolbar, find and replace, outline, version history, templates, smart paste, KaTeX math, Mermaid diagrams, word goals, themed HTML export, and ZIP backups. Works offline with no account.",
        "url": "https://www.coffeeandfun.com/markdown-editor/",
        "image": "https://www.coffeeandfun.com/assets/images/social/pages/markdown-editor.png",
        "applicationCategory": "ProductivityApplication",
        "operatingSystem": "macOS, iOS, iPadOS, Chrome, Edge, Firefox, Safari",
        "offers": [
            { "@type": "Offer", "name": "Browser extension (Chrome, Edge, Firefox)", "price": "0", "priceCurrency": "USD" },
            { "@type": "Offer", "name": "Mac, iPad & iPhone app with Safari extension", "price": "5", "priceCurrency": "USD" }
        ],
        "featureList": [
            "Live GitHub-flavored markdown preview",
            "Formatting toolbar with keyboard shortcuts",
            "Find and replace with match case",
            "Outline panel for long documents",
            "Automatic version history with restore",
            "Document templates",
            "Smart paste converts HTML to markdown",
