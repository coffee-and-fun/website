    <main id="main-content">

        <!-- ============ HERO ============ -->
        <section class="relative" aria-labelledby="hero-heading">
            <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 pt-16 sm:pt-24 pb-10 text-center relative">

                <p class="mono inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-sm font-semibold mb-8" style="background:#1e293b; border:1px solid #334155; color:#94a3b8;">
                    <span style="color:#2dd4bf;">$</span> brew install a-nicer-way-to-write
                </p>

                <h1 id="hero-heading" class="display-hero mx-auto max-w-4xl">
                    <span class="md-prefix" aria-hidden="true"># </span>It's just a markdown editor.<br />
                    <span class="code-hl">Until it isn't.</span><span class="cursor-blink" aria-hidden="true"></span>
                </h1>

                <p class="mx-auto mt-7 max-w-2xl text-lg sm:text-xl leading-relaxed" style="color:#94a3b8;">
                    Write in markdown, watch it render live, and keep every word on your own device.
                    Templates, version history, math, diagrams, beautiful exports — and yes, an optional pet cat.
                </p>

                <div class="mt-9 flex flex-col sm:flex-row items-center justify-center gap-4">
                    <a href="#get" class="btn-md-primary">
                        Get it free for your browser
