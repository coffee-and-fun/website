  <meta property="og:site_name" content="Coffee & Fun" />
  <meta property="og:title" content="Coco's Trivia Corner: 53,000+ Quiz Questions - Coffee & Fun LLC" />
  <meta property="og:description" content="Play 10 new trivia questions every day, drawn from a bank of more than 53,000. Score points, earn a rank, and share your result. Free, no account needed." />
