<!DOCTYPE html>
<html class="brand-color-background scroll-smooth antialiased" lang="en" data-theme="light" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Apps, Extensions & Free Web Tools - Coffee & Fun LLC</title>
    <meta name="title" content="Apps, Extensions & Free Web Tools - Coffee & Fun LLC" />
    <meta name="description" content="Browse everything Coffee & Fun LLC makes: Mac and iOS apps, Chrome and Safari extensions, free web tools, open source projects, and a few retired favorites." />
    <meta name="author" content="Coffee & Fun LLC" />
    <meta name="robots" content="index, follow" />
    <meta name="rating" content="safe for kids" />

    <link rel="canonical" href="https://www.coffeeandfun.com/apps/" />
    <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />
    <link rel="apple-touch-icon" href="/assets/images/social/192.png" />
    <link rel="icon" href="/assets/images/social/192.png" sizes="192x192" type="image/png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coffee & Fun" />
    <meta property="og:title" content="Apps, Extensions & Free Web Tools - Coffee & Fun LLC" />
    <meta property="og:description" content="Browse everything Coffee & Fun LLC makes: Mac and iOS apps, Chrome and Safari extensions, free web tools, open source projects, and a few retired favorites." />
    <meta property="og:url" content="https://www.coffeeandfun.com/apps/" />
    <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/apps.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Coffee & Fun logo with the slogan Crafting software, one brew at a time" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bycoffeeandfun" />
    <meta name="twitter:title" content="Apps, Extensions & Free Web Tools - Coffee & Fun LLC" />
    <meta name="twitter:description" content="Browse everything Coffee & Fun LLC makes: Mac and iOS apps, Chrome and Safari extensions, free web tools, open source projects, and a few retired favorites." />
    <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/apps.png" />
    <meta name="twitter:image:alt" content="Coffee & Fun logo with the slogan Crafting software, one brew at a time" />

    <link rel="manifest" href="/assets/images/social/site.webmanifest" />
    <meta name="theme-color" content="#fef5ec" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    {% include schema-org.liquid %}

    {% bundledCss %}



    {% pageCss "product" %}{% pageCss "apps" %}

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        "name": "Apps, Extensions & Free Web Tools - Coffee & Fun LLC",
        "description": "Browse everything Coffee & Fun LLC makes: Mac and iOS apps, Chrome and Safari extensions, free web tools, open source projects, and a few retired favorites.",
        "url": "https://www.coffeeandfun.com/apps/",
        "publisher": {
          "@id": "https://www.coffeeandfun.com/#organization"
        },
        "isPartOf": {
          "@id": "https://www.coffeeandfun.com/#website"
        },
        "mainEntity": {
          "@id": "https://www.coffeeandfun.com/apps/#catalogue"
        }
      }
    </script>

    {% include apps-itemlist.liquid %}
</head>

<body class="cf-catalog-page">
{% include header.liquid %}
<main tabindex="-1" id="main-content">
  <section class="ca-hero" aria-labelledby="catalog-title">
    <div class="ca-wrap ca-intro">
      <div class="ca-page-doodles" aria-hidden="true">
        <svg class="ca-doodle-plane" viewBox="0 0 160 130" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M82 19L147 8L119 69L107 44L82 19ZM107 44L147 8M106 45L103 61L114 53"/><path d="M91 76C24 131 7 72 39 77C67 83 39 117 12 117" stroke-dasharray="4 7"/></svg>
        <svg class="ca-doodle-cursor" viewBox="0 0 90 105" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M24 34L30 82L42 68L54 91L64 84L51 63L72 60L24 34ZM22 18L18 8M38 17L42 4M51 25L65 18M12 30L3 27"/></svg>
        <svg class="ca-doodle-spark" viewBox="0 0 100 90" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M34 12L40 33L62 39L41 45L34 68L27 47L7 40L27 33ZM77 57L79 80M67 69L91 68M79 11L87 21M87 11L79 21"/></svg>
        <svg class="ca-doodle-heart" viewBox="0 0 60 65" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M31 52C-1 34 8 8 25 24C40 1 64 23 31 52"/></svg>
        <span class="ca-love-note">made with love</span>
      </div>
      <h1 id="catalog-title">Our Apps &amp; Tools</h1>
      <p>Tools, extensions, and experiments, built with care.</p>
    </div>
    <div class="ca-controls ca-wrap" role="search" aria-label="Search the collection">
      <label class="ca-search" for="appSearchInput"><span class="ca-sr-only">Search apps &amp; tools</span><span class="ca-search-field"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="6.5"/><path d="M15 15L21 21"/></svg><input id="appSearchInput" type="search" placeholder="Search apps &amp; tools…" autocomplete="off"></span></label>
      <div class="ca-filter-area"><div id="filterTabs" class="ca-filters" role="group" aria-label="Filter by platform"><button class="filter-tab active" type="button" data-filter="all" aria-pressed="true">All</button>{% assign platforms = 'Web,Chrome,Safari,macOS,iOS,Open Source' | split: ',' %}{% for platform in platforms %}<button class="filter-tab" type="button" data-filter="{{ platform }}" aria-pressed="false">{% include platform-icon.liquid %}{{ platform }}</button>{% endfor %}</div><span class="ca-filter-note" aria-hidden="true"><svg viewBox="0 0 65 40" fill="none"><path d="M59 6Q28 8 7 29M12 15L6 30L24 30"/></svg>find your kind of thing</span></div>
      <div class="ca-results-line"><p id="catalogueStatus" class="ca-sr-only" role="status" aria-live="polite">{{ apps.apps.size }} apps and {{ apps.tools.size }} free tools to explore.</p><button type="button" id="clearCatalogue" hidden>Clear search &amp; filters</button></div>
    </div>
  </section>
  <div id="noResults" class="ca-empty ca-wrap hidden"><span aria-hidden="true">{% include journal-mark.liquid, drawing: 'bulb' %}</span><h2>No bright ideas by that name.</h2><p>Try another search, or clear the filters above.</p></div>
  <section class="ca-section ca-wrap" id="our-apps" aria-labelledby="apps-heading">
    <div class="ca-section-title"><div><h2 id="apps-heading">Apps &amp; extensions</h2><p>Little helpers. Big personalities.</p></div><span class="ca-margin-note" aria-hidden="true">pick a favorite <svg viewBox="0 0 80 50" fill="none"><path d="M6 8C47 0 67 17 52 37M43 27L52 40L65 30"/></svg></span></div>
    <div class="ca-app-grid" id="appGrid">{% assign featuredApps = 'Stillkeys|Immersive Reader for Safari|ProcrastiNOT|Markdown Editor|Hide Spoilers|Confetti Cannon|Incognito Bear|Simple Screenshot Pro' | split: '|' %}{% for appName in featuredApps %}{% assign app = apps.apps | where: 'name', appName | first %}{% if app %}{% include catalog-card.liquid %}{% endif %}{% endfor %}{% for app in apps.apps %}{% unless featuredApps contains app.name %}{% include catalog-card.liquid %}{% endunless %}{% endfor %}</div>
  </section>
  {% include section-wave.liquid, waveFrom: '#fef5ec', waveTo: '#f6ebe1' %}
  <section class="ca-section ca-tools" id="tools" aria-labelledby="tools-heading">
    <div class="ca-wrap"><div class="ca-section-title"><div><h2 id="tools-heading">Free tools</h2><p>No download. Just open and go.</p></div><span class="ca-tools-doodle" aria-hidden="true"><svg viewBox="0 0 95 70" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 31L74 28L69 59L21 61L15 31ZM9 31L80 27M29 37L32 54M48 37L48 54M63 35L60 52M25 28L41 9M64 28L49 10M82 13L86 6M85 22L94 20"/></svg><span>help yourself!</span></span></div>
    <div class="ca-tools-grid" id="toolsGrid">{% for app in apps.tools %}<a class="app-card ca-tool" href="{{ app.link }}" data-title="{{ app.name | downcase | escape }}" data-description="{{ app.description | downcase | escape }} {{ app.shortDescription | downcase | escape }}" data-platforms="{{ app.platform | join: ' ' | downcase }}"><div class="ca-tool-art ca-tool-{{ app.link | remove: "/" }}" aria-hidden="true">{% include catalog-tool-art.liquid %}</div><div class="ca-tool-copy"><h3>{{ app.name }}</h3><p>{{ app.shortDescription | default: app.description }}</p><span class="ca-tool-label">Free web tool</span></div></a>{% endfor %}</div>
    </div>
  </section>
  {% include section-wave.liquid, waveFrom: '#f6ebe1', waveTo: '#fef5ec' %}
  <section class="ca-section ca-wrap" id="open-source" aria-labelledby="source-heading">
    <div class="ca-section-title"><div><h2 id="source-heading">Open source</h2><p>A few good starting points for your next idea.</p></div><span class="ca-margin-note" aria-hidden="true">make it your own.</span></div>
    <div class="ca-source-grid" id="opensourceGrid">{% for app in apps.opensource %}<a class="app-card ca-source" href="{{ app.link }}" data-title="{{ app.name | downcase | escape }}" data-description="{{ app.description | downcase | escape }}" data-platforms="open source"><div class="ca-source-art ca-source-art-{{ forloop.index }}" aria-hidden="true"><img src="{{ app.image }}" alt="" width="800" height="420" loading="lazy" decoding="async">{% include catalog-source-doodles.liquid %}</div><div class="ca-source-copy"><h3>{{ app.name }}</h3><p>{% case forloop.index %}{% when 1 %}An open word list for your next project.{% when 2 %}Remove personal information from text.{% when 3 %}A tiny maths challenge for your forms.{% endcase %}</p><span class="ca-source-link">Explore project</span></div></a>{% endfor %}</div>
  </section>
  <section class="ca-section ca-wrap" id="archive" aria-labelledby="archive-heading">
    <details class="ca-archive-notebook" open><summary><h2 class="ca-archive-title" id="archive-heading">The graveyard</h2><span class="ca-archive-summary">{{ apps.graveyard.size }} retired projects <span class="ca-archive-toggle" aria-hidden="true">+</span></span></summary><div class="ca-graveyard-intro"><p class="ca-archive-note">Retired projects from our sketchbook.</p><svg class="ca-graveyard-doodle" viewBox="0 0 100 85" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M24 71L24 34C23 3 71 2 73 34L78 71L63 64L53 74L43 65L24 71ZM38 34L39 39M57 33L58 38M42 49Q49 55 55 48M8 18L9 29M3 24L15 23M86 48L88 62M81 55L95 54"/></svg></div>
    <div class="ca-archive-grid" id="graveyardGrid">{% for app in apps.graveyard %}{% include catalog-graveyard-card.liquid %}{% endfor %}</div></details>
  </section>
</main>
{% include footer.liquid %}
{% pageJs "apps" %}
</body></html>
