        /* ---------- The TV ---------- */
        .cabinet { width: min(96vw, 980px); margin-top: 0.4rem; }

        .antenna {
            position: relative;
            height: 74px;
            margin-bottom: -12px;
            pointer-events: none;
        }
        .antenna .rod {
            position: absolute;
            bottom: 0;
            left: 50%;
            width: 5px;
            height: 84px;
            background: linear-gradient(180deg, #8d8578, #3d3830);
            border-radius: 3px;
            transform-origin: bottom center;
        }
        .antenna .rod.l { transform: rotate(-34deg); }
        .antenna .rod.r { transform: rotate(30deg); }
        .antenna .rod::after {
            content: '';
            position: absolute;
            top: -7px;
            left: -3px;
            width: 11px;
            height: 11px;
            border-radius: 50%;
            background: #b8ae9d;
        }
        .antenna .base {
            position: absolute;
            bottom: -4px;
            left: 50%;
