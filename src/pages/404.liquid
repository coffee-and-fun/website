    <p class="credits">
        Cat fighters: <a href="https://pixelfight.itch.io/cat-pack" rel="noopener">Pixel Cats! by PixelFight</a> (CC0).
        Font: Press Start 2P (SIL OFL). Crash and Coco are real cats. No cats were harmed; one page was lost.
    </p>

    <div class="sr-only" role="status" aria-live="polite" id="announcer-live"></div>

    <noscript>
        <p style="max-width: 60ch; text-align: center; font-size: 11px; line-height: 2">
            The tournament needs JavaScript, but the important part doesn't:
            this page wasn't found. Use the links above to get back to the site.
        </p>
    </noscript>

    <script>
    (() => {
        'use strict';

        /* ============================== setup ============================== */
        const W = 640, H = 360, GROUND = 312;
        const cv = document.getElementById('game');
        const cx = cv.getContext('2d');
        cx.imageSmoothingEnabled = false;

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const live = document.getElementById('announcer-live');
        const say = (t) => { live.textContent = t; };

        /* Sprite sheets: 8 cols x 15 rows of 32px frames, 120 linear frames.
           Ranges come from the pack's Aseprite frame tags. */
        const FR = 32, COLS = 8, SCALE = 3, DRAW = FR * SCALE;
        const A = {
            idle:   { s: 0,   n: 8, fps: 8  },
            runL:   { s: 20,  n: 8, fps: 14 },
            runR:   { s: 28,  n: 8, fps: 14 },
            punchL: { s: 47,  n: 3, fps: 16 },
            punchR: { s: 50,  n: 3, fps: 16 },
            rollL:  { s: 64,  n: 8, fps: 24 },
            rollR:  { s: 56,  n: 8, fps: 24 },
            jumpL:  { s: 96,  n: 8, fps: 12 },
            jumpR:  { s: 112, n: 8, fps: 12 }
        };
        const CATS = {
            crash: { name: 'CRASH', img: '/assets/images/games/404/crash.png' },
            coco:  { name: 'COCO',  img: '/assets/images/games/404/coco.png' }
        };
        const sheets = {};
        for (const k of Object.keys(CATS)) {
            const im = new Image();
            im.src = CATS[k].img;
            sheets[k] = im;
        }
        document.getElementById('face-crash').style.backgroundImage = "url('" + CATS.crash.img + "')";
        document.getElementById('face-coco').style.backgroundImage = "url('" + CATS.coco.img + "')";

        /* ============================== audio ============================== */
        let AC = null, muted = false;
        try { muted = localStorage.getItem('cf404_mute') === '1'; } catch (e) { /* private mode */ }
        const sndBtn = document.getElementById('btn-sound');
        const syncSnd = () => {
            sndBtn.textContent = muted ? 'SOUND: OFF' : 'SOUND: ON';
            sndBtn.setAttribute('aria-pressed', String(!muted));
        };
        syncSnd();
        sndBtn.addEventListener('click', () => {
            muted = !muted;
            try { localStorage.setItem('cf404_mute', muted ? '1' : '0'); } catch (e) { /* fine */ }
            syncSnd();
        });
        function beep(freq, dur, type, vol, slide) {
            if (muted) return;
            try {
                AC = AC || new (window.AudioContext || window.webkitAudioContext)();
                const o = AC.createOscillator(), g = AC.createGain();
                o.type = type || 'square';
                o.frequency.setValueAtTime(freq, AC.currentTime);
                if (slide) o.frequency.exponentialRampToValueAtTime(slide, AC.currentTime + dur);
                g.gain.setValueAtTime(vol || 0.04, AC.currentTime);
                g.gain.exponentialRampToValueAtTime(0.0001, AC.currentTime + dur);
                o.connect(g).connect(AC.destination);
                o.start();
                o.stop(AC.currentTime + dur);
            } catch (e) { /* audio unavailable */ }
        }
        const sfx = {
            select: () => beep(660, 0.09, 'square', 0.05),
            start:  () => {
                beep(392, 0.1, 'square', 0.05);
                setTimeout(() => beep(523, 0.1, 'square', 0.05), 110);
                setTimeout(() => beep(784, 0.16, 'square', 0.05), 220);
            },
            whiff:  () => beep(190, 0.06, 'sawtooth', 0.03),
            hit:    () => { beep(120, 0.09, 'square', 0.07, 60); beep(45, 0.12, 'triangle', 0.08); },
            roll:   () => beep(300, 0.08, 'triangle', 0.035, 520),
            ko:     () => beep(500, 0.6, 'sawtooth', 0.07, 40),
            round:  () => beep(330, 0.12, 'square', 0.05, 440)
        };

        /* ============================== input ============================== */
        const keys = {};
        const KEYMAP = {
            ArrowLeft: 'left', KeyA: 'left',
            ArrowRight: 'right', KeyD: 'right',
            ArrowUp: 'jump', KeyW: 'jump',
            KeyZ: 'punch', KeyJ: 'punch',
            KeyX: 'roll', KeyK: 'roll'
        };
        addEventListener('keydown', (e) => {
            if (e.code === 'KeyP' || e.code === 'Escape') {
                if (state === 'play' || state === 'pause') { togglePause(); e.preventDefault(); }
                return;
            }
            const k = KEYMAP[e.code];
            if (!k) return;
            if (state === 'play') e.preventDefault();
            keys[k] = true;
        });
        addEventListener('keyup', (e) => { const k = KEYMAP[e.code]; if (k) keys[k] = false; });
        addEventListener('blur', () => { if (state === 'play') togglePause(true); });

        document.querySelectorAll('.tbtn').forEach((b) => {
            const k = b.dataset.t;
            const on = (e) => { e.preventDefault(); keys[k] = true; };
            const off = (e) => { e.preventDefault(); keys[k] = false; };
            b.addEventListener('pointerdown', on);
            b.addEventListener('pointerup', off);
            b.addEventListener('pointercancel', off);
            b.addEventListener('pointerleave', off);
        });

        /* ============================== fighters ============================== */
        const SPEED = 170, JUMP_V = -470, GRAV = 1300, ROLL_V = 330;
        const PUNCH_TIME = 3 / A.punchL.fps, ROLL_TIME = 0.34;
        const PUNCH_REACH = 52, PUNCH_DMG = 9, BODY_W = 34;

        function mkFighter(catKey, x, facing, isCPU) {
            return {
                cat: catKey, name: CATS[catKey].name,
                x, y: GROUND, vx: 0, vy: 0,
                facing, isCPU,
                hp: 100, rounds: 0,
                state: 'idle', t: 0, animT: 0,
                punchDidHit: false,
                rollCd: 0, punchCd: 0,
                stun: 0, invuln: 0,
                flash: 0, koSpin: 0,
                ai: { think: 0, dir: 0, wantPunch: false, wantRoll: false, wantJump: false }
            };
        }

        function setState(f, s) {
            if (f.state !== s) { f.state = s; f.t = 0; f.animT = 0; f.punchDidHit = false; }
        }

        // only play movement sfx for the human, cut the noise
        function sfxIf(f, name) { if (!f.isCPU) sfx[name](); }

        function fighterInput(f, inp, dt, foe) {
            if (f.state === 'ko' || f.state === 'win') { f.vx = 0; return; }
            f.rollCd = Math.max(0, f.rollCd - dt);
            f.punchCd = Math.max(0, f.punchCd - dt);
            if (f.stun > 0) { f.stun -= dt; setState(f, 'hit'); return; }

            const grounded = f.y >= GROUND - 0.5;
            if (f.state === 'punch') {
                if (f.t >= PUNCH_TIME) setState(f, grounded ? 'idle' : 'jump');
                else return;
            }
            if (f.state === 'roll') {
                f.vx = f.facing * ROLL_V;
                if (f.t >= ROLL_TIME) { f.vx = 0; setState(f, grounded ? 'idle' : 'jump'); }
                else return;
            }

            // square up with the opponent while grounded
            if (grounded) f.facing = foe.x >= f.x ? 1 : -1;

            let mx = 0;
            if (inp.left) mx -= 1;
            if (inp.right) mx += 1;
            f.vx = mx * SPEED;

            if (inp.punch && f.punchCd <= 0) {
                f.punchCd = 0.42;
                setState(f, 'punch');
                sfxIf(f, 'whiff');
                return;
            }
            if (inp.roll && grounded && f.rollCd <= 0) {
                if (mx !== 0) f.facing = mx;
                f.rollCd = 0.95;
                f.invuln = ROLL_TIME;
                setState(f, 'roll');
                sfxIf(f, 'roll');
                return;
            }
            if (inp.jump && grounded) { f.vy = JUMP_V; setState(f, 'jump'); return; }
            if (grounded) setState(f, mx !== 0 ? 'run' : 'idle');
            else if (f.state !== 'jump') setState(f, 'jump');
        }

        function fighterPhysics(f, dt) {
            f.invuln = Math.max(0, f.invuln - dt);
            f.flash = Math.max(0, f.flash - dt);
            f.t += dt;
            f.animT += dt;
            f.x += f.vx * dt;
            f.vy += GRAV * dt;
            f.y += f.vy * dt;
            if (f.y > GROUND) {
                f.y = GROUND;
                f.vy = 0;
                if (f.state === 'jump') setState(f, 'idle');
            }
            f.x = Math.max(46, Math.min(W - 46, f.x));
            if (f.state === 'ko') { f.koSpin += dt; f.vx *= 0.9; }
        }

        function tryHit(att, def) {
            if (att.state !== 'punch' || att.punchDidHit) return;
            const frame = Math.min(2, Math.floor(att.animT * A.punchL.fps));
            if (frame !== 1) return;                       // active on the middle frame
            if (def.invuln > 0 || def.state === 'ko') return;
            const reach = att.x + att.facing * PUNCH_REACH;
            const dx = Math.abs(reach - def.x);
            const dy = Math.abs(att.y - def.y);
            if (dx < BODY_W && dy < 40) {
                att.punchDidHit = true;
                def.hp = Math.max(0, def.hp - PUNCH_DMG);
                def.stun = 0.26;
                def.flash = 0.18;
                def.vx = att.facing * 210;
                def.vy = -60;
                sfx.hit();
                shake = reduceMotion ? 0 : 5;
                hitstop = 0.055;
                if (def.hp <= 0) startKO(att, def);
            }
        }

        /* ============================== AI ============================== */
        function aiThink(f, foe, dt) {
            const ai = f.ai;
            ai.gap = (ai.gap || 0) - dt;                  // personal punch pacing
            ai.think -= dt;
            if (ai.think > 0) return;
            ai.think = 0.11 + Math.random() * 0.09;
            const dist = Math.abs(foe.x - f.x);
            const dir = foe.x > f.x ? 1 : -1;
            // beatable in round 1, spicy by round 3
            const punchGap = Math.max(0.42, 0.95 - round * 0.18);
            ai.dir = 0; ai.wantPunch = false; ai.wantRoll = false; ai.wantJump = false;

            if (foe.state === 'punch' && dist < 95 && Math.random() < 0.24) {
                ai.wantRoll = true;
                ai.dir = -dir;                             // dodge away
                return;
            }
            if (dist > 240 && Math.random() < 0.1) ai.wantJump = true;
            if (dist > 66) {
                ai.dir = dir;
                if (dist > 120 && Math.random() < 0.05) ai.wantRoll = true;         // roll in
            } else if (ai.gap <= 0) {
                const r = Math.random();
                if (r < 0.55) { ai.wantPunch = true; ai.gap = punchGap; }
                else if (r < 0.75) { ai.wantRoll = true; ai.dir = -dir; ai.gap = punchGap * 0.7; } // whiff bait
                else ai.dir = -dir;                                                  // back off
            } else if (Math.random() < 0.25) {
                ai.dir = -dir;                             // circle out while waiting
            }
        }
        function aiInput(f) {
            return {
                left: f.ai.dir < 0, right: f.ai.dir > 0,
                jump: f.ai.wantJump, punch: f.ai.wantPunch, roll: f.ai.wantRoll
            };
        }

        /* ============================== match flow ============================== */
        let state = 'boot';           // boot | select | round | play | roundend | end | pause
        let p1 = null, p2 = null;     // p1 = human
        let round = 0, timer = 60;
        let banner = null, bannerT = 0, inputLock = true;
        let shake = 0, hitstop = 0;
        let finishText = '';

        const ui = document.getElementById('ui');
        const scr = {
            start: document.getElementById('scr-start'),
            select: document.getElementById('scr-select'),
            end: document.getElementById('scr-end')
        };
        function show(name) {
            ui.hidden = !name;
            for (const k of Object.keys(scr)) scr[k].hidden = k !== name;
        }

        function startMatch(pickKey) {
            const cpuKey = pickKey === 'crash' ? 'coco' : 'crash';
            p1 = mkFighter(pickKey, 180, 1, false);
            p2 = mkFighter(cpuKey, W - 180, -1, true);
            round = 0;
            nextRound();
        }
        function nextRound() {
            round++;
            timer = 60;
            const spots = [[p1, 180, 1], [p2, W - 180, -1]];
            for (const [f, x, face] of spots) {
                f.hp = 100; f.x = x; f.y = GROUND; f.vx = 0; f.vy = 0; f.facing = face;
                f.stun = 0; f.invuln = 0; f.flash = 0; f.koSpin = 0;
                setState(f, 'idle');
            }
            show(null);
            state = 'round';
            inputLock = true;
            const intro = () => {
                setBanner('ROUND ' + round, 1.0, () => {
                    sfx.round();
                    setBanner('FIGHT!', 0.55, () => { inputLock = false; state = 'play'; });
                });
                say('Round ' + round + '. Fight!');
            };
            if (round === 1) setBanner(p1.name + ' VS ' + p2.name, 1.0, intro);
            else intro();
        }
        function setBanner(text, dur, then) {
            banner = { text, then };
            bannerT = dur;
        }
        function startKO(winner, loser) {
            setState(loser, 'ko');
            loser.vx = winner.facing * 130;
            loser.vy = -180;
            sfx.ko();
            finishText = winner.hp === 100 ? 'PURRFECT!' : 'CLAWTALITY!';
            endRound(winner);
        }
        function endRound(winner) {
            if (state !== 'play') return;
            state = 'roundend';
            inputLock = true;
            winner.rounds++;
            const matchOver = winner.rounds >= 2;
            if (winner.state !== 'ko') setState(winner, 'win');
            say(winner.name + ' wins round ' + round + (matchOver ? ' and the match.' : '.'));
            setBanner(finishText || 'TIME!', 0.9, () => {
                setBanner(winner.name + ' WINS', 1.1, () => {
                    finishText = '';
                    if (matchOver) endMatch(winner);
                    else nextRound();
                });
            });
        }
        function endMatch(winner) {
            state = 'end';
            const youWon = winner === p1;
            document.getElementById('end-title').textContent = youWon ? 'YOU WIN' : 'CPU WINS';
            document.getElementById('end-quip').textContent = youWon
                ? 'The page is still missing. But honor is restored.'
                : winner.name + ' takes the belt. The page remains at large.';
            show('end');
        }
        function togglePause(force) {
            if (state === 'play' || force === true) { state = 'pause'; say('Paused'); }
            else if (state === 'pause') { state = 'play'; say('Resumed'); }
        }

        document.getElementById('btn-start').addEventListener('click', () => {
            sfx.start();
            state = 'select';
            show('select');
        });
        document.querySelectorAll('.slot[data-pick]').forEach((b) =>
            b.addEventListener('click', () => { sfx.select(); startMatch(b.dataset.pick); }));
        document.getElementById('btn-rematch').addEventListener('click', () => { sfx.start(); startMatch(p1.cat); });
        document.getElementById('btn-reselect').addEventListener('click', () => {
            sfx.select();
            state = 'select';
            show('select');
        });
        document.getElementById('btn-pause').addEventListener('click', () => togglePause());
        show('start');

        /* ============================== drawing ============================== */
        function drawBackdrop(t) {
            const sky = cx.createLinearGradient(0, 0, 0, H);
            sky.addColorStop(0, '#0b0710');
            sky.addColorStop(0.55, '#1c1026');
            sky.addColorStop(1, '#2a1524');
            cx.fillStyle = sky;
            cx.fillRect(0, 0, W, H);
            // stars
            cx.fillStyle = 'rgba(245,233,210,0.5)';
            for (let i = 0; i < 40; i++) {
                if ((i + Math.floor(t)) % 7 === 0) continue; // twinkle
                cx.fillRect((i * 97) % W, (i * 53) % 180, 2, 2);
            }
            // moon
            cx.fillStyle = '#f3e6c8';
            cx.beginPath();
            cx.arc(540, 62, 30, 0, 7);
            cx.fill();
            cx.fillStyle = '#e2d2ae';
            cx.fillRect(528, 52, 8, 6);
            cx.fillRect(548, 70, 10, 6);
            cx.fillRect(538, 62, 6, 4);
            // skyline
            cx.fillStyle = '#171020';
            const bl = [[0,150,70],[60,120,54],[110,170,80],[185,135,60],[240,180,70],[305,120,80],[380,160,66],[440,130,90],[525,150,70],[590,120,50]];
            for (const [bx, bh, bw] of bl) cx.fillRect(bx, 310 - bh, bw, bh);
            cx.fillStyle = '#e8b13a';
            for (let i = 0; i < 26; i++) {
                if (i % 3 === 0) continue;
                cx.fillRect(((i * 71) % 620) + 8, 160 + ((i * 37) % 120), 3, 4);
            }
            // rooftop floor
            cx.fillStyle = '#241a2e';
            cx.fillRect(0, GROUND + 20, W, H - GROUND - 20);
            cx.fillStyle = '#31243e';
            cx.fillRect(0, GROUND + 14, W, 8);
            cx.fillStyle = '#413055';
            for (let gx = 0; gx < W; gx += 32) cx.fillRect(gx, GROUND + 14, 16, 3);
            // pillar torches: steaming coffee cups
            for (const px of [34, W - 58]) {
                cx.fillStyle = '#1b1326';
                cx.fillRect(px - 6, GROUND - 38, 36, 58);
                cx.fillStyle = '#2c2138';
                cx.fillRect(px - 6, GROUND - 38, 36, 5);
                cx.fillStyle = '#c22a33';
                cx.fillRect(px, GROUND - 62, 24, 20);       // cup
                cx.fillStyle = '#8d1a22';
                cx.fillRect(px, GROUND - 46, 24, 4);
                cx.fillStyle = '#f5e9d2';
                cx.fillRect(px + 3, GROUND - 60, 18, 3);    // foam
                const st = Math.sin(t * 2 + px) * 3;        // steam
                cx.fillStyle = 'rgba(245,233,210,0.35)';
                cx.fillRect(px + 8 + st, GROUND - 74, 3, 6);
                cx.fillRect(px + 14 - st, GROUND - 84, 3, 6);
            }
        }

        function drawFighter(f, t) {
            const sheet = sheets[f.cat];
            if (!sheet || !sheet.complete || !sheet.naturalWidth) return;
            let anim, frame;
            const airborne = f.y < GROUND - 0.5;
            const dirKey = f.facing === 1 ? 'R' : 'L';
            if (f.state === 'ko') {
                anim = A['roll' + dirKey];
                frame = f.koSpin < 0.7 ? Math.floor(f.koSpin * 20) % anim.n : 3; // spin, then rest as a ball
            } else if (f.state === 'roll') {
                anim = A['roll' + dirKey];
                frame = Math.min(anim.n - 1, Math.floor((f.t / ROLL_TIME) * anim.n));
            } else if (f.state === 'punch') {
                anim = A['punch' + dirKey];
                frame = Math.min(anim.n - 1, Math.floor(f.animT * anim.fps));
            } else if (airborne || f.state === 'jump') {
                anim = A['jump' + dirKey];
                const prog = Math.max(0, Math.min(1, 0.5 + (f.vy / 900)));
                frame = Math.min(anim.n - 1, Math.floor(prog * anim.n));
            } else if (f.state === 'run') {
                anim = A['run' + dirKey];
                frame = Math.floor(f.animT * anim.fps) % anim.n;
            } else if (f.state === 'hit') {
                anim = A.idle;
                frame = 1;
            } else {
                anim = A.idle;
                frame = Math.floor(f.animT * anim.fps) % anim.n;
            }
            const idx = anim.s + frame;
            const sxp = (idx % COLS) * FR;
            const syp = Math.floor(idx / COLS) * FR;
            const dx = Math.round(f.x - DRAW / 2);
            const dy = Math.round(f.y - DRAW + 10);

            // ground shadow (airborne frames get their baked shadow cropped off)
            cx.fillStyle = 'rgba(0,0,0,0.35)';
            cx.beginPath();
            cx.ellipse(f.x, GROUND + 12, 26, 6, 0, 0, 7);
            cx.fill();

            const crop = (airborne || f.state === 'jump') ? 5 : 0;
            cx.save();
            if (f.flash > 0 && Math.floor(f.flash * 30) % 2 === 0) cx.filter = 'brightness(3)';
            cx.drawImage(sheet, sxp, syp, FR, FR - crop, dx, dy, DRAW, DRAW - crop * SCALE);
            cx.restore();

            if (f.state === 'ko' && f.koSpin > 0.7) {       // dizzy stars
                cx.fillStyle = '#e8b13a';
                for (let i = 0; i < 3; i++) {
                    const a = t * 3 + i * 2.1;
                    cx.fillRect(f.x + Math.cos(a) * 22 - 2, f.y - 60 + Math.sin(a) * 7, 4, 4);
                }
            }
        }

        function drawHUD() {
            const bw = 240, bh = 16;
            const sides = [[p1, true], [p2, false]];
            for (const [f, left] of sides) {
                const x = left ? 16 : W - 16 - bw;
                cx.fillStyle = '#000';
                cx.fillRect(x - 2, 14, bw + 4, bh + 4);
                cx.fillStyle = '#3a0d12';
                cx.fillRect(x, 16, bw, bh);
                const w = Math.round(bw * (f.hp / 100));
                const g = cx.createLinearGradient(0, 16, 0, 16 + bh);
                g.addColorStop(0, '#ffd76a');
                g.addColorStop(0.5, '#e8b13a');
                g.addColorStop(1, '#c22a33');
                cx.fillStyle = g;
                cx.fillRect(left ? x : x + bw - w, 16, w, bh);
                cx.font = '8px "Press Start 2P", monospace';
                cx.fillStyle = '#f5e9d2';
                cx.textAlign = left ? 'left' : 'right';
                cx.fillText(f.name + (f.isCPU ? ' (CPU)' : ''), left ? x : x + bw, 46);
                for (let i = 0; i < 2; i++) {               // round pips
                    const px = left ? x + i * 14 : x + bw - 8 - i * 14;
                    cx.fillStyle = i < f.rounds ? '#e8b13a' : '#463a2a';
                    cx.fillRect(px, 52, 8, 8);
                }
            }
            cx.textAlign = 'center';
            cx.font = '16px "Press Start 2P", monospace';
            cx.fillStyle = timer <= 10 ? '#c22a33' : '#f5e9d2';
            cx.fillText(String(Math.ceil(Math.max(0, timer))).padStart(2, '0'), W / 2, 34);
        }

        function drawBanner(dt) {
            if (!banner) return;
            bannerT -= dt;
            const txt = banner.text;
            const big = txt === 'FIGHT!' || txt === 'PURRFECT!' || txt === 'CLAWTALITY!' || txt === 'TIME!';
            const pulse = reduceMotion ? 1 : 1 + Math.max(0, bannerT) * 0.25;
            cx.textAlign = 'center';
            cx.font = Math.round((big ? 30 : 20) * pulse) + 'px "Press Start 2P", monospace';
            cx.fillStyle = '#000';
            cx.fillText(txt, W / 2 + 3, H / 2 + 3);
            cx.fillStyle = big ? '#c22a33' : '#e8b13a';
            cx.fillText(txt, W / 2, H / 2);
            if (bannerT <= 0) {
                const then = banner.then;
                banner = null;
                then && then();
            }
        }

        /* ============================== main loop ============================== */
        let last = performance.now();
        function loop(now) {
            requestAnimationFrame(loop);
            let dt = Math.min(0.05, (now - last) / 1000);
            last = now;
            const t = now / 1000;

            if (hitstop > 0) { hitstop -= dt; dt = 0; }

            if (state === 'play' && dt > 0) {
                timer -= dt;
                aiThink(p2, p1, dt);
                fighterInput(p1, inputLock ? {} : keys, dt, p2);
                fighterInput(p2, inputLock ? {} : aiInput(p2), dt, p1);
                fighterPhysics(p1, dt);
                fighterPhysics(p2, dt);
                tryHit(p1, p2);
                tryHit(p2, p1);
                if (timer <= 0 && state === 'play') {
                    finishText = 'TIME!';
                    endRound(p1.hp >= p2.hp ? p1 : p2);
                }
            } else if ((state === 'round' || state === 'roundend') && dt > 0) {
                fighterPhysics(p1, dt);
                fighterPhysics(p2, dt);
            }

            cx.save();
            if (shake > 0 && !reduceMotion) {
                shake = Math.max(0, shake - dt * 30);
                cx.translate((Math.random() - 0.5) * shake, (Math.random() - 0.5) * shake);
            }
            drawBackdrop(t);
            if (p1 && p2) {
                drawFighter(p2, t);
                drawFighter(p1, t);
                drawHUD();
            }
            drawBanner(dt);
            if (state === 'pause') {
                cx.fillStyle = 'rgba(0,0,0,0.6)';
                cx.fillRect(0, 0, W, H);
                cx.textAlign = 'center';
                cx.font = '20px "Press Start 2P", monospace';
                cx.fillStyle = '#e8b13a';
                cx.fillText('PAUSED', W / 2, H / 2);
                cx.font = '9px "Press Start 2P", monospace';
                cx.fillStyle = '#b8a88f';
                cx.fillText('P TO RESUME', W / 2, H / 2 + 28);
            }
            cx.restore();
        }
        requestAnimationFrame(loop);
    })();
    </script>
</body>
</html>
