<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>404 Tournament: Page Not Found - Coffee & Fun LLC</title>
    <meta name="title" content="404 Tournament: Page Not Found - Coffee & Fun LLC" />
    <meta name="description" content="This page is missing, so settle it in the 404 Tournament: a tiny pixel cat fighting game starring Crash and Coco. Then head back to the good stuff." />
    <meta name="robots" content="noindex, nofollow" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coffee & Fun" />
    <meta property="og:title" content="404 Tournament: Page Not Found - Coffee & Fun LLC" />
    <meta property="og:description" content="This page is missing, so settle it in the 404 Tournament: a tiny pixel cat fighting game starring Crash and Coco. Then head back to the good stuff." />
    <meta property="og:url" content="https://www.coffeeandfun.com/404.html" />
    <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/404-tournament.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Pixel cats Crash and Coco face off under a 404 Tournament sign" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bycoffeeandfun" />
    <meta name="twitter:title" content="404 Tournament: Page Not Found - Coffee & Fun LLC" />
    <meta name="twitter:description" content="This page is missing, so settle it in the 404 Tournament: a tiny pixel cat fighting game starring Crash and Coco. Then head back to the good stuff." />
    <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/404-tournament.png" />
    <meta name="twitter:image:alt" content="Pixel cats Crash and Coco face off under a 404 Tournament sign" />

    <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />
    <link rel="apple-touch-icon" href="/assets/images/social/192.png" />
    <meta name="theme-color" content="#0b0710" />

    <link rel="preload" href="/assets/fonts/PressStart2P-latin.woff2" as="font" type="font/woff2" crossorigin>

    {% pageCss "404" %}
</head>
<body>
    <a class="skip" href="#home-link">Skip to home link</a>
    <h1 class="sr-only">404 Tournament: Page Not Found</h1>

    <main class="stage">
        <canvas id="game" width="640" height="360" role="img" aria-label="404 Tournament: a small pixel-art fighting game where two cats, Crash and Coco, battle on a rooftop under a giant 404 sign. Playable with keyboard or touch. The home link below works without playing."></canvas>
        <div class="scanlines" aria-hidden="true"></div>
        <div class="vignette" aria-hidden="true"></div>

        <div class="ui" id="ui">
            <!-- start -->
            <section class="scr" id="scr-start">
                <h2>INSERT COFFEE<br />TO CONTINUE</h2>
                <p>A very small fighting game about a very missing page.</p>
                <p>Best of 3 rounds. 60 seconds each.</p>
                <p class="rec" id="rec-start" hidden></p>
                <p style="margin-top: 1.2rem"><button class="btn" id="btn-start" type="button">PRESS START</button></p>
            </section>

            <!-- choose fighter -->
            <section class="scr" id="scr-select" hidden>
                <h2>CHOOSE YOUR FIGHTER</h2>
                <div class="roster">
                    <button class="slot" type="button" data-pick="crash">
                        <span class="face" id="face-crash" aria-hidden="true"></span>
                        <span class="nm">CRASH</span>
                        <span class="rl">HEAD OF SECURITY</span>
                    </button>
                    <button class="slot" type="button" data-pick="coco">
                        <span class="face" id="face-coco" aria-hidden="true"></span>
                        <span class="nm">COCO</span>
                        <span class="rl">HEAD OF SEARCH</span>
                    </button>
                    <button class="slot locked" type="button" data-pick="konami" id="slot-konami" disabled>
                        <span class="face" id="face-konami" aria-hidden="true">?</span>
                        <span class="nm" id="nm-konami">???</span>
                        <span class="rl" id="rl-konami">PAGE NOT FOUND</span>
                    </button>
                    <div class="slot locked" aria-hidden="true">
                        <span class="face">?</span>
                        <span class="nm">???</span>
                        <span class="rl">PAGE NOT FOUND</span>
                    </div>
                </div>
                <p>The other cat fights for the machine.</p>
            </section>

            <!-- end -->
            <section class="scr" id="scr-end" hidden>
                <h2 id="end-title">YOU WIN</h2>
                <p id="end-quip">The page is still missing. But honor is restored.</p>
                <p class="rec" id="rec-end"></p>
                <p class="hint" id="konami-hint" hidden>PSST... UP UP DOWN DOWN LEFT RIGHT LEFT RIGHT B A</p>
                <p style="margin-top: 1.2rem">
                    <button class="btn" id="btn-rematch" type="button">REMATCH</button>
                    <button class="btn ghost" id="btn-reselect" type="button">CHANGE FIGHTER</button>
                </p>
            </section>
        </div>
    </main>

    <div class="console">
        <div class="deck">
            <p class="keys">
                <b>ARROWS</b> MOVE &nbsp; <b>UP</b> JUMP &nbsp; <b>Z</b> PUNCH &nbsp; <b>X</b> ROLL &nbsp; <b>C</b> BLOCK &nbsp; <b>P</b> PAUSE
            </p>
            <div>
                <button class="iconbtn" id="btn-sound" type="button" aria-pressed="true">SOUND: ON</button>
                <button class="iconbtn" id="btn-pause" type="button" aria-pressed="false">PAUSE</button>
            </div>
        </div>

        <div class="touchpad">
            <div class="tgroup">
                <button class="tbtn" data-t="left" type="button" aria-label="Move left">&lt;</button>
                <button class="tbtn" data-t="right" type="button" aria-label="Move right">&gt;</button>
            </div>
            <div class="tgroup">
                <button class="tbtn" data-t="jump" type="button">JUMP</button>
                <button class="tbtn" data-t="punch" type="button">PUNCH</button>
                <button class="tbtn" data-t="roll" type="button">ROLL</button>
                <button class="tbtn" data-t="block" type="button">BLOCK</button>
            </div>
        </div>
    </div>

    <div class="exitwrap">
        <a class="exit" id="home-link" href="/">TAKE ME HOME</a>
    </div>

    <p class="credits">
        Cat fighters: <a href="https://pixelfight.itch.io/cat-pack" rel="noopener">Pixel Cats! by PixelFight</a> (CC0).
        Font: Press Start 2P (SIL OFL). Crash and Coco are real cats. No cats were harmed; one page was lost.
    </p>

    <div class="toast" id="toast" role="status"></div>
    <div class="sr-only" role="status" aria-live="polite" id="announcer-live"></div>

    <noscript>
        <p style="max-width: 60ch; text-align: center; font-size: 11px; line-height: 2; padding: 0 1rem 2rem">
            The tournament needs JavaScript, but the important part doesn't:
            this page wasn't found. Use the TAKE ME HOME link above to get back to the site.
        </p>
    </noscript>

    {% pageJs "404" %}
</body>
</html>
