</head>
<body>
    <a class="skip" href="#exits">Skip to site links</a>

    <header class="marquee">
        <p class="presents">Coffee &amp; Fun LLC presents</p>
        <h1 class="title"><span class="four">404</span> TOURNAMENT</h1>
        <p class="tagline">
            <strong>ERROR 404: PAGE NOT FOUND.</strong><br />
            The page you wanted has left the arena. Two cats remain.<br />
            Settle it, then head back to the good stuff below.
        </p>
    </header>

    <main class="cabinet">
        <div class="antenna" aria-hidden="true">
            <span class="rod l"></span>
            <span class="rod r"></span>
            <span class="base"></span>
        </div>
        <div class="tv-body">
        <div class="screen-wrap">
            <canvas id="game" width="640" height="360" role="img" aria-label="404 Tournament: a small pixel-art fighting game where two cats, Crash and Coco, battle on a rooftop. Playable with keyboard or touch. The site links below work without playing."></canvas>
            <div class="scanlines" aria-hidden="true"></div>

            <div class="ui" id="ui">
                <!-- start -->
                <section class="scr" id="scr-start">
                    <h2>INSERT COFFEE<br />TO CONTINUE</h2>
                    <p>A very small fighting game about a very missing page.</p>
                    <p style="margin-bottom: 1.2rem">Best of 3 rounds. 60 seconds each.</p>
                    <button class="btn" id="btn-start" type="button">PRESS START</button>
                </section>

                <!-- choose fighter -->
                <section class="scr" id="scr-select" hidden>
                    <h2>CHOOSE YOUR FIGHTER</h2>
                    <div class="roster">
                        <button class="slot" type="button" data-pick="crash">
                            <span class="face" id="face-crash" aria-hidden="true"></span>
                            <span class="nm">CRASH</span>
                            <span class="rl">HEAD OF SECURITY</span>
                        </button>
                        <button class="slot" type="button" data-pick="coco">
                            <span class="face" id="face-coco" aria-hidden="true"></span>
                            <span class="nm">COCO</span>
                            <span class="rl">HEAD OF SEARCH</span>
                        </button>
                        <div class="slot locked" aria-hidden="true">
                            <span class="face">?</span>
                            <span class="nm">???</span>
                            <span class="rl">PAGE NOT FOUND</span>
                        </div>
                        <div class="slot locked" aria-hidden="true">
                            <span class="face">?</span>
                            <span class="nm">???</span>
                            <span class="rl">PAGE NOT FOUND</span>
                        </div>
                    </div>
                    <p>The other cat fights for the machine.</p>
                </section>

                <!-- end -->
                <section class="scr" id="scr-end" hidden>
                    <h2 id="end-title">YOU WIN</h2>
                    <p id="end-quip">The page is still missing. But honor is restored.</p>
                    <p style="margin-top: 1.2rem">
                        <button class="btn" id="btn-rematch" type="button">REMATCH</button>
                        <button class="btn ghost" id="btn-reselect" type="button">CHANGE FIGHTER</button>
                    </p>
                </section>
            </div>
            <div class="glass" aria-hidden="true"></div>
        </div>

        <div class="tv-panel" aria-hidden="true">
            <span class="knob"></span>
            <span class="knob small"></span>
            <span class="speaker"></span>
            <span class="badge">COFFEE &amp; FUN<br />CRT-404</span>
            <span class="led"></span>
        </div>
        </div>

        <div class="tv-feet" aria-hidden="true"><i></i><i></i></div>

        <div class="deck">
            <p class="keys">
                <b>&larr;&rarr;</b> MOVE &nbsp; <b>&uarr;</b> JUMP &nbsp; <b>Z</b> PUNCH &nbsp; <b>X</b> ROLL &nbsp; <b>P</b> PAUSE
            </p>
            <div>
                <button class="iconbtn" id="btn-sound" type="button" aria-pressed="true">SOUND: ON</button>
