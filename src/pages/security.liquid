<!doctype html>
<html class="brand-color-background scroll-smooth antialiased" lang="en" data-theme="light" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary Meta Tags -->
    <title>Security - Coffee &amp; Fun LLC</title>
    <meta name="title" content="Security - Coffee &amp; Fun LLC" />
    <meta name="description" content="How Coffee &amp; Fun keeps its apps safe: frequent small updates, current dependencies, almost no stored data, and a promise to tell you when something goes wrong." />
    <meta name="keywords" content="security, responsible disclosure, app security, browser extension security, Coffee &amp; Fun LLC, report a vulnerability" />
    <meta name="author" content="Coffee &amp; Fun LLC" />
    <meta name="robots" content="index, follow" />
    <meta name="rating" content="safe for kids" />

    <link rel="canonical" href="https://www.coffeeandfun.com/security/" />
    <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coffee &amp; Fun" />
    <meta property="og:title" content="Security - Coffee &amp; Fun LLC" />
    <meta property="og:description" content="How Coffee &amp; Fun keeps its apps safe: frequent small updates, current dependencies, almost no stored data, and a promise to tell you when something goes wrong." />
    <meta property="og:url" content="https://www.coffeeandfun.com/security/" />
    <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/security.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Coffee &amp; Fun cup logo above a red badge reading Security" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bycoffeeandfun" />
    <meta name="twitter:creator" content="@bycoffeeandfun" />
    <meta name="twitter:title" content="Security - Coffee &amp; Fun LLC" />
    <meta name="twitter:description" content="How Coffee &amp; Fun keeps its apps safe: frequent small updates, current dependencies, almost no stored data, and a promise to tell you when something goes wrong." />
    <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/security.png" />
    <meta name="twitter:image:alt" content="Coffee &amp; Fun cup logo above a red badge reading Security" />

    <link rel="manifest" href="/assets/images/social/site.webmanifest" />
    <meta name="theme-color" content="#fef5ec" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="apple-touch-icon" href="/assets/images/social/192.png" />
    <link rel="icon" href="/assets/images/social/192.png" sizes="192x192" type="image/png" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": "Security",
        "description": "Coffee & Fun LLC security practices and how to report a problem.",
        "url": "https://www.coffeeandfun.com/security/",
        "publisher": {
          "@type": "Organization",
          "name": "Coffee & Fun LLC",
          "url": "https://www.coffeeandfun.com/",
          "email": "hello@coffeeandfun.com"
        },
        "breadcrumb": {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.coffeeandfun.com/" },
            { "@type": "ListItem", "position": 2, "name": "Security", "item": "https://www.coffeeandfun.com/security/" }
          ]
        }
      }
    </script>

    {% bundledCss %}


    {% include scripts.html %}
    {% include sketch-styles.liquid %}
  </head>

  <body>
    {% assign showFun = true %}
    {% assign showMiddleBadgeWithText = true %}
    {% include header.liquid %}

    <main id="main-content">

      <!-- Hero -->
      <section class="relative mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 pt-20 sm:pt-28 pb-10 sm:pb-14 text-center overflow-visible">
        <h1 class="brand-heading text-4xl sm:text-5xl lg:text-6xl leading-[1.15] mb-5">
          Security
        </h1>
        <p class="text-lg sm:text-xl text-stone-600 max-w-2xl mx-auto leading-relaxed">
          Small updates, shipped often. Very little of your information anywhere near us. And if something does go wrong, you will hear it from us first.
        </p>

        <p class="mt-8 text-xl sm:text-2xl text-caramel" style="font-family: 'Caveat', cursive;">
          Updated often&nbsp;&nbsp;&middot;&nbsp;&nbsp;Checked constantly&nbsp;&nbsp;&middot;&nbsp;&nbsp;Told you first
        </p>

        <div class="sketch-note" style="top: 22%; left: 5%; transform: rotate(-8deg);">
          <svg width="26" height="30" viewBox="0 0 26 30">
            <rect x="3" y="13" width="20" height="14" rx="3" fill="none" stroke="var(--color-mocha)" stroke-width="2" stroke-linejoin="round" opacity="0.4"/>
            <path d="M7 13 L7 9 C7 5, 9 2, 13 2 C17 2, 19 5, 19 9 L19 13" fill="none" stroke="var(--color-mocha)" stroke-width="2" stroke-linecap="round" opacity="0.4"/>
            <circle cx="13" cy="20" r="2" fill="var(--color-coral)" opacity="0.45"/>
          </svg>
        </div>

        <div class="sketch-note sketch-wiggle" style="top: 42%; right: 6%; --sketch-rotate: 8deg;">
          <svg width="12" height="22" viewBox="0 0 16 28">
            <path d="M10 0 L4 12 L10 12 L6 28" class="sketch-lightning"/>
          </svg>
        </div>

        <div class="sketch-note" style="top: 12%; right: 8%; transform: rotate(10deg);">
          <svg width="24" height="24" viewBox="0 0 30 30">
            <path d="M15 2 L17 11 L26 11 L19 17 L22 26 L15 21 L8 26 L11 17 L4 11 L13 11 Z" fill="none" stroke="#fd6155" stroke-width="1.5" stroke-linejoin="round" opacity="0.35"/>
          </svg>
        </div>

        <div class="sketch-note" style="bottom: 6%; left: 4%;">
          <svg width="50" height="14" viewBox="0 0 50 14">
            <path d="M2 8 C8 2, 14 12, 20 7 C26 2, 32 12, 38 7 C44 2, 48 10, 48 7" class="sketch-squiggle"/>
          </svg>
        </div>
      </section>

      <!-- Content -->
      <section class="relative mx-auto max-w-2xl px-4 sm:px-6 lg:px-8 pb-16 overflow-visible">
        <div class="sketch-note text-base sm:text-lg" style="top: -10px; right: -6%; transform: rotate(4deg); opacity: 0.75;">
          boring on purpose!
        </div>

        <div class="sketch-note sketch-float-slow" style="top: 55%; left: -6%; --sketch-rotate: 10deg;">
          <svg width="16" height="14" viewBox="0 0 24 22">
            <path d="M12 21 C12 21, 2 14, 2 7 C2 3, 5 1, 8 2 C10 3, 11 5, 12 6 C13 5, 14 3, 16 2 C19 1, 22 3, 22 7 C22 14, 12 21, 12 21 Z" class="sketch-heart-filled"/>
          </svg>
        </div>

        <article class="space-y-10 text-pretty">

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">The short version</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              The safest data is data nobody has. Our apps keep your information on your own device, so there is no big pile of it sitting on a server waiting to be stolen. On top of that we update constantly and we tell the truth when something breaks.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">We update a lot</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              We ship small updates often rather than big ones rarely. A small change is easier to check, easier to undo, and gets a fix to you in days instead of months. If you use one of our <a class="underline decoration-2 underline-offset-2" style="color: var(--color-caramel);" href="/apps/">apps or extensions</a>, it is quietly getting better in the background.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">We keep the building blocks current</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              Every app is built partly from other people's code. When one of those pieces gets a security fix, we take the update. We watch for those alerts continuously and treat them as work to do now, not later.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">Less data, less risk</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              Most of our apps never send your information anywhere, because they do their work on your device. There is no account to break into and no database of your files. You can read the details on our <a class="underline decoration-2 underline-offset-2" style="color: var(--color-caramel);" href="/privacy/">privacy page</a>.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">We check our own work</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              We review changes before they go out, test the things people rely on most, and go back through older code when we learn something new. Some of our code is public, so anyone can look at it themselves on our <a class="underline decoration-2 underline-offset-2" style="color: var(--color-caramel);" href="/open-source/">open source page</a>.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">If something goes wrong, we say so</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              If we find a problem that could have affected you, we will publish it. We will say what happened, what we did, and what you should do, in normal words. We would rather tell you about a mistake than have you find out some other way.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">Found a problem? Please tell us</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              Email <a class="underline decoration-2 underline-offset-2" style="color: var(--color-caramel);" href="mailto:hello@coffeeandfun.com?subject=Security%20report">hello@coffeeandfun.com</a> with "Security" in the subject. Tell us which app, what you did, and what happened. A screenshot or a short list of steps helps a lot.
            </p>
            <p class="text-lg text-stone-600 leading-relaxed mt-4">
              We will reply, keep you updated while we fix it, and credit you when it is done if you would like us to. We are a small team, so please give us a reasonable amount of time before sharing it publicly.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">Two things we ask</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              Please only test against your own accounts and your own data, and please do not do anything that would break the service for other people. Look, tell us, and let us fix it. That is all we ask.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-stone-900 mb-3">Helperbird</h2>
            <p class="text-lg text-stone-600 leading-relaxed">
              Helperbird is a bigger product with its own accounts and its own setup, so it has its own security information. Visit <a class="underline decoration-2 underline-offset-2" style="color: var(--color-caramel);" href="https://www.helperbird.com" rel="noopener">helperbird.com</a> for that.
            </p>
          </section>

          <p class="text-sm text-stone-500 pt-4">Last updated: 4 August 2026.</p>

        </article>
      </section>

      <!-- CTA -->
      <section class="relative mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 pb-24 sm:pb-32 text-center overflow-visible">
        <div class="sketch-note text-base sm:text-lg" style="top: -6px; right: 10%; transform: rotate(4deg);">
          <svg width="18" height="16" viewBox="0 0 22 20" style="position: relative; display: inline-block; margin-right: 3px; vertical-align: middle;">
            <path d="M3 10 L9 16 L19 4" class="sketch-check"/>
          </svg>
          no bad news is bad news
        </div>

        <h2 class="brand-heading text-3xl sm:text-4xl lg:text-5xl leading-[1.25] mb-4">
          Spotted Something?
        </h2>
        <p class="text-lg sm:text-xl text-stone-600 max-w-xl mx-auto leading-relaxed mb-8">
          Big or small, we want to know. There is no wrong way to report it.
        </p>

        <div class="relative inline-block">
          <a
            class="btn btn-lg rounded-lg px-8 sm:px-10 font-semibold text-white border-0 bg-caramel hover:bg-espresso shadow-[0_10px_15px_-3px_rgba(122,78,49,0.35)] hover:shadow-xl hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-espresso focus-visible:ring-offset-2 transition-all duration-200"
            href="mailto:hello@coffeeandfun.com?subject=Security%20report"
            title="Email Coffee &amp; Fun a security report"
          >
            Report a Problem
          </a>
        </div>

        <div class="relative inline-block w-full">
          <p class="mt-6 text-sm text-stone-500">
            Or write to <a href="mailto:hello@coffeeandfun.com" class="underline hover:text-stone-700 transition-colors" style="color: var(--color-mocha);">hello@coffeeandfun.com</a>
          </p>
          <div class="sketch-note" style="bottom: -8px; left: 50%; transform: translateX(-50%);">
            <svg width="100" height="10" viewBox="0 0 100 10">
              <path d="M2 7 C12 2, 22 10, 35 5 C48 0, 58 10, 72 5 C85 0, 92 8, 98 4" class="sketch-underline"/>
            </svg>
          </div>
        </div>
      </section>

    </main>

    {% include modals.liquid %}
    {% include footer.liquid %}
  </body>
</html>
