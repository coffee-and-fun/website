<!DOCTYPE html>
<html class="antialiased" lang="en" data-theme="light" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary Meta Tags -->
    <title>Free Chrome Extension Icon Generator - Coffee & Fun LLC</title>
    <meta name="title" content="Free Chrome Extension Icon Generator - Coffee & Fun LLC" />
    <meta name="description" content="Upload one 1024x1024 image and get all nine icon sizes a Chrome extension needs, 16px to 1024px, resized right in your browser. Download each size or one zip." />
    <meta name="keywords" content="chrome extension icons, icon generator, resize icons, extension development, manifest icons, browser extension, icon resizer, png icons" />
    <meta name="author" content="Coffee & Fun LLC" />
    <meta name="robots" content="index, follow" />
    <meta name="rating" content="general" />

    <!-- Canonical URL -->
    <link rel="canonical" href="https://www.coffeeandfun.com/chrome-extension-icon-generator/" />

    <!-- Favicon -->
    <link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />
    <link rel="apple-touch-icon" href="/assets/images/social/192.png" />
    <link rel="icon" href="/assets/images/social/192.png" sizes="192x192" type="image/png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Coffee & Fun" />
    <meta property="og:title" content="Free Chrome Extension Icon Generator - Coffee & Fun LLC" />
    <meta property="og:description" content="Upload one 1024x1024 image and get all nine icon sizes a Chrome extension needs, 16px to 1024px, resized right in your browser. Download each size or one zip." />
    <meta property="og:url" content="https://www.coffeeandfun.com/chrome-extension-icon-generator/" />
    <meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/chrome-extension-icon-generator.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Edge, Chrome, and Firefox logos above the words Browser Extension Icon Generator" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@bycoffeeandfun" />
    <meta name="twitter:creator" content="@bycoffeeandfun" />
    <meta name="twitter:title" content="Free Chrome Extension Icon Generator - Coffee & Fun LLC" />
    <meta name="twitter:description" content="Upload one 1024x1024 image and get all nine icon sizes a Chrome extension needs, 16px to 1024px, resized right in your browser. Download each size or one zip." />
    <meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/chrome-extension-icon-generator.png" />
    <meta name="twitter:image:alt" content="Edge, Chrome, and Firefox logos above the words Browser Extension Icon Generator" />
    <meta name="twitter:domain" content="coffeeandfun.com" />
    <meta name="twitter:url" content="https://www.coffeeandfun.com/chrome-extension-icon-generator/" />

    <!-- Web App Manifest -->
    <link rel="manifest" href="/assets/images/social/site.webmanifest" />
    <meta name="theme-color" content="#fef5ec" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Icon Generator" />

    <!-- Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "@id": "https://www.coffeeandfun.com/chrome-extension-icon-generator/",
        "name": "Chrome Extension Icon Generator",
        "description": "Generate all required icon sizes for your Chrome extension from a single 1024x1024 image. Outputs 16, 19, 32, 38, 48, 64, 128, 512, and 1024px icons.",
        "url": "https://www.coffeeandfun.com/chrome-extension-icon-generator/",
        "image": "https://www.coffeeandfun.com/assets/images/social/pages/chrome-extension-icon-generator.png",
        "applicationCategory": "UtilitiesApplication",
        "operatingSystem": "Web Browser",
        "browserRequirements": "Requires JavaScript. Requires HTML5.",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "featureList": [
          "Nine icon sizes from one upload (16 to 1024 px)",
          "Download each size individually",
          "Download every size as one zip",
          "Ready-made manifest.json snippet",
          "Local processing - images never leave the browser"
        ],
        "creator": {
          "@id": "https://www.coffeeandfun.com/#founder"
        },
        "publisher": {
          "@id": "https://www.coffeeandfun.com/#organization"
        },
        "isAccessibleForFree": true,
        "inLanguage": "en"
      }
    </script>

    <script src="https://unpkg.com/vue@3"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

    {% bundledCss %}
    {% pageCss "chrome-extension-icon-generator" %}
    {% include sketch-styles.liquid %}
{% include schema-org.liquid %}

    </head>

<body>
    <a href="#tool" class="skip">Skip to the tool</a>

    {% include header.liquid %}
{% raw %}
    <main v-cloak id="main-content" class="wrap">

        <header id="tool">
            <h1 class="brand-heading text-3xl sm:text-4xl">Every Chrome extension icon size, from one image</h1>
            <p class="lede">Drop in one big picture, 1024 &times; 1024 works best, and get back all nine sizes Chrome asks for, ready to download one by one or all at once. Your image never leaves your browser.</p>

            <!-- Sketch: sparkle top-right -->
            <div class="sketch-note sketch-float" aria-hidden="true" style="top: -12px; right: -3%; --sketch-rotate: 8deg;">
                <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24">
                    <path d="M12 2 L13.5 10.5 L22 12 L13.5 13.5 L12 22 L10.5 13.5 L2 12 L10.5 10.5 Z" class="sketch-sparkle"/>
                </svg>
            </div>

            <!-- Sketch: small cross, far left of the heading -->
            <div class="sketch-note sketch-wiggle" aria-hidden="true" style="top: 4px; left: -3.5%; --sketch-rotate: -12deg;">
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16">
                    <path d="M3 3 L13 13 M13 3 L3 13" class="sketch-cross"/>
                </svg>
            </div>

            <!-- Sketch: squiggle under the heading, left edge -->
            <div class="sketch-note" aria-hidden="true" style="top: 52%; left: -3%;">
                <svg aria-hidden="true" width="30" height="10" viewBox="0 0 34 12">
                    <path d="M2 6 C6 1, 10 11, 14 6 C18 1, 22 11, 26 6 C28 3, 30 5, 32 6" class="sketch-squiggle"/>
                </svg>
            </div>

            <!-- Sketch: dashed circle, right of the lede -->
            <div class="sketch-note sketch-float-slow" aria-hidden="true" style="top: 58%; right: -2.5%; --sketch-rotate: -6deg;">
                <svg aria-hidden="true" width="26" height="26" viewBox="0 0 36 36">
                    <circle cx="18" cy="18" r="12" class="sketch-circle" transform="rotate(20 18 18)"/>
                </svg>
            </div>

            <!-- Sketch: "drop it here" pointing down at step 1 -->
            <div class="sketch-note text-base" aria-hidden="true" style="bottom: 10px; right: 3%; transform: rotate(-4deg);">
                drop it here
                <svg aria-hidden="true" width="26" height="22" viewBox="0 0 28 24" style="position: relative; display: inline-block; margin-left: 2px; vertical-align: middle;">
                    <path d="M2 4 C10 4, 20 8, 24 20 M24 20 L17 17 M24 20 L25 12" class="sketch-arrow"/>
                </svg>
            </div>
        </header>

        <!-- Live status for screen readers -->
        <div class="sr-only" role="status" aria-live="polite">{{ announcement }}</div>

        <!-- ===== Step 1: upload ===== -->
        <section class="cf-step" aria-labelledby="h-pick">
            <h2 class="step-label" id="h-pick">1, Pick your icon</h2>

            <label v-if="!image" for="icon-file" class="drop" :class="{ drag: dragging }"
                   @dragover.prevent="dragging = true" @dragleave="dragging = false" @drop.prevent="onDrop">
                <div class="ico"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg></div>
                <div class="main">Drop your picture, or click to choose</div>
                <div class="sub" id="drop-formats">PNG, JPG, or WEBP, a square PNG with transparency works best</div>
                <input id="icon-file" ref="fileInput" type="file"
                       accept="image/png,image/jpeg,image/jpg,image/webp"
                       class="sr-only" @change="onFileChange" aria-describedby="drop-formats" />
            </label>

            <div v-else class="thumb-row">
                <img :src="image" alt="" class="thumb" />
                <div class="thumb-meta">
                    <div class="name">{{ fileName || 'Your picture' }}</div>
                    <div class="dim">{{ imgW }} &times; {{ imgH }} px</div>
                </div>
                <button type="button" class="btn btn-ghost" style="--btn-color: var(--color-cocoa)" @click="reset" aria-label="Remove this picture and start over">Change</button>
            </div>

            <div v-if="fileError" class="banner warn" role="alert">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4"/><path d="M12 17h.01"/><circle cx="12" cy="12" r="10"/></svg>
                <span>{{ fileError }}</span>
            </div>

            <div v-if="sizeBanner" class="banner" :class="sizeBanner.tone">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4"/><path d="M12 17h.01"/><circle cx="12" cy="12" r="10"/></svg>
                <span>{{ sizeBanner.text }}</span>
            </div>
        </section>

        <!-- ===== Step 2: generate ===== -->
        <section class="cf-step" aria-labelledby="h-make">
            <h2 class="step-label" id="h-make">2, Make every size</h2>
            <button type="button" class="btn btn-lg" style="--btn-color: var(--color-cocoa); --btn-fg: #fff" @click="generate" :disabled="!image || generating">
                <span v-if="generating" class="spin" aria-hidden="true"></span>
                {{ generating ? 'Generating…' : 'Generate all icon sizes' }}
            </button>
            <p v-if="!image" class="hint">Pick a picture in step 1 first.</p>
            <p class="hint">Makes 16, 19, 32, 38, 48, 64, 128, 512, and 1024 px, everything your <code>manifest.json</code>, toolbar, and the Chrome Web Store ask for.</p>
        </section>

        <!-- ===== Step 3: download ===== -->
        <section class="cf-step" aria-labelledby="h-download">
            <h2 class="step-label" id="h-download">3, Download your sizes</h2>

            <template v-if="icons.length">
                <ul class="icon-grid">
                    <li class="icon-card" v-for="icon in icons" :key="icon.size">
                        <div class="tile">
                            <img :src="icon.dataUrl" alt=""
                                 :width="Math.min(icon.size, 64)" :height="Math.min(icon.size, 64)" />
                        </div>
                        <p class="size" aria-hidden="true">{{ icon.size }} &times; {{ icon.size }}</p>
                        <a class="btn btn-outline dl" style="--btn-color: var(--color-cocoa)" :href="icon.dataUrl" :download="icon.size + '.png'"
                           :aria-label="'Download the ' + icon.size + ' by ' + icon.size + ' pixel icon as ' + icon.size + '.png'"
                           @click="announce(icon.size + ' by ' + icon.size + ' icon downloaded.')">Download</a>
                    </li>
                </ul>

                <div class="dl-all">
                    <button type="button" class="btn btn-lg" style="--btn-color: var(--color-cocoa); --btn-fg: #fff" @click="downloadAll" :disabled="zipBusy">
                        <span v-if="zipBusy" class="spin" aria-hidden="true"></span>
                        {{ zipBusy ? 'Zipping…' : 'Download all ' + icons.length + ' as a zip' }}
                    </button>
                    <p v-if="zipError" class="copy-note bad" role="alert">{{ zipError }}</p>
                    <p v-else class="copy-note">One file, <code>extension-icons.zip</code>, with every size named by its pixel width, 16.png, 19.png, and so on.</p>
                </div>
            </template>
            <div v-else class="code-empty">Your nine icon sizes will appear here once you generate them.</div>
        </section>

        <!-- ===== Step 4: manifest snippet ===== -->
        <section class="cf-step" aria-labelledby="h-manifest">
            <h2 class="step-label" id="h-manifest">4, Paste into your manifest</h2>

            <template v-if="icons.length">
                <button type="button" class="btn btn-lg" style="--btn-color: var(--color-cocoa); --btn-fg: #fff" @click="copyManifest">
                    {{ copied ? 'Copied ✓' : 'Copy the snippet' }}
                </button>
                <p v-if="copyFailed" class="copy-note bad">Copy didn&rsquo;t work, the snippet below is selected, press Ctrl+C or Cmd+C.</p>
                <p class="paste-hint">Add this to your <code>manifest.json</code>. The paths assume the icons live in an <code>icons/</code> folder next to it, rename them to match your project.</p>
                <div class="code-scroll" tabindex="0" role="region" aria-label="Your manifest.json icons snippet">
                    <pre ref="codePre">{{ manifestSnippet }}</pre>
                </div>
            </template>
            <div v-else class="code-empty">A ready-made <code>manifest.json</code> snippet will appear here too.</div>
        </section>

        <p class="note">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <span>Everything happens on your own device, your pictures are resized right here in the browser and never uploaded anywhere.</span>
        </p>

        <p class="foot">A free tool by Coffee &amp; Fun · Works offline once loaded · No sign-up</p>
    </main>
{% endraw %}

    {% include modals.liquid %}
    {% include footer.liquid %}

    {% pageJs "chrome-extension-icon-generator" %}
</body>
</html>
