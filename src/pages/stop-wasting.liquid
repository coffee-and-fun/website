<!DOCTYPE html>
<html class="scroll-smooth antialiased special-red" lang="en" data-theme="light" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		
		<!-- Primary Meta Tags -->
		<title>ProcrastiNOT - Website Blocked</title>
		<meta name="title" content="ProcrastiNOT - Website Blocked" />
		<meta name="description" content="ProcrastiNOT blocks time-wasting websites so you can focus on your goals. This page appears when the app stops you from visiting a site you chose to block." />
		<meta name="keywords" content="website blocker, productivity, focus, procrastination blocker, ProcrastiNOT, Coffee & Fun" />
		<meta name="author" content="Coffee & Fun LLC" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="rating" content="safe for kids" />
		
		<!-- Canonical URL -->
		<link rel="canonical" href="https://www.coffeeandfun.com/stop-wasting/" />
		
		<!-- Favicon -->
		<link rel="icon" href="/assets/images/brand/favicon.png" sizes="any" />

		<!-- Open Graph Meta Tags -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Coffee & Fun" />
		<meta property="og:title" content="ProcrastiNOT - Website Blocked" />
		<meta property="og:description" content="ProcrastiNOT blocks time-wasting websites so you can focus on your goals. This page appears when the app stops you from visiting a site you chose to block." />
		<meta property="og:url" content="https://www.coffeeandfun.com/stop-wasting/" />
		<meta property="og:image" content="https://www.coffeeandfun.com/assets/images/social/pages/stop-wasting.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="ProcrastiNOT card with a head and spiral icon and the words stop time wasting" />

		<!-- Twitter Card Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@bycoffeeandfun" />
		<meta name="twitter:creator" content="@bycoffeeandfun" />
		<meta name="twitter:title" content="ProcrastiNOT - Website Blocked" />
		<meta name="twitter:description" content="ProcrastiNOT blocks time-wasting websites so you can focus on your goals. This page appears when the app stops you from visiting a site you chose to block." />
		<meta name="twitter:image" content="https://www.coffeeandfun.com/assets/images/social/pages/stop-wasting.png" />
		<meta name="twitter:image:alt" content="ProcrastiNOT card with a head and spiral icon and the words stop time wasting" />
		<meta name="twitter:domain" content="coffeeandfun.com" />
		<meta name="twitter:url" content="https://www.coffeeandfun.com/stop-wasting/" />

		<!-- PWA Manifest -->
		<link rel="manifest" href="/assets/images/social/site.webmanifest" />

		<!-- Theme & Mobile Meta -->
		<meta name="theme-color" content="#fc7367" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />

		<!-- Icons -->
		<link rel="apple-touch-icon" href="/assets/images/social/192.png" />
		<link rel="icon" href="/assets/images/social/192.png" sizes="192x192" type="image/png" />

		<!-- Structured Data (JSON-LD) -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "WebPage",
				"name": "ProcrastiNOT - Website Blocked",
				"description": "Blocked page displayed by ProcrastiNOT when users attempt to access time-wasting websites",
				"url": "https://www.coffeeandfun.com/stop-wasting/",
				"isPartOf": {
					"@type": "SoftwareApplication",
					"name": "ProcrastiNOT",
					"applicationCategory": "ProductivityApplication",
					"operatingSystem": ["macOS", "iOS", "iPadOS"],
					"publisher": {
						"@type": "Organization",
						"name": "Coffee & Fun LLC",
						"url": "https://www.coffeeandfun.com"
					}
				}
			}
		</script>

		{% bundledCss %}


		{% include scripts.html %}

    {% pageCss "stop-wasting" %}
	</head>
	
	<body>
		<main class="relative isolate min-h-full special-red">
			<div class="mx-auto max-w-4xl px-6 py-32 text-center sm:py-40 lg:px-8">
				<img
					class="mx-auto block"
					height="128"
					width="128"
					src="/assets/images/apps/procrastinot.png"
					alt="ProcrastiNOT app icon, a head with a spiral inside"
				/>
				<h1 id="blockMessage" class="mt-4 text-2xl font-bold tracking-tight text-white sm:text-3xl">
					Blocked! But don't worry, I'm sure cat videos are overrated anyway.
				</h1>
				<p class="mt-4 font-semibold sm:mt-6 badge badge-lg badge-outline">
					You paid for this app after all.
				</p>
			</div>
		</main>

    {% pageJs "stop-wasting" %}
	</body>
</html>